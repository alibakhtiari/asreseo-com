---
import Icon from '../ui/Icon.astro';
import Logo from '../Logo.astro';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props as Props;
void lang;

const currentYear = new Date().getFullYear();

const footerLinks = {
  services: [
    { title: 'Master Services Suite ↗', href: '/services/' },
    { title: 'SEO Infrastructure', href: '/services/seo/' },
    { title: 'Web Engineering & Speed', href: '/services/web/' },
    { title: 'Digital Marketing & Ads', href: '/services/marketing/' },
    { title: 'Content & Entity Systems', href: '/services/content/' },
    { title: 'Neural AI & GEO Suite', href: '/services/ai/' },
  ],
  company: [
    { title: 'About Us', href: '/about/' },
    { title: 'Portfolio Archive', href: '/portfolio/' },
    { title: 'Command Center (mcp.asreseo.com) ↗', href: 'https://mcp.asreseo.com' },
    { title: 'Command Center Repo (GitHub) ↗', href: 'https://github.com/alibakhtiari/asreseo-command-center' },
    { title: 'WebABC SEO Suite (emdash-seo) ↗', href: 'https://github.com/alibakhtiari/emdash-seo' },
    { title: 'Blog', href: '/blog/' },
    { title: 'Contact Terminal', href: '/contact/' },
  ],
  support: [
    { title: 'FAQ', href: '/faq/' },
    { title: 'Support SLA', href: '/support/' },
    { title: 'Free Consultation', href: '/consultation/' },
    { title: 'n8n Automation Engine ↗', href: 'https://n8n.asreseo.com' },
    { title: 'n8n AvvalAI Node ↗', href: 'https://github.com/alibakhtiari/n8n-nodes-avvalai' },
    { title: 'n8n ImageRouter Node ↗', href: 'https://github.com/alibakhtiari/n8n-nodes-imagerouter' },
    { title: 'LLM Manifest (llms.txt) ↗', href: '/llms.txt' },
  ],
};
---
<footer class="bg-[#000000] border-t-2 border-white/20 text-slate-300 wireframe-grid relative">
  <div class="w-full max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
    <!-- Main Footer -->
    <div class="py-16 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
      <!-- Brand & Telemetry -->
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 bg-black border-2 border-white/20 flex items-center justify-center text-[#CCFF00] shrink-0">
            <Logo class="w-6 h-6 text-[#CCFF00]" />
          </div>
          <div>
            <h2 class="text-xl font-black uppercase text-white tracking-tight font-sans">AsreSEO</h2>
            <p class="text-[10px] font-mono text-[#CCFF00] uppercase tracking-widest">[AUTONOMOUS_SEARCH_SYSTEMS]</p>
          </div>
        </div>

        <p class="text-slate-400 leading-relaxed text-xs sm:text-sm font-sans">
          Autonomous search infrastructure, deterministic knowledge graphs, and LLM citation dominance engineered for enterprise scale.
        </p>

        <div class="pt-2 font-mono text-xs flex flex-col gap-2">
          <a
            href="https://wa.me/13463272878"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 text-slate-300 hover:text-black hover:bg-[#25D366] hover:border-black transition-all bg-black border border-white/20 px-3.5 py-2 uppercase font-bold"
          >
            <Icon name="whatsapp" class="h-3.5 w-3.5 text-[#25D366] group-hover:text-black" />
            <span>WhatsApp: +1 (346) 327-2878 ↗</span>
          </a>
          <a
            href="tel:+13463272878"
            class="inline-flex items-center gap-2.5 text-slate-300 hover:text-black hover:bg-[#CCFF00] hover:border-black transition-all bg-black border border-white/20 px-3.5 py-2 uppercase font-bold"
          >
            <Icon name="phone-call" class="h-3.5 w-3.5 text-[#CCFF00] group-hover:text-black" />
            <span>Call: +1 (346) 327-2878</span>
          </a>
          <a
            href="mailto:info@asreseo.com"
            class="inline-flex items-center gap-2.5 text-slate-300 hover:text-black hover:bg-[#CCFF00] hover:border-black transition-all bg-black border border-white/20 px-3.5 py-2 uppercase font-bold"
          >
            <Icon name="mail" class="h-3.5 w-3.5 text-[#CCFF00] group-hover:text-black" />
            <span>info@asreseo.com</span>
          </a>
        </div>
      </div>

      <!-- Services / Tactical Protocols -->
      <div class="font-mono text-xs">
        <div class="text-[#CCFF00] font-black uppercase tracking-wider mb-4 pb-2 border-b border-white/10">
          [Tactical Protocols]
        </div>
        <ul class="space-y-2">
          {footerLinks.services.map((link) => (
            <li>
              <a
                href={link.href}
                class={`block transition-colors uppercase py-1 ${
                  link.href === '/services/'
                    ? 'text-[#CCFF00] font-bold hover:underline'
                    : 'text-slate-400 hover:text-white'
                }`}
              >
                {link.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Company / Systems Division -->
      <div class="font-mono text-xs">
        <div class="text-[#CCFF00] font-black uppercase tracking-wider mb-4 pb-2 border-b border-white/10">
          [Systems Division]
        </div>
        <ul class="space-y-2">
          {footerLinks.company.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.href.startsWith('http') ? '_blank' : undefined}
                rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                class="block text-slate-400 hover:text-white transition-colors uppercase py-1"
              >
                {link.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Support & Automation Telemetry -->
      <div class="font-mono text-xs">
        <div class="text-[#CCFF00] font-black uppercase tracking-wider mb-4 pb-2 border-b border-white/10">
          [Telemetry & Automation]
        </div>
        <ul class="space-y-2">
          {footerLinks.support.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.href.startsWith('http') ? '_blank' : undefined}
                rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                class={`block transition-colors uppercase py-1 ${
                  link.href.includes('n8n')
                    ? 'text-slate-300 hover:text-[#CCFF00] font-bold'
                    : 'text-slate-400 hover:text-white'
                }`}
              >
                {link.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom Footer -->
    <div class="border-t-2 border-white/15 py-6 font-mono text-xs">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4 text-slate-500">
        <p class="uppercase">
          © {currentYear} AsreSEO. All rights reserved.
        </p>
        <div class="flex items-center gap-x-4 sm:gap-x-6 uppercase flex-wrap justify-center">
          <a href="/privacy/" class="hover:text-[#CCFF00] transition-colors">
            Privacy
          </a>
          <span>/</span>
          <a href="/terms/" class="hover:text-[#CCFF00] transition-colors">
            Terms
          </a>
          <span>/</span>
          <a href="/sitemap/" class="hover:text-[#CCFF00] transition-colors">
            Sitemap
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
