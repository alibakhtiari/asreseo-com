---
import Icon from '../../ui/Icon.astro';
import type { MenuItem as MenuItemType } from './types';

interface Props {
  item: MenuItemType;
  lang?: string;
}

const { item, lang = 'en' } = Astro.props as Props;
void lang;
---
<li>
  <a
    href={item.href || '#'}
    class="group flex items-center justify-between p-1.5 rounded-none hover:bg-white/5 transition-colors font-mono text-[11px]"
    data-mm-close
  >
    <div class="flex-1 min-w-0 pr-1">
      <div class="flex items-center gap-1.5">
        <span class="text-slate-300 group-hover:text-[#CCFF00] transition-colors truncate">
          {item.title}
        </span>
        {item.isPopular && (
          <span class="bg-black border border-[#CCFF00] text-[#CCFF00] text-[9px] px-1 py-0.2 font-black uppercase shrink-0">
            FLAGSHIP
          </span>
        )}
        {item.isNew && !item.isPopular && (
          <span class="bg-black border border-emerald-500/50 text-emerald-400 text-[9px] px-1 py-0.2 font-bold uppercase shrink-0">
            NEW
          </span>
        )}
      </div>
    </div>
    <Icon name="arrow-right" class="h-3 w-3 text-[#CCFF00] opacity-0 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all shrink-0" />
  </a>
</li>
