---
import type { MenuCategory as MenuCategoryType } from './types';
import MenuItem from './MenuItem.astro'
import Icon from '../../ui/Icon.astro';
const { category }: any = Astro.props;


interface MenuCategoryProps {
  category: MenuCategoryType;
  onClose: () => void;
}



  
---
<div class="space-y-3">
      <!-- Category Header -->
      <div class="flex items-center space-x-2 space-x-reverse mb-3">
        <span class="w-8 h-8 rounded-lg bg-primary/10 flex items-center justify-center shrink-0"><Icon name={category.icon} class="h-4 w-4 text-primary" /></span>
        <h4 class={`font-semibold text-sm ${category.color}`}>
          {category.title}
        </h4>
      </div>

      <!-- Category Items -->
      <ul class="space-y-2">
        {category.items.map((item: any, itemIndex: number) => (
          <MenuItem item={item} />
        ))}
      </ul>
    </div>
