const totalServices = serviceCategories.reduce((acc, c) => acc + (c.services?.length || 0), 0);
---

<section class="py-24 bg-[#000000] text-white border-b-2 border-white/10 wireframe-grid relative" aria-label="Master Services Directory" data-services-section>
  <div class="w-full max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 relative z-10">
    <!-- Header Block -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6 pb-8 border-b-2 border-white/15">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-[#0a0d14] border border-white/20 mb-4 font-mono text-xs text-[#CCFF00] tracking-wider uppercase">
          <span class="w-2 h-2 rounded-full bg-[#CCFF00] animate-pulse"></span>
          <span>[DIRECTORY // 20_ACTIVE_PROTOCOLS]</span>
        </div>
        <h2 class="text-3xl sm:text-5xl lg:text-6xl font-black uppercase tracking-tight text-white font-sans">
          Master Tactical <span class="text-[#CCFF00]">Directory</span>
        </h2>
      </div>
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
        <p class="text-slate-400 max-w-md text-sm sm:text-base font-sans">
          Explore all {totalServices} autonomous protocols across 5 core engineering sectors.
        </p>
        <Button
          href={localize('/services/')}
          variant="acid"
          size="sm"
          class="shrink-0 px-5 py-3 font-mono text-xs uppercase"
        >
          Master Services Hub ↗
        </Button>
      </div>
    </div>

    <!-- Category Filter Tabs -->
    <div class="flex items-center gap-2 flex-wrap mb-16 font-mono text-xs" role="tablist" aria-label="Service categories">
      <button
        type="button"
        data-tab="all"
        class="shrink-0 rounded-none border-2 px-4 py-2.5 font-bold uppercase transition-colors bg-[#CCFF00] text-black border-black shadow-[2px_2px_0px_#FFFFFF] cursor-pointer"
        role="tab"
        aria-selected="true"
      >
        ALL_PROTOCOLS ({totalServices})
      </button>
      {serviceCategories.map((c, idx) => (
        <button
          type="button"
          data-tab={String(idx)}
          class="shrink-0 rounded-none border-2 border-white/20 px-4 py-2.5 font-bold uppercase transition-colors text-slate-300 hover:border-[#CCFF00] hover:text-[#CCFF00] bg-black cursor-pointer"
          role="tab"
          aria-selected="false"
        >
          {c.title.toUpperCase()} ({c.services?.length || 0})
        </button>
      ))}
    </div>

    <!-- Services Categories Container -->
    <div class="space-y-16" data-services-container>
      {serviceCategories.map((category, categoryIndex) => (
        <div data-cat-idx={String(categoryIndex)}>
          <!-- Category Header -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8 pb-4 border-b border-white/15">
            <div class="flex items-center gap-3">
              <span class="font-mono text-xs text-[#CCFF00] font-bold bg-[#0a0e17] px-2.5 py-1 border border-white/20">
                {category.code}
              </span>
              <h3 class="text-xl sm:text-2xl font-black uppercase text-white font-sans tracking-tight">
                {category.title}
              </h3>
            </div>
            <a
              href={localize(category.href)}
              class="font-mono text-xs font-bold text-[#CCFF00] uppercase hover:underline flex items-center gap-1.5"
            >
              Inspect Sector Suite ↗
            </a>
          </div>

          <!-- Services Grid -->
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {category.services?.map((service: any, sIdx: number) => (
              <div class="bg-[#0a0e17] border-2 border-white/15 p-6 sm:p-7 flex flex-col justify-between brutalist-card group hover:border-[#CCFF00] transition-all">
                <div>
                  <div class="flex items-center justify-between pb-3 mb-4 border-b border-white/10 font-mono text-xs">
                    <span class="text-slate-500 font-bold uppercase tracking-wider">
                      PROTOCOL_0{sIdx + 1}
                    </span>
                    {service.isPopular ? (
                      <span class="px-2 py-0.5 bg-black border border-[#CCFF00] text-[#CCFF00] font-bold uppercase text-[10px]">
                        FLAGSHIP
                      </span>
                    ) : service.isNew ? (
                      <span class="px-2 py-0.5 bg-black border border-emerald-500/50 text-emerald-400 font-bold uppercase text-[10px]">
                        UPDATED
                      </span>
                    ) : null}
                  </div>

                  <a href={localize(service.href)}>
                    <h4 class="text-lg sm:text-xl font-black uppercase text-white group-hover:text-[#CCFF00] transition-colors mb-3 leading-snug">
                      {service.title}
                    </h4>
                  </a>

                  <p class="text-xs sm:text-sm text-slate-300 mb-6 leading-relaxed font-sans">
                    {service.description}
                  </p>
                </div>

                <div class="pt-4 border-t border-white/10 font-mono text-xs">
                  <a
                    href={localize(service.href)}
                    class="w-full py-3 px-4 font-bold uppercase text-center block bg-black border border-white/20 text-white hover:bg-[#CCFF00] hover:text-black hover:border-black transition-all"
                  >
                    Inspect Protocol ↗
                  </a>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Architecture Commission Box -->
    <div class="mt-20 p-8 sm:p-12 bg-[#090d16] border-2 border-[#CCFF00] brutalist-shadow-white flex flex-col lg:flex-row items-center justify-between gap-8">
      <div class="space-y-3 text-center lg:text-left max-w-2xl">
        <div class="font-mono text-xs text-[#CCFF00] uppercase font-bold tracking-widest">
          [CUSTOM_INGESTION // ARCHITECT_CONSULTATION]
        </div>
        <h3 class="text-2xl sm:text-3xl font-black uppercase text-white tracking-tight leading-tight">
          Require a Bespoke Multi-Territory Search Engine Pipeline?
        </h3>
        <p class="text-slate-300 text-sm sm:text-base leading-relaxed font-sans">
          Our principal systems architects will review your indexing footprint and design an empirical roadmap tailored to your technical requirements.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row gap-4 shrink-0 font-mono text-xs w-full lg:w-auto">
        <Button
          href={localize('/consultation/')}
          variant="acid"
          size="lg"
          class="px-8 py-4 justify-center"
        >
          Initialize Technical Audit ↗
        </Button>
        <Button
          href={localize('/services/')}
          variant="brutalist"
          size="lg"
          class="px-8 py-4 justify-center"
        >
          Master Services Hub
        </Button>
      </div>
    </div>
  </div>
</section>

<script>
  const section = document.querySelector('[data-services-section]');
  const tabBtns = section?.querySelectorAll<HTMLButtonElement>('[data-tab]');
  const categories = section?.querySelectorAll<HTMLElement>('[data-cat-idx]');

  const ACTIVE = ['bg-[#CCFF00]', 'text-black', 'border-black', 'shadow-[2px_2px_0px_#FFFFFF]'];
  const IDLE = ['border-white/20', 'text-slate-300', 'bg-black'];

  tabBtns?.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.getAttribute('data-tab');
      tabBtns.forEach((b) => {
        b.classList.remove(...ACTIVE);
        b.classList.add(...IDLE);
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.remove(...IDLE);
      btn.classList.add(...ACTIVE);
      btn.setAttribute('aria-selected', 'true');

      categories?.forEach((cat) => {
        const idx = cat.getAttribute('data-cat-idx');
        if (target === 'all' || target === idx) {
          cat.style.display = '';
        } else {
          cat.style.display = 'none';
        }
      });
    });
  });
</script>
