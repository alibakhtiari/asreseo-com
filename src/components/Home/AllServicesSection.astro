---
import Button from '../ui/button/Button.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props as Props;
void lang;
const localize = (p?: string) => p;

const serviceCategories = [
  {
    title: 'SEO Infrastructure',
    code: 'SECTOR_01',
    href: '/services/seo/',
    icon: 'search',
    services: [
      {
        title: 'Technical & On-Page SEO',
        description: 'Edge rendering, IndexNow pipelines, Core Web Vitals optimization, and crawl error mitigation for page-one SERP dominance.',
        href: '/services/seo/technical-onpage/',
        icon: 'zap',
        isPopular: true,
        isNew: true,
      },
      {
        title: 'Content & Authority Architecture',
        description: 'Deterministic entity trees, knowledge graph syndication, and high-tier Wikidata citation loops.',
        href: '/services/seo/content-authority/',
        icon: 'file-text',
        isNew: true,
      },
      {
        title: 'Local SEO Topology',
        description: 'Multi-node geo-targeted schemas and localized map-pack prominence with automated coordinate calibration.',
        href: '/services/seo/local-seo/',
        icon: 'globe',
        isNew: true,
      },
    ],
  },
  {
    title: 'Web Engineering & Performance',
    code: 'SECTOR_02',
    href: '/services/web/',
    icon: 'palette',
    services: [
      {
        title: 'SEO-Driven Web Architecture',
        description: 'Blazing headless websites and semantic Astro/Next.js frontend systems built for instantaneous indexation.',
        href: '/services/web/seo-web-design/',
        icon: 'globe',
      },
      {
        title: 'Sub-20ms Speed Optimization',
        description: 'Edge-caching strategies, asset minification, and zero-layout-shift Core Web Vitals tuning (100/100 PageSpeed).',
        href: '/services/web/website-speed/',
        icon: 'zap',
      },
      {
        title: 'High-Converting Landing Nodes',
        description: 'Programmatic landing pages engineered for aggressive CTR, message match, and immediate conversion capture.',
        href: '/services/web/landing-pages/',
        icon: 'target',
      },
      {
        title: 'UX & Information Topology',
        description: 'Cognitive user flows, clear call-to-action matrices, and frictionless buyer progression tracking.',
        href: '/services/web/ux-architecture/',
        icon: 'users',
      },
    ],
  },
  {
    title: 'Digital Marketing & Acquisition',
    code: 'SECTOR_03',
    href: '/services/marketing/',
    icon: 'trending-up',
    services: [
      {
        title: 'Programmatic Google Ads & PPC',
        description: 'Algorithmic bid adjustments, negative keyword automation, and high-ROAS search query targeting.',
        href: '/services/marketing/google-ads/',
        icon: 'target',
      },
      {
        title: 'Automated Retention Email Funnels',
        description: 'Behavior-triggered drip pipelines, lifecycle segmentations, and high-deliverability edge webhooks.',
        href: '/services/marketing/email-marketing/',
        icon: 'mail',
      },
      {
        title: 'Cross-Channel Distribution',
        description: 'Targeted authority campaigns designed to expand brand reach across commercial networks.',
        href: '/services/marketing/social-media/',
        icon: 'share2',
      },
      {
        title: 'Sales Funnel Engineering',
        description: 'Mathematical lead conversion pipelines from initial anonymous impression to high-ticket signed agreement.',
        href: '/services/marketing/sales-funnel-management/',
        icon: 'trending-up',
      },
      {
        title: '360° Integrated Campaigns',
        description: 'Full-spectrum cross-channel execution aligning paid search, programmatic content, and organic entity boost.',
        href: '/services/marketing/integrated-campaigns/',
        icon: 'bar-chart3',
      },
    ],
  },
  {
    title: 'Content & Entity Systems',
    code: 'SECTOR_04',
    href: '/services/content/',
    icon: 'file-text',
    services: [
      {
        title: 'Technical Copywriting & Research',
        description: 'In-depth, mathematically structured editorial dossiers designed for both human executives and LLM scrapers.',
        href: '/services/content/text-content/',
        icon: 'file-text',
      },
      {
        title: 'Multi-Channel Social Feeds',
        description: 'High-signal educational social assets capturing industry attention and driving inbound backlink references.',
        href: '/services/content/social-media-content/',
        icon: 'share2',
      },
      {
        title: 'Visual Assets & Infographics',
        description: 'High-density architectural diagrams and infographics crafted to earn passive editorial citations.',
        href: '/services/content/visual-content/',
        icon: 'eye',
      },
      {
        title: 'Programmatic Content Calendars',
        description: 'Deterministic content release cadence engineered to maximize topical authority breadth without cannibalization.',
        href: '/services/content/content-calendar/',
        icon: 'bar-chart3',
      },
      {
        title: 'Multilingual Syntactic Translation',
        description: 'High-precision semantic translation mapping native search intent across 28 global enterprise territories.',
        href: '/services/content/translation/',
        icon: 'globe',
      },
    ],
  },
  {
    title: 'Neural AI & GEO Suite',
    code: 'SECTOR_05',
    href: '/services/ai/',
    icon: 'bot',
    services: [
      {
