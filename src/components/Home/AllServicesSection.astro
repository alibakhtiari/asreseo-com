        title: 'AI Agents & Telemetry Pipelines',
        description: 'Autonomous synthetic agents monitoring negative citations and automating competitive query interception.',
        href: '/services/ai/marketing-engagement/',
        icon: 'bot',
        isNew: true,
      },
      {
