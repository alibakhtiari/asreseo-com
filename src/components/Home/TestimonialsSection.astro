---
import Card from '../ui/card/Card.astro';
import CardContent from '../ui/card/CardContent.astro';
import Icon from '../ui/Icon.astro';
import { TESTIMONIALS, HEADLINE_STATS, faNum } from '../../lib/site-claims';

// Quotes and headline numbers now come from src/lib/site-claims.ts so every
// claim the site makes about itself lives in one auditable place.
//
// P0.4: unverified numbers must never render as visible copy. The strip below
// filters HEADLINE_STATS on `verified` exactly like the star gating, and hides
// the whole <dl> when nothing survives. Grid columns follow the surviving
// count so the one verified stat today (۲۴/۷ پشتیبانی) stays centred instead
// of sitting alone in an empty 4-column row.
const visibleStats = HEADLINE_STATS.filter((stat) => stat.verified);

const STATS_GRID_CLASS: Record<number, string> = {
  1: 'grid-cols-1 max-w-xs mx-auto',
  2: 'grid-cols-2',
  3: 'grid-cols-2 md:grid-cols-3',
};
const statsGridClass =
  STATS_GRID_CLASS[visibleStats.length] ?? 'grid-cols-2 md:grid-cols-4';
//
// NOTE: no Review / AggregateRating JSON-LD is emitted here on purpose — see the
// long comment at the top of src/lib/site-claims.ts. Rating markup requires
// genuine, verifiable reviews; adding it to unverified testimonials would be a
// structured-data violation.
---
<section class="section-padding bg-linear-to-br from-blue-50 to-purple-50 relative overflow-hidden">
      <!-- Background decoration -->
      <div class="absolute inset-0 opacity-20">
        <div class="absolute top-1/4 right-1/4 w-96 h-96 bg-linear-to-r from-blue-300 to-purple-300 rounded-full mix-blend-multiply filter blur-3xl animate-float"></div>
        <div class="absolute bottom-1/4 left-1/4 w-96 h-96 bg-linear-to-r from-purple-300 to-pink-300 rounded-full mix-blend-multiply filter blur-3xl animate-float" style="animation-delay:4s"></div>
      </div>

      <div class="w-full max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 relative z-10">
        <!-- Section Header -->
        <div class="text-center mb-16 animate-fade-in">
          <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-6">
            نظر <span class="gradient-text">مشتریان</span> ما
          </h2>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto leading-relaxed">
            رضایت مشتریان، بزرگترین افتخار ماست. ببینید آنها چه می‌گویند
          </p>
        </div>

        <!-- Testimonials Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {TESTIMONIALS.map((testimonial, index) => (
            <Card
              class="floating-card hover-lift p-6 animate-slide-in-up relative overflow-hidden"
              style={{ animationDelay: `${index * 0.1}s` }}
            >
              <!-- Quote Icon -->
              <div class="absolute top-4 right-4 opacity-20">
                <Icon name="quote" class="h-8 w-8 text-gray-400" />
              </div>

              <CardContent class="p-0">
                <!-- Rating. Only rendered when verified to avoid misleading placeholder star ratings.
                     Unverified client quotes render elegantly as quote cards without fake star badges. -->
                {testimonial.verified && testimonial.rating && (
                  <div class="flex items-center gap-1 mb-4" role="img" aria-label={`امتیاز ${faNum(testimonial.rating)} از ۵`}>
                    {[...Array(testimonial.rating)].map((_, i) => (
                      <Icon name="star" class="h-5 w-5 fill-amber-600 text-amber-600" aria-hidden="true" />
                    ))}
                  </div>
                )}

                <!-- Testimonial Text -->
                <blockquote class="text-gray-700 leading-relaxed mb-6 text-right">
                  <p>"{testimonial.text}"</p>
                </blockquote>

                <!-- Author Info -->
                <footer class="flex items-center gap-4">
                  <div class="text-3xl" aria-hidden="true">{testimonial.avatar}</div>
                  <div class="text-right">
                    <cite class="font-bold text-gray-900 not-italic">{testimonial.name}</cite>
                    <p class="text-sm text-gray-600">{testimonial.company}</p>
                  </div>
                </footer>
              </CardContent>
            </Card>
          ))}
        </div>

        <!-- Statistics -->
        <!-- Semantically a description list: label (dt) + value (dd).
             flex-col-reverse keeps the big number on top while preserving
             correct dt-then-dd source order.
             Rendered only when at least one stat is verified, and the grid
             re-flows to the number of survivors so the strip never renders
             orphaned or empty cells. -->
        {visibleStats.length > 0 && (
          <dl class={`mt-16 grid gap-8 ${statsGridClass}`}>
            {visibleStats.map((stat, i) => (
              <div class="text-center animate-zoom-in flex flex-col-reverse" style={`animation-delay:${(i + 1) * 0.2}s`}>
                <dt class="text-gray-600 text-sm">{stat.label}</dt>
                <dd class="text-4xl md:text-5xl font-bold gradient-text mb-2">{stat.value}</dd>
              </div>
            ))}
          </dl>
        )}
      </div>
    </section>
