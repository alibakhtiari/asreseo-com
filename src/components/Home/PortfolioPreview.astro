---
import Card from '../ui/card/Card.astro';
import CardContent from '../ui/card/CardContent.astro';
import Badge from '../ui/badge/Badge.astro';
import Button from '../ui/button/Button.astro';
import Icon from '../ui/Icon.astro';
import Picture from '../ui/Picture.astro';

// Real delivered work — mirrors `cases` on /portfolio/ (single source of truth
// would be better; keep these in sync if a case is added or retitled).
const cases = [
  {
    slug: 'case-law-rag',
    title: 'چت‌بات حقوقی هوشمند با RAG',
    category: 'هوش مصنوعی',
    image: '/images/portfolio-law-rag.webp',
  },
  {
    slug: 'case-ai-callcenter',
    title: 'مرکز تماس هوشمند با تحلیل مکالمات',
    category: 'هوش مصنوعی',
    image: '/images/portfolio-ai-callcenter.webp',
  },
  {
    slug: 'case-seo-monitoring',
    title: 'پایش خودکار سئو با هشدار لحظه‌ای',
    category: 'سئو',
    image: '/images/portfolio-seo-monitoring.webp',
  },
  {
    slug: 'case-content-pipeline',
    title: 'خط لوله اتوماسیون تولید و انتشار محتوا',
    category: 'محتوا',
    image: '/images/portfolio-content-pipeline.webp',
  },
  {
    slug: 'case-ads-reporting',
    title: 'گزارش‌دهی خودکار تبلیغات با تحلیل هوشمند',
    category: 'تبلیغات',
    image: '/images/portfolio-ads-reporting.webp',
  },
];
---

<section class="py-16 lg:py-24 bg-white">
  <div class="w-full max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-6">
        نمونه‌کارهای <span class="gradient-text">واقعی</span> ما
      </h2>
      <p class="text-xl text-gray-800 max-w-3xl mx-auto leading-relaxed">
        پروژه‌های اجراشده با خروجی قابل اندازه‌گیری، نه وعده‌های کلی
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {cases.map((c) => (
        <Card class="group overflow-hidden border-0 shadow-lg hover:shadow-2xl transition-shadow duration-300">
          <a href={`/portfolio/#${c.slug}`} class="block">
            <Picture
              src={c.image}
              alt={c.title}
              aspectRatio="16 / 9"
              sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
              class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-500"
            />
          </a>
          <CardContent class="p-6">
            <Badge class="mb-3 bg-primary/10 text-blue-700">{c.category}</Badge>
            <h3 class="text-lg font-bold text-gray-900 mb-4 leading-snug">
              <a href={`/portfolio/#${c.slug}`} class="hover:text-primary transition-colors">
                {c.title}
              </a>
            </h3>
            <a
              href={`/portfolio/#${c.slug}`}
              class="inline-flex items-center gap-1 text-sm font-medium text-primary hover:gap-2 transition-all"
            >
              مشاهده جزئیات پروژه
              <Icon name="arrow-left" class="h-4 w-4" />
            </a>
          </CardContent>
        </Card>
      ))}
    </div>

    <div class="text-center mt-12">
      <Button href="/portfolio/" size="lg" class="group">
        مشاهده همه نمونه‌کارها
        <Icon name="arrow-left" class="mr-2 h-5 w-5 group-hover:-translate-x-1 transition-transform" />
      </Button>
    </div>
  </div>
</section>
