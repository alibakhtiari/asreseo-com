---
import { cva } from "class-variance-authority"
import { cn } from '../../../lib/utils'
const buttonVariants = cva(
  "inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-none text-sm font-bold ring-offset-background transition-colors focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:size-4 [&_svg]:shrink-0",
  {
    variants: {
      variant: {
        default: "btn-acid-yellow bg-[#CCFF00] text-black hover:bg-[#b8e600] font-black uppercase tracking-wider rounded-none brutalist-shadow-white border-2 border-black",
        destructive:
          "bg-destructive text-destructive-foreground hover:bg-destructive/90 rounded-none border-2 border-red-500",
        outline:
          "btn-brutalist-outline bg-black text-white hover:bg-white/10 font-bold uppercase tracking-wider rounded-none border-2 border-white/20",
        secondary:
          "btn-brutalist-outline bg-black text-white hover:bg-white/10 font-bold uppercase tracking-wider rounded-none border-2 border-white/20",
        ghost: "hover:bg-accent hover:text-accent-foreground rounded-none",
        link: "text-[#CCFF00] underline-offset-4 hover:underline",
        acid: "btn-acid-yellow bg-[#CCFF00] text-black hover:bg-[#b8e600] font-black uppercase tracking-wider rounded-none brutalist-shadow-white border-2 border-black",
        brutalist: "btn-brutalist-outline bg-black text-white hover:bg-white/10 font-bold uppercase tracking-wider rounded-none border-2 border-white/20",
      },
      size: {
        default: "h-11 px-6 py-3",
        sm: "h-9 px-4 py-2",
        lg: "h-13 px-8 py-4",
        icon: "h-10 w-10",
      },
    },
    defaultVariants: {
      variant: "default",
      size: "default",
    },
  }
)
// Renders an <a> when `href` is supplied — real link semantics (right-click,
// middle-click, crawler-followable) instead of invalid <a><button></a> nesting.
// `type` defaults to "button" so a stray button can never submit a form by
// accident; form submit buttons must pass type="submit" explicitly.
// `as="span"` renders the same visuals with no interactive element at all —
// use it when the whole surrounding card is already the link, so you don't
// ship invalid <a><button></a> nesting (WCAG 4.1.2).
const { class: className, variant, size, href, type, as, ...rest }: any = Astro.props;
const cls = cn(buttonVariants({ variant, size, className }));
---
{href ? (
  <a href={href} class={cls} {...rest}><slot /></a>
) : as === 'span' ? (
  <span class={cls} {...rest}><slot /></span>
) : (
  <button type={type ?? 'button'} class={cls} {...rest}><slot /></button>
)}
