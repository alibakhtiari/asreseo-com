---
import { cva } from "class-variance-authority"
import { cn } from '../../../lib/utils'
const badgeVariants = cva(
  "inline-flex items-center rounded-none font-mono text-[11px] font-bold uppercase tracking-wider border px-2.5 py-1 transition-colors focus:outline-hidden focus:ring-2 focus:ring-ring focus:ring-offset-2",
  {
    variants: {
      variant: {
        default:
          "border-white/20 bg-black text-[#CCFF00] hover:border-[#CCFF00]",
        secondary:
          "border-white/20 bg-[#0a0e17] text-slate-300 hover:text-white",
        destructive:
          "border-red-500/50 bg-red-950/40 text-red-400",
        outline: "border-white/20 text-slate-300 bg-transparent",
      },
    },
    defaultVariants: {
      variant: "default",
    },
  }
)
const { class: className, variant, ...rest }: any = Astro.props;
---
<div class={cn(badgeVariants({ variant }), className)} {...rest} ><slot /></div>
