---
import Icon from '../ui/Icon.astro';
import Picture from '../ui/Picture.astro';
import Input from '../ui/input/Input.astro';
---
<section class="section-padding bg-gray-900 relative overflow-hidden">
      <div class="absolute inset-0 z-0">
        <Picture
          src="/images/blog-hero.webp"
          alt="وبلاگ عصر سئو"
         
         
          class="object-cover opacity-30 blur-xs"
          eager
        />
        <div class="absolute inset-0 bg-linear-to-b from-gray-900/40 via-gray-900/80 to-background-50" />
      </div>

      <div class="container-custom relative z-10 pt-16 md:pt-20">
        <div class="text-center max-w-4xl mx-auto animate-fade-in">
          <h1 class="text-4xl md:text-6xl font-bold text-white mb-6 drop-shadow-lg">
            وبلاگ <span class="bg-linear-to-r from-primary-400 to-secondary-400 bg-clip-text text-transparent animate-pulse">عصر سئو</span>
          </h1>
          <p class="text-xl text-gray-200 mb-8 leading-relaxed drop-shadow-md">
            آخرین مقالات و راهنماهای دیجیتال مارکتینگ، سئو و بازاریابی آنلاین
          </p>

          <div class="max-w-2xl mx-auto">
            <div class="relative">
              <Input
                type="text"
                placeholder="جستجو در مقالات..."
                class="pl-12 pr-4 py-4 text-lg rounded-xl border-2 border-white/20 bg-white/10 backdrop-blur-md text-white placeholder:text-gray-400 focus:border-primary-400 focus:bg-white/20 transition-all duration-300"
              />
              <Icon name="search" class="absolute left-4 top-1/2 transform -translate-y-1/2 h-5 w-5 text-gray-400" />
            </div>
          </div>
        </div>
      </div>
    </section>
