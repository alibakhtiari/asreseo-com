---
import Card from '../ui/card/Card.astro';
import CardContent from '../ui/card/CardContent.astro';
import CardHeader from '../ui/card/CardHeader.astro';
import Badge from '../ui/badge/Badge.astro';
import Button from '../ui/button/Button.astro';
import Icon from '../ui/Icon.astro';
import Picture from '../ui/Picture.astro';
const { posts }: any = Astro.props;
---
<div class="space-y-8">
      <div class="flex items-center justify-between">
        <h2 class="text-2xl font-bold text-gray-900">آخرین مقالات</h2>
        <div class="flex gap-2">
          <Badge variant="outline">همه</Badge>
          <Badge variant="outline">سئو</Badge>
          <Badge variant="outline">گوگل ادز</Badge>
          <Badge variant="outline">دیجیتال مارکتینگ</Badge>
        </div>
      </div>

      <div class="grid gap-8">
        {posts.map((post: any, index: number) => (
          <Card class={`overflow-hidden hover:shadow-xl transition-all duration-300 animate-fade-in ${post.featured ? 'border-2 border-primary/20' : ''}`}>
            <div class="md:flex">
              <div class="md:w-1/3">
                <Picture 
                  src={post.image} 
                  alt={post.title}
                  class="w-full h-48 md:h-full object-cover"
                />
              </div>
              <div class="md:w-2/3">
                <CardHeader class="pb-4">
                  <div class="flex items-center gap-4 mb-3">
                    <Badge class="bg-primary/10 text-primary">
                      {post.category}
                    </Badge>
                    {post.featured && (
                      <Badge class="bg-green-100 text-green-700">
                        ویژه
                      </Badge>
                    )}
                  </div>
                  <a href={`/blog/${post.slug}/`}>
                    <h3 class="text-xl font-bold text-gray-900 mb-3 hover:text-primary transition-colors">
                      {post.title}
                    </h3>
                  </a>
                  <p class="text-gray-600 leading-relaxed">
                    {post.excerpt}
                  </p>
                </CardHeader>
                <CardContent class="pt-0">
                  <div class="flex items-center justify-between">
                    <div class="flex items-center gap-4 text-sm text-gray-500">
                      <div class="flex items-center gap-1">
                        <Icon name="user" class="h-4 w-4" />
                        {post.author}
                      </div>
                      <div class="flex items-center gap-1">
                        <Icon name="clock" class="h-4 w-4" />
                        {post.readTime}
                      </div>
                      <span>{new Date(post.date).toLocaleDateString('fa-IR')}</span>
                    </div>
                    <a href={`/blog/${post.slug}/`}>
                      <Button variant="ghost" class="text-primary hover:text-primary/80">
                        ادامه مطلب
                        <Icon name="arrow-left" class="h-4 w-4 mr-2" />
                      </Button>
                    </a>
                  </div>
                </CardContent>
              </div>
            </div>
          </Card>
        ))}
      </div>
    </div>
