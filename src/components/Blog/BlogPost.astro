---
import Card from '../ui/card/Card.astro';
import CardContent from '../ui/card/CardContent.astro';
import CardHeader from '../ui/card/CardHeader.astro';
import Accordion from '../ui/Accordion.astro';
import AccordionContent from '../ui/AccordionContent.astro';
import AccordionItem from '../ui/AccordionItem.astro';
import AccordionTrigger from '../ui/AccordionTrigger.astro';
import Badge from '../ui/badge/Badge.astro';
import Button from '../ui/button/Button.astro';
import Icon from '../ui/Icon.astro';
import Picture from '../ui/Picture.astro';

const { post, Content }: any = Astro.props;

const jsonLdFAQ = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": post.faqs?.map((faq: any) => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.answer
      }
    })) || []
  };

  const jsonLdArticle = {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": post.title,
    "description": post.excerpt,
    "author": {
      "@type": "Person",
      "name": post.author
    },
    "datePublished": post.date,
    "dateModified": post.updated || post.date,
    "publisher": {
      "@type": "Organization",
      "name": "عصر سئو",
      "logo": {
        "@type": "ImageObject",
        "url": "https://asreseo.com/Logo-spaced.png"
      }
    },
    "image": post.image,
    "keywords": post.tags?.join(", ") ?? ""
  };
---
<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLdArticle)} />
{post.faqs && post.faqs.length > 0 && (
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLdFAQ)} />
)}
<article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Header -->
        <header class="mb-8">
          <div class="flex items-center gap-4 mb-6">
            <Badge class="bg-primary/10 text-primary">
              {post.category}
            </Badge>
            {post.featured && (
              <Badge class="bg-green-100 text-green-700">
                ویژه
              </Badge>
            )}
          </div>
          
          <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4 leading-tight">
            {post.title}
          </h1>
          
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-6 text-sm text-gray-500 gap-4">
            <div class="flex flex-wrap items-center gap-4">
              <div class="flex items-center gap-1">
                <Icon name="user" class="h-4 w-4" />
                {post.author}
              </div>
              <div class="flex items-center gap-1">
                <Icon name="clock" class="h-4 w-4" />
                {post.readTime}
              </div>
              <span>{new Date(post.date).toLocaleDateString('fa-IR')}</span>{post.updated && (
                <span>به‌روزرسانی: {new Date(post.updated).toLocaleDateString('fa-IR')}</span>
              )}
            </div>
            
            <div class="flex gap-2">
              <Button 
                variant="outline" 
                size="sm"
                data-share-btn
              >
                <Icon name="share2" class="h-4 w-4 ml-2" />
                اشتراک‌گذاری
              </Button>
            </div>
          </div>
          
          <Picture 
            src={post.image} 
            alt={post.title}
            class="w-full h-64 md:h-96 object-cover rounded-lg mb-8"
          />
        </header>

        <!-- Table of Contents Accordion -->
        {post.tableOfContents && post.tableOfContents.length > 0 && (
          <div class="mb-8">
            <Accordion type="single" collapsible class="w-full">
              <AccordionItem value="toc">
                <AccordionTrigger class="text-lg font-semibold">
                  <div class="flex items-center gap-2">
                    <Icon name="list" class="h-5 w-5" />
                    فهرست مطالب
                  </div>
                </AccordionTrigger>
                <AccordionContent>
                  <div class="grid md:grid-cols-2 gap-2 pt-4">
                    {post.tableOfContents.map((item: any, index: number) => (
                      <a
                       
                        href={`#${item.id}`}
                        class={`block text-sm hover:text-primary transition-colors p-2 rounded hover:bg-primary/5 ${
                          item.level === 2 ? 'font-medium' : 'mr-4 text-gray-600'
                        }`}
                      >
                        <div class="flex items-center gap-2">
                          <Icon name="chevron-right" class="h-3 w-3" />
                          {item.title}
                        </div>
                      </a>
                    ))}
                  </div>
                </AccordionContent>
              </AccordionItem>
            </Accordion>
          </div>
        )}

        <!-- Key Takeaways -->
        {post.keyTakeaways && post.keyTakeaways.length > 0 && (
          <Card class="speakable-summary mb-8 bg-linear-to-br from-primary/5 to-primary/10 border-primary/20">
            <CardHeader>
              <h3 class="font-bold text-xl text-primary flex items-center gap-2">
                <div class="w-6 h-6 bg-primary rounded-full flex items-center justify-center">
                  <span class="text-white text-sm">!</span>
                </div>
                نکات کلیدی
              </h3>
            </CardHeader>
            <CardContent>
              <div class="grid md:grid-cols-2 gap-4">
                {post.keyTakeaways.map((takeaway: any, index: number) => (
                  <div class="flex items-start gap-3 p-3 bg-white/50 rounded-lg">
                    <div class="w-3 h-3 bg-primary rounded-full mt-1 shrink-0" />
                    <p class="text-sm leading-relaxed font-medium">{takeaway}</p>
                  </div>
                ))}
              </div>
            </CardContent>
          </Card>
        )}

        <div class="grid grid-cols-1 gap-8">

          <!-- Article Content -->
          <div class="prose prose-lg max-w-none mb-12 prose-headings:text-gray-900 prose-h2:text-2xl prose-h3:text-xl prose-p:text-gray-700 prose-p:leading-relaxed prose-strong:text-gray-900 prose-ul:text-gray-700 prose-ol:text-gray-700 blog-body">
              <Content />
          </div>

          <!-- FAQs -->
          {post.faqs && post.faqs.length > 0 && (
            <section class="mb-12">
              <h2 class="text-2xl font-bold mb-6">سوالات متداول</h2>
              <div class="space-y-4">
                {post.faqs.map((faq: any, index: number) => (
                  <Card>
                    <CardHeader>
                      <h3 class="font-semibold text-lg">{faq.question}</h3>
                    </CardHeader>
                    <CardContent>
                      <p class="leading-relaxed text-gray-700">{faq.answer}</p>
                    </CardContent>
                  </Card>
                ))}
              </div>
            </section>
          )}

          <!-- Tags -->
          <div class="flex flex-wrap gap-2 mb-8">
            {post.tags.map((tag: any, index: number) => (
              <Badge variant="outline">
                {tag}
              </Badge>
            ))}
          </div>

          <!-- CTA -->
          <Card class="bg-linear-to-br from-primary/5 to-primary/10 border-primary/20">
            <CardContent class="text-center py-8">
              <h3 class="text-xl font-bold mb-4">نیاز به مشاوره تخصصی دارید؟</h3>
              <p class="text-gray-600 mb-6">
                تیم متخصص عصر سئو آماده ارائه مشاوره رایگان و راهنمایی شما است
              </p>
              <div class="flex gap-4 justify-center">
                <Button>
                  مشاوره رایگان
                </Button>
                <Button variant="outline">
                  مشاهده خدمات
                </Button>
              </div>
            </CardContent>
          </Card>
        </div>
      </article>

<script>
  document.querySelectorAll('[data-share-btn]').forEach((b) =>
    b.addEventListener('click', async () => {
      const url = window.location.href;
      const title = document.title;
      if (navigator.share) {
        try {
          await navigator.share({ title, url });
        } catch {}
      } else if (navigator.clipboard) {
        try {
          await navigator.clipboard.writeText(url);
        } catch {}
      }
    }),
  );
</script>
