---
import Icon from '../ui/Icon.astro';

export interface Props {
  title?: string;
  titleHighlight?: string;
  subtitle?: string;
  benefits: string[];
  icon?: string;
  iconColorClass?: string;
  iconBgClass?: string;
}

const {
  title = 'مزایای خدمات',
  titleHighlight,
  subtitle,
  benefits = [],
  icon = 'award',
  iconColorClass = 'text-indigo-600',
  iconBgClass = 'bg-indigo-100',
} = Astro.props;

let beforeHighlight = title;
let afterHighlight = '';
let hasHighlight = false;

if (titleHighlight && title.includes(titleHighlight)) {
  const parts = title.split(titleHighlight);
  beforeHighlight = parts[0];
  afterHighlight = parts.slice(1).join(titleHighlight);
  hasHighlight = true;
}
---

<section class="section-padding">
  <div class="container-custom">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold text-gray-900 mb-6">
        {hasHighlight ? (
          <>
            {beforeHighlight}<span class="gradient-text">{titleHighlight}</span>{afterHighlight}
          </>
        ) : (
          title
        )}
      </h2>
      {subtitle && (
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          {subtitle}
        </p>
      )}
    </div>

    <div class="grid md:grid-cols-2 gap-6 max-w-4xl mx-auto">
      {benefits.map((benefit) => (
        <div class="flex items-start gap-4 p-6 bg-white rounded-xl border border-gray-200 hover:shadow-md transition-shadow">
          <div class={`w-8 h-8 ${iconBgClass} rounded-lg flex items-center justify-center shrink-0`}>
            <Icon name={icon} class={`h-5 w-5 ${iconColorClass}`} />
          </div>
          <span class="text-gray-900 font-medium leading-relaxed text-right">
            {benefit}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
