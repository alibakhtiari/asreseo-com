---
import Button from '../ui/button/Button.astro';
import Card from '../ui/card/Card.astro';
import CardContent from '../ui/card/CardContent.astro';
import Icon from '../ui/Icon.astro';
---
<section class="section-padding bg-linear-to-br from-blue-600 to-green-600">
      <div class="container-custom">
        <Card class="bg-white/10 backdrop-blur-md border-white/20 text-white">
          <CardContent class="text-center p-12">
            <h2 class="text-3xl md:text-4xl font-bold mb-6 animate-fade-in">
              آماده شروع همکاری هستید؟
            </h2>
            <p class="text-xl mb-8 text-white/90 max-w-2xl mx-auto animate-fade-in">
              همین الان با ما تماس بگیرید و مشاوره رایگان دریافت کنید.
              تیم متخصص ما آماده پاسخگویی به سوالات شماست.
            </p>

            <div class="grid md:grid-cols-3 gap-6 mb-8">
              <div class="flex flex-col items-center p-6 bg-white/10 rounded-xl backdrop-blur-xs">
                <Icon name="phone" class="h-8 w-8 mb-3" />
                <h3 class="font-semibold mb-2">تماس تلفنی</h3>
                <p class="text-white/80">۰۲۱-۱۲۳۴۵۶۷۸</p>
              </div>

              <div class="flex flex-col items-center p-6 bg-white/10 rounded-xl backdrop-blur-xs">
                <Icon name="mail" class="h-8 w-8 mb-3" />
                <h3 class="font-semibold mb-2">ایمیل</h3>
                <p class="text-white/80">info@asreseo.com</p>
              </div>

              <div class="flex flex-col items-center p-6 bg-white/10 rounded-xl backdrop-blur-xs">
                <Icon name="message-circle" class="h-8 w-8 mb-3" />
                <h3 class="font-semibold mb-2">پشتیبانی آنلاین</h3>
                <p class="text-white/80">۲۴ ساعته</p>
              </div>
            </div>

            <div class="flex flex-col sm:flex-row gap-4 justify-center animate-fade-in">
              <Button href="/consultation/" size="lg" class="bg-white text-blue-600 hover:bg-white/90 px-8">
                مشاوره رایگان
              </Button>
              <Button href="/portfolio/" size="lg" variant="outline" class="border-white text-white hover:bg-white/10 px-8">
                مشاهده نمونه کارها
              </Button>
            </div>
          </CardContent>
        </Card>
      </div>
    </section>
