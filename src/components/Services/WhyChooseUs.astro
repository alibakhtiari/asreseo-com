---
import Icon from '../ui/Icon.astro';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props as Props;
void lang;

const features = [
  {
    icon: "award",
    title: 'Expert, Experienced Team',
    description: 'Our specialists bring years of digital marketing experience to your service',
    color: 'from-accent-400 to-accent-600',
  },
  {
    icon: "trending-up",
    title: 'Measurable Results',
    description: 'Everything we do is data-driven, delivering results you can measure',
    color: 'from-secondary-400 to-secondary-600',
  },
  {
    icon: "shield",
    title: 'Safe & Proven Methods',
    description: 'All our techniques follow Google guidelines and are completely safe',
    color: 'from-primary-400 to-primary-600',
  },
  {
    icon: "clock",
    title: '24/7 Support',
    description: 'Our support team is always available to deliver the best possible service',
    color: 'from-secondary-300 to-primary-500',
  },
  {
    icon: "users",
    title: 'Client-Centric Approach',
    description: 'Your goals are our priority and everything is focused on your success',
    color: 'from-accent-500 to-primary-500',
  },
  {
    icon: "headphones-icon",
    title: 'Free Consultation',
    description: 'We offer a complete consultation before starting any project',
    color: 'from-primary-400 to-secondary-500',
  },
];
---
<section class="section-padding bg-slate-900 text-white">
  <div class="container-custom">
    <div class="text-center mb-16 animate-fade-in">
      <h2 class="text-3xl md:text-4xl font-bold mb-6">
        Why Choose <span class="gradient-text">AsreSEO</span>?
      </h2>
      <p class="text-xl text-slate-300 max-w-3xl mx-auto">
        Key benefits of working with our specialized digital marketing team
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {features.map((feature) => (
        <div class="bg-slate-800/50 backdrop-blur-xs p-8 rounded-2xl border border-slate-700 hover:border-slate-600 transition-all duration-300 hover:-translate-y-1">
          <div class={`w-14 h-14 rounded-xl bg-linear-to-r ${feature.color} flex items-center justify-center mb-6`}>
            <Icon name={feature.icon} class="h-7 w-7 text-white" />
          </div>
          <h3 class="text-xl font-bold mb-3">{feature.title}</h3>
          <p class="text-slate-300 leading-relaxed">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
