---
import Header from '../Layout/Header.astro';
import Footer from '../Layout/Footer.astro';
import Button from '../ui/button/Button.astro';
import Icon from '../ui/Icon.astro';
const { description, canonicalUrl, heroTitle, heroDescription, children }: any = Astro.props;

  const normalizedCanonical = canonicalUrl ? (canonicalUrl.endsWith('/') ? canonicalUrl : `${canonicalUrl}/`) : 'https://asreseo.com/services/';

  // Enhanced structured data for better SEO
  const structuredData = {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": heroTitle,
    "description": description,
    "provider": {
      "@type": "Organization",
      "name": "عصر سئو",
      "url": "https://asreseo.com",
      "logo": "https://asreseo.com/Logo-spaced.png",
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+989125811880",
        "contactType": "customer service"
      }
    },
    "areaServed": {
      "@type": "Country",
      "name": "Iran"
    },
    "availableLanguage": "Persian",
    "offers": {
      "@type": "Offer",
      "availability": "https://schema.org/InStock",
      "price": "0",
      "priceCurrency": "IRR",
      "description": "مشاوره رایگان"
    }
  };

  const breadcrumbStructuredData = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "خانه",
        "item": "https://asreseo.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "خدمات",
        "item": "https://asreseo.com/services/"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": heroTitle,
        "item": normalizedCanonical
      }
    ]
  };
---
<div class="min-h-screen bg-white">
        <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
        <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbStructuredData)} />
        <Header />
        <main>
          <!-- Minimal Hero Section -->
              <nav class="m-4 pt-2" aria-label="مسیر">
                <ol class="flex items-center space-x-2 space-x-reverse text-sm text-slate-600">
                  <li>
                    <a href="/" class="hover:text-slate-900 transition-colors">
                      خانه
                    </a>
                  </li>
                  <li class="text-slate-400">/</li>
                  <li>
                    <a href="/services/" class="hover:text-slate-900 transition-colors">
                      خدمات
                    </a>
                  </li>
                  <li class="text-slate-400">/</li>
                  <li class="text-slate-900 font-medium">{heroTitle}</li>
                </ol>
              </nav>
          <section class="flex justify-center relative bg-linear-to-br from-slate-50 to-blue-50/30 border-b border-slate-100">
            <div class="container-custom py-8 md:py-12">
              <!-- Breadcrumb -->

              <div class="max-w-4xl">
                <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-slate-900 mb-6 leading-tight">
                  {heroTitle}
                </h1>
                <p class="text-xl md:text-2xl text-slate-600 mb-12 leading-relaxed max-w-3xl">
                  {heroDescription}
                </p>

                <!-- CTA Buttons -->
                <div class="flex flex-col sm:flex-row gap-4 mb-16 justify-center">
                  <Button size="lg" class="bg-blue-600 hover:bg-blue-700 text-white px-8 shadow-xs">
                    <Icon name="phone" class="ml-2 h-5 w-5" />
                    مشاوره رایگان
                  </Button>
                  <Button size="lg" variant="outline" class="border-slate-300 text-slate-700 hover:bg-slate-50 px-8">
                    <Icon name="mail" class="ml-2 h-5 w-5" />
                    درخواست قیمت
                  </Button>
                </div>

                <!-- Trust Indicators - Minimal -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-center sm:text-right bg-slate-100 rounded-3xl p-4">
                  <div class="flex items-center justify-center text-slate-600">
                    <div class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center">
                      <Icon name="star" class="h-5 w-5 text-blue-600" />
                    </div>
                    <span class="font-medium">+۵۰۰ پروژه موفق</span>
                  </div>
                  <div class="flex items-center justify-center text-slate-600">
                    <div class="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center">
                      <Icon name="check-circle" class="h-5 w-5 text-green-600" />
                    </div>
                    <span class="font-medium">ضمانت کیفیت</span>
                  </div>
                  <div class="flex items-center justify-center text-slate-600">
                    <div class="w-10 h-10 bg-purple-100 rounded-full flex items-center justify-center">
                      <Icon name="clock" class="h-5 w-5 text-purple-600" />
                    </div>
                    <span class="font-medium">پشتیبانی ۲۴/۷</span>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <!-- Content Section -->
          {children ? (
            <div class="bg-white">
              <slot />
            </div>
          ) : (
            <section class="py-20 bg-white">
              <div class="container-custom">
                <div class="text-center max-w-3xl mx-auto">
                  <div class="w-20 h-20 bg-linear-to-br from-blue-500 to-purple-600 rounded-2xl flex items-center justify-center mx-auto mb-8">
                    <span class="text-2xl">🚀</span>
                  </div>
                  <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-6">
                    محتوای این صفحه در حال تکمیل است
                  </h2>
                  <p class="text-lg text-slate-600 mb-8 leading-relaxed">
                    به زودی محتوای کاملی از این خدمات در اختیار شما قرار خواهد گرفت.
                    برای اطلاعات بیشتر و مشاوره رایگان با ما تماس بگیرید.
                  </p>
                  <div class="flex flex-col sm:flex-row gap-4 justify-center">
                    <a href="/contact/">
                      <Button class="bg-blue-600 hover:bg-blue-700 text-white px-8">
                        تماس با ما
                        <Icon name="arrow-left" class="ml-2 h-5 w-5" />
                      </Button>
                    </a>
                    <a href="/services/">
                      <Button variant="outline" class="border-slate-300 text-slate-700 hover:bg-slate-50 px-8">
                        مشاهده سایر خدمات
                      </Button>
                    </a>
                  </div>
                </div>
              </div>
            </section>
          )}

          <!-- Minimal CTA Section -->
          <section class="py-16 bg-slate-900 text-white">
            <div class="container-custom">
              <div class="text-center max-w-3xl mx-auto">
                <h2 class="text-3xl md:text-4xl font-bold mb-4">
                  آماده شروع هستید؟
                </h2>
                <p class="text-xl text-slate-300 mb-8">
                  همین الان با تیم متخصص عصر سئو تماس بگیرید
                </p>
                <div class="flex flex-col sm:flex-row gap-4 justify-center">
                  <a href="tel:+989125811880">
                    <Button size="lg" class="bg-white text-slate-900 hover:bg-slate-100 px-8">
                      <Icon name="phone" class="ml-2 h-5 w-5" />
                      ۰۹۱۲۵۸۱۱۸۸۰
                    </Button>
                  </a>
                  <a href="mailto:info@asreseo.com">
                    <Button size="lg" variant="outline" class="border-slate-600 text-white hover:bg-slate-800 px-8">
                      <Icon name="mail" class="ml-2 h-5 w-5" />
                      info@asreseo.com
                    </Button>
                  </a>
                </div>
              </div>
            </div>
          </section>
        </main>
        <Footer />
      </div>
