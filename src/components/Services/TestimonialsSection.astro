---
import { TESTIMONIALS } from '../../lib/site-claims';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props as Props;
void lang;

const testimonials = TESTIMONIALS.slice(0, 3);
---
<section class="section-padding">
  <div class="container-custom">
    <div class="text-center mb-16 animate-fade-in">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
        What Our <span class="gradient-text">Clients</span> Say
      </h2>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        Experiences of happy clients working with AsreSEO
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      {testimonials.map((testimonial) => (
        <div class="bg-white p-8 rounded-xl shadow-xs border hover:shadow-md transition-shadow animate-fade-in">
          <div class="flex items-center gap-4 mb-6">
            <div class="text-4xl" aria-hidden="true">
              {testimonial.avatar}
            </div>
            <div>
              <h3 class="font-bold text-gray-900">{testimonial.name}</h3>
              <p class="text-sm text-gray-600">{testimonial.company}</p>
            </div>
          </div>

          <blockquote class="text-gray-700 leading-relaxed italic">
            "{testimonial.text}"
          </blockquote>

          {testimonial.verified && testimonial.rating && (
            <div class="flex text-amber-600 mt-4" role="img" aria-label={`Rated ${testimonial.rating} out of 5`}>
              {[...Array(testimonial.rating)].map(() => (
                <span aria-hidden="true">⭐</span>
              ))}
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
