---

export interface WorkflowStep {
  step: string | number;
  title: string;
  desc: string;
}

export interface Props {
  lang?: string;
  title?: string;
  titleHighlight?: string;
  subtitle?: string;
  steps: WorkflowStep[];
  themeColor?: 'pink' | 'indigo' | 'blue' | 'green' | 'purple' | 'cyan' | 'amber';
  bgGradient?: string;
}

const {
  lang = 'en',
  title: rawTitle,
  titleHighlight,
  subtitle,
  steps = [],
} = Astro.props;

void lang;
const title = rawTitle ?? 'Autonomous Deployment Workflow';

let beforeHighlight = title;
let afterHighlight = '';
let hasHighlight = false;

if (titleHighlight && title.includes(titleHighlight)) {
  const parts = title.split(titleHighlight);
  beforeHighlight = parts[0];
  afterHighlight = parts.slice(1).join(titleHighlight);
  hasHighlight = true;
}
---

<section class="py-20 bg-[#000000] border-t-2 border-white/10 wireframe-grid relative">
  <div class="w-full max-w-5xl mx-auto px-6 sm:px-8">
    <div class="mb-14 text-left">
      <div class="font-mono text-xs text-[#CCFF00] uppercase tracking-widest mb-2">[PIPELINE_EXECUTION // PHASED_ROLLOUT]</div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-black uppercase text-white tracking-tight leading-tight">
        {hasHighlight ? (
          <>
            {beforeHighlight}<span class="text-[#CCFF00]">{titleHighlight}</span>{afterHighlight}
          </>
        ) : (
          title
        )}
      </h2>
      {subtitle && (
        <p class="text-sm sm:text-base text-slate-400 font-mono mt-3 max-w-3xl">
          // {subtitle}
        </p>
      )}
    </div>

    <div class="space-y-6">
      {steps.map((step, idx) => (
        <div class="flex flex-col sm:flex-row items-start gap-6 p-6 sm:p-8 bg-[#0a0e17] border-2 border-white/15 brutalist-card hover:border-[#CCFF00] transition-colors">
          <div class="w-14 h-14 bg-black border-2 border-[#CCFF00] text-[#CCFF00] font-mono text-xl font-black flex items-center justify-center shrink-0">
            {String(step.step || idx + 1).padStart(2, '0')}
          </div>
          <div class="flex-1 text-left">
            <h3 class="text-xl sm:text-2xl font-black text-white uppercase mb-2 tracking-tight">
              {step.title}
            </h3>
            <p class="text-slate-300 leading-relaxed text-sm sm:text-base">
              {step.desc}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
