---
import Card from '../ui/card/Card.astro';
import CardContent from '../ui/card/CardContent.astro';
import Icon from '../ui/Icon.astro';

export interface StatItem {
  metric: string;
  label: string;
  icon?: string;
  color?: string;
}

export interface Props {
  stats: StatItem[];
  gradientClass?: string;
  metricColorClass?: string;
  iconColorClass?: string;
}

const {
  stats = [],
  gradientClass = 'bg-linear-to-r from-slate-50 to-indigo-50/40',
  metricColorClass = 'text-indigo-700',
  iconColorClass = 'text-indigo-600',
} = Astro.props;
---

<section class={`section-padding ${gradientClass}`}>
  <div class="container-custom">
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
      {stats.map((stat) => (
        <Card class="text-center border-0 bg-white/80 backdrop-blur-sm">
          <CardContent class="p-6">
            {stat.icon && (
              <Icon name={stat.icon} class={`h-8 w-8 ${iconColorClass} mx-auto mb-3`} />
            )}
            <div class={`text-3xl font-bold ${stat.color || metricColorClass} mb-2`}>
              {stat.metric}
            </div>
            <p class="text-gray-900 font-medium">
              {stat.label}
            </p>
          </CardContent>
        </Card>
      ))}
    </div>
  </div>
</section>
