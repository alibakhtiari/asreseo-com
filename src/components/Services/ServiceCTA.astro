---
import Button from '../ui/button/Button.astro';

export interface Props {
  title: string;
  description: string;
  primaryText?: string;
  primaryHref?: string;
  primaryClass?: string;
  primaryCta?: { text?: string; href?: string; class?: string };
  secondaryText?: string;
  secondaryHref?: string;
  secondaryClass?: string;
  secondaryCta?: { text?: string; href?: string; class?: string };
  bgClass?: string;
  theme?: string;
}

// Dark CTA sections ship on `from-slate-900 to-slate-800` (≈ #0F172A → #1E293B).
//
// TWO contrast requirements apply here and they pull in opposite directions:
//   1. the white LABEL on the button fill  (WCAG 1.4.3, needs ≥4.5:1)
//   2. the button fill against the section (WCAG 1.4.11, needs ≥3:1) or the
//      control loses its edge on a dark surface.
//
// The previous map used `-500` fills and justified them with "≥4.8:1 on the
// same dark surface" — but that measured the button *against the section*, not
// the label *against the button*. Nine of the ten were failing requirement 1:
// white on green-500 is only 2.28:1, on amber-500 2.15:1, on purple-500 4.12:1.
//
// Each entry below is the first shade in its ramp that satisfies BOTH. Hover
// steps one shade darker rather than lighter: every lighter step drops the
// label back under 4.5:1 (e.g. purple-600 → purple-500 is 4.12:1), whereas
// darkening only ever improves it.
const THEME_BUTTONS: Record<string, string> = {
  // label / vs-section
  indigo: 'bg-indigo-500 hover:bg-indigo-600 text-white font-semibold shadow-lg shadow-indigo-500/30', // 4.58 / 3.90
  purple: 'bg-purple-600 hover:bg-purple-700 text-white font-semibold shadow-lg shadow-purple-600/30', // 5.53 / 3.22
  blue: 'bg-blue-600 hover:bg-blue-700 text-white font-semibold shadow-lg shadow-blue-600/30', // 5.26 / 3.40
  green: 'bg-green-700 hover:bg-green-800 text-white font-semibold shadow-lg shadow-green-700/30', // 4.94 / 3.61
  emerald: 'bg-emerald-700 hover:bg-emerald-800 text-white font-semibold shadow-lg shadow-emerald-700/30', // 5.37 / 3.32
  orange: 'bg-orange-700 hover:bg-orange-800 text-white font-semibold shadow-lg shadow-orange-700/30', // 5.23 / 3.41
  amber: 'bg-amber-700 hover:bg-amber-800 text-white font-semibold shadow-lg shadow-amber-700/30', // 5.05 / 3.53
  teal: 'bg-teal-700 hover:bg-teal-800 text-white font-semibold shadow-lg shadow-teal-700/30', // 5.39 / 3.31
  pink: 'bg-pink-600 hover:bg-pink-700 text-white font-semibold shadow-lg shadow-pink-600/30', // 4.54 / 3.93
  cyan: 'bg-cyan-700 hover:bg-cyan-800 text-white font-semibold shadow-lg shadow-cyan-700/30', // 5.28 / 3.38
  red: 'bg-red-600 hover:bg-red-700 text-white font-semibold shadow-lg shadow-red-600/30', // 4.76 / 3.75
};

const {
  title,
  description,
  primaryText,
  primaryHref,
  primaryClass,
  primaryCta,
  secondaryText,
  secondaryHref,
  secondaryClass,
  secondaryCta,
  bgClass = 'bg-linear-to-br from-slate-900 to-slate-800 text-white',
  theme = 'indigo',
} = Astro.props;

const defaultPrimaryClass = THEME_BUTTONS[theme] ?? THEME_BUTTONS.indigo;
const effPrimaryText = primaryCta?.text || primaryText || 'مشاوره رایگان';
const effPrimaryHref = primaryCta?.href || primaryHref || '/contact/';
const effPrimaryClass = primaryCta?.class || primaryClass || defaultPrimaryClass;

const effSecondaryText = secondaryCta?.text || secondaryText;
const effSecondaryHref = secondaryCta?.href || secondaryHref || '/services/';
const effSecondaryClass = secondaryCta?.class || secondaryClass || 'bg-transparent border-white text-white hover:bg-white hover:text-slate-900';
---

<section class={`section-padding ${bgClass}`}>
  <div class="container-custom text-center">
    <h2 class="text-3xl md:text-4xl font-bold mb-6">
      {title}
    </h2>
    <p class="text-xl mb-8 max-w-3xl mx-auto opacity-90 leading-relaxed">
      {description}
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <Button size="lg" class={effPrimaryClass} href={effPrimaryHref}>
          {effPrimaryText}
        </Button>
      {effSecondaryText && (
        <Button variant="outline" size="lg" class={effSecondaryClass} href={effSecondaryHref}>
            {effSecondaryText}
          </Button>
      )}
    </div>
  </div>
</section>
