---
import Button from '../ui/button/Button.astro';

export interface Props {
  title: string;
  description: string;
  primaryText?: string;
  primaryHref?: string;
  primaryClass?: string;
  secondaryText?: string;
  secondaryHref?: string;
  secondaryClass?: string;
  bgClass?: string;
}

const {
  title,
  description,
  primaryText = 'مشاوره رایگان',
  primaryHref = '/contact/',
  primaryClass = 'bg-indigo-600 hover:bg-indigo-700 text-white',
  secondaryText,
  secondaryHref = '/services/',
  secondaryClass = 'border-white text-white hover:bg-white hover:text-slate-900',
  bgClass = 'bg-linear-to-br from-slate-900 to-slate-800 text-white',
} = Astro.props;
---

<section class={`section-padding ${bgClass}`}>
  <div class="container-custom text-center">
    <h2 class="text-3xl md:text-4xl font-bold mb-6">
      {title}
    </h2>
    <p class="text-xl mb-8 max-w-3xl mx-auto opacity-90 leading-relaxed">
      {description}
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a href={primaryHref}>
        <Button size="lg" class={primaryClass}>
          {primaryText}
        </Button>
      </a>
      {secondaryText && (
        <a href={secondaryHref}>
          <Button variant="outline" size="lg" class={secondaryClass}>
            {secondaryText}
          </Button>
        </a>
      )}
    </div>
  </div>
</section>
