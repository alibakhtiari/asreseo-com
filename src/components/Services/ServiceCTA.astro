---
import Button from '../ui/button/Button.astro';

export interface Props {
  title: string;
  description: string;
  primaryText?: string;
  primaryHref?: string;
  primaryClass?: string;
  primaryCta?: { text?: string; href?: string; class?: string };
  secondaryText?: string;
  secondaryHref?: string;
  secondaryClass?: string;
  secondaryCta?: { text?: string; href?: string; class?: string };
  bgClass?: string;
  theme?: string;
}

const THEME_BUTTONS: Record<string, string> = {
  indigo: 'bg-indigo-600 hover:bg-indigo-700 text-white',
  purple: 'bg-purple-600 hover:bg-purple-700 text-white',
  blue: 'bg-blue-600 hover:bg-blue-700 text-white',
  green: 'bg-green-600 hover:bg-green-700 text-white',
  emerald: 'bg-emerald-600 hover:bg-emerald-700 text-white',
  orange: 'bg-orange-600 hover:bg-orange-700 text-white',
  amber: 'bg-amber-600 hover:bg-amber-700 text-white',
  teal: 'bg-teal-600 hover:bg-teal-700 text-white',
  pink: 'bg-pink-600 hover:bg-pink-700 text-white',
  cyan: 'bg-cyan-600 hover:bg-cyan-700 text-white',
};

const {
  title,
  description,
  primaryText,
  primaryHref,
  primaryClass,
  primaryCta,
  secondaryText,
  secondaryHref,
  secondaryClass,
  secondaryCta,
  bgClass = 'bg-linear-to-br from-slate-900 to-slate-800 text-white',
  theme = 'indigo',
} = Astro.props;

const defaultPrimaryClass = THEME_BUTTONS[theme] ?? THEME_BUTTONS.indigo;
const effPrimaryText = primaryCta?.text || primaryText || 'مشاوره رایگان';
const effPrimaryHref = primaryCta?.href || primaryHref || '/contact/';
const effPrimaryClass = primaryCta?.class || primaryClass || defaultPrimaryClass;

const effSecondaryText = secondaryCta?.text || secondaryText;
const effSecondaryHref = secondaryCta?.href || secondaryHref || '/services/';
const effSecondaryClass = secondaryCta?.class || secondaryClass || 'border-white text-white hover:bg-white hover:text-slate-900';
---

<section class={`section-padding ${bgClass}`}>
  <div class="container-custom text-center">
    <h2 class="text-3xl md:text-4xl font-bold mb-6">
      {title}
    </h2>
    <p class="text-xl mb-8 max-w-3xl mx-auto opacity-90 leading-relaxed">
      {description}
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <Button size="lg" class={effPrimaryClass} href={effPrimaryHref}>
          {effPrimaryText}
        </Button>
      {effSecondaryText && (
        <Button variant="outline" size="lg" class={effSecondaryClass} href={effSecondaryHref}>
            {effSecondaryText}
          </Button>
      )}
    </div>
  </div>
</section>
