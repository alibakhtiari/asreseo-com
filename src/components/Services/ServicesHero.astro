---
import Icon from '../ui/Icon.astro';
import Button from '../ui/button/Button.astro';
import Picture from '../ui/Picture.astro';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props as Props;
const localize = (p: string) => p;
---
<section class="section-padding bg-[#080c14] relative overflow-hidden border-b border-white/5">
      <!-- Background Blobs -->
      <div class="absolute top-0 right-0 w-1/3 h-full bg-cyan-500/10 blur-3xl -z-10 rounded-full mix-blend-screen opacity-50 animate-blob"></div>
      <div class="absolute bottom-0 left-0 w-1/3 h-full bg-blue-500/10 blur-3xl -z-10 rounded-full mix-blend-screen opacity-50 animate-blob animation-delay-2000"></div>

      <div class="container-custom relative z-10">
        <div class="grid lg:grid-cols-2 gap-12 items-center mb-16">
          <div class="text-left animate-fade-in order-2 lg:order-1">
            <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm border border-white/20 text-white px-4 py-2 rounded-full text-sm font-medium mb-6">
              <Icon name="sparkles" class="h-4 w-4 text-cyan-400" />
              360° digital marketing services
            </div>
            <h1 class="text-3xl md:text-5xl lg:text-6xl font-bold text-white mb-8 leading-tight drop-shadow-lg">
              Professional <span class="bg-linear-to-r from-cyan-400 to-blue-500 bg-clip-text text-transparent animate-pulse">SEO & AI</span> and digital marketing services by AsreSEO
            </h1>
            <p class="text-xl md:text-2xl text-slate-300 mb-8 leading-relaxed drop-shadow-md">
              With AsreSEO full-service digital marketing, take your business to the top. Our expert team, with years of experience, is ready to walk with you.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-start">
              <Button href={localize('/consultation/')} size="lg" class="gradient-bg border-0 text-white px-8 hover:shadow-lg hover:shadow-cyan-500/30 transition-all duration-300">
                Get a free consultation
              </Button>
              <Button href={localize('/portfolio/')} variant="outline" size="lg" class="border-white/20 bg-white/5 text-white hover:bg-white/10 backdrop-blur-sm">
                Portfolio
              </Button>
            </div>
          </div>

          <div class="relative h-100 md:h-125 w-full animate-fade-in order-1 lg:order-2 group">
            <div class="absolute inset-0 bg-linear-to-tr from-primary-500/10 to-transparent z-0 rounded-3xl" />
            <Picture
              src="/images/services-hero.webp"
              alt="AsreSEO services"
              class="object-contain drop-shadow-2xl group-hover:scale-105 transition-transform duration-700"
              eager
            />
          </div>
        </div>

        <!-- Enhanced Stats Cards -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8">
          <div class="group text-center p-6 md:p-8 bg-white/5 backdrop-blur-md rounded-2xl border border-white/10 hover:border-primary-400/50 hover:bg-white/10 hover:-translate-y-1.25 transition-all duration-500">
            <div class="w-14 h-14 md:w-16 md:h-16 bg-linear-to-br from-primary-500 to-primary-600 rounded-2xl flex items-center justify-center mx-auto mb-6 group-hover:rotate-12 group-hover:animate-glow transition-transform duration-500 shadow-lg shadow-primary-500/30">
              <Icon name="users" class="h-7 w-7 md:h-8 md:w-8 text-white" />
            </div>
            <div class="text-3xl md:text-5xl font-bold bg-linear-to-r from-primary-400 to-primary-200 bg-clip-text text-transparent mb-3">Many</div>
            <div class="text-sm md:text-base text-gray-300 font-medium">Happy clients</div>
          </div>

          <div class="group text-center p-6 md:p-8 bg-white/5 backdrop-blur-md rounded-2xl border border-white/10 hover:border-secondary-400/50 hover:bg-white/10 hover:-translate-y-1.25 transition-all duration-500" style="animation-delay:0.2s">
            <div class="w-14 h-14 md:w-16 md:h-16 bg-linear-to-br from-secondary-500 to-secondary-600 rounded-2xl flex items-center justify-center mx-auto mb-6 group-hover:rotate-12 group-hover:animate-glow transition-transform duration-500 shadow-lg shadow-secondary-500/30">
              <Icon name="trending-up" class="h-7 w-7 md:h-8 md:w-8 text-white" />
            </div>
            <div class="text-3xl md:text-5xl font-bold bg-linear-to-r from-secondary-400 to-secondary-200 bg-clip-text text-transparent mb-3">Significant</div>
            <div class="text-sm md:text-base text-gray-300 font-medium">Traffic growth</div>
          </div>

          <div class="group text-center p-6 md:p-8 bg-white/5 backdrop-blur-md rounded-2xl border border-white/10 hover:border-accent-400/50 hover:bg-white/10 hover:-translate-y-1.25 transition-all duration-500" style="animation-delay:0.4s">
            <div class="w-14 h-14 md:w-16 md:h-16 bg-linear-to-br from-accent-500 to-accent-600 rounded-2xl flex items-center justify-center mx-auto mb-6 group-hover:rotate-12 group-hover:animate-glow transition-transform duration-500 shadow-lg shadow-accent-500/30">
              <Icon name="target" class="h-7 w-7 md:h-8 md:w-8 text-white" />
            </div>
            <div class="text-3xl md:text-5xl font-bold bg-linear-to-r from-accent-400 to-accent-200 bg-clip-text text-transparent mb-3">High</div>
            <div class="text-sm md:text-base text-gray-300 font-medium">Success rate</div>
          </div>

          <div class="group text-center p-6 md:p-8 bg-white/5 backdrop-blur-md rounded-2xl border border-white/10 hover:border-primary-400/50 hover:bg-white/10 hover:-translate-y-1.25 transition-all duration-500" style="animation-delay:0.6s">
            <div class="w-14 h-14 md:w-16 md:h-16 bg-linear-to-br from-primary-400 to-secondary-500 rounded-2xl flex items-center justify-center mx-auto mb-6 group-hover:rotate-12 group-hover:animate-glow transition-transform duration-500 shadow-lg shadow-primary-500/30">
              <Icon name="search" class="h-7 w-7 md:h-8 md:w-8 text-white" />
            </div>
            <div class="text-3xl md:text-5xl font-bold bg-linear-to-r from-primary-400 to-secondary-300 bg-clip-text text-transparent mb-3">Numerous</div>
            <div class="text-sm md:text-base text-gray-300 font-medium">Top-ranked keywords</div>
          </div>
        </div>
      </div>
    </section>
