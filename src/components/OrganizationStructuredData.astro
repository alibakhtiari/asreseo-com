---
import { withServiceMeta } from '../lib/service-schema';
// Canonical entity for the whole site. This is the ONLY full declaration of
// `#organization`; every other page links to it with a lightweight
// `{"@type":"Organization","@id":"…/#organization"}` reference instead of
// re-declaring the entity with its own copy of these properties.
const data = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['Organization', 'ProfessionalService'],
      '@id': 'https://asreseo.com/#organization',
      name: 'عصر سئو',
      alternateName: 'AsreSEO',
      url: 'https://asreseo.com/',
      logo: {
        '@type': 'ImageObject',
        url: 'https://asreseo.com/Logo-spaced.png',
        // Measured from the actual asset (public/Logo-spaced.png is 512×512).
        width: 512,
        height: 512,
      },
      // E.164 — matches every tel: href and the llms.txt phone line.
      telephone: '+989125811880',
      // The about-page timeline starts at ۱۳۹۸ (Farvardin 1398 = March 2019).
      foundingDate: '2019',
      description:
        'ارائه‌دهنده خدمات حرفه‌ای سئو، تبلیغات گوگل، دیجیتال مارکتینگ و طراحی وب‌سایت در ایران',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'خیابان شریعتی',
        addressLocality: 'تهران',
        addressRegion: 'تهران',
        addressCountry: 'IR',
      },
      contactPoint: [
        {
          '@type': 'ContactPoint',
          telephone: '+989125811880',
          contactType: 'customer service',
          areaServed: { '@type': 'Country', name: 'Iran' },
          availableLanguage: ['Persian', 'English'],
        },
        {
          '@type': 'ContactPoint',
          telephone: '+989125811880',
          contactType: 'customer support',
          areaServed: { '@type': 'Country', name: 'Iran' },
        },
        {
          '@type': 'ContactPoint',
          telephone: '+989125811880',
          contactType: 'emergency',
          areaServed: { '@type': 'Country', name: 'Iran' },
          hoursAvailable: {
            '@type': 'OpeningHoursSpecification',
            dayOfWeek: [
              'Monday',
              'Tuesday',
              'Wednesday',
              'Thursday',
              'Friday',
              'Saturday',
              'Sunday',
            ],
            opens: '00:00',
            closes: '23:59',
          },
        },
      ],
      // Mirrors the visible "ساعات کاری" card on /contact/:
      // شنبه تا چهارشنبه ۹:۰۰–۱۸:۰۰، پنج‌شنبه ۹:۰۰–۱۴:۰۰ (جمعه فقط مانیتورینگ).
      openingHoursSpecification: [
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Saturday', 'Sunday', 'Monday', 'Tuesday', 'Wednesday'],
          opens: '09:00',
          closes: '18:00',
        },
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Thursday'],
          opens: '09:00',
          closes: '14:00',
        },
      ],
      founder: {
        '@type': 'Person',
        name: 'علی بختیاری',
        jobTitle: 'مدیر ارشد استراتژی و بنیان‌گذار',
      },
      sameAs: [
        'https://instagram.com/asreseo',
        'https://t.me/asreseo',
        'https://linkedin.com/company/asreseo',
      ],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'خدمات دیجیتال مارکتینگ عصر سئو',
        itemListElement: [
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: 'خدمات سئو',
              description: 'بهینه‌سازی وب‌سایت برای موتورهای جستجو',
            },
          },
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: 'تبلیغات گوگل ادز',
              description: 'مدیریت کمپین‌های تبلیغاتی در گوگل',
            },
          },
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: 'طراحی وب‌سایت',
              description: 'طراحی وب‌سایت‌های سئو محور و واکنش‌گرا',
            },
          },
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: 'خدمات هوش مصنوعی',
              description: 'پیاده‌سازی راهکارهای هوش مصنوعی برای بازاریابی',
            },
          },
        ],
      },
    },
    {
      '@type': 'WebSite',
      '@id': 'https://asreseo.com/#website',
      url: 'https://asreseo.com/',
      name: 'عصر سئو',
      publisher: {
        '@id': 'https://asreseo.com/#organization',
      },
    },
  ],
};
---
<script type="application/ld+json" is:inline set:html={JSON.stringify(withServiceMeta(data, { url: 'https://asreseo.com/', image: '/og-default.png', idNamespace: 'organization-service' }))}></script>
