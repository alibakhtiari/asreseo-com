---
export interface BreadcrumbItem {
  position?: number;
  name: string;
  item?: string;
  url?: string;
}

export interface Props {
  items?: BreadcrumbItem[];
}

const { items = [] } = Astro.props;

const defaultList: BreadcrumbItem[] = [
  {
    position: 1,
    name: 'خانه',
    item: 'https://asreseo.com/',
  },
];

const elements = items.length > 0 ? items : defaultList;

const data = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: elements.map((item, idx) => ({
    '@type': 'ListItem',
    position: item.position ?? idx + 1,
    name: item.name,
    item: item.item || (item.url?.startsWith('http') ? item.url : `https://asreseo.com${item.url || ''}`),
  })),
};
---
<script id="breadcrumb-data" type="application/ld+json" is:inline set:html={JSON.stringify(data)}></script>
