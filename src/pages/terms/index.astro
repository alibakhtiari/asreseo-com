---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Layout/Header.astro';
import Footer from '../../components/Layout/Footer.astro';
import BreadcrumbStructuredData from '../../components/BreadcrumbStructuredData.astro';

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'شرایط استفاده از خدمات عصر سئو',
  url: 'https://asreseo.com/terms/',
  inLanguage: 'fa-IR',
};
const breadcrumbs = [
  { position: 1, name: 'خانه', item: 'https://asreseo.com/' },
  { position: 2, name: 'شرایط استفاده', item: 'https://asreseo.com/terms/' },
];
---
<BaseLayout title='قوانین و مقررات | عصر سئو' description='قوانین و مقررات استفاده از خدمات عصر سئو؛ شرایط همکاری، تعهدات طرفین و ضوابط ارائه خدمات سئو و بازاریابی.' canonical='https://asreseo.com/terms/' ogType='website' twitterCard='summary_large_image'>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(pageSchema)} />
  <BreadcrumbStructuredData items={breadcrumbs} />
<div class="min-h-screen bg-white">
            <Header />
            <main class="section-padding pt-32">
                <div class="container-custom max-w-4xl">
                    <h1 class="text-4xl font-bold mb-8 text-right">قوانین و مقررات</h1>
                    <div class="prose prose-lg max-w-none text-right" dir="rtl">
                        <p>استفاده از خدمات عصر سئو به منزله پذیرش کامل قوانین و مقررات زیر می‌باشد.</p>

                        <h2 class="text-2xl font-bold mt-8 mb-4">۱. تعهدات ما</h2>
                        <p>عصر سئو متعهد است که خدمات خود را با بالاترین کیفیت و مطابق با استانداردهای روز دنیای دیجیتال ارائه دهد.</p>

                        <h2 class="text-2xl font-bold mt-8 mb-4">۲. تعهدات کاربر</h2>
                        <p>کاربران موظف هستند اطلاعات صحیح را در فرم‌ها وارد کنند و از هرگونه استفاده غیرمجاز از محتوای وب‌سایت خودداری نمایند.</p>

                        <h2 class="text-2xl font-bold mt-8 mb-4">۳. مالکیت دانش</h2>
                        <p>تمامی محتوای تولید شده در وب‌سایت عصر سئو متعلق به این مجموعه بوده و هرگونه کپی‌برداری بدون ذکر منبع پیگرد قانونی دارد.</p>

                        <h2 class="text-2xl font-bold mt-8 mb-4">۴. تغییرات قوانین</h2>
                        <p>عصر سئو حق دارد در هر زمان قوانین خود را به‌روزرسانی کند. تغییرات از طریق همین صفحه به اطلاع کاربران خواهد رسید.</p>
                    </div>
                </div>
            </main>
            <Footer />
        </div>
</BaseLayout>
