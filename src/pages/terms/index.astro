---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Layout/Header.astro';
import Footer from '../../components/Layout/Footer.astro';
import BreadcrumbStructuredData from '../../components/BreadcrumbStructuredData.astro';

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'شرایط استفاده از خدمات عصر سئو',
  url: 'https://asreseo.com/terms/',
  inLanguage: 'fa-IR',
};
const breadcrumbs = [
  { position: 1, name: 'خانه', item: 'https://asreseo.com/' },
  { position: 2, name: 'شرایط استفاده', item: 'https://asreseo.com/terms/' },
];
---
<BaseLayout title='قوانین و مقررات و شرایط همکاری | عصر سئو' description='قوانین و مقررات عصر سئو؛ دامنه خدمات، نحوه شروع قرارداد، تعهدات طرفین، پرداخت و صورتحساب، محرمانگی، مالکیت فکری، فسخ و شرایط حل اختلاف در همکاری‌ها.' canonical='https://asreseo.com/terms/' ogType='website' twitterCard='summary_large_image'>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(pageSchema)} />
  <BreadcrumbStructuredData items={breadcrumbs} />
<div class="min-h-screen bg-white">
            <Header />
            <main class="section-padding pt-32">
                <div class="container-custom max-w-4xl">
                    <h1 class="text-4xl font-bold mb-8 text-right">قوانین و مقررات</h1>
                    <div class="prose prose-lg max-w-none text-right" dir="rtl">
                        <p>استفاده از وب‌سایت و خدمات عصر سئو به منزله پذیرش کامل قوانین و مقررات زیر است. این شرایط چارچوب همکاری میان عصر سئو و کارفرما را مشخص می‌کند و در کنار پیشنهاد فنی و قرارداد منعقدشده، سند مرجع روابط طرفین خواهد بود.</p>

                        <h2 class="text-2xl font-bold mt-8 mb-4">۱. دامنه خدمات و نحوه شروع همکاری</h2>
                        <p>خدمات عصر سئو شامل سئو و بهینه‌سازی وب‌سایت، دیجیتال مارکتینگ، تبلیغات گوگل، تولید محتوا، هوش مصنوعی و طراحی وب است. هر همکاری با بررسی درخواست شما و ارائه پیشنهاد کاری آغاز می‌شود؛ پس از تایید پیشنهاد، قرارداد کتبی شامل دامنه کارها، زمان‌بندی و شرایط مالی تنظیم و توسط طرفین امضا می‌شود. تا پیش از امضای قرارداد، تعهدی برای شروع اجرا وجود ندارد.</p>

                        <h2 class="text-2xl font-bold mt-8 mb-4">۲. تعهدات عصر سئو</h2>
                        <p>عصر سئو متعهد است خدمات خود را مطابق با قرارداد، برنامه زمان‌بندی توافق‌شده و استانداردهای حرفه‌ای روز دنیای دیجیتال ارائه دهد، اقدامات انجام‌شده را شفاف گزارش کند و برای پاسخگویی در دسترس کارفرما باشد. تغییرات مهم در روند کار یا ریسک‌های احتمالی پیش از اجرا با کارفرما در میان گذاشته می‌شود.</p>

                        <h2 class="text-2xl font-bold mt-8 mb-4">۳. تعهدات کارفرما</h2>
                        <p>کارفرما موظف است اطلاعات صحیح و به‌روز را در اختیار تیم قرار دهد، دسترسی‌های لازم را به‌موقع تامین کند و بازخوردها و تاییدیه‌های خود را در زمان توافق‌شده ارائه دهد. تاخیر در تامین دسترسی یا تاییدیه‌ها می‌تواند زمان‌بندی پروژه را جابه‌جا کند. همچنین استفاده غیرمجاز از محتوای وب‌سایت و ارائه اطلاعات خلاف واقع خارج از تعهدات عصر سئو است.</p>

                        <h2 class="text-2xl font-bold mt-8 mb-4">۴. تاییدیه‌ها و دوره‌های بازنگری</h2>
                        <p>پیش از انتشار هر خروجی، نسخه پیش‌نویس برای تایید به کارفرما ارائه می‌شود. تعداد دوره‌های بازنگری و مهلت پاسخگویی در قرارداد مشخص می‌شود؛ بازخوردی که خارج از دامنه توافق‌شده باشد، پس از بررسی در صورت نیاز بازنگری در قرارداد را می‌طلبد. پس از تایید و انتشار، اعمال تغییرات جدید در چارچوب درخواست جداگانه انجام می‌شود.</p>

                        <h2 class="text-2xl font-bold mt-8 mb-4">۵. پرداخت و صورتحساب</h2>
                        <p>هزینه هر خدمت، دوره پرداخت و شیوه صدور صورتحساب در پیشنهاد مالی یا قرارداد مشخص می‌شود و صورتحساب‌ها در موعد مقرر ارسال می‌گردد. در صورت تاخیر در پرداخت، عصر سئو می‌تواند اجرای خدمات را تا زمان تسویه حساب تعلیق کند و تعلیق مداوم می‌تواند به فسخ قرارداد منجر شود.</p>

                        <h2 class="text-2xl font-bold mt-8 mb-4">۶. محرمانگی</h2>
                        <p>هر دو طرف متعهدند اطلاعات محرمانه طرف مقابل مانند اسرار تجاری، فهرست مشتریان، دسترسی‌های فنی و جزئیات مالی را صرفاً در حد اجرای قرارداد استفاده کنند و در اختیار اشخاص ثالث قرار ندهند. این تعهد پس از پایان قرارداد نیز تا زمانی که خود اطلاعات محرمانه باقی است پابرجاست.</p>

                        <h2 class="text-2xl font-bold mt-8 mb-4">۷. مالکیت فکری و واگذاری مجوز</h2>
                        <p>پس از تسویه کامل مالی، مجوز استفاده از خروجی‌های سفارشی پروژه مانند طراحی‌ها، متن‌ها و مستندات تحویل‌داده‌شده به کارفرما واگذار می‌شود. ابزارها و کدهای عمومی که عصر سئو مستقل از پروژه توسعه داده متعلق به همین مجموعه می‌ماند و استفاده از آن‌ها مشروط به شرایط مجوز خودش است. محتوای منتشرشده در وب‌سایت عصر سئو نیز متعلق به این مجموعه بوده و کپی‌برداری از آن بدون اجازه پیگرد قانونی دارد.</p>

                        <h2 class="text-2xl font-bold mt-8 mb-4">۸. نمایش نمونه کار</h2>
                        <p>عصر سئو حق دارد نام کارفرما و نمونه‌کارهای انجام‌شده را برای معرفی خدمات خود در وب‌سایت، شبکه‌های اجتماعی و پیشنهادهای آینده استفاده کند، مگر اینکه کارفرما پیش از شروع همکاری به‌صورت کتبی با این استفاده مخالفت کرده باشد.</p>

                        <h2 class="text-2xl font-bold mt-8 mb-4">۹. تعلیق و فسخ</h2>
                        <p>در صورت نقض تعهدات طرف مقابل، تاخیر مداوم در پرداخت یا همکاری نکردن با درخواست‌های منطقی، هر یک از طرفین می‌تواند قرارداد را فسخ کند. در این حالت کارهای تکمیل‌شده تا تاریخ فسخ محاسبه و تسویه می‌شود و تعهدات محرمانگی و مالکیت فکری مطابق همین شرایط ادامه می‌یابد.</p>

                        <h2 class="text-2xl font-bold mt-8 mb-4">۱۰. محدودیت مسئولیت</h2>
                        <p>مسئولیت عصر سئو در قبال هر قرارداد محدود به مبلغ همان قرارداد و خسارات مستقیم ناشی از تقصیر آن است. عصر سئو در قبال خسارات غیرمستقیم مانند از دست رفتن درآمد یا نتایجی که خارج از کنترل آن بوده — از جمله تغییرات الگوریتم موتورهای جستجو، اقدامات رقبا یا قطعی زیرساخت‌های شخص ثالث — مسئولیتی ندارد. خدمات بر مبنای دانش روز و حسن‌نیت ارائه می‌شود و هیچ نتیجه رتبه یا درآمدی تضمین نمی‌شود.</p>

                        <h2 class="text-2xl font-bold mt-8 mb-4">۱۱. حل اختلاف و قانون حاکم</h2>
                        <p>ابتدا تلاش می‌شود اختلاف از طریق مذاکره مستقیم و حسن‌نیت حل شود. در صورت عدم توافق، موضوع به مراجع قضایی صالح ارجاع می‌شود و قوانین جمهوری اسلامی ایران حاکم بر این قرارداد است.</p>

                        <h2 class="text-2xl font-bold mt-8 mb-4">۱۲. فورس ماژور</h2>
                        <p>هیچ‌یک از طرفین در قبال تاخیر یا عدم‌اجرا ناشی از رویدادهای خارج از کنترل معقول مانند بلایای طبیعی، قطعی گسترده ارتباطات یا تصمیمات دولتی مسئول نیست؛ به شرط آنکه موضوع را اطلاع دهد و پس از رفع شرایط، اجرای تعهدات را از سر بگیرد.</p>

                        <h2 class="text-2xl font-bold mt-8 mb-4">۱۳. تغییرات قوانین</h2>
                        <p>عصر سئو حق دارد در هر زمان این شرایط را به‌روزرسانی کند. نسخه جاری همیشه در همین صفحه منتشر می‌شود و تغییرات از طریق همین صفحه به اطلاع کاربران خواهد رسید.</p>
                    </div>
                </div>
            </main>
            <Footer />
        </div>
</BaseLayout>
