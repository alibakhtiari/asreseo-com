---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Layout/Header.astro';
import Footer from '../../components/Layout/Footer.astro';
import BreadcrumbStructuredData from '../../components/BreadcrumbStructuredData.astro';

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'سیاست حریم خصوصی عصر سئو',
  url: 'https://asreseo.com/privacy/',
  inLanguage: 'fa-IR',
};
const breadcrumbs = [
  { position: 1, name: 'خانه', item: 'https://asreseo.com/' },
  { position: 2, name: 'سیاست حریم خصوصی', item: 'https://asreseo.com/privacy/' },
];
---
<BaseLayout title='سیاست حریم خصوصی و حفاظت از داده‌های کاربران | عصر سئو' description='سیاست حریم خصوصی عصر سئو؛ نحوه جمع‌آوری اطلاعات از فرم‌های تماس و خبرنامه، اهداف پردازش، مدت نگهداری، کوکی‌ها، پردازش‌کنندگان و حقوق شما.' canonical='https://asreseo.com/privacy/' ogType='website' twitterCard='summary_large_image'>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(pageSchema)} />
  <BreadcrumbStructuredData items={breadcrumbs} />
<div class="min-h-screen bg-white">
            <Header />
            <main class="section-padding pt-32">
                <div class="container-custom max-w-4xl">
                    <h1 class="text-4xl font-bold mb-8 text-right">سیاست حریم خصوصی</h1>
                    <div class="prose prose-lg max-w-none text-right" dir="rtl">
                        <p>ما در عصر سئو به حریم خصوصی شما اهمیت می‌دهیم. در این صفحه توضیح می‌دهیم چه اطلاعاتی را از چه مسیرهایی جمع‌آوری می‌کنیم، با چه هدفی از آن استفاده می‌کنیم، چه مدت نگه می‌داریم و چگونه می‌توانید حقوق خود را به‌عنوان صاحب داده پیگیری کنید. این سیاست درباره وب‌سایت عصر سئو و فرم‌ها و کانال‌های ارتباطی همان اعمال می‌شود.</p>

                        <h2 class="text-2xl font-bold mt-8 mb-4">۱. اطلاعاتی که جمع‌آوری می‌کنیم</h2>
                        <p>هنگامی که شما از فرم تماس ما استفاده می‌کنید، در خبرنامه عضو می‌شوید یا برای دریافت مشاوره درخواست می‌دهید، اطلاعاتی نظیر نام، آدرس ایمیل، شماره تماس و متن پیام شما را دریافت می‌کنیم. در مکاتبات قراردادی ممکن است نام و نشانی کسب‌وکار شما نیز ثبت شود. اگر برای ارائه خدمات به دسترسی محدود به ابزارهایی مانند سرچ کنسول یا پنل مدیریت محتوا نیاز باشد، آن دسترسی صرفاً در چارچوب همان قرارداد استفاده می‌شود و با پایان همکاری بازپسگرفته می‌شود. هنگام بازدید از وب‌سایت نیز داده‌های فنی محدودی مانند نشانی IP، نوع مرورگر و صفحات بازدیدشده به‌صورت خودکار و تجمیعی ثبت می‌شود.</p>

                        <h2 class="text-2xl font-bold mt-8 mb-4">۲. نحوه استفاده از اطلاعات</h2>
                        <p>اطلاعات شما صرفاً برای پاسخگویی به درخواست‌های شما، تهیه پیشنهاد و عقد قرارداد، ارائه خدمات، ارسال گزارش‌های پروژه و در صورت تمایل خودتان ارسال به‌روزرسانی‌های مرتبط با خدمات ما استفاده می‌شود. عضویت در خبرنامه تنها با رضایت صریح شما انجام می‌شود و هر زمان می‌توانید با لغو عضویت، دریافت آن را متوقف کنید. ما اطلاعات تماس شما را نمی‌فروشیم و خارج از اهدافی که در همین صفحه آمده به کار نمی‌بریم.</p>

                        <h2 class="text-2xl font-bold mt-8 mb-4">۳. مدت نگهداری و حذف اطلاعات</h2>
                        <p>درخواست‌هایی که به همکاری نینجامیده تا پایان پیگیری همان درخواست نگهداری و سپس حذف یا تجمیع می‌شوند. سوابق مالی و قراردادی تا زمانی که ماهیت همکاری و الزامات قانونی ایجاب کند نگه داشته می‌شود و پس از آن پاک می‌شود. اطلاعات عضویت در خبرنامه تا لغو عضویت شما باقی می‌ماند. اگر بخواهید، پیش از حذف نیز می‌توانیم نسخه‌ای از داده‌هایی را که به شما تعلق دارد در اختیارتان بگذاریم.</p>

                        <h2 class="text-2xl font-bold mt-8 mb-4">۴. پردازش‌کنندگان و افشای محدود</h2>
                        <p>برای اجرای خدمات از پردازش‌کنندگانی مانند میزبانی وب‌سایت، سرویس ارسال ایمیل، ابزارهای تحلیل ترافیک و فضای ذخیره‌سازی ابری استفاده می‌کنیم. این پردازش‌کنندگان فقط در حد نیاز به داده دسترسی دارند و موظف به حفاظت از آن هستند. بخشی از این ابزارها ممکن است خارج از ایران میزبانی شوند که در آن صورت انتقال داده صرفاً برای همین اهداف انجام می‌شود. اطلاعات شما خارج از چارچوب همین خدمات با شخص ثالثی به اشتراک گذاشته نمی‌شود.</p>

                        <h2 class="text-2xl font-bold mt-8 mb-4">۵. امنیت داده‌ها</h2>
                        <p>ما از پروتکل‌های امنیتی مدرن از جمله رمزگذاری انتقال داده، کنترل دسترسی کاربران داخلی و بازبینی دوره‌ای ابزارها برای محافظت از داده‌های شما استفاده می‌کنیم. دسترسی اعضای تیم به اطلاعات مشتریان محدود به ضرورت کاری است و در صورت بروز حادثه امنیتی مرتبط با داده‌های شما، مطابق با الزامات قانونی اطلاع‌رسانی می‌کنیم.</p>

                        <h2 class="text-2xl font-bold mt-8 mb-4">۶. کوکی‌ها</h2>
                        <p>این وب‌سایت برای بهبود تجربه کاربری از کوکی‌های استاندارد استفاده می‌کند. کوکی‌های ضروری پایه‌ترین امکانات صفحات را فعال نگه می‌دارند و کوکی‌های تحلیلی به شکل تجمیعی به ما نشان می‌دهند کدام بخش‌ها بیشتر دیده می‌شوند. می‌توانید کوکی‌ها را از تنظیمات مرورگر خود مسدود یا پاک کنید؛ در این صورت ممکن است بخشی از امکانات وب‌سایت درست کار نکند.</p>

                        <h2 class="text-2xl font-bold mt-8 mb-4">۷. حقوق شما به‌عنوان دارنده داده</h2>
                        <p>شما حق دارید از ما بخواهید نسخه‌ای از اطلاعاتی را که درباره شما نگه می‌داریم ارائه دهیم، اطلاعات نادرست یا ناقص را اصلاح کنیم و در مواردی که نیازی به نگهداری آن نیست یا مبتنی بر رضایت شما ثبت شده، آن را حذف کنیم. همچنین می‌توانید محدودکردن پردازش یا اعتراض به شیوه مشخصی از استفاده از داده‌هایتان را درخواست کنید.</p>

                        <h2 class="text-2xl font-bold mt-8 mb-4">۸. چگونه درخواست خود را ثبت کنیم</h2>
                        <p>برای استفاده از هریک از حقوق بالا، کافی است درخواست خود را به نشانی info@asreseo.com ایمیل کنید و هویت خود را به شیوه‌ای تایید نمایید که اطمینان یابیم داده به شخص اشتباهی ارائه نمی‌شود. درخواست شما بررسی و نتیجه از همان کانال اطلاع داده می‌شود. اگر پاسخ مناسبی دریافت نکردید، حق مراجعه به مراجع نظارتی ذی‌صلاح برای شما محفوظ است.</p>

                        <h2 class="text-2xl font-bold mt-8 mb-4">۹. تغییرات این سیاست</h2>
                        <p>ممکن است این سیاست را برای انعکاس تغییرات خدمات یا الزامات قانونی به‌روزرسانی کنیم. نسخه جاری همیشه در همین صفحه منتشر می‌شود و در تغییرات اساسی از طریق ایمیل یا اعلان در وب‌سایت اطلاع‌رسانی می‌کنیم.</p>

                        <h2 class="text-2xl font-bold mt-8 mb-4">۱۰. تماس با ما</h2>
                        <p>اگر درباره این سیاست یا نحوه برخورد با اطلاعات شخصی‌تان پرسشی دارید، از طریق ایمیل info@asreseo.com با ما در تماس باشید. کارشناسان ما پیش از عقد قرارداد و در طول همکاری نیز به پرسش‌های مرتبط با حریم خصوصی پاسخ می‌دهند.</p>
                    </div>
                </div>
            </main>
            <Footer />
        </div>
</BaseLayout>
