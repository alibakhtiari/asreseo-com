---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Layout/Header.astro';
import Footer from '../../components/Layout/Footer.astro';
import BreadcrumbStructuredData from '../../components/BreadcrumbStructuredData.astro';

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'سیاست حریم خصوصی عصر سئو',
  url: 'https://asreseo.com/privacy/',
  inLanguage: 'fa-IR',
};
const breadcrumbs = [
  { position: 1, name: 'خانه', item: 'https://asreseo.com/' },
  { position: 2, name: 'سیاست حریم خصوصی', item: 'https://asreseo.com/privacy/' },
];
---
<BaseLayout title='حریم خصوصی | عصر سئو' description='سیاست حفظ حریم خصوصی عصر سئو: نحوه جمع‌آوری، استفاده و محافظت از اطلاعات کاربران وب‌سایت و فرم‌های تماس.' canonical='https://asreseo.com/privacy/' ogType='website' twitterCard='summary_large_image'>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(pageSchema)} />
  <BreadcrumbStructuredData items={breadcrumbs} />
<div class="min-h-screen bg-white">
            <Header />
            <main class="section-padding pt-32">
                <div class="container-custom max-w-4xl">
                    <h1 class="text-4xl font-bold mb-8 text-right">سیاست حریم خصوصی</h1>
                    <div class="prose prose-lg max-w-none text-right" dir="rtl">
                        <p>ما در عصر سئو به حریم خصوصی شما اهمیت می‌دهیم. در این صفحه توضیح می‌دهیم که چه اطلاعاتی را جمع‌آوری می‌کنیم و چگونه از آن‌ها استفاده می‌کنیم.</p>

                        <h2 class="text-2xl font-bold mt-8 mb-4">۱. اطلاعاتی که جمع‌آوری می‌کنیم</h2>
                        <p>هنگامی که شما از فرم تماس ما استفاده می‌کنید یا در خبرنامه عضو می‌شوید، اطلاعاتی نظیر نام، آدرس ایمیل و شماره تماس شما را دریافت می‌کنیم.</p>

                        <h2 class="text-2xl font-bold mt-8 mb-4">۲. نحوه استفاده از اطلاعات</h2>
                        <p>اطلاعات شما صرفاً برای پاسخگویی به درخواست‌های شما، ارائه خدمات و ارسال به‌روزرسانی‌های مرتبط با خدمات ما استفاده می‌شود.</p>

                        <h2 class="text-2xl font-bold mt-8 mb-4">۳. امنیت داده‌ها</h2>
                        <p>ما از پروتکل‌های امنیتی مدرن برای محافظت از داده‌های شما استفاده می‌کنیم و هرگز اطلاعات شما را با شخص ثالث به اشتراک نمی‌گذاریم.</p>

                        <h2 class="text-2xl font-bold mt-8 mb-4">۴. کوکی‌ها</h2>
                        <p>این وب‌سایت برای بهبود تجربه کاربری از کوکی‌های استاندارد استفاده می‌کند.</p>
                    </div>
                </div>
            </main>
            <Footer />
        </div>
</BaseLayout>
