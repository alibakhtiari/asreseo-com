---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/button/Button.astro";
import Icon from "../components/ui/Icon.astro";

const lang = 'en' as const;
const localize = (p: string) => p;
---
<BaseLayout
  lang="en"
  title="Page Not Found | AsreSEO"
  description="The page you requested doesn't exist or has been moved. From the AsreSEO homepage, find SEO services, AI, web design, and Google Ads."
  noindex
  nofollow
>
  <div class="min-h-screen flex items-center justify-center bg-[#000000] text-slate-100 relative overflow-hidden">
    <!-- Background animation -->
    <div class="absolute inset-0 opacity-20 pointer-events-none">
      <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-cyan-500/20 rounded-full filter blur-3xl animate-float"></div>
      <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-blue-500/20 rounded-full filter blur-3xl animate-float [animation-delay:4s]"></div>
    </div>

    <div class="text-center relative z-10 max-w-2xl mx-auto px-4">
      <div class="animate-fade-in">
        <h1 class="text-8xl md:text-9xl font-black gradient-text mb-4 tracking-tight">404</h1>
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Page not found</h2>
        <p class="text-lg md:text-xl text-slate-400 mb-8 leading-relaxed max-w-lg mx-auto">
          Unfortunately, the page you were looking for couldn't be found. You may have typed the address incorrectly, or the page may have been moved.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
          <Button size="lg" class="gradient-bg text-white px-8 py-3 text-lg hover:opacity-95 shadow-lg shadow-cyan-500/20 transition-all duration-200 transform hover:scale-105" href={localize('/')}>
              <Icon name="arrow-right" class="h-5 w-5 mr-2" />
              Back to homepage
            </Button>
          <Button
            variant="outline"
            size="lg"
            class="border border-white/20 text-slate-200 hover:bg-white/10 hover:text-white px-8 py-3 text-lg transition-all duration-200"
            data-go-back
          >
            <Icon name="search" class="h-5 w-5 mr-2" />
            Go back
          </Button>
        </div>

        <!-- Popular links -->
        <div class="bg-slate-900/60 backdrop-blur-xl rounded-2xl p-6 border border-white/10 shadow-2xl">
          <p class="text-slate-300 mb-4 font-semibold text-sm">You may have been looking for:</p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <a href={localize('/')} class="text-cyan-400 hover:text-cyan-300 transition-colors py-2 px-3 rounded-lg hover:bg-white/5 text-sm font-medium">
              Homepage
            </a>
            <a href={localize('/services/')} class="text-cyan-400 hover:text-cyan-300 transition-colors py-2 px-3 rounded-lg hover:bg-white/5 text-sm font-medium">
              Our services
            </a>
            <a href={localize('/about/')} class="text-cyan-400 hover:text-cyan-300 transition-colors py-2 px-3 rounded-lg hover:bg-white/5 text-sm font-medium">
              About us
            </a>
            <a href={localize('/contact/')} class="text-primary hover:text-primary-700 transition-colors py-2 px-3 rounded-lg hover:bg-primary-50">
              Contact us
            </a>
            <a href={localize('/blog/')} class="text-primary hover:text-primary-700 transition-colors py-2 px-3 rounded-lg hover:bg-primary-50">
              News blog
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
<script>document.querySelectorAll("[data-go-back]").forEach((b)=>b.addEventListener("click",()=>window.history.back()));</script>
</BaseLayout>
