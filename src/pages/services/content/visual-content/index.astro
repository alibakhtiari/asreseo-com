              <ServiceBenefits title="مزایای استراتژیک" titleHighlight="محتوای بصری عصر سئو" subtitle="آنچه محتوای بصری حرفه‌ای برای برند شما ایجاد می‌کند و در گزارش عملکرد پایش می‌شود" benefits={benefits} />

        <!-- Workflow Section -->
        <section class="section-padding bg-linear-to-br from-indigo-50 to-pink-50">
          <div class="container-custom">
            <div class="text-center mb-12">
              <h2 class="text-3xl font-bold text-gray-900 mb-6">
                فرآیند <span class="gradient-text">تولید محتوای بصری</span> عصر سئو
              </h2>
              <p class="text-xl text-gray-600">
