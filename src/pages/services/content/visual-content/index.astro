---
<BaseLayout title='تولید محتوای تصویری، ویدیویی و اینفوگرافیک | عصر سئو' description='طراحی گرافیک و تولید محتوای بصری با ویدیو مارکتینگ، اینفوگرافیک انیمیشنی و عکاسی حرفه‌ای. نرخ تبدیل و تعامل در داشبورد گزارش‌دهی عصر سئو قابل پیگیری است.' keywords='محتوای تصویری, ویدیو مارکتینگ, طراحی گرافیک, اینفوگرافیک, موشن گرافیک, تولید محتوا' canonical='https://asreseo.com/services/content/visual-content/' ogType='website' ogUrl='https://asreseo.com/services/content/visual-content/' ogImages={[{ url: "/og/visual-content-hero.jpg", width: 1200, height: 630, alt: "محتوای تصویری و ویدیویی | عصر سئو" }]} twitterCard='summary_large_image'
  ogTitle='محتوای تصویری و ویدیویی | عصر سئو'

  ogDescription='طراحی گرافیک و تولید ویدیو حرفه‌ای برای برند شما.'
>
<div class="min-h-screen bg-white">
      <script id="structured-data" type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

      <Header />
      <BreadcrumbStructuredData
        items={[
          { position: 1, name: 'خانه', item: 'https://asreseo.com/' },
          { position: 2, name: 'خدمات محتوا', item: 'https://asreseo.com/services/content/' },
          { position: 3, name: 'محتوای تصویری و ویدیویی', item: 'https://asreseo.com/services/content/visual-content/' }
        ]}
      />

      <main>
        <!-- Hero Section -->
        <ServiceHero
          badge="تولید محتوای بصری حرفه‌ای"
          title="محتوای"
          titleGradient="تصویری و ویدیویی"
          description="قدرت دیداری برای برند شما! ویدیو مارکتینگ حرفه‌ای که نرخ تبدیل آن در داشبورد گزارش‌دهی پیگیری می‌شود، و محتوای گرافیکی که میلیون‌ها بار دیده می‌شود در عصر سئو."
          primaryCta={{ text: "سفارش محتوای بصری" }}
          secondaryCta={{ text: "مشاهده نمونه کارها" }}
          imageSrc="/images/visual-content-hero.webp"
          imageAlt="محتوای تصویری و ویدیویی"
          theme="purple"
        />

        <!-- Stats Section -->
        <ServiceStats stats={stats} theme="purple" />

        <!-- Content Types Section -->
        <section class="section-padding">
          <div class="container-custom">
            <div class="text-center mb-12">
              <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
                استراتژی محتوا <span class="gradient-text">بر اساس هدف</span>
              </h2>
              <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                رویکردهای تخصصی برای اهداف بازاریابی متفاوت
              </p>
            </div>

            <div class="grid md:grid-cols-2 gap-8">
              {contentTypes.map((content, index) => (
                <Card class="hover:shadow-xl transition-all duration-300 group border-0 shadow-lg">
                  <CardHeader class="pb-4">
                    <div class="flex items-center gap-3 mb-3">
                      <div class="w-12 h-12 bg-indigo-100 rounded-lg flex items-center justify-center group-hover:bg-indigo-200 transition-colors">
                        <Icon name="sparkles" class="h-6 w-6 text-indigo-600" />
                      </div>
                      <CardTitle class="text-xl font-semibold">{content.type}</CardTitle>
                    </div>
                  </CardHeader>
                  <CardContent>
                    <div class="space-y-3">
                      <div class="flex justify-between items-center">
                        <span class="text-gray-600">مخاطب هدف:</span>
                        <span class="text-indigo-600 font-medium">{content.audience}</span>
                      </div>
                      <div class="flex justify-between items-center">
                        <span class="text-gray-600">هدف اصلی:</span>
                        <span class="text-purple-600 font-medium">{content.goal}</span>
                      </div>
                      <Badge class="bg-green-100 text-green-800 w-fit">{content.impact}</Badge>
                    </div>
                  </CardContent>
                </Card>
              ))}
            </div>
          </div>
        </section>

        <!-- Service Categories Section -->
        <section class="section-padding bg-linear-to-br from-slate-50 to-indigo-50">
          <div class="container-custom">
            <div class="text-center mb-12">
              <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
                دسته‌بندی کامل <span class="gradient-text">خدمات بصری عصر سئو</span>
              </h2>
              <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                تمام نیازهای محتوای تصویری برند شما در یک پلتفرم
              </p>
            </div>

            <div class="space-y-12">
              {serviceCategories.map((category, index) => (
                <div class="bg-white rounded-xl shadow-lg p-8">
                  <div class="flex items-center gap-4 mb-6">
                    <div class="w-16 h-16 bg-pink-100 rounded-full flex items-center justify-center">
                      <Icon name={category.icon} class="h-8 w-8 text-pink-600" />
                    </div>
                    <h3 class="text-2xl font-bold text-gray-900">{category.category}</h3>
                  </div>
                  <div class="grid md:grid-cols-3 gap-6">
                    {category.services.map((service, serviceIndex) => (
                      <Card class="hover:shadow-md transition-shadow">
                        <CardHeader>
                          <CardTitle class="text-lg">{service.name}</CardTitle>
                        </CardHeader>
                        <CardContent>
                          <p class="text-gray-600 mb-3 text-sm">{service.description}</p>
                          <div class="flex flex-wrap gap-1">
                            {service.formats.map((format, formatIndex) => (
                              <Badge variant="outline" class="text-xs">
                                {format}
