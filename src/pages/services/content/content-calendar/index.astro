            <div class="space-y-8">
              {workflowSteps.map((step, index) => (
                <div id={`step-${index + 1}`} class="flex items-center gap-8 p-6 bg-white/80 rounded-xl shadow-xs scroll-mt-24">
                  <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center text-2xl font-bold text-blue-700">
                    {index + 1}
                  </div>
                  <div class="flex-1">
                    <h3 class="text-xl font-semibold text-gray-900 mb-2">
                      {step.step}
