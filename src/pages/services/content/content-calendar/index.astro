              alt="Sample content calendar table with columns for title, goal, keyword, content format and publish date"
              width="1672"
              height="941"
              loading="lazy"
              decoding="async"
              class="w-full h-auto rounded-2xl shadow-xs border border-gray-200"
            />
          </div>
        </section>

        <!-- Copyable four-week example calendar. Deliberately contains no
             performance statistics. -->
