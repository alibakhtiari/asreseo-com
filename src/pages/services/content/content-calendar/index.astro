---
import { withServiceMeta } from '../../../../lib/service-schema';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Header from '../../../../components/Layout/Header.astro';
import Footer from '../../../../components/Layout/Footer.astro';
import Card from '../../../../components/ui/card/Card.astro';
import CardContent from '../../../../components/ui/card/CardContent.astro';
import CardHeader from '../../../../components/ui/card/CardHeader.astro';
import CardTitle from '../../../../components/ui/card/CardTitle.astro';
import Badge from '../../../../components/ui/badge/Badge.astro';
import Icon from '../../../../components/ui/Icon.astro';
import ServiceHero from '../../../../components/Services/ServiceHero.astro';
import ServiceStats from '../../../../components/Services/ServiceStats.astro';
import ServiceFAQ from '../../../../components/Services/ServiceFAQ.astro';
import ServiceCTA from '../../../../components/Services/ServiceCTA.astro';
import BreadcrumbStructuredData from '../../../../components/BreadcrumbStructuredData.astro';
import ServiceBenefits from '../../../../components/Services/ServiceBenefits.astro';





const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  'name': 'Content Calendar Design & Publishing Planning',
  'description': 'Expert editorial calendar services for websites and social feeds with strategic planning and automated, regular content publishing.',
  'serviceType': 'Content Calendar & Editorial Planning',
  'inLanguage': 'en-US',
  'provider': {
    '@type': 'Organization',
    'name': 'AsreSEO',
    'url': 'https://asreseo.com'
  },
  'hasOfferCatalog': {
    '@type': 'OfferCatalog',
    'name': 'Content calendar services',
    'itemListElement': [
      {
        '@type': 'Offer',
        'itemOffered': {
          '@type': 'Service',
          'name': 'Smart publishing schedules',
          'description': 'Strategic timing for website and social content',
          'inLanguage': 'en-US'
        }
      },
      {
        '@type': 'Offer',
        'itemOffered': {
          '@type': 'Service',
          'name': 'Content cycle automation',
          'description': 'Integration with scheduling tools and automatic publishing',
          'inLanguage': 'en-US'
        }
      }
    ]
  }
};



  const strategies = [
    {
      type: 'Seasonal Strategy',
      description: 'Content tied to seasons, holidays and annual events',
      examples: ['New Year content', 'Summer campaigns', 'Autumn prep'],
      impact: 'One season ahead'
    },
    {
      type: 'Pillar Strategy',
      description: 'Strategic cornerstone content usable for months',
      examples: ['Complete product guides', 'Expert tutorials', 'In-depth research'],
      impact: 'Long-term returns'
    },
    {
      type: 'Cluster Strategy',
      description: 'A content network around one core topic',
      examples: ['Content around one product', 'Full tutorial series', 'Related article sets'],
      impact: 'Unified cluster coverage'
    }
  ];

  const pillars = [
    {
      pillar: 'Audience-Centric Planning',
      description: 'Planning around the needs and behavior of your target audience',
      benefits: ['Better connection', 'Higher engagement', 'More conversions']
    },
    {
      pillar: 'Data-Driven Scheduling',
      description: 'Timing based on past performance data analysis',
      benefits: ['Higher returns', 'Optimized timing', 'Performance forecasting']
    },
    {
      pillar: 'Brand Consistency',
      description: 'Keeping the brand message aligned across all published content',
      benefits: ['Brand recognition', 'Customer trust', 'Competitive distinction']
    },
    {
      pillar: 'Campaign Integration',
      description: 'Aligning content with marketing and sales campaigns',
      benefits: ['Stronger sales', 'Team alignment', 'Unified management']
    }
  ];

  const features = [
    {
      icon: "calendar",
      title: 'Smart Publishing Schedules',
      description: 'Precise, strategic timing for every content type across platforms, tuned to each network’s algorithms.',
      benefits: ['Regular publishing', 'Maximum reach', 'Steady growth']
    },
    {
      icon: "list-todo",
      title: 'Campaign-Aligned Content',
      description: 'Full content-strategy alignment with marketing events, discounts, seasonal pushes and brand campaigns.',
      benefits: ['Stronger campaigns', 'Right timing', 'Combined returns']
    },
    {
      icon: "sparkles",
      title: 'Stronger Brand Order & Cohesion',
      description: 'Structured production with defined roles, responsibilities and workflows for content teams.',
      benefits: ['Team efficiency', 'Content quality', 'On-time delivery']
    },
    {
      icon: "bar-chart3",
      title: 'Advanced Reporting & Analysis',
      description: 'A full dashboard with KPIs, trend analysis and continuous improvement ideas.',
      benefits: ['Full transparency', 'Informed decisions', 'Steady improvement']
    },
    {
      icon: "target",
      title: 'Strategic Goal Tracking',
      description: 'Showing how content delivers on marketing, sales and branding goals.',
      benefits: ['Strategic alignment', 'ROI measurement', 'Expectation management']
    },
    {
      icon: "trending-up",
      title: 'Continuous Publishing Optimization',
      description: 'A/B testing on timing, formats and platforms, analyzed for peak efficiency.',
      benefits: ['Higher returns', 'Lessons learned', 'Ongoing improvement']
    }
  ];

  const benefits = [
    'Regular, predictable publishing of quality strategic content',
    'Higher audience engagement through targeted content planning',
    'Less rework and wasted team time',
    'Content aligned with marketing and sales goals',
    'Higher content-marketing returns through smart publishing'
  ];

  const tools = [
    {
      name: 'Google Calendar Integration',
      description: 'Full Google Calendar sync for team collaboration',
      features: ['Team coordination', 'Smart reminders', 'Multi-device access']
    },
    {
      name: 'Asana Integration',
      description: 'Project-management links for task tracking',
      features: ['Task management', 'Execution scheduling', 'Progress reports']
    },
    {
      name: 'Buffer/SocialPilot Integration',
      description: 'Automated social publishing',
      features: ['Auto publishing', 'Multi-account management', 'Analytics reports']
    }
  ];

  // Answer-first sections for the queries that already send impressions to this
  // page but had no matching heading.
  const automationItems = [
    {
      icon: 'clock',
      title: 'Automatic Scheduling & Publishing',
      description: 'Content marked “final approved” in the calendar goes live on your site, Instagram, LinkedIn or newsletter in its defined window.'
    },
    {
      icon: 'bell',
      title: 'Chain Reminders for the Team',
      description: 'Writer, designer and channel manager each get reminded ahead of time, so incomplete or unapproved content never reaches a publishing slot.'
    },
    {
      icon: 'refresh-cw',
      title: 'Tool Sync',
      description: 'Each calendar row stays current with your Google Calendar and project tools, so everyone sees every item’s status in one place.'
    },
    {
      icon: 'send',
      title: 'Multi-Channel Distribution',
      description: 'One approved article becomes a social version, a newsletter digest and internal-link suggestions — without rewriting from scratch.'
    },
    {
      icon: 'link',
      title: 'Tracking Parameters',
      description: 'Outbound links carry tracking parameters so you can see which channel brought each visit.'
    },
    {
      icon: 'shield',
      title: 'Halt Without Approval',
      description: 'Anything that hasn’t passed review stays unpublished; automation never replaces human judgment.'
    }
  ];

  const cycleSteps = [
    {
      step: 'Request & Idea Logging',
      desc: 'Every topic — from Search Console questions, sales-team suggestions or customer queries — enters the calendar with a title and target keyword.'
    },
    {
      step: 'Writing & SEO',
      desc: 'The writer works from a content brief: the target question, heading structure and related pieces the article must link to.'
    },
    {
      step: 'Review & Approval',
      desc: 'Copy passes technical and editorial editing, and its calendar row moves from draft to final approval.'
    },
    {
      step: 'Publishing Schedule',
      desc: 'Windows are set by channel capacity and the occasions calendar so no week runs empty or overloaded.'
    },
    {
      step: 'Publishing & Distribution',
      desc: 'The piece goes live on site and socials, gets its tracking link, and its digest is prepared for the newsletter.'
    },
    {
      step: 'Measurement & Feedback',
      desc: 'Each item’s performance is logged in its row; what worked gets refreshed and its idea loops back to step one.'
    }
  ];

  // A selection guide, kept separate from `tools` above, which lists what we
  // integrate with.
  const toolChoices = [
    {
      name: 'Spreadsheets (Google Sheets or Excel)',
      best: 'New, low-volume teams',
      why: 'Cheapest setup, ready templates, easy access for everyone'
    },
    {
      name: 'Google Calendar',
      best: 'Distributed and remote teams',
      why: 'Shows in everyone’s personal calendar with reminders, on mobile and desktop'
    },
    {
      name: 'Trello or Asana',
      best: 'Teams with multi-step approvals',
      why: 'Every item’s status from draft to published visible at a glance'
    },
    {
      name: 'Notion',
      best: 'Teams wanting content and docs in one place',
      why: 'Calendar, article archive and briefs in a single hub'
    },
    {
      name: 'Buffer or SocialPilot',
      best: 'Multi-channel brands',
      why: 'Automated scheduling and publishing across accounts with performance reports'
    },
    {
      name: 'Built-in WordPress Scheduler',
      best: 'Article-heavy sites',
      why: 'Publishes articles with no extra tools; not enough for multi-channel calendars'
    }
  ];

  // Filled-in four-week example. This is the page's information-gain block:
  // a calendar a reader can copy, not a description of one.
  const calendarExample = [
    { week: 'Week 1', channel: 'Site (Blog)', type: 'Comprehensive guide', topic: 'How to choose an SEO package for a new site', goal: 'Awareness — capturing educational searches' },
    { week: 'Week 1', channel: 'Instagram', type: 'Educational carousel', topic: 'Seven takeaways from the guide, slide by slide', goal: 'Awareness — restating the article visually' },
    { week: 'Week 1', channel: 'Email newsletter', type: 'Welcome email', topic: 'Guide digest with a read-the-article button', goal: 'Nurture — bringing new readers back to the site' },
    { week: 'Week 2', channel: 'Site (Blog)', type: 'Comparison article', topic: 'Paid ads vs. SEO on a small budget', goal: 'Consideration — answering comparison searches' },
    { week: 'Week 2', channel: 'LinkedIn', type: 'Real-experience post', topic: 'One real challenge from a recent project and its fix', goal: 'Consideration — showing expertise to decision-makers' },
    { week: 'Week 2', channel: 'Instagram', type: 'Behind-the-scenes reel', topic: 'How an order moves through our team', goal: 'Awareness — introducing the team' },
    { week: 'Week 3', channel: 'Site (Blog)', type: 'Question-led article', topic: 'Answering customers’ most-asked pricing question', goal: 'Consideration — ranking for near-purchase questions' },
    { week: 'Week 3', channel: 'Instagram', type: 'Poll story', topic: 'Question of the week; results pick week four’s topic', goal: 'Engagement — sourcing next week’s idea' },
    { week: 'Week 3', channel: 'Video channel', type: 'Short video', topic: 'Three key points from the article in minutes', goal: 'Awareness — covering video search' },
    { week: 'Week 4', channel: 'Site (Blog)', type: 'Refreshing an old article', topic: 'Last season’s highest-traffic post', goal: 'Retention — freshening and holding an existing ranking' },
    { week: 'Week 4', channel: 'Email newsletter', type: 'Month digest', topic: 'The month’s four best pieces plus a special offer', goal: 'Purchase — guiding readers to service pages' },
    { week: 'Week 4', channel: 'Instagram & LinkedIn', type: 'Month roundup', topic: 'Top-tips carousel and next month’s plan', goal: 'Engagement — closing the loop, restarting it' }
  ];

  const stats = [
    // Qualitative process facts, not performance percentages — every numeric
    // marketing claim here would be unverifiable (see src/lib/site-claims.ts).
    { metric: '4 Weeks', label: 'Fixed planning horizon', color: 'text-blue-600', icon: "calendar" },
    { metric: '6 Steps', label: 'Documented execution process', color: 'text-green-800', icon: "list-todo" },
    { metric: 'Multi-Channel', label: 'Web, newsletter & social', color: 'text-purple-600', icon: "users" },
    { metric: 'Monthly', label: 'Performance reports & reviews', color: 'text-orange-600', icon: "target" }
  ];

  const workflowSteps = [
    {
      step: 'Strategy Analysis',
      desc: 'Reviewing competitors, audiences and your business content goals'
    },
    {
      step: 'Content Strategy Design',
      desc: 'Defining content pillars, platform mix and timing strategy'
    },
    {
      step: 'Calendar Scheduling',
      desc: 'Monthly, weekly and daily planning with owners for every piece'
    },
    {
      step: 'Execution Tooling',
      desc: 'Connecting automation and publishing-schedule tools'
    },
    {
      step: 'Monitoring & Correction',
      desc: 'Tracking performance and applying strategic fixes'
    },
    {
      step: 'Reporting & Improvement',
      desc: 'Monthly reports with better-strategy proposals'
    }
  ];

  const faqs = [
    {
      question: 'Is a content calendar only for social media?',
      answer: 'No — the AsreSEO calendar covers every platform: website, blog, social feeds (Instagram, LinkedIn, X, TikTok), email marketing, video channels and more. One comprehensive, unified plan for your brand’s entire digital presence.'
    },
    {
      question: 'How do we apply changes to the calendar?',
      answer: 'We build the calendar online (Google Sheets or Trello) so your team and ours can edit easily. Mobile apps keep it accessible on the go.'
    },
    {
      question: 'How are publishing deadlines communicated?',
      answer: 'An advanced reminder system with email, SMS and in-app notifications. Sensitive posts also get a phone call. Nothing gets forgotten.'
    },
    {
      question: 'Does it include content production or just planning?',
      answer: 'Depending on your package: strategic planning only, or production, graphics, caption writing and even publishing too. Our full package covers strategy through execution.'
    },
    {
      question: 'What is the monthly calendar volume?',
      answer: 'It varies with your goals. Small brands usually need 24 posts a month; mid-size brands 60–80; larger brands plan bigger volumes.'
    },
    {
      question: 'How do I measure the calendar’s ROI?',
      answer: 'With metrics like follower growth, engagement, website traffic, conversion rates, sales and even brand value. We deliver a full monthly report with charts and analysis.'
    },
    {
      question: 'How many weeks ahead should the calendar be written?',
      answer: 'A rolling four-week cycle stays fixed, with seasonal events and campaigns locked up to a season ahead. Each week, upcoming rows are revised against real performance — the calendar is a living document, not a write-once plan.'
    },
    {
      question: 'Does publishing automation replace the content team?',
      answer: 'No. Automation handles the mechanical part — scheduling, reminders, publishing and status logging. Topic choice, copy quality, final review and audience interaction stay human; the tooling just executes without delay.'
    },
    {
      question: 'What do you need from us to start designing the calendar?',
      answer: 'Core topics and services, active channels, your team’s real production capacity and seasonal business goals. If you can share Google Search Console access, analyzing the queries your site already shows for is the fastest starting point.'
    }
  ];

const breadcrumbs = [
  { position: 1, name: 'Home', item: 'https://asreseo.com/' },
  { position: 2, name: 'Content Services', item: 'https://asreseo.com/services/content/' },
  { position: 3, name: 'Content Calendar', item: 'https://asreseo.com/services/content/content-calendar/' }
];

// HowTo is generated from the SAME `workflowSteps` array that renders the
// visible numbered section below, so the markup and the schema can never drift.
// Step URLs point at real on-page anchors (#step-1 … #step-6).
const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How to design and run a content calendar',
  description:
    'AsreSEO’s 6-step approach to building, executing and optimizing website and social content calendars',
  inLanguage: 'en-US',
  totalTime: 'P30D',
  step: workflowSteps.map((s, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name: s.step,
    text: s.desc,
    url: `https://asreseo.com/services/content/content-calendar/#step-${i + 1}`,
  })),
};
---
<BaseLayout
  lang="en"
  title='Content Calendar, Site Planning & Publishing Automation | AsreSEO'
  description='Content calendar design and site editorial planning with publishing automation; blog and social scheduling, a ready sample calendar and monthly AsreSEO performance reports.'
  keywords='content calendar, site content calendar, publishing automation, content planning, content calendar'
  canonical='/services/content/content-calendar/'
  ogType='website'
  ogUrl='https://asreseo.com/services/content/content-calendar/'
  ogImages={[{ url: "/og/content-calendar-hero.jpg", width: 1200, height: 630, alt: "Website and social content calendar planning by AsreSEO" }]}
  twitterCard='summary_large_image'
>
<div class="min-h-screen bg-[#000000] text-slate-100 wireframe-grid">
      <script id="structured-data" type="application/ld+json" is:inline set:html={JSON.stringify(withServiceMeta(structuredData, { url: 'https://asreseo.com/services/content/content-calendar/', image: '/og/content-calendar-hero.jpg' }))} />
      <BreadcrumbStructuredData items={breadcrumbs} />
      <script id="howto-structured-data" type="application/ld+json" is:inline set:html={JSON.stringify(howToSchema)} />

      <Header lang="en" />

      <main>
        <!-- Hero Section -->
        <ServiceHero
          lang="en"
          badge="Strategic Content Organization"
          title="Website Content Calendars"
          titleGradient="& Publishing Automation"
          description="Science-based publishing plans for lasting audience engagement. Smart content-team organization with advanced AsreSEO tooling and proven strategies."
          primaryCta={{ text: "Design My Content Calendar", href: "/consultation/" }}
          secondaryCta={{ text: "See Sample Calendars", href: "/portfolio/" }}
          imageSrc="/images/content-calendar-hero.webp"
          imageAlt="Website content calendar planning with publishing automation"
          theme="blue"
        />

        <!-- Answer-first block for the head query. A standalone, quotable
             definition sitting directly under the H1 — no heading, so the
             answer itself is the first thing Google reads. -->
        <section class="py-8 md:py-10 bg-white border-b border-blue-100">
          <div class="container-custom max-w-4xl text-left">
            <span class="inline-block bg-blue-100 text-blue-700 text-xs md:text-sm font-medium px-3 py-1 rounded-full mb-4">
              What is a content calendar?
            </span>
            <p class="text-base md:text-lg text-gray-700 leading-loose bg-blue-50/50 p-6 rounded-2xl border border-blue-100">
              <strong>A content calendar</strong> is a scheduled document specifying what content publishes when, on which channel and toward which goal. It unites website, blog, email newsletter and social feeds in a single plan, logging each row’s title, target keyword, format (article, video, carousel), owner, edit status and publish date. A content calendar removes day-to-day, last-minute publishing decisions, lets the team foresee seasonal content and campaigns, and keeps important topic clusters from slipping. It is usually written four weeks ahead and refreshed weekly against real page and post performance. Its practical output is a plan everyone works from — nothing ships without a date and an owner.
            </p>
          </div>
        </section>

        <!-- AEO Direct Answer Section -->
        <section class="py-10 bg-blue-50/60 border-y border-blue-100">
          <div class="container-custom max-w-4xl text-left">
            <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-3">
              What is a site content calendar, and how does it keep publishing consistent?
            </h2>
            <p class="text-base md:text-lg text-gray-700 leading-relaxed bg-white p-6 rounded-2xl shadow-xs border border-blue-100">
              <strong>A site content calendar</strong> is a scheduled roadmap stating which topics publish when, by which writer and toward which SEO or promotional goal across website and social feeds. Building it with publishing discipline and automation tooling cuts human error and wasted time, and guarantees every keyword in your Google Search Console topic clusters gets covered systematically.
            </p>
          </div>
        </section>

        <!-- Stats Section -->
        <ServiceStats lang="en" stats={stats} theme="blue" />

        <!-- Pillars Section -->
        <section class="section-padding">
          <div class="container-custom">
            <div class="text-center mb-12">
              <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
                The Four <span class="gradient-text">Core Pillars</span> of a Winning Content Calendar
              </h2>
              <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                A scientific, complete approach to organizing your brand’s content
              </p>
            </div>

            <div class="grid md:grid-cols-2 gap-8">
              {pillars.map((pillar, index) => (
                <Card class="hover:shadow-xl transition-all duration-300 group border-0 shadow-lg">
                  <CardHeader class="pb-4">
                    <div class="flex items-center gap-3 mb-3">
                      <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center group-hover:bg-blue-200 transition-colors">
                        <Icon name="target" class="h-6 w-6 text-blue-600" />
                      </div>
                      <CardTitle class="text-xl font-semibold">{pillar.pillar}</CardTitle>
                    </div>
                    <p class="text-gray-600">{pillar.description}</p>
                  </CardHeader>
                  <CardContent>
                    <div class="space-y-1">
                      {pillar.benefits.map((benefit, benefitIndex) => (
                        <div class="flex items-center gap-2 text-sm text-gray-500">
                          <Icon name="check-circle2" class="h-4 w-4 text-green-500 shrink-0" />
                          {benefit}
                        </div>
                      ))}
                    </div>
                  </CardContent>
                </Card>
              ))}
            </div>
          </div>
        </section>

        <!-- Content Strategies Section -->
        <section class="section-padding bg-linear-to-br from-slate-50 to-indigo-50">
          <div class="container-custom">
            <div class="text-center mb-12">
              <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
                Advanced <span class="gradient-text">Publishing</span> Strategies
              </h2>
              <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                Proven methods for maximum content impact and returns
              </p>
            </div>

            <div class="grid md:grid-cols-3 gap-8">
              {strategies.map((strategy, index) => (
                <Card class="hover:shadow-xl transition-all duration-300 group border-0 shadow-lg bg-white">
                  <CardHeader class="pb-4">
                    <div class="flex items-center gap-3 mb-3">
                      <div class="w-12 h-12 bg-indigo-100 rounded-lg flex items-center justify-center group-hover:bg-indigo-200 transition-colors">
                        <Icon name="calendar" class="h-6 w-6 text-indigo-600" />
                      </div>
                      <CardTitle class="text-xl font-semibold">{strategy.type}</CardTitle>
                    </div>
                    <p class="text-gray-600 mb-4">{strategy.description}</p>
                    <Badge class="mb-3 bg-green-100 text-green-800">{strategy.impact}</Badge>
                  </CardHeader>
                  <CardContent>
                    <div class="space-y-1">
                      {strategy.examples.map((example, exampleIndex) => (
                        <div class="flex items-center gap-2 text-sm text-gray-600">
                          <Icon name="badge-check" class="h-4 w-4 text-green-500 shrink-0" />
                          {example}
                        </div>
                      ))}
                    </div>
                  </CardContent>
                </Card>
              ))}
            </div>
          </div>
        </section>

        <!-- Features Section -->
        <section class="section-padding">
          <div class="container-custom">
            <div class="text-center mb-12">
              <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
                Complete <span class="gradient-text">Content Calendar Management</span> Services
              </h2>
              <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                Full coverage from strategy to execution and measurement
              </p>
            </div>

            <div class="grid md:grid-cols-2 gap-8">
              {features.map((feature, index) => (
                <Card class="hover:shadow-xl transition-all duration-300 group border-0 shadow-lg">
                  <CardHeader class="pb-4">
                    <div class="flex items-center gap-3 mb-3">
                      <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center group-hover:bg-blue-200 transition-colors">
                        <Icon name={feature.icon} class="h-6 w-6 text-blue-600" />
                      </div>
                      <CardTitle class="text-xl font-semibold">{feature.title}</CardTitle>
                    </div>
                  </CardHeader>
                  <CardContent>
                    <p class="text-gray-600 mb-4 leading-relaxed">
                      {feature.description}
                    </p>
                    <div class="space-y-2">
                      {feature.benefits.map((benefit, benefitIndex) => (
                        <div class="flex items-center gap-2 text-sm text-gray-500">
                          <Icon name="check-circle2" class="h-4 w-4 text-green-500 shrink-0" />
                          {benefit}
                        </div>
                      ))}
                    </div>
                  </CardContent>
                </Card>
              ))}
            </div>
          </div>
        </section>

        <!-- Tools Integration Section -->
        <section class="section-padding bg-slate-50">
          <div class="container-custom">
            <div class="text-center mb-12">
              <h2 class="text-3xl font-bold text-gray-900 mb-6">
                Integrated With <span class="gradient-text">Professional Tools</span>
              </h2>
              <p class="text-xl text-gray-600">
                Seamless connections to top content-management and automation tools
              </p>
            </div>

            <div class="max-w-4xl mx-auto space-y-6">
              {tools.map((tool, index) => (
                <Card class="hover:shadow-md transition-shadow">
                  <CardContent class="p-6">
                    <div class="flex items-start gap-4">
                      <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center shrink-0">
                        <Icon name="bar-chart3" class="h-8 w-8 text-blue-600" />
                      </div>
                      <div class="flex-1">
                        <h3 class="text-xl font-semibold text-gray-900 mb-2">
                          {tool.name}
                        </h3>
                        <p class="text-gray-600 mb-3">{tool.description}</p>
                        <div class="flex flex-wrap gap-2">
                          {tool.features.map((feature, featureIndex) => (
                            <Badge variant="outline" class="text-sm">
                              {feature}
                            </Badge>
                          ))}
                        </div>
                      </div>
                    </div>
                  </CardContent>
                </Card>
              ))}
            </div>
          </div>
        </section>

        <!-- Publishing automation — one H2 per zero-click query, each with a
             full answer rather than a stub. -->
        <section class="section-padding bg-white border-t border-gray-200/60">
          <div class="container-custom max-w-5xl">
            <div class="text-center mb-10">
              <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
                What Is <span class="gradient-text">Publishing Automation</span>?
              </h2>
              <p class="text-lg text-gray-600 leading-relaxed max-w-3xl mx-auto">
                The mechanical side of publishing — timing, destination and status logging — handed to systems so your content team spends its hours on topics and copy, not reminders and moving posts around.
              </p>
            </div>

            <div class="grid md:grid-cols-2 gap-6">
              {automationItems.map((item) => (
                <Card class="hover:shadow-md transition-shadow border-0 shadow-sm">
