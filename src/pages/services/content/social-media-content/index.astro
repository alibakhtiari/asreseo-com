    },
    {
      icon: "sparkles",
      title: 'Engagement Growth',
      description: 'Strategies that lift comments, likes and shares',
      benefits: ['Organic growth', 'Real followers', 'Loyal community']
    },
    {
      icon: "calendar",
      title: 'Smart Publishing Calendar',
      description: 'Posting schedules timed from analysis of your audience’s best hours',
      benefits: ['More reach per post', 'Steady engagement', 'Lasting page growth']
    }
  ];

  const contentStrategies = [
    {
      type: 'Trends & News',
      description: 'Covering the day’s news and hot topics to hold attention',
      examples: ['Industry news', 'Anniversaries', 'Global events']
    },
    {
