      icon: "users",
      color: 'blue'
    },
    {
      name: 'Telegram',
      description: 'Instant messaging, news and direct audience contact',
      followers: 'Monthly tracking',
      engagement: 'Weekly reports',
      icon: "message-square",
      color: 'blue'
    },
    {
      name: 'X (Twitter)',
      description: 'Media buzz, fast news and trend-setting',
      followers: 'Monthly tracking',
