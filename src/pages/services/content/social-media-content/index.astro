const breadcrumbs = [
    { position: 1, name: 'Home', item: 'https://asreseo.com/' },
    { position: 2, name: 'Content Services', item: 'https://asreseo.com/services/content/' },
    { position: 3, name: 'Social Media Content', item: 'https://asreseo.com/services/content/social-media-content/' },
  ];

---
<BaseLayout lang="en" title='Social Media Content Production | AsreSEO' description='Full-service social content: creative ideation, engaging captions, beautiful graphics, publishing calendars and engagement strategy across 5 major platforms.' keywords='social media content, social content, Instagram, Telegram, LinkedIn, X, creative ideation' canonical='/services/content/social-media-content/' ogType='website' ogUrl='https://asreseo.com/services/content/social-media-content/' ogImages={[{ url: "/og/social-media-content-hero.jpg", width: 1200, height: 630, alt: "Social media content | AsreSEO" }]} twitterCard='summary_large_image'
  ogTitle='Social Media Content | Professional Production | AsreSEO'

  ogDescription='Ideation, production and management of social content to grow your brand.'
>
<div class="min-h-screen bg-[#000000] text-slate-100 wireframe-grid">
      <script id="structured-data" type="application/ld+json" is:inline
        set:html={JSON.stringify(withServiceMeta(structuredData, { url: 'https://asreseo.com/services/content/social-media-content/', image: '/og/social-media-content-hero.jpg' }))}
      />

      <Header lang="en" />
      <BreadcrumbStructuredData items={breadcrumbs} />

      <main>
        <ServiceHero
          lang="en"
          badge="Professional Social Media Content"
          title="Social Media Content"
          titleHighlight="Social Media"
          description="Creative ideation, compelling captions and engagement strategy for lasting page growth — from Instagram to LinkedIn, build a powerful presence."
          primaryCtaText="Start Your Content Strategy"
          secondaryCtaText="Free Social Media Consultation"
          imageSrc="/images/social-media-content-hero.webp"
          imageAlt="Professional social media content"
          theme="pink"
        />

        <ServiceStats lang="en" stats={stats} />

        <!-- Platforms Section -->
        <section class="section-padding">
          <div class="container-custom">
            <div class="text-center mb-12">
              <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
                Coverage Across <span class="gradient-text">5 Major Platforms</span>
              </h2>
              <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                A dedicated strategy per platform for the best returns and ROI
              </p>
            </div>

            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
              {platforms.map((platform, index) => (
                <Card class="hover:shadow-xl transition-all duration-300 group animate-fade-in border-0 shadow-lg">
                  <CardHeader class="pb-4">
                    <div class="flex items-center gap-3 mb-3">
                      <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center group-hover:bg-purple-200 transition-colors">
                        <Icon name={platform.icon} class="h-6 w-6 text-purple-600" />
                      </div>
                      <div>
                        <CardTitle class="text-xl font-semibold">{platform.name}</CardTitle>
                        <div class="flex gap-4 mt-2 text-sm">
                          <span class="text-green-800 font-medium">{platform.followers} followers</span>
                          <span class="text-blue-600 font-medium">{platform.engagement} engagement</span>
                        </div>
                      </div>
                    </div>
                  </CardHeader>
                  <CardContent>
                    <p class="text-gray-600 leading-relaxed">
                      {platform.description}
                    </p>
                  </CardContent>
                </Card>
              ))}
            </div>
          </div>
        </section>

        <!-- Content Strategies Section -->
        <section class="section-padding bg-linear-to-br from-slate-50 to-indigo-50">
          <div class="container-custom">
            <div class="text-center mb-12">
              <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
                Effective <span class="gradient-text">Content Strategies</span>
              </h2>
              <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                A mix of modern strategies for maximum engagement and page growth
              </p>
            </div>

            <div class="grid md:grid-cols-2 gap-8">
              {contentStrategies.map((strategy, index) => (
                <Card class="hover:shadow-xl transition-all duration-300 group border-0 shadow-lg bg-white">
                  <CardHeader class="pb-4">
                    <div class="flex items-center gap-3 mb-3">
                      <div class="w-12 h-12 bg-indigo-100 rounded-lg flex items-center justify-center group-hover:bg-indigo-200 transition-colors">
                        <Icon name="target" class="h-6 w-6 text-indigo-600" />
                      </div>
                      <CardTitle class="text-xl font-semibold">{strategy.type}</CardTitle>
                    </div>
                    <p class="text-gray-600 mb-4">{strategy.description}</p>
                  </CardHeader>
                  <CardContent>
                    <div class="space-y-1">
                      {strategy.examples.map((example, exampleIndex) => (
                        <div class="flex items-center gap-2 text-sm text-gray-500">
                          <Icon name="badge-check" class="h-4 w-4 text-green-500 shrink-0" />
                          {example}
                        </div>
                      ))}
                    </div>
                  </CardContent>
                </Card>
              ))}
            </div>
          </div>
        </section>

        <!-- Features Section -->
        <section class="section-padding">
          <div class="container-custom">
            <div class="text-center mb-12">
              <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
                Creative <span class="gradient-text">Social Media Services</span>
              </h2>
              <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                From ideation to publishing — full coverage of social content
              </p>
            </div>

            <div class="grid md:grid-cols-2 gap-8">
              {features.map((feature, index) => (
                <Card class="hover:shadow-xl transition-all duration-300 group border-0 shadow-lg">
                  <CardHeader class="pb-4">
                    <div class="flex items-center gap-3 mb-3">
                      <div class="w-12 h-12 bg-pink-100 rounded-lg flex items-center justify-center group-hover:bg-pink-200 transition-colors">
                        <Icon name={feature.icon} class="h-6 w-6 text-pink-600" />
                      </div>
                      <CardTitle class="text-xl font-semibold">{feature.title}</CardTitle>
                    </div>
                  </CardHeader>
                  <CardContent>
                    <p class="text-gray-600 mb-4 leading-relaxed">
                      {feature.description}
                    </p>
                    <div class="space-y-2">
                      {feature.benefits.map((benefit, benefitIndex) => (
                        <div class="flex items-center gap-2 text-sm text-gray-500">
                          <Icon name="badge-check" class="h-4 w-4 text-green-500 shrink-0" />
                          {benefit}
                        </div>
                      ))}
                    </div>
                  </CardContent>
                </Card>
              ))}
            </div>
          </div>
        </section>

        <ServiceBenefits
          lang="en"
          title="Benefits of Professional"
          titleHighlight="Social Content"
          subtitle="Strong social media is the key to modern digital marketing success"
          benefits={benefits}
          iconColorClass="text-pink-600"
          iconBgClass="bg-pink-100"
        />

        <ServiceWorkflow
          lang="en"
          title="The AsreSEO Social Media"
          titleHighlight="Process"
          subtitle="A scientific 4-step approach to content that truly delivers"
          steps={workflowSteps}
          themeColor="pink"
        />

        <ServiceFAQ
          lang="en"
          title="Frequently Asked Questions"
          highlightWord="Questions"
          subtitle="Answers to common client questions about social content"
          faqs={faqs}
        />

        <ServiceCTA
          lang="en"
          title="Fill Your Feed With Creative Ideas — Starting Today!"
          description="From creative ideation to smart publishing strategy, AsreSEO social content services will turn your page into a social media star."
          primaryText="Start Social Content"
          secondaryText="See Our Content Samples"
          primaryClass="bg-pink-600 hover:bg-pink-700 text-white font-semibold shadow-lg shadow-pink-600/30"
        />
      </main>

      <Footer lang="en" />
    </div>
</BaseLayout>
