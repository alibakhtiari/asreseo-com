      engagement: 'Weekly reports',
      icon: "trending-up",
      color: 'black'
    }
  ];

  const features = [
    {
      icon: "share2",
      title: 'Creative Ideation',
      description: 'Original, goal-driven ideas matched to your brand identity on every platform',
      benefits: ['Boundless creativity', 'Competitive edge', 'High appeal']
    },
    {
      icon: "message-square",
      title: 'Professional Captions',
      description: 'Impactful copy with strategic hashtags and powerful calls to action',
