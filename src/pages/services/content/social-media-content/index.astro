const breadcrumbs = [
    { position: 1, name: 'خانه', item: 'https://asreseo.com/' },
    { position: 2, name: 'خدمات محتوا', item: 'https://asreseo.com/services/content/' },
    { position: 3, name: 'محتوای شبکه‌های اجتماعی', item: 'https://asreseo.com/services/content/social-media-content/' },
  ];

---
<BaseLayout title='تولید محتوای شبکه‌های اجتماعی | عصر سئو' description='خدمات کامل تولید محتوای شبکه اجتماعی شامل ایده‌پردازی خلاقانه، کپشن جذاب، گرافیک زیبا، تقویم انتشار و استراتژی تعامل‌سازی برای ۵ پلتفرم اصلی.' keywords='محتوای شبکه‌های اجتماعی, سوشال مدیا کانتنت, اینستاگرام, تلگرام, لینکدین, توییتر, ایده‌پردازی خلاقانه' canonical='https://asreseo.com/services/content/social-media-content/' ogType='website' ogUrl='https://asreseo.com/services/content/social-media-content/' ogImages={[{ url: "/images/social-media-content-hero.webp", width: 1200, height: 630, alt: "محتوای شبکه‌های اجتماعی | عصر سئو" }]} twitterCard='summary_large_image'
  ogTitle='محتوای شبکه‌های اجتماعی | تولید محتوا حرفه‌ای | عصر سئو'

  ogDescription='ایده‌پردازی، تولید و مدیریت محتوای شبکه‌های اجتماعی برای رشد برند شما.'
>
<div class="min-h-screen bg-white">
      <script id="structured-data" type="application/ld+json" is:inline
        set:html={JSON.stringify(structuredData)}
      />

      <Header />
      <BreadcrumbStructuredData items={breadcrumbs} />

      <main>
        <ServiceHero
          badge="محتوای شبکه‌های اجتماعی حرفه‌ای"
          title="محتوای شبکه‌های اجتماعی"
          titleHighlight="شبکه‌های اجتماعی"
          description="قدرت ایده‌پردازی خلاقانه، کپشن جذاب و استراتژی تعامل‌سازی برای رشد ۵۰۰% پیج شما در شبکه‌های اجتماعی. از اینستاگرام تا لینکدین، حضور قدرتمند برقرار کنید."
          primaryCtaText="شروع استراتژی محتوایی"
          secondaryCtaText="مشاوره رایگان سوشال مدیا"
          imageSrc="/images/social-media-content-hero.webp"
          imageAlt="محتوای شبکه‌های اجتماعی حرفه‌ای"
          theme="pink"
        />

        <ServiceStats
          stats={stats}
          gradientClass="bg-linear-to-r from-purple-50 to-pink-50"
          metricColorClass="text-purple-700"
          iconColorClass="text-pink-600"
        />

        <!-- Platforms Section -->
        <section class="section-padding">
          <div class="container-custom">
            <div class="text-center mb-12">
              <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
                پوشش <span class="gradient-text">۵ پلتفرم اصلی</span>
              </h2>
              <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                استراتژی اختصاصی برای هر پلتفرم با بهترین بازدهی و ROI ممکن
              </p>
            </div>

            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
              {platforms.map((platform, index) => (
                <Card class="hover:shadow-xl transition-all duration-300 group animate-fade-in border-0 shadow-lg">
                  <CardHeader class="pb-4">
                    <div class="flex items-center gap-3 mb-3">
                      <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center group-hover:bg-purple-200 transition-colors">
                        <Icon name={platform.icon} class="h-6 w-6 text-purple-600" />
                      </div>
                      <div>
                        <CardTitle class="text-xl font-semibold">{platform.name}</CardTitle>
                        <div class="flex gap-4 mt-2 text-sm">
                          <span class="text-green-800 font-medium">{platform.followers} فالوور</span>
                          <span class="text-blue-600 font-medium">{platform.engagement} تعامل</span>
                        </div>
                      </div>
                    </div>
                  </CardHeader>
                  <CardContent>
                    <p class="text-gray-600 leading-relaxed">
                      {platform.description}
                    </p>
                  </CardContent>
                </Card>
              ))}
            </div>
          </div>
        </section>

        <!-- Content Strategies Section -->
        <section class="section-padding bg-linear-to-br from-slate-50 to-indigo-50">
          <div class="container-custom">
            <div class="text-center mb-12">
              <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
                استراتژی‌های <span class="gradient-text">محتوایی اثربخش</span>
              </h2>
              <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                ترکیبی از استراتژی‌های مدرن برای حداکثر تعامل و رشد پیج شما
              </p>
            </div>

            <div class="grid md:grid-cols-2 gap-8">
              {contentStrategies.map((strategy, index) => (
                <Card class="hover:shadow-xl transition-all duration-300 group border-0 shadow-lg bg-white">
                  <CardHeader class="pb-4">
                    <div class="flex items-center gap-3 mb-3">
                      <div class="w-12 h-12 bg-indigo-100 rounded-lg flex items-center justify-center group-hover:bg-indigo-200 transition-colors">
                        <Icon name="target" class="h-6 w-6 text-indigo-600" />
                      </div>
                      <CardTitle class="text-xl font-semibold">{strategy.type}</CardTitle>
                    </div>
                    <p class="text-gray-600 mb-4">{strategy.description}</p>
                  </CardHeader>
                  <CardContent>
                    <div class="space-y-1">
                      {strategy.examples.map((example, exampleIndex) => (
                        <div class="flex items-center gap-2 text-sm text-gray-500">
                          <Icon name="badge-check" class="h-4 w-4 text-green-500 shrink-0" />
                          {example}
                        </div>
                      ))}
                    </div>
                  </CardContent>
                </Card>
              ))}
            </div>
          </div>
        </section>

        <!-- Features Section -->
        <section class="section-padding">
          <div class="container-custom">
            <div class="text-center mb-12">
              <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
                خدمات <span class="gradient-text">سوشال مدیا خلاقانه</span>
              </h2>
              <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                از ایده‌پردازی تا انتشار، پوشش کامل تمام جوانب محتوای شبکه اجتماعی
              </p>
            </div>

            <div class="grid md:grid-cols-2 gap-8">
              {features.map((feature, index) => (
                <Card class="hover:shadow-xl transition-all duration-300 group border-0 shadow-lg">
                  <CardHeader class="pb-4">
                    <div class="flex items-center gap-3 mb-3">
                      <div class="w-12 h-12 bg-pink-100 rounded-lg flex items-center justify-center group-hover:bg-pink-200 transition-colors">
                        <Icon name={feature.icon} class="h-6 w-6 text-pink-600" />
                      </div>
                      <CardTitle class="text-xl font-semibold">{feature.title}</CardTitle>
                    </div>
                  </CardHeader>
                  <CardContent>
                    <p class="text-gray-600 mb-4 leading-relaxed">
                      {feature.description}
                    </p>
                    <div class="space-y-2">
                      {feature.benefits.map((benefit, benefitIndex) => (
                        <div class="flex items-center gap-2 text-sm text-gray-500">
                          <Icon name="badge-check" class="h-4 w-4 text-green-500 shrink-0" />
                          {benefit}
                        </div>
                      ))}
                    </div>
                  </CardContent>
                </Card>
              ))}
            </div>
          </div>
        </section>

        <ServiceBenefits
          title="مزایای محتوای شبکه اجتماعی حرفه‌ای"
          titleHighlight="شبکه اجتماعی حرفه‌ای"
          subtitle="سوشال مدیا قدرتمند، کلید موفقیت مارکتینگ دیجیتال مدرن است"
          benefits={benefits}
          iconColorClass="text-pink-600"
          iconBgClass="bg-pink-100"
        />

        <ServiceWorkflow
          title="فرآیند سوشال مدیا عصر سئو"
          titleHighlight="سوشال مدیا عصر سئو"
          subtitle="رویکرد علمی ۴ مرحله‌ای برای محتوایی که واقعاً نتیجه می‌دهد"
          steps={workflowSteps}
          themeColor="pink"
        />

        <ServiceFAQ
          title="سوالات متداول"
          highlightWord="متداول"
          subtitle="پاسخ به پرسش‌های رایج مشتریان درباره محتوای شبکه اجتماعی"
          faqs={faqs}
        />

        <ServiceCTA
          title="پیج شما همین امروز پر از ایده خلاقانه شود!"
          description="با خدمات محتوای شبکه‌های اجتماعی عصر سئو، از ایده‌پردازی خلاقانه تا استراتژی انتشار هوشمند، پیج شما را به ستاره رسانه‌های اجتماعی تبدیل خواهیم کرد."
          primaryText="شروع محتوای سوشال مدیا"
          secondaryText="نمونه محتواهای ما را ببینید"
          primaryClass="bg-pink-600 hover:bg-pink-700 text-white"
        />
      </main>

      <Footer />
    </div>
</BaseLayout>
