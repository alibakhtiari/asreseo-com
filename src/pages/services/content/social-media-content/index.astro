  ];

  // Qualitative process facts, not performance percentages — client-result
  // percentages are unverifiable (see src/lib/site-claims.ts authenticity policy).
  const stats = [
    { metric: 'Monthly', label: 'Follower reports', color: 'text-pink-600', icon: "users" },
    { metric: 'Weekly', label: 'Audience engagement reports', color: 'text-green-800', icon: "heart" },
    { metric: 'Periodic', label: 'Performance reports', color: 'text-blue-600', icon: "trending-up" },
