                        <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-3">
                            اعتبار صفحه (Page Authority) چیست و چه تفاوتی با اعتبار دامنه دارد؟
                        </h2>
                        <p class="text-base md:text-lg text-gray-700 leading-relaxed bg-white p-6 rounded-2xl shadow-xs border border-amber-100">
                            <strong>اعتبار صفحه (Page Authority یا PA)</strong> شاخصی عددی است که توانایی یک صفحه مشخص از وب‌سایت را برای کسب رتبه در نتایج موتور جستجو ارزیابی می‌کند. در حالی که اعتبار دامنه (Domain Authority) قدرت کل وب‌سایت را می‌سنجد، اعتبار صفحه بر کیفیت محتوای همان صفحه، لینک‌های داخلی هدایت‌شده به آن و بک‌لینک‌های معتبر خارجی ورودی به همان URL متمرکز است. در عصر سئو با پیاده‌سازی معماری تاپیکال آتوریتی و لینک‌سازی هدفمند، اعتبار صفحات کلیدی لندینگ و مقالات شما ارتقا یافته و جایگاه این صفحات در نتایج جستجو بهبود می‌یابد.
                        </p>
                    </div>
                </section>

                <!-- Stats Section -->
                <ServiceStats stats={stats} theme="amber" />

                <!-- Content Services Section -->
                <section class="section-padding">
                    <div class="container-custom">
                        <div class="text-center mb-12">
                            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
                                خدمات <span class="gradient-text">سئو محتوا</span> (Content SEO)
                            </h2>
                            <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                                تولید محتوایی که هم برای کاربر جذاب است و هم برای موتورهای جستجو بهینه شده است
                            </p>
                        </div>

                        <div class="grid md:grid-cols-2 gap-8">
                            {contentServices.map((service, index) => (
                                <Card class="hover:shadow-xl transition-all duration-300 group animate-fade-in border-0 shadow-lg">
                                    <CardHeader class="pb-4">
                                        <div class="flex items-center gap-3 mb-3">
                                            <div class="w-12 h-12 bg-amber-100 rounded-lg flex items-center justify-center group-hover:bg-amber-200 transition-colors">
                                                <Icon name={service.icon} class="h-6 w-6 text-amber-600" />
                                            </div>
                                            <CardTitle class="text-xl font-semibold">{service.title}</CardTitle>
                                        </div>
                                    </CardHeader>
                                    <CardContent>
                                        <p class="text-gray-600 mb-4 leading-relaxed">
                                            {service.description}
                                        </p>
                                        <div class="space-y-2">
                                            {service.benefits.map((benefit, benefitIndex) => (
                                                <div class="flex items-center gap-2 text-sm text-gray-500">
                                                    <Icon name="check-circle" class="h-4 w-4 text-green-500 shrink-0" />
                                                    {benefit}
                                                </div>
                                            ))}
                                        </div>
                                    </CardContent>
                                </Card>
                            ))}
                        </div>
                    </div>
                </section>

                <!-- Authority Services Section -->
                <section class="section-padding bg-slate-50">
                    <div class="container-custom">
                        <div class="text-center mb-12">
                            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
                                خدمات <span class="gradient-text">لینک‌سازی و اعتبار</span> (Authority)
                            </h2>
                            <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                                افزایش اعتبار دامنه شما نزد گوگل با استراتژی‌های لینک‌سازی امن و مؤثر
                            </p>
                        </div>

                        <div class="grid md:grid-cols-2 gap-8">
                            {authorityServices.map((service, index) => (
                                <Card class="hover:shadow-xl transition-all duration-300 group animate-fade-in border-0 shadow-lg bg-white">
                                    <CardHeader class="pb-4">
                                        <div class="flex items-center gap-3 mb-3">
                                            <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center group-hover:bg-purple-200 transition-colors">
                                                <Icon name={service.icon} class="h-6 w-6 text-purple-600" />
                                            </div>
                                            <CardTitle class="text-xl font-semibold">{service.title}</CardTitle>
                                        </div>
                                    </CardHeader>
                                    <CardContent>
                                        <p class="text-gray-600 mb-4 leading-relaxed">
                                            {service.description}
                                        </p>
                                        <div class="space-y-2">
                                            {service.benefits.map((benefit, benefitIndex) => (
                                                <div class="flex items-center gap-2 text-sm text-gray-500">
                                                    <Icon name="check-circle" class="h-4 w-4 text-green-500 shrink-0" />
                                                    {benefit}
                                                </div>
                                            ))}
                                        </div>
                                    </CardContent>
                                </Card>
                            ))}
                        </div>
                    </div>
                </section>

                <!-- Content Types Section -->
                <section class="section-padding bg-linear-to-br from-slate-50 to-indigo-50">
                    <div class="container-custom">
                        <div class="text-center mb-12">
                            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
                                انواع <span class="gradient-text">محتوای استراتژیک</span>
                            </h2>
                            <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                                ما برای هر مرحله از قیف فروش، محتوای مناسب تولید می‌کنیم
                            </p>
                        </div>

                        <div class="grid md:grid-cols-2 gap-8">
                            {contentTypes.map((type, index) => (
                                <Card class="hover:shadow-xl transition-all duration-300 group border-0 shadow-lg bg-white">
                                    <CardHeader class="pb-4">
                                        <div class="flex items-center gap-3 mb-3">
                                            <div class="w-12 h-12 bg-indigo-100 rounded-lg flex items-center justify-center group-hover:bg-indigo-200 transition-colors">
                                                <Icon name={type.icon} class="h-6 w-6 text-indigo-600" />
                                            </div>
                                            <CardTitle class="text-xl font-semibold">{type.title}</CardTitle>
                                        </div>
                                        <p class="text-gray-600 mb-4">{type.description}</p>
                                    </CardHeader>
                                    <CardContent>
                                        <div class="space-y-1">
                                            {type.features.map((feature, featureIndex) => (
                                                <div class="flex items-center gap-2 text-sm text-gray-500">
                                                    <Icon name="check-circle" class="h-4 w-4 text-green-500 shrink-0" />
                                                    {feature}
                                                </div>
                                            ))}
                                        </div>
                                    </CardContent>
                                </Card>
                            ))}
                        </div>
                    </div>
                </section>

                <!-- Factor checklist. The audit asked for a page-authority factor
                     image on this page (query «اعتبار صفحه», 18 impr / pos 63.7).
                     The asset already existed but was only used by the blog post,
                     so it is reused here. Native width/height set to avoid CLS. -->
                <section class="section-padding bg-slate-50 border-t border-gray-200/60">
                    <div class="container-custom max-w-4xl">
                        <div class="text-center mb-8">
                            <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-3">
                                چک‌لیست عوامل موثر بر اعتبار صفحه
                            </h2>
                            <p class="text-gray-600">
                                فهرست مواردی که در هر ممیزی اعتبار صفحه بررسی و امتیازدهی می‌شود
                            </p>
                        </div>
                        <img
                            src="/images/content-authority-post-checklist.webp"
                            alt="چک‌لیست عوامل موثر بر اعتبار صفحه شامل کیفیت محتوا، لینک‌سازی داخلی، سیگنال‌های تجربه کاربر و اعتبار منابع"
                            width="1672"
                            height="941"
                            loading="lazy"
                            decoding="async"
                            class="w-full h-auto rounded-2xl shadow-xs border border-gray-200"
                        />
                    </div>
                </section>

                <!-- Commercial half of the page: process, deliverables and reporting.
                     The definitional half (factors, checklist) lives in
                     /blog/page-authority-guide/ and is linked above. -->
                <section class="section-padding bg-white border-t border-gray-200/60">
                    <div class="container-custom max-w-5xl">
                        <div class="text-center mb-10">
                            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
                                فرآیند <span class="gradient-text">افزایش اعتبار صفحه</span> در عصر سئو
                            </h2>
                            <p class="text-lg text-gray-600 leading-relaxed max-w-3xl mx-auto">
                                افزایش اعتبار صفحه کار یک‌باره نیست؛ برنامه‌ای ماهانه است که اول صفحات هدف را مشخص می‌کند، سپس سه لایه کار (محتوا، لینک داخلی، بک‌لینک) را روی همان صفحات اجرا می‌کند و در پایان ماه با شما مرور می‌شود. پنج مرحله دارد:
                            </p>
                        </div>

                        <div class="space-y-5">
                            {processSteps.map((item, index) => (
                                <div class="flex items-start gap-5 p-5 bg-white rounded-xl shadow-xs border border-amber-100">
                                    <span class="w-10 h-10 rounded-full bg-amber-100 text-amber-800 flex items-center justify-center text-base font-bold shrink-0">
                                        {index + 1}
                                    </span>
                                    <div class="flex-1">
                                        <h3 class="text-lg font-semibold text-gray-900 mb-1">
                                            {item.step}
                                        </h3>
                                        <p class="text-gray-600 leading-relaxed text-sm md:text-base">
                                            {item.desc}
                                        </p>
                                    </div>
                                </div>
                            ))}
                        </div>
                    </div>
                </section>

                <section class="section-padding bg-slate-50 border-t border-gray-200/60">
                    <div class="container-custom max-w-5xl">
                        <div class="text-center mb-10">
                            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
                                خروجی‌های قابل تحویل <span class="gradient-text">پروژه اعتبار صفحه</span>
                            </h2>
                            <p class="text-lg text-gray-600 leading-relaxed max-w-3xl mx-auto">
                                در پایان هر مرحله و هر ماه، چیز مشخصی به دست شما می‌رسد — سند، فهرست یا گزارشی که می‌توانید باز کنید و بررسی کنید، نه صرفاً گزارش «در حال انجام».
                            </p>
                        </div>

                        <div class="grid md:grid-cols-2 gap-6">
                            {deliverables.map((item) => (
                                <Card class="hover:shadow-md transition-shadow border-0 shadow-sm bg-white">
                                    <CardContent class="p-6">
                                        <div class="flex items-start gap-4">
                                            <div class="w-11 h-11 bg-amber-100 rounded-lg flex items-center justify-center shrink-0">
                                                <Icon name={item.icon} class="h-5 w-5 text-amber-700" />
                                            </div>
                                            <div>
                                                <h3 class="text-lg font-semibold text-gray-900 mb-2">
                                                    {item.title}
                                                </h3>
                                                <p class="text-gray-600 leading-relaxed text-sm md:text-base">
                                                    {item.description}
                                                </p>
                                            </div>
                                        </div>
                                    </CardContent>
                                </Card>
                            ))}
                        </div>
                    </div>
                </section>

                <section class="section-padding bg-white border-t border-gray-200/60">
                    <div class="container-custom max-w-4xl">
                        <div class="text-center mb-8">
                            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
                                پیشرفت <span class="gradient-text">افزایش اعتبار صفحه</span> را چگونه گزارش می‌دهیم؟
                            </h2>
                            <p class="text-lg text-gray-600 leading-relaxed max-w-3xl mx-auto">
                                پیشرفت را با ادعای درصدی نشان نمی‌دهیم؛ هر گزارش بر اساس داده‌هایی تنظیم می‌شود که خودتان هم می‌توانید در همان ابزارها ببینید. ماهانه پنج دسته اطلاعات روی میز است:
                            </p>
                        </div>

                        <div class="max-w-3xl mx-auto space-y-3">
                            {reportSignals.map((signal) => (
                                <div class="flex items-start gap-3 bg-amber-50/60 border border-amber-100 rounded-xl p-4">
                                    <Icon name="check-circle" class="h-5 w-5 text-green-600 shrink-0 mt-0.5" />
                                    <span class="text-gray-700 leading-relaxed text-sm md:text-base">
                                        {signal}
                                    </span>
                                </div>
                            ))}
                        </div>

                        <p class="max-w-3xl mx-auto mt-7 text-center text-gray-600 leading-relaxed">
                            گزارش ماهانه در جلسه کوتاهی مرور می‌شود و اولویت‌های ماه بعد در همان جلسه تعیین می‌گردد؛ هر عددی هم در گزارش باشد، منبع آن کنارش نوشته می‌شود تا خودتان بتوانید راستی‌آزمایی کنید.
                        </p>
                    </div>
                </section>

                <!-- FAQ Section -->
                <ServiceFAQ
                    faqs={faqs}
                    title="سوالات متداول"
                    description="پاسخ به سوالات شما درباره محتوا و لینک‌سازی"
                    theme="amber"
                />

                <!-- CTA Section -->
                <ServiceCTA
                    title="صدای برند خود را به گوش همه برسانید!"
                    description="با محتوای قدرتمند و اعتبار دامنه بالا، جایگاه خود را در صدر نتایج گوگل تثبیت کنید. ما استراتژی، تولید و توزیع را برای شما انجام می‌دهیم."
                    primaryCta={{ text: "شروع کمپین محتوایی", href: "/consultation/" }}
                    secondaryCta={{ text: "مشاوره رایگان", href: "/consultation/" }}
                    theme="amber"
                />
            </main>

            <Footer />
        </div>
</BaseLayout>
