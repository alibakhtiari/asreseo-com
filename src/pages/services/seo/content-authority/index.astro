---
import { withServiceMeta } from '../../../../lib/service-schema';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Header from '../../../../components/Layout/Header.astro';
import Footer from '../../../../components/Layout/Footer.astro';
import Card from '../../../../components/ui/card/Card.astro';
import CardContent from '../../../../components/ui/card/CardContent.astro';
import CardHeader from '../../../../components/ui/card/CardHeader.astro';
import CardTitle from '../../../../components/ui/card/CardTitle.astro';
import Badge from '../../../../components/ui/badge/Badge.astro';
import Icon from '../../../../components/ui/Icon.astro';
import ServiceHero from '../../../../components/Services/ServiceHero.astro';
import ServiceStats from '../../../../components/Services/ServiceStats.astro';
import ServiceFAQ from '../../../../components/Services/ServiceFAQ.astro';
import ServiceCTA from '../../../../components/Services/ServiceCTA.astro';
import BreadcrumbStructuredData from '../../../../components/BreadcrumbStructuredData.astro';
import Picture from '../../../../components/ui/Picture.astro';





const structuredData = {
    '@context': 'https://schema.org',
    '@type': 'Service',
    'name': 'Page & Domain Authority Growth with Content SEO',
    'description': 'Specialized services for growing Page Authority and domain authority with topical authority strategy and principled link building.',
    'serviceType': 'SEO Content & Page Authority Optimization',
    'provider': {
        '@type': 'Organization',
        'name': 'AsreSEO',
        'url': 'https://asreseo.com'
    },
    'inLanguage': 'en-US',
    'hasOfferCatalog': {
        '@type': 'OfferCatalog',
        'name': 'Content SEO & Authority Services',
        'itemListElement': [
            {
                '@type': 'Offer',
                'itemOffered': {
                    '@type': 'Service',
                    'name': 'Page Authority Growth',
                    'description': 'A strategy for lifting page authority with valuable content and structured link building'
                }
            },
            {
                '@type': 'Offer',
                'itemOffered': {
                    '@type': 'Service',
                    'name': 'Topical Authority Strategy',
                    'description': 'Full coverage of content topic clusters to outperform competitors'
                }
            },
            {
                '@type': 'Offer',
                'itemOffered': {
                    '@type': 'Service',
                    'name': 'Outreach Link Building & Sponsored Content',
                    'description': 'Earning quality white-hat backlinks from reputable publishers'
                }
            }
        ]
    }
};



    const contentServices = [
        {
            icon: "edit3",
            title: 'SEO-Driven Content Production',
            description: 'In-depth, practical articles that solve real user needs and are optimized for Google.',
            benefits: ['Organic traffic growth', 'Longer user dwell time', 'Answering real user needs']
        },
        {
            icon: "trending-up",
            title: 'Topical Authority Strategy',
            description: 'Comprehensive coverage of every subtopic in your business to prove expertise to Google.',
            benefits: ['Market leadership', 'Faster rankings', 'Google\u2019s trust']
        },
        {
            icon: "search",
            title: 'Semantic Keyword Research',
            description: 'Beyond plain keywords \u2014 focusing on user intent and related concepts.',
            benefits: ['Precise targeting', 'Higher conversion rate', 'Full topic coverage']
        },
        {
            icon: "align-justify",
            title: 'Existing Content Optimization',
            description: 'Updating and enriching older articles to win back lost rankings.',
            benefits: ['Fast traffic growth', 'Leveraging existing assets', 'Improved content freshness']
        }
    ];

    const authorityServices = [
        {
            icon: "link",
            title: 'External Link Building',
            description: 'Earning quality backlinks from reputable sites relevant to your industry.',
            benefits: ['Higher domain authority', 'Better hard-keyword rankings', 'Referral traffic']
        },
        {
            icon: "file-text",
            title: 'Targeted Sponsored Content',
            description: 'Publishing your news and articles in major outlets for branding and SEO.',
            benefits: ['Strong branding', 'Permanent links', 'Audience trust']
        },
        {
            icon: "shield",
            title: 'Link Profile Management',
            description: 'Continuous backlink monitoring and disavowing spammy links to prevent penalties.',
            benefits: ['Site security', 'Penalty prevention', 'Healthy domain']
        },
        {
            icon: "target",
            title: 'Advanced Internal Linking',
            description: 'Designing your internal link structure to spread link equity across every page.',
            benefits: ['Better indexing', 'Stronger pages', 'Better navigation']
        }
    ];

    const contentTypes = [
        {
            title: 'In-Depth Expert Articles',
            description: 'Deep, technical pieces that attract professional buyers',
            features: ['Comprehensive topic coverage', 'Charts and reader-friendly visuals', 'Strong call to action'],
            icon: "file-text",
            color: 'blue'
        },
        {
            title: 'Practical How-To Guides',
            description: 'Step-by-step tutorials that solve user problems',
            features: ['Step-by-step walkthroughs', 'Real-world examples', 'Optimized to rank'],
            icon: "book-open",
            color: 'green'
        },
        {
            title: 'Case Studies',
            description: 'Showcasing real results from successful projects',
            features: ['Client-aligned stories', 'Real numbers and stats', 'High trust-building'],
            icon: "target",
            color: 'purple'
        },
        {
            title: 'Trend Coverage',
            description: 'Covering breaking news and hot topics',
            features: ['Fast turnaround', 'Viral marketing potential', 'Instant traffic'],
            icon: "trending-up",
            color: 'orange'
        }
    ];

    // Qualitative process facts, not performance percentages — no invented
    // traffic/CVR figures (see src/lib/site-claims.ts authenticity policy).
    const stats = [
        { metric: '5 steps', label: 'Documented delivery process', color: 'text-amber-600', icon: "list-todo" },
        { metric: '3 layers', label: 'Content, internal links, backlinks', color: 'text-purple-600', icon: "layers" },
        { metric: 'Monthly', label: 'Verifiable progress reports', color: 'text-green-800', icon: "bar-chart3" },
        { metric: 'White-hat', label: 'Link building & sponsored content', color: 'text-blue-600', icon: "check-circle" }
    ];

    // Commercial half of the /services/seo/content-authority ↔ /blog/page-authority-guide
    // split: this page answers how the engagement runs, what is delivered and how
    // progress is reported. Deliberately qualitative — no invented percentages,
    // DA/PA figures or client numbers (see src/lib/site-claims.ts).
    const processSteps = [
        {
            step: 'Target-page audit',
            desc: 'Deciding which pages \u2014 landing pages and key articles \u2014 should gain authority, and reviewing each one\u2019s current internal links, content and backlinks.'
        },
        {
            step: 'Internal link architecture',
            desc: 'Mapping link paths from your strongest pages to target pages, fixing anchors and adding missing links to sections left unlinked.'
        },
        {
            step: 'Target-page content upgrade',
            desc: 'Rewriting and completing each page around real search queries: heading structure, subtopic coverage and structured data.'
        },
        {
            step: 'Targeted external link building',
            desc: 'Sponsored content and content partnerships only with relevant, reputable outlets in your niche, plus monitoring inbound links and dropping low-quality ones.'
        },
        {
            step: 'Monthly tracking & reporting',
            desc: 'Monitoring target-page positions, the queries they appear for and fresh inbound links, then reporting back and setting next month\u2019s priorities.'
        }
    ];

    const deliverables = [
        {
            icon: 'list-todo',
            title: 'Prioritized target-page list',
            description: 'Exactly which page gets worked on, why, and in what order \u2014 plus each page\u2019s current state.'
        },
        {
            icon: 'link',
            title: 'Internal link architecture document',
            description: 'Source links, destination pages and suggested anchors \u2014 something your own team can keep running.'
        },
        {
            icon: 'file-text',
            title: 'Rewritten, publish-ready content',
            description: 'The final version of each target page with heading structure and structured data, ready to publish.'
        },
        {
            icon: 'shield',
            title: 'Sponsored content & inbound backlink report',
            description: 'A list of the outlets you were published in and the fresh links pointing at your target pages.'
        },
        {
            icon: 'bar-chart3',
            title: 'Monthly progress report',
            description: 'Where your target pages stand in search results, fast-growing queries, the month\u2019s completed work and next month\u2019s priorities.'
        },
        {
            icon: 'file-text',
            title: 'In-house execution playbook',
            description: 'A guide your team can use to keep internal linking and content updates going without us.'
        }
    ];

    const reportSignals = [
        'Target-page positions in search results and how they move in Google Search Console',
        'The queries each page appears for, plus newly added queries',
        'New internal and inbound backlinks \u2014 and which page and domain they came from',
        'Page health: indexation, crawler errors and load speed',
        'Topic-cluster coverage progress and subtopics still to complete'
    ];

    const faqs = [
        {
            question: 'Why is content king?',
            answer: 'Because Google exists to answer users\u2019 questions. Quality content is the only way to meet that need and keep Google happy.'
        },
        {
            question: 'Is buying backlinks a good idea?',
            answer: 'Buying bulk, low-quality links is dangerous. We focus on \u201cearning\u201d links through PR, great content and quality sponsored placements \u2014 which is completely safe.'
        },
        {
            question: 'How long does topical authority take?',
            answer: 'Depending on your niche\u2019s competition, publishing 20\u201350 related articles with proper internal linking typically builds topical authority within 3\u20136 months.'
        },
        {
            question: 'Is your content original?',
            answer: 'Yes \u2014 everything is written by specialist writers and carefully checked for uniqueness and writing quality.'
        },
        {
            question: 'How effective is sponsored content?',
            answer: 'Published in the right outlet with the right copy, sponsored content is one of the strongest SEO signals: it lifts domain authority and brings direct traffic.'
        },
        {
            question: 'Where does a page-authority project start?',
            answer: 'With a short kickoff session and a target-page audit. The list of pages to strengthen, each one\u2019s priority and its current link and content state are defined and confirmed with you; then internal link architecture and content upgrades begin, with external link building following the same plan.'
        },
        {
            question: 'Which pages should come first?',
            answer: 'Usually the pages closest to revenue \u2014 service pages and landing pages \u2014 plus articles that already get Search Console impressions but rank low and can move with content and internal-link upgrades. You approve the final list at kickoff.'
        }
    ];

const breadcrumbs = [
    { position: 1, name: 'Home', item: 'https://asreseo.com/' },
    { position: 2, name: 'SEO Services', item: 'https://asreseo.com/services/seo/' },
    { position: 3, name: 'Page Authority & Content SEO', item: 'https://asreseo.com/services/seo/content-authority/' }
];
---
<BaseLayout
  lang="en"
  title='Page Authority, Domain & Content Authority Growth | AsreSEO'
  description='Page Authority growth services with target-page audits, internal link architecture and reputable link building; AsreSEO\u2019s delivery process and monthly progress reporting.'
  keywords='page authority, grow page authority, Page Authority, content SEO, topical authority, link building, sponsored content'
  canonical='/services/seo/content-authority/'
  ogType='website'
  ogUrl='https://asreseo.com/services/seo/content-authority/'
  ogImages={[{ url: "/og/content-authority-hero.jpg", width: 1200, height: 630, alt: "Page authority growth & content SEO services by AsreSEO" }]}
  twitterCard='summary_large_image'
>
<div class="min-h-screen bg-[#000000] text-slate-100 wireframe-grid">
            <script id="structured-data" type="application/ld+json" is:inline set:html={JSON.stringify(withServiceMeta(structuredData, { url: 'https://asreseo.com/services/seo/content-authority/', image: '/og/content-authority-hero.jpg' }))} />
            <BreadcrumbStructuredData items={breadcrumbs} />

            <Header lang="en" />

            <main>
                <!-- Hero Section -->
                <ServiceHero lang="en"
                    badge="Content Power + Link Authority"
                    title="Page Authority Growth & Content SEO"
                    titleGradient="Content SEO"
                    description="A winning formula for conquering search results. Valuable content users love, plus powerful links Google trusts."
                    primaryCta={{ text: "Start My Content Strategy", href: "/consultation/" }}
                    secondaryCta={{ text: "Link Building Consultation", href: "/consultation/" }}
                    imageSrc="/images/content-authority-hero.webp"
                    imageAlt="Page authority growth and content SEO"
                    theme="amber"
                />

                <!-- Answer-first block for «page authority». Self-contained
                     and quotable, sitting directly under the H1; the intent split
                     with /blog/page-authority-guide/ is stated right below it. -->
                <section class="py-8 md:py-10 bg-white border-b border-amber-100">
                    <div class="container-custom max-w-4xl text-left">
                        <span class="inline-block bg-amber-100 text-amber-800 text-xs md:text-sm font-medium px-3 py-1 rounded-full mb-4">
                            What is page authority and how do you grow it?
                        </span>
                        <p class="text-base md:text-lg text-gray-700 leading-loose bg-amber-50/50 p-6 rounded-2xl border border-amber-100">
                            <strong>Page Authority</strong> is a specific page\u2019s ability to rank in search results \u2014 how trustworthy and credible that single URL looks to search engines. It is shaped by the depth and quality of that page\u2019s content, the internal links pointing to it, reputable inbound backlinks and the on-page experience, and unlike domain authority it says nothing about the domain as a whole. Growing page authority takes three layers of work: strengthening the target page\u2019s content, an internal link architecture that passes value from stronger pages, and earning relevant backlinks from reputable publishers. At AsreSEO these three layers run as a monthly program with progress reports \u2014 because authority can\u2019t be built overnight, and its steady, gradual growth must stay visible to you.
                        </p>
                        <div class="mt-5 border-l-4 border-amber-300 pl-4 text-sm md:text-base text-gray-600 leading-relaxed">
                            This page explains how the engagement runs: the steps, the deliverables and how progress is reported. For the definition of page authority, what influences it and the full audit checklist, read our guide: <a href="/blog/page-authority-guide/" class="text-amber-700 font-semibold underline hover:no-underline">What is page authority and how do you grow it? \u2014 AsreSEO\u2019s complete guide</a>. The two pieces complement each other: one covers definition and factors, the other covers delivery and reporting.
                        </div>
                    </div>
                </section>

                <!-- AEO Direct Answer Section -->
                <section class="py-10 bg-amber-50/60 border-y border-amber-100">
                    <div class="container-custom max-w-4xl text-left">
                        <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-3">
                            What is Page Authority (PA) and how is it different from Domain Authority?
                        </h2>
                        <p class="text-base md:text-lg text-gray-700 leading-relaxed bg-white p-6 rounded-2xl shadow-xs border border-amber-100">
                            <strong>Page Authority (PA)</strong> is a numeric score estimating a specific page\u2019s ability to rank in search results. While Domain Authority measures the strength of the whole website, Page Authority focuses on that page\u2019s content quality, the internal links directed at it and the reputable external backlinks pointing to that same URL. At AsreSEO, topical authority architecture and targeted link building lift the authority of your key landing pages and articles, improving their positions in search results.
                        </p>
                    </div>
                </section>

                <!-- Stats Section -->
                <ServiceStats lang="en" stats={stats} theme="amber" />

                <!-- Content Services Section -->
                <section class="section-padding">
                    <div class="container-custom">
                        <div class="text-center mb-12">
                            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
                                <span class="gradient-text">Content SEO</span> Services
                            </h2>
                            <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                                Content users find compelling and search engines find optimized
                            </p>
                        </div>

                        <div class="grid md:grid-cols-2 gap-8">
                            {contentServices.map((service, index) => (
                                <Card class="hover:shadow-xl transition-all duration-300 group animate-fade-in border-0 shadow-lg">
                                    <CardHeader class="pb-4">
                                        <div class="flex items-center gap-3 mb-3">
                                            <div class="w-12 h-12 bg-amber-100 rounded-lg flex items-center justify-center group-hover:bg-amber-200 transition-colors">
                                                <Icon name={service.icon} class="h-6 w-6 text-amber-600" />
                                            </div>
                                            <CardTitle class="text-xl font-semibold">{service.title}</CardTitle>
                                        </div>
                                    </CardHeader>
                                    <CardContent>
                                        <p class="text-gray-600 mb-4 leading-relaxed">
                                            {service.description}
                                        </p>
                                        <div class="space-y-2">
                                            {service.benefits.map((benefit, benefitIndex) => (
                                                <div class="flex items-center gap-2 text-sm text-gray-500">
                                                    <Icon name="check-circle" class="h-4 w-4 text-green-500 shrink-0" />
                                                    {benefit}
                                                </div>
                                            ))}
                                        </div>
                                    </CardContent>
                                </Card>
                            ))}
                        </div>
                    </div>
                </section>

                <!-- Authority Services Section -->
                <section class="section-padding bg-slate-50">
                    <div class="container-custom">
                        <div class="text-center mb-12">
                            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
                                <span class="gradient-text">Link Building & Authority</span> Services
                            </h2>
                            <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                                Raising your domain\u2019s standing with Google through safe, effective link strategies
                            </p>
                        </div>

                        <div class="grid md:grid-cols-2 gap-8">
                            {authorityServices.map((service, index) => (
                                <Card class="hover:shadow-xl transition-all duration-300 group animate-fade-in border-0 shadow-lg bg-white">
                                    <CardHeader class="pb-4">
                                        <div class="flex items-center gap-3 mb-3">
                                            <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center group-hover:bg-purple-200 transition-colors">
                                                <Icon name={service.icon} class="h-6 w-6 text-purple-600" />
                                            </div>
                                            <CardTitle class="text-xl font-semibold">{service.title}</CardTitle>
                                        </div>
                                    </CardHeader>
                                    <CardContent>
                                        <p class="text-gray-600 mb-4 leading-relaxed">
                                            {service.description}
                                        </p>
                                        <div class="space-y-2">
                                            {service.benefits.map((benefit, benefitIndex) => (
                                                <div class="flex items-center gap-2 text-sm text-gray-500">
                                                    <Icon name="check-circle" class="h-4 w-4 text-green-500 shrink-0" />
                                                    {benefit}
                                                </div>
                                            ))}
                                        </div>
                                    </CardContent>
                                </Card>
                            ))}
                        </div>
                    </div>
                </section>

                <!-- Content Types Section -->
                <section class="section-padding bg-linear-to-br from-slate-50 to-indigo-50">
                    <div class="container-custom">
                        <div class="text-center mb-12">
                            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
                                Strategic <span class="gradient-text">Content Formats</span>
                            </h2>
                            <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                                The right content for every stage of your sales funnel
                            </p>
                        </div>

                        <div class="grid md:grid-cols-2 gap-8">
                            {contentTypes.map((type, index) => (
                                <Card class="hover:shadow-xl transition-all duration-300 group border-0 shadow-lg bg-white">
                                    <CardHeader class="pb-4">
                                        <div class="flex items-center gap-3 mb-3">
                                            <div class="w-12 h-12 bg-indigo-100 rounded-lg flex items-center justify-center group-hover:bg-indigo-200 transition-colors">
                                                <Icon name={type.icon} class="h-6 w-6 text-indigo-600" />
                                            </div>
                                            <CardTitle class="text-xl font-semibold">{type.title}</CardTitle>
                                        </div>
                                        <p class="text-gray-600 mb-4">{type.description}</p>
                                    </CardHeader>
                                    <CardContent>
                                        <div class="space-y-1">
                                            {type.features.map((feature, featureIndex) => (
                                                <div class="flex items-center gap-2 text-sm text-gray-500">
                                                    <Icon name="check-circle" class="h-4 w-4 text-green-500 shrink-0" />
                                                    {feature}
                                                </div>
                                            ))}
                                        </div>
                                    </CardContent>
                                </Card>
                            ))}
                        </div>
                    </div>
                </section>

                <!-- Factor checklist. The audit asked for a page-authority factor
                     image on this page (query «page authority», 18 impr / pos 63.7).
                     The asset already existed but was only used by the blog post,
                     so it is reused here. Native width/height set to avoid CLS. -->
                <section class="section-padding bg-slate-50 border-t border-gray-200/60">
                    <div class="container-custom max-w-4xl">
                        <div class="text-center mb-8">
                            <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-3">
                                Page authority factor checklist
                            </h2>
                            <p class="text-gray-600">
                                Everything we score in a page-authority audit
                            </p>
                        </div>
                        <Picture
                            src="/images/content-authority-post-checklist.webp"
                            alt="Checklist of page authority factors: content quality, internal linking, user-experience signals and source credibility"
                            widths={[480, 768, 1024, 1400, 1672]}
                            sizes="(max-width: 896px) 100vw, 896px"
                            formats={['avif', 'webp']}
                            loading="lazy"
                            decoding="async"
                            class="w-full h-auto rounded-2xl shadow-xs border border-gray-200"
                        />
                    </div>
                </section>

                <!-- Commercial half of the page: process, deliverables and reporting.
                     The definitional half (factors, checklist) lives in
                     /blog/page-authority-guide/ and is linked above. -->
                <section class="section-padding bg-white border-t border-gray-200/60">
                    <div class="container-custom max-w-5xl">
                        <div class="text-center mb-10">
                            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
                                AsreSEO\u2019s <span class="gradient-text">Page Authority Growth</span> Process
                            </h2>
                            <p class="text-lg text-gray-600 leading-relaxed max-w-3xl mx-auto">
                                Growing page authority isn\u2019t a one-off task \u2014 it\u2019s a monthly program that first pins down target pages, then runs three layers of work (content, internal links, backlinks) on those same pages, and reviews everything with you at month\u2019s end. Five steps:
                            </p>
                        </div>

                        <div class="space-y-5">
                            {processSteps.map((item, index) => (
                                <div class="flex items-start gap-5 p-5 bg-white rounded-xl shadow-xs border border-amber-100">
                                    <span class="w-10 h-10 rounded-full bg-amber-100 text-amber-800 flex items-center justify-center text-base font-bold shrink-0">
                                        {index + 1}
                                    </span>
                                    <div class="flex-1">
                                        <h3 class="text-lg font-semibold text-gray-900 mb-1">
                                            {item.step}
                                        </h3>
                                        <p class="text-gray-600 leading-relaxed text-sm md:text-base">
                                            {item.desc}
                                        </p>
                                    </div>
                                </div>
                            ))}
                        </div>
                    </div>
                </section>

                <section class="section-padding bg-slate-50 border-t border-gray-200/60">
                    <div class="container-custom max-w-5xl">
                        <div class="text-center mb-10">
                            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
                                <span class="gradient-text">Page Authority Project</span> Deliverables
                            </h2>
                            <p class="text-lg text-gray-600 leading-relaxed max-w-3xl mx-auto">
                                At the end of every stage and every month you receive something concrete \u2014 a document, list or report you can open and inspect, not just an \u201cin progress\u201d status.
                            </p>
                        </div>

                        <div class="grid md:grid-cols-2 gap-6">
                            {deliverables.map((item) => (
                                <Card class="hover:shadow-md transition-shadow border-0 shadow-sm bg-white">
                                    <CardContent class="p-6">
                                        <div class="flex items-start gap-4">
                                            <div class="w-11 h-11 bg-amber-100 rounded-lg flex items-center justify-center shrink-0">
                                                <Icon name={item.icon} class="h-5 w-5 text-amber-700" />
                                            </div>
                                            <div>
                                                <h3 class="text-lg font-semibold text-gray-900 mb-2">
                                                    {item.title}
                                                </h3>
                                                <p class="text-gray-600 leading-relaxed text-sm md:text-base">
                                                    {item.description}
                                                </p>
                                            </div>
                                        </div>
                                    </CardContent>
                                </Card>
                            ))}
                        </div>
                    </div>
                </section>

                <section class="section-padding bg-white border-t border-gray-200/60">
                    <div class="container-custom max-w-4xl">
                        <div class="text-center mb-8">
                            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
                                How do we report <span class="gradient-text">page authority</span> progress?
                            </h2>
                            <p class="text-lg text-gray-600 leading-relaxed max-w-3xl mx-auto">
                                We don\u2019t report progress with percentage claims \u2014 every report is built on data you can verify yourself in the same tools. Five groups of information land on the table each month:
                            </p>
                        </div>

                        <div class="max-w-3xl mx-auto space-y-3">
                            {reportSignals.map((signal) => (
                                <div class="flex items-start gap-3 bg-amber-50/60 border border-amber-100 rounded-xl p-4">
                                    <Icon name="check-circle" class="h-5 w-5 text-green-600 shrink-0 mt-0.5" />
                                    <span class="text-gray-700 leading-relaxed text-sm md:text-base">
                                        {signal}
                                    </span>
                                </div>
                            ))}
                        </div>

                        <p class="max-w-3xl mx-auto mt-7 text-center text-gray-600 leading-relaxed">
                            The monthly report is reviewed in a short session where next month\u2019s priorities are set together \u2014 and every number in the report cites its source so you can verify it yourself.
                        </p>
                    </div>
                </section>

                <!-- FAQ Section -->
                <ServiceFAQ lang="en"
                    faqs={faqs}
                    title="Frequently Asked Questions"
                    highlightWord="Asked Questions"
                    description="Answers to your questions about content & link building"
                    theme="amber"
                />

                <!-- CTA Section -->
                <ServiceCTA lang="en"
                    title="Make your brand\u2019s voice heard everywhere!"
                    description="Cement your spot at the top of Google with powerful content and high domain authority. We handle strategy, production and distribution for you."
                    primaryCta={{ text: "Start My Content Campaign", href: "/consultation/" }}
                    secondaryCta={{ text: "Free Consultation", href: "/consultation/" }}
                    theme="amber"
                />
            </main>

            <Footer lang="en" />
        </div>
</BaseLayout>
