    'Accurate measurement of each channel impact',
    'Better returns through coordinated channels',
    'A unified customer experience at every touchpoint'
  ];

  const stats = [
    { metric: 'Brand growth', label: 'Higher brand awareness', color: 'text-green-800', icon: "target" },
    { metric: 'Budget control', label: 'Lower marketing costs', color: 'text-blue-600', icon: "dollar-sign" },
    { metric: 'Wide coverage', label: 'Advertising channels', color: 'text-purple-600', icon: "layers" },
    { metric: 'Online dashboard', label: 'Accurate performance reports', color: 'text-orange-600', icon: "bar-chart3" }
  ];

  const features = [
    {
      icon: "megaphone",
      title: 'Multi-Channel Coverage',
      description: 'Coordinated campaign execution across social media, Google Ads, email and 10+ advertising platforms.',
      benefits: ['Complete coverage control', 'Maximum audience reach', 'Greater impact']
    },
    {
