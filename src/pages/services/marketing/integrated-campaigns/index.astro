// Tailwind only sees class names that literally appear in source, so a runtime
// `bg-${color}-100` is invisible to it. Map them explicitly instead.
const channelTile: Record<string, string> = {
  blue: 'bg-blue-100', green: 'bg-green-100', purple: 'bg-purple-100', cyan: 'bg-cyan-100',
};
const channelTileHover: Record<string, string> = {
  blue: 'group-hover:bg-blue-200', green: 'group-hover:bg-green-200',
  purple: 'group-hover:bg-purple-200', cyan: 'group-hover:bg-cyan-200',
};
import ServiceFAQ from '../../../../components/Services/ServiceFAQ.astro';
import ServiceCTA from '../../../../components/Services/ServiceCTA.astro';
import BreadcrumbStructuredData from '../../../../components/BreadcrumbStructuredData.astro';





