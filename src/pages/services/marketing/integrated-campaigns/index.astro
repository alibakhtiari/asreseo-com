const breadcrumbs = [
    { position: 1, name: 'Home', item: 'https://asreseo.com/' },
    { position: 2, name: 'Marketing Services', item: 'https://asreseo.com/services/marketing/' },
    { position: 3, name: 'Integrated Campaigns', item: 'https://asreseo.com/services/marketing/integrated-campaigns/' },
  ];

---
<BaseLayout lang="en" title='Integrated Multi-Channel Ad Campaigns | AsreSEO' description='Integrated multi-channel advertising campaigns. Grow brand awareness with a coordinated multi-channel strategy across social media, Google Ads and email marketing.' keywords='integrated campaigns, integrated advertising, Integrated Marketing, multi-channel marketing, AsreSEO' canonical='/services/marketing/integrated-campaigns/' ogType='website' ogUrl='https://asreseo.com/services/marketing/integrated-campaigns/' ogImages={[{ url: "/og/integrated-campaigns-hero.jpg", width: 1200, height: 630, alt: "Integrated campaigns | AsreSEO" }]} twitterCard='summary_large_image'
  ogTitle='Integrated Advertising Campaigns | AsreSEO'

  ogDescription='Unified multi-channel advertising strategies for maximum impact and high ROI.'
>
<div class="min-h-screen bg-[#000000] text-slate-100 wireframe-grid">
      <script id="structured-data" type="application/ld+json" is:inline
        set:html={JSON.stringify(withServiceMeta(structuredData, { url: 'https://asreseo.com/services/marketing/integrated-campaigns/', image: '/og/integrated-campaigns-hero.jpg' }))}
      />

      <Header lang="en" />
      <BreadcrumbStructuredData items={breadcrumbs} />

      <main>
        <ServiceHero lang="en"
          badge="Integrated multi-channel marketing"
          title="Integrated Advertising Campaigns"
          titleHighlight="Integrated"
          description="Unified advertising strategies across multiple channels for maximum impact. Grow brand awareness with coordinated social media, Google Ads and email marketing campaigns."
          primaryCtaText="Start Your Integrated Campaign"
          secondaryCtaText="Strategic Consultation"
          imageSrc="/images/integrated-campaigns-hero.webp"
          imageAlt="Integrated advertising campaigns"
          theme="indigo"
        />

        <ServiceStats lang="en" stats={stats} />

        <!-- Marketing Channels Section -->
        <section class="py-20 bg-[#000000] border-t-2 border-white/10 wireframe-grid relative">
          <div class="container-custom">
            <div class="mb-14 text-left">
              <div class="font-mono text-xs text-[#CCFF00] uppercase tracking-widest mb-2">[OMNICHANNEL_GRID // CHANNEL_MATRIX]</div>
              <h2 class="text-3xl sm:text-4xl md:text-5xl font-black uppercase text-white tracking-tight leading-tight">
                Marketing Channels <span class="text-[#CCFF00]">We Cover</span>
              </h2>
              <p class="text-sm sm:text-base text-slate-400 font-mono mt-3 max-w-3xl">
                // Complete digital coverage with strategic coordination across every channel
              </p>
            </div>

            <div class="grid md:grid-cols-2 gap-8">
              {marketingChannels.map((channel, index) => (
                <Card class="bg-[#0a0e17] border-2 border-white/15 brutalist-card hover:border-[#CCFF00] transition-colors rounded-none">
                  <CardHeader class="pb-4">
                    <div class="flex items-center gap-3 mb-3">
                      <div class="w-12 h-12 bg-black border border-white/20 text-[#CCFF00] flex items-center justify-center shrink-0">
                        <Icon name={channel.icon} class="h-6 w-6 text-[#CCFF00]" />
                      </div>
                      <CardTitle class="text-xl font-bold uppercase text-white">{channel.name}</CardTitle>
                    </div>
                    <p class="text-slate-300 mb-2 text-sm">{channel.description}</p>
                  </CardHeader>
                  <CardContent>
                    <div class="flex flex-wrap gap-2 border-t border-white/10 pt-4">
                      {channel.platforms.map((platform, platformIndex) => (
                        <span class="text-xs font-mono uppercase bg-black px-2.5 py-1 border border-white/20 text-slate-300">
                          {platform}
                        </span>
                      ))}
                    </div>
                  </CardContent>
                </Card>
              ))}
            </div>
          </div>
        </section>

        <!-- Features Section -->
        <section class="py-20 bg-[#000000] border-t-2 border-white/10 wireframe-grid relative">
          <div class="container-custom">
            <div class="mb-14 text-left">
              <div class="font-mono text-xs text-[#CCFF00] uppercase tracking-widest mb-2">[STRATEGIC_SUPERIORITY // ADVANTAGES]</div>
              <h2 class="text-3xl sm:text-4xl md:text-5xl font-black uppercase text-white tracking-tight leading-tight">
                What Makes <span class="text-[#CCFF00]">Integrated</span> Campaigns Better
              </h2>
              <p class="text-sm sm:text-base text-slate-400 font-mono mt-3 max-w-3xl">
                // Why do AsreSEO integrated campaigns beat single-channel campaigns?
              </p>
            </div>

            <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
              {features.map((feature, index) => (
                <Card class="bg-[#0a0e17] border-2 border-white/15 brutalist-card hover:border-[#CCFF00] transition-colors rounded-none">
                  <CardHeader class="pb-4">
                    <div class="flex items-center gap-3 mb-3">
                      <div class="w-12 h-12 bg-black border border-white/20 text-[#CCFF00] flex items-center justify-center shrink-0">
                        <Icon name={feature.icon} class="h-6 w-6 text-[#CCFF00]" />
                      </div>
                      <CardTitle class="text-lg font-bold uppercase text-white">{feature.title}</CardTitle>
                    </div>
                  </CardHeader>
                  <CardContent>
                    <p class="text-slate-300 mb-4 leading-relaxed text-sm">
                      {feature.description}
                    </p>
                    <div class="space-y-2 border-t border-white/10 pt-4">
                      {feature.benefits.map((benefit, benefitIndex) => (
                        <div class="flex items-center gap-2 text-sm text-slate-300">
                          <Icon name="check-circle" class="h-4 w-4 text-[#CCFF00] shrink-0" />
                          <span>{benefit}</span>
                        </div>
                      ))}
                    </div>
                  </CardContent>
                </Card>
              ))}
            </div>
          </div>
        </section>

        <!-- Campaign Objectives -->
        <section class="py-20 bg-[#000000] border-t-2 border-white/10 wireframe-grid relative">
          <div class="container-custom">
            <div class="mb-14 text-left">
              <div class="font-mono text-xs text-[#CCFF00] uppercase tracking-widest mb-2">[CAMPAIGN_TARGETING // CORE_OBJECTIVES]</div>
              <h2 class="text-3xl sm:text-4xl md:text-5xl font-black uppercase text-white tracking-tight leading-tight">
                <span class="text-[#CCFF00]">Integrated</span> Campaign Objectives
              </h2>
              <p class="text-sm sm:text-base text-slate-400 font-mono mt-3 max-w-2xl">
                // Campaigns shaped around your business to hit your marketing goals
              </p>
            </div>

            <div class="grid md:grid-cols-2 gap-4">
              {campaignObjectives.map((objective, index) => (
                <div class="flex items-center gap-4 p-4 bg-[#0a0e17] border-2 border-white/15 hover:border-[#CCFF00] transition-colors rounded-none brutalist-card group">
                  <div class="w-10 h-10 bg-black border border-white/20 flex items-center justify-center shrink-0 group-hover:border-[#CCFF00] transition-colors">
                    <Icon name="target" class="h-5 w-5 text-[#CCFF00]" />
                  </div>
                  <div class="flex-1">
                    <div class="font-mono text-[10px] text-slate-500 uppercase tracking-widest mb-0.5">
                      OBJ_{String(index + 1).padStart(2, '0')}
                    </div>
                    <span class="text-white font-medium text-sm block">
                      {objective}
                    </span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </section>

        <!-- Campaign Types -->
        <section class="py-20 bg-[#000000] border-t-2 border-white/10 wireframe-grid relative">
          <div class="container-custom">
            <div class="mb-14 text-left">
              <div class="font-mono text-xs text-[#CCFF00] uppercase tracking-widest mb-2">[STRATEGY_BLUEPRINTS // CAMPAIGN_MODELS]</div>
              <h2 class="text-3xl sm:text-4xl md:text-5xl font-black uppercase text-white tracking-tight leading-tight">
                <span class="text-[#CCFF00]">Integrated</span> Campaign Types
              </h2>
              <p class="text-sm sm:text-base text-slate-400 font-mono mt-3 max-w-2xl">
                // Campaign strategies matched to your marketing goals
              </p>
            </div>

            <div class="grid md:grid-cols-2 gap-6">
              {campaignTypes.map((campaign, index) => (
                <Card class="bg-[#0a0e17] border-2 border-white/15 brutalist-card hover:border-[#CCFF00] transition-colors rounded-none">
                  <CardHeader>
                    <CardTitle class="text-xl font-bold uppercase text-white">{campaign.title}</CardTitle>
                    <p class="text-slate-300 text-sm mt-1">{campaign.description}</p>
                  </CardHeader>
                  <CardContent>
                    <div class="space-y-2 border-t border-white/10 pt-4">
                      <h4 class="font-mono text-xs uppercase tracking-wider text-[#CCFF00] mb-2">Example campaigns:</h4>
                      {campaign.examples.map((example, exampleIndex) => (
                        <div class="flex items-center gap-2 text-sm text-slate-300">
                          <Icon name="check-circle" class="h-3 w-3 text-[#CCFF00] shrink-0" />
                          <span>{example}</span>
                        </div>
                      ))}
                    </div>
                  </CardContent>
                </Card>
              ))}
            </div>
          </div>
        </section>

        <ServiceBenefits lang="en"
          title="Integrated Advertising Campaigns"
          titleHighlight="Integrated"
          subtitle="Tangible multi-channel marketing results that grow your brand everywhere"
          benefits={benefits}
          iconColorClass="text-indigo-600"
          iconBgClass="bg-indigo-100"
        />

        <ServiceWorkflow lang="en"
          title="How We Run Integrated Campaigns"
          titleHighlight="Integrated"
          subtitle="A proven 6-step approach to multi-channel campaign success"
          steps={processSteps}
          themeColor="indigo"
          bgGradient="bg-linear-to-br from-purple-50 to-indigo-50"
        />

        <ServiceFAQ lang="en"
          title="Frequently Asked Questions"
          highlightWord="Asked Questions"
          subtitle="Answers to the most common questions about integrated advertising campaigns"
          faqs={faqs}
        />

        <ServiceCTA lang="en"
          title="Make your brand powerful across the entire digital space!"
          description="With integrated advertising campaigns, reach all of your target customers. A multi-channel marketing strategy for maximum impact and high ROI."
          primaryText="Start Your Integrated Campaign"
          secondaryText="Free Marketing Strategy"
        />
      </main>

      <Footer lang="en" />
    </div>
</BaseLayout>
