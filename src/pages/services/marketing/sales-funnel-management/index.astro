---
import { withServiceMeta } from '../../../../lib/service-schema';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Header from '../../../../components/Layout/Header.astro';
import Footer from '../../../../components/Layout/Footer.astro';
import Card from '../../../../components/ui/card/Card.astro';
import CardContent from '../../../../components/ui/card/CardContent.astro';
import CardHeader from '../../../../components/ui/card/CardHeader.astro';
import CardTitle from '../../../../components/ui/card/CardTitle.astro';
import Badge from '../../../../components/ui/badge/Badge.astro';
import Icon from '../../../../components/ui/Icon.astro';
import ServiceHero from '../../../../components/Services/ServiceHero.astro';
import ServiceStats from '../../../../components/Services/ServiceStats.astro';
import ServiceFAQ from '../../../../components/Services/ServiceFAQ.astro';
import ServiceCTA from '../../../../components/Services/ServiceCTA.astro';
import BreadcrumbStructuredData from '../../../../components/BreadcrumbStructuredData.astro';
import ServiceBenefits from '../../../../components/Services/ServiceBenefits.astro';

// Tailwind scans source text, so a class built at runtime (`bg-${c}-100`) is
// invisible to it — those colours only worked because some *other* file happened
// to use them literally. Map them out explicitly. -800 (not -700) keeps the
// label at 6.4:1 on the -100 background, comfortably past WCAG 1.4.3.
const stageBadge: Record<string, string> = {
  blue: 'bg-blue-100 text-blue-800',
  green: 'bg-green-100 text-green-800',
  yellow: 'bg-yellow-100 text-yellow-800',
  orange: 'bg-orange-100 text-orange-800',
  purple: 'bg-purple-100 text-purple-800',
};





const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  'name': 'Sales Funnel Management',
  'description': 'Sales funnel design and optimization services including customer behavior analysis and marketing automation',
  'serviceType': 'Sales Funnel Management',
  'inLanguage': 'en-US',
  'provider': {
    '@type': 'Organization',
    'name': 'AsreSEO',
    'url': 'https://asreseo.com'
  },
  'hasOfferCatalog': {
    '@type': 'OfferCatalog',
    'name': 'Sales funnel services',
    'itemListElement': [
      {
        '@type': 'Offer',
        'itemOffered': {
          '@type': 'Service',
          'name': 'Funnel analysis',
          'description': 'Reviewing your customers current journey',
          'inLanguage': 'en-US'
        }
      },
      {
        '@type': 'Offer',
        'itemOffered': {
          '@type': 'Service',
          'name': 'Conversion optimization',
          'description': 'Increasing conversion rates at every stage',
          'inLanguage': 'en-US'
        }
      }
    ]
  }
};



  const funnelStages = [
    {
      stage: 'Awareness',
      phase: 'TOP',
      percentage: 'Entire target audience',
      description: 'Recognizing the need and discovering your brand',
      color: 'blue',
      activities: ['Educational content', 'Social media', 'Advertising']
    },
    {
      stage: 'Interest',
      phase: 'MIDDLE',
      percentage: 'Solution seekers',
      description: 'Exploring solutions and comparing options',
      color: 'green',
      activities: ['Expert blog', 'Tutorial videos', 'Webinars']
    },
    {
      stage: 'Consideration',
      phase: 'MIDDLE',
      percentage: 'Serious buyers',
      description: 'Evaluating benefits and comparing competitors',
      color: 'yellow',
      activities: ['Case studies', 'Free trial', 'Free consultation']
    },
    {
      stage: 'Action',
      phase: 'BOTTOM',
      percentage: 'Final buyers',
      description: 'Final purchase and transaction completion',
      color: 'orange',
      activities: ['Special offer', 'Guarantee', 'Easy checkout']
    },
    {
      stage: 'Retention',
      phase: 'BOTTOM',
      percentage: 'Returning customers',
      description: 'Repeat purchases and word-of-mouth marketing',
      color: 'purple',
      activities: ['Excellent support', 'Loyalty program', 'Remarketing']
    }
  ];

  const services = [
    {
      icon: "bar-chart3",
      title: 'Advanced Audit of Your Current Funnel',
      description: 'A complete review of the customer journey from entry to purchase, identifying weak points and optimization opportunities with Google Analytics and Hotjar.',
      benefits: ['Finding weak points', 'Accurate data', 'Scientific planning']
    },
    {
      icon: "target",
      title: 'Personalized Funnel Design',
      description: 'Building a unique customer journey based on your product, audience and business goals, using proven digital marketing methods.',
      benefits: ['Higher efficiency', 'Personal experience', 'Better conversion rates']
    },
    {
      icon: "zap",
      title: 'Smart Marketing Automation',
      description: 'Implementing email, SMS and messaging automation for reminders, follow-ups and smart offers.',
      benefits: ['Operational efficiency', '24/7 performance', 'Lower costs']
    },
    {
      icon: "trending-up",
      title: 'A/B Testing & Continuous Improvement',
      description: 'Ongoing testing of pages, forms, CTAs and marketing content to reach the best possible conversion rate.',
      benefits: ['Continuous improvement', 'Data-driven results', 'Maximum ROI']
    },
    {
      icon: "users",
      title: 'Integrated Customer & CRM Management',
      description: 'A centralized customer system with smart grouping by funnel stage, purchase history and online behavior.',
      benefits: ['Simple management', 'Unified view', 'Better customer building']
    },
    {
      icon: "dollar-sign",
      title: 'Accurate Financial & ROI Reporting',
      description: 'Precise measurement of marketing spend, resulting revenue and return on investment for informed decisions.',
      benefits: ['Budget planning', 'Financial transparency', 'Better decisions']
    }
  ];

  const optimizationStrategies = [
    {
      title: 'Landing Page Optimization',
      icon: "target",
      techniques: [
        'A/B testing headlines and images',
        'Optimizing input forms',
        'Faster page loading',
        'Strategic CTAs'
      ],
      impact: 'Steadily better conversion rates'
    },
    {
      title: 'Email Marketing Automation',
      icon: "scroll-text",
      techniques: [
        'Automated welcome campaigns',
        'Smart follow-up emails',
        'Remarketing campaigns',
        'Abandoned-cart follow-up'
      ],
      impact: 'Better email open rates'
    },
    {
      title: 'Customer Journey Mapping',
      icon: "users",
      techniques: [
        'Mapping the customer journey',
        'Identifying touchpoints',
        'Optimizing user experience',
        'Reducing checkout friction'
      ],
      impact: 'Higher purchase completion'
    }
  ];

  const benefits = [
    'Measurably higher lead-to-customer conversion with an optimized journey',
    'Lower cost per new customer through sales-process automation',
    'Better customer experience and satisfaction with personalized UX',
    'Full funnel transparency with advanced analytics dashboards',
    'Customer retention and win-back with remarketing strategies'
  ];

  const stats = [
    { metric: 'Steady growth', label: 'Measurable conversion rates', color: 'text-green-800', icon: "trending-up" },
    { metric: 'Cost efficiency', label: 'Lower acquisition costs', color: 'text-blue-600', icon: "dollar-sign" },
    { metric: 'Online dashboard', label: 'Transparent reporting', color: 'text-purple-600', icon: "bar-chart3" },
    { metric: '24/7', label: 'Full automation', color: 'text-orange-600', icon: "zap" }
  ];

  const workflowSteps = [
    {
      step: 'Analysis & Review',
      desc: 'Reviewing your current funnel and identifying weaknesses and improvement opportunities'
    },
    {
      step: 'Strategy Design',
      desc: 'Building a comprehensive roadmap with quantitative goals and execution strategies'
    },
    {
      step: 'Technical Implementation',
      desc: 'Setting up tools, automations and tracking pixels'
    },
    {
      step: 'Testing & Optimization',
      desc: 'Extensive A/B testing and continuous data-driven optimization'
    },
    {
      step: 'Reporting & Monitoring',
      desc: 'Weekly reports, ROI analysis and ongoing improvement suggestions'
    }
  ];

  const faqs = [
    {
      question: 'What is a sales funnel and why does it matter?',
      answer: 'A sales funnel is the scientific path that guides a customer from awareness to final purchase. If this path is not optimized, you lose many potential customers. Optimizing it noticeably improves your conversion rate.'
    },
    {
      question: 'How do you measure funnel conversion rates?',
      answer: 'With tools like Google Analytics, Hotjar, your CRM database and ad pixels, we measure every funnel stage precisely — tracking stage-to-stage conversion, average time per stage and customer drop-off points.'
    },
    {
      question: 'How long until I see funnel improvements?',
      answer: 'Major changes are usually applied within the first 1–2 weeks and early results become visible. Full, stable optimization typically takes 4–8 weeks, with conversion rates improving continuously along the way.'
    },
    {
      question: 'Is a sales funnel right for every business?',
      answer: 'Yes — for online stores, digital services, B2B and traditional businesses alike. The strategy differs for each, but the shared goal is conversion-rate optimization. From small startups to large companies, everyone benefits.'
    },
    {
      question: 'Are technical changes to my website required?',
      answer: 'It depends on your current setup. If you lack analytics and automation tools, they need to be set up; if you have them, we build the strategy on what exists. Your website keeps running normally throughout.'
    },
    {
      question: 'How much does sales funnel management cost?',
      answer: 'Request a custom quote — pricing depends on scope: your current funnel complexity, required tools and contract length.'
    }
  ];

---
<BaseLayout lang="en" title='Sales Funnel Management | Boost Conversion Rates | AsreSEO' description='Scientific sales funnel design and management with customer behavior analysis, marketing automation, A/B testing and conversion rate optimization (CRO).' keywords='sales funnel, Sales Funnel, conversion rate, Customer Journey, sales automation, digital marketing, AsreSEO' canonical='/services/marketing/sales-funnel-management/' ogType='website' ogUrl='https://asreseo.com/services/marketing/sales-funnel-management/' ogImages={[{ url: "/og/sales-funnel-hero.jpg", width: 1200, height: 630, alt: "Sales funnel management | AsreSEO" }]} twitterCard='summary_large_image'
  ogTitle='Sales Funnel Management | AsreSEO'

  ogDescription='Designing and optimizing sales funnels for higher conversion rates.'
>
<div class="min-h-screen bg-[#000000] text-slate-100 wireframe-grid">
      <script id="structured-data" type="application/ld+json" is:inline
        set:html={JSON.stringify(withServiceMeta(structuredData, { url: 'https://asreseo.com/services/marketing/sales-funnel-management/', image: '/og/sales-funnel-hero.jpg' }))}
      />

      <Header lang="en" />
      <BreadcrumbStructuredData
        items={[
          { position: 1, name: 'Home', item: 'https://asreseo.com/' },
          { position: 2, name: 'Marketing Services', item: 'https://asreseo.com/services/marketing/' },
          { position: 3, name: 'Sales Funnel Management', item: 'https://asreseo.com/services/marketing/sales-funnel-management/' }
        ]}
      />

      <main>
        <!-- Hero Section -->
        <ServiceHero lang="en"
          badge="Professional sales funnel management"
          title="Sales Funnel Management"
          titleGradient="Sales Funnel"
          description="Measurably higher conversion rates with scientific funnel design, smart marketing automation and customer-behavior optimization at AsreSEO."
          primaryCta={{ text: "Optimize My Sales Funnel" }}
          secondaryCta={{ text: "Free Funnel Audit" }}
          imageSrc="/images/sales-funnel-hero.webp"
          imageAlt="Professional sales funnel management"
          theme="orange"
        />

        <!-- Stats Section -->
        <ServiceStats lang="en" stats={stats} theme="orange" />

        <!-- Funnel Stages Section -->
        <section class="section-padding">
          <div class="container-custom">
            <div class="text-center mb-12">
              <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
                The Standard <span class="gradient-text">Sales Funnel Stages</span>
              </h2>
              <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                The scientific path guiding customers from awareness to final purchase
              </p>
            </div>

            <div class="max-w-4xl mx-auto space-y-6">
              {funnelStages.map((stage, index) => (
                <Card class="hover:shadow-lg transition-all duration-300">
                  <CardContent class="p-6">
                    <div class="flex items-center gap-6">
                      <div class="shrink-0">
                        <div class="w-12 h-12 bg-orange-100 rounded-full flex items-center justify-center">
                          <span class="text-lg font-bold text-orange-700">{index + 1}</span>
                        </div>
                      </div>
                      <div class="flex-1">
                        <div class="flex items-center justify-between mb-2">
                          <h3 class="text-xl font-semibold text-gray-900">{stage.stage}</h3>
                          <Badge class={stageBadge[stage.color] ?? 'bg-gray-100 text-gray-800'}>{stage.percentage}</Badge>
                        </div>
                        <p class="text-gray-600 mb-3">{stage.description}</p>
                        <div class="flex flex-wrap gap-2">
                          {stage.activities.map((activity, actIndex) => (
                            <Badge variant="outline" class="text-sm">
                              {activity}
                            </Badge>
                          ))}
                        </div>
                      </div>
                    </div>
                  </CardContent>
                </Card>
              ))}
            </div>
          </div>
        </section>

        <!-- Services Section -->
        <section class="section-padding bg-linear-to-br from-slate-50 to-indigo-50">
          <div class="container-custom">
            <div class="text-center mb-12">
              <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
                AsreSEO <span class="gradient-text">Sales Funnel Management</span> Services
              </h2>
              <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                A comprehensive approach to turning visitors into customers
              </p>
            </div>

            <div class="grid md:grid-cols-2 gap-8">
              {services.map((service, index) => (
                <Card class="hover:shadow-xl transition-all duration-300 group border-0 shadow-lg bg-white">
                  <CardHeader class="pb-4">
                    <div class="flex items-center gap-3 mb-3">
                      <div class="w-12 h-12 bg-orange-100 rounded-lg flex items-center justify-center group-hover:bg-orange-200 transition-colors">
                        <Icon name={service.icon} class="h-6 w-6 text-orange-600" />
                      </div>
                      <CardTitle class="text-xl font-semibold">{service.title}</CardTitle>
                    </div>
                  </CardHeader>
                  <CardContent>
                    <p class="text-gray-600 mb-4 leading-relaxed">
                      {service.description}
                    </p>
                    <div class="space-y-2">
                      {service.benefits.map((benefit, benefitIndex) => (
                        <div class="flex items-center gap-2 text-sm text-gray-500">
                          <Icon name="check-circle2" class="h-4 w-4 text-green-500 shrink-0" />
                          {benefit}
                        </div>
                      ))}
                    </div>
                  </CardContent>
                </Card>
              ))}
            </div>
          </div>
        </section>

        <!-- Optimization Strategies Section -->
        <section class="section-padding">
          <div class="container-custom">
            <div class="text-center mb-12">
              <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
                Effective <span class="gradient-text">Optimization Strategies</span>
              </h2>
              <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                Practical techniques with measurable results for every funnel stage
              </p>
            </div>

            <div class="grid md:grid-cols-3 gap-8">
              {optimizationStrategies.map((strategy, index) => (
                <Card class="hover:shadow-xl transition-all duration-300 group border-0 shadow-lg">
                  <CardHeader class="pb-4">
                    <div class="flex items-center gap-3 mb-3">
                      <div class="w-12 h-12 bg-indigo-100 rounded-lg flex items-center justify-center group-hover:bg-indigo-200 transition-colors">
                        <Icon name={strategy.icon} class="h-6 w-6 text-indigo-600" />
                      </div>
                      <CardTitle class="text-xl font-semibold">{strategy.title}</CardTitle>
                    </div>
                    <Badge class="mb-3 bg-green-100 text-green-800">{strategy.impact}</Badge>
                  </CardHeader>
                  <CardContent>
                    <div class="space-y-1">
                      {strategy.techniques.map((technique, techniqueIndex) => (
                        <div class="flex items-center gap-2 text-sm text-gray-600">
                          <Icon name="check-circle2" class="h-4 w-4 text-green-500 shrink-0" />
                          {technique}
                        </div>
                      ))}
                    </div>
                  </CardContent>
                </Card>
              ))}
            </div>
          </div>
        </section>

              <ServiceBenefits lang="en" title="Professional Sales Funnel Management" titleHighlight="Sales Funnel" subtitle="Tangible results that directly help your business" benefits={benefits} />

        <!-- Workflow Section -->
        <section class="section-padding bg-linear-to-br from-red-50 to-orange-50">
          <div class="container-custom">
            <div class="text-center mb-12">
              <h2 class="text-3xl font-bold text-gray-900 mb-6">
                The AsreSEO <span class="gradient-text">Sales Funnel Management</span> Process
              </h2>
              <p class="text-xl text-gray-600">
                A proven 5-step approach to maximum conversion rates
              </p>
            </div>

            <div class="space-y-8">
              {workflowSteps.map((step, index) => (
                <div class="flex items-center gap-8 p-6 bg-white/80 rounded-xl shadow-xs">
                  <div class="w-16 h-16 bg-orange-100 rounded-full flex items-center justify-center text-2xl font-bold text-orange-700">
                    {index + 1}
                  </div>
                  <div class="flex-1">
                    <h3 class="text-xl font-semibold text-gray-900 mb-2">
                      {step.step}
                    </h3>
                    <p class="text-gray-600 leading-relaxed">
                      {step.desc}
                    </p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </section>

        <!-- FAQ Section -->
        <ServiceFAQ lang="en"
          title="Frequently Asked Questions"
          titleGradient="Asked Questions"
          subtitle="Answers to our customers' most common questions about sales funnels"
          faqs={faqs}
        />

        <!-- CTA Section -->
        <ServiceCTA lang="en"
          title="Why are you losing so many potential customers?"
          description="Chances are your sales funnel is not optimized and customers drop off along the buying journey. With scientific analysis and advanced automation, AsreSEO noticeably lifts your conversion rate. Do not let your customers go to competitors!"
          primaryCta={{ text: "Start Funnel Optimization" }}
          secondaryCta={{ text: "Free Funnel Audit" }}
          primaryClass="bg-orange-700 hover:bg-orange-800 text-white font-semibold shadow-lg shadow-orange-700/30"
        />
      </main>

      <Footer lang="en" />
    </div>
</BaseLayout>
