---
<BaseLayout title='مدیریت قیف فروش | Sales Funnel Management | افزایش نرخ تبدیل ۳۰۰% | عصر سئو' description='طراحی و مدیریت علمی قیف فروش با تحلیل comport رفتار مشتری، اتوماسیون بازاریابی، A/B Testing و افزایش نرخ تبدیل تا ۳۰۰%.' keywords='قیف فروش, Sales Funnel, نرخ تبدیل, Customer Journey, اتوماسیون فروش, بازاریابی دیجیتال' canonical='https://asreseo.com/services/marketing/sales-funnel-management/' ogType='website' ogUrl='https://asreseo.com/services/marketing/sales-funnel-management/' ogImages={[{ url: "/images/sales-funnel-hero.webp", width: 1200, height: 630, alt: "مدیریت قیف فروش | عصر سئو" }]} twitterCard='summary_large_image'
  ogTitle='مدیریت قیف فروش | عصر سئو'

  ogDescription='طراحی و بهینه‌سازی قیف فروش برای افزایش نرخ تبدیل.'
>
<div class="min-h-screen bg-white">
      <script id="structured-data" type="application/ld+json" is:inline
        set:html={JSON.stringify(structuredData)}
      />

      <Header />
      <BreadcrumbStructuredData
        items={[
          { name: 'خانه', url: '/' },
          { name: 'خدمات بازاریابی', url: '/services/marketing/' },
          { name: 'مدیریت قیف فروش', url: '/services/marketing/sales-funnel-management/' }
        ]}
      />

      <main>
        <!-- Hero Section -->
        <ServiceHero
          badge="مدیریت قیف فروش حرفه‌ای"
          title="مدیریت"
          titleGradient="قیف فروش"
          description="افزایش نرخ تبدیل ۳۰۰% با طراحی علمی قیف فروش، اتوماسیون بازاریابی هوشمند و بهینه‌سازی رفتار مشتری در عصر سئو."
          primaryCta={{ text: "بهینه‌سازی قیف فروش" }}
          secondaryCta={{ text: "تحلیل رایگان قیف فروش فعلی" }}
          imageSrc="/images/sales-funnel-hero.webp"
          imageAlt="مدیریت قیف فروش حرفه‌ای"
          theme="orange"
        />

        <!-- Stats Section -->
        <ServiceStats stats={stats} theme="orange" />

        <!-- Funnel Stages Section -->
        <section class="section-padding">
          <div class="container-custom">
            <div class="text-center mb-12">
              <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
                مراحل <span class="gradient-text">قیف فروش استاندارد</span>
              </h2>
              <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                مسیر علمی هدایت مشتریان از آگاهی تا خرید نهایی
              </p>
            </div>

            <div class="max-w-4xl mx-auto space-y-6">
              {funnelStages.map((stage, index) => (
                <Card class="hover:shadow-lg transition-all duration-300">
                  <CardContent class="p-6">
                    <div class="flex items-center gap-6">
                      <div class="shrink-0">
                        <div class="w-12 h-12 bg-orange-100 rounded-full flex items-center justify-center">
                          <span class="text-lg font-bold text-orange-700">{index + 1}</span>
                        </div>
                      </div>
                      <div class="flex-1">
                        <div class="flex items-center justify-between mb-2">
                          <h3 class="text-xl font-semibold text-gray-900">{stage.stage}</h3>
                          <Badge class={`bg-${stage.color}-100 text-${stage.color}-700`}>{stage.percentage}</Badge>
                        </div>
                        <p class="text-gray-600 mb-3">{stage.description}</p>
                        <div class="flex flex-wrap gap-2">
                          {stage.activities.map((activity, actIndex) => (
                            <Badge variant="outline" class="text-sm">
                              {activity}
                            </Badge>
                          ))}
                        </div>
                      </div>
                    </div>
                  </CardContent>
                </Card>
              ))}
            </div>
          </div>
        </section>

        <!-- Services Section -->
        <section class="section-padding bg-linear-to-br from-slate-50 to-indigo-50">
          <div class="container-custom">
            <div class="text-center mb-12">
              <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
                خدمات <span class="gradient-text">مدیریت قیف فروش</span> عصر سئو
              </h2>
              <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                رویکردی جامع برای تبدیل بازدیدکنندگان به مشتریان
              </p>
            </div>

            <div class="grid md:grid-cols-2 gap-8">
              {services.map((service, index) => (
                <Card class="hover:shadow-xl transition-all duration-300 group border-0 shadow-lg bg-white">
                  <CardHeader class="pb-4">
                    <div class="flex items-center gap-3 mb-3">
                      <div class="w-12 h-12 bg-orange-100 rounded-lg flex items-center justify-center group-hover:bg-orange-200 transition-colors">
                        <Icon name={service.icon} class="h-6 w-6 text-orange-600" />
                      </div>
                      <CardTitle class="text-xl font-semibold">{service.title}</CardTitle>
                    </div>
                  </CardHeader>
                  <CardContent>
                    <p class="text-gray-600 mb-4 leading-relaxed">
                      {service.description}
                    </p>
                    <div class="space-y-2">
                      {service.benefits.map((benefit, benefitIndex) => (
                        <div class="flex items-center gap-2 text-sm text-gray-500">
                          <Icon name="check-circle2" class="h-4 w-4 text-green-500 shrink-0" />
                          {benefit}
                        </div>
                      ))}
                    </div>
                  </CardContent>
                </Card>
              ))}
            </div>
          </div>
        </section>

        <!-- Optimization Strategies Section -->
        <section class="section-padding">
          <div class="container-custom">
            <div class="text-center mb-12">
              <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
                استراتژی‌های <span class="gradient-text">بهینه‌سازی اثربخش</span>
              </h2>
              <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                تکنیک‌های عملی با اثبات نتایج برای هر مرحله قیف فروش
              </p>
            </div>

            <div class="grid md:grid-cols-3 gap-8">
              {optimizationStrategies.map((strategy, index) => (
                <Card class="hover:shadow-xl transition-all duration-300 group border-0 shadow-lg">
                  <CardHeader class="pb-4">
                    <div class="flex items-center gap-3 mb-3">
                      <div class="w-12 h-12 bg-indigo-100 rounded-lg flex items-center justify-center group-hover:bg-indigo-200 transition-colors">
                        <Icon name={strategy.icon} class="h-6 w-6 text-indigo-600" />
                      </div>
                      <CardTitle class="text-xl font-semibold">{strategy.title}</CardTitle>
                    </div>
                    <Badge class="mb-3 bg-green-100 text-green-700">{strategy.impact}</Badge>
                  </CardHeader>
                  <CardContent>
                    <div class="space-y-1">
                      {strategy.techniques.map((technique, techniqueIndex) => (
                        <div class="flex items-center gap-2 text-sm text-gray-600">
                          <Icon name="check-circle2" class="h-4 w-4 text-green-500 shrink-0" />
                          {technique}
                        </div>
                      ))}
                    </div>
                  </CardContent>
                </Card>
              ))}
            </div>
          </div>
        </section>

        <!-- Benefits Section -->
        <section class="section-padding bg-slate-50">
          <div class="container-custom">
            <div class="text-center mb-12">
              <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
                مزایای مدیریت <span class="gradient-text">قیف فروش حرفه‌ای</span>
              </h2>
              <p class="text-xl text-gray-600 max-w-2xl mx-auto">
                نتایج ملموس که مستقیماً به کسب‌وکار شما کمک می‌کنند
              </p>
            </div>

            <div class="grid md:grid-cols-2 gap-6 max-w-4xl mx-auto">
              {benefits.map((benefit, index) => (
                <div class="flex items-start gap-4 p-6 bg-white rounded-xl border border-gray-200 hover:shadow-md transition-shadow">
                  <div class="w-8 h-8 bg-orange-100 rounded-lg flex items-center justify-center shrink-0">
                    <Icon name="award" class="h-5 w-5 text-orange-600" />
                  </div>
                  <span class="text-gray-900 font-medium leading-relaxed">
                    {benefit}
                  </span>
                </div>
              ))}
            </div>
          </div>
        </section>

        <!-- Workflow Section -->
        <section class="section-padding bg-linear-to-br from-red-50 to-orange-50">
          <div class="container-custom">
            <div class="text-center mb-12">
              <h2 class="text-3xl font-bold text-gray-900 mb-6">
                فرآیند <span class="gradient-text">مدیریت قیف فروش</span> عصر سئو
              </h2>
              <p class="text-xl text-gray-600">
                رویکرد علمی ۵ مرحله‌ای برای حداکثر نرخ تبدیل
              </p>
            </div>

            <div class="space-y-8">
              {workflowSteps.map((step, index) => (
                <div class="flex items-center gap-8 p-6 bg-white/80 rounded-xl shadow-xs">
                  <div class="w-16 h-16 bg-orange-100 rounded-full flex items-center justify-center text-2xl font-bold text-orange-700">
                    {index + 1}
                  </div>
                  <div class="flex-1">
                    <h3 class="text-xl font-semibold text-gray-900 mb-2">
                      {step.step}
                    </h3>
                    <p class="text-gray-600 leading-relaxed">
                      {step.desc}
                    </p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </section>

        <!-- FAQ Section -->
        <ServiceFAQ
          title="سوالات"
          titleGradient="متداول"
          subtitle="پاسخ به پرسش‌های رایج مشتریان درباره قیف فروش"
          faqs={faqs}
        />

        <!-- CTA Section -->
        <ServiceCTA
          title="چرا بسیاری از مشتریان بالقوه را از دست می‌دهید؟"
          description="احتمال خیلی بالا است که قیف فروش شما بهینه نباشد و مشتریان شما در مسیر خرید رها شوند. عصر سئو با تحلیل علمی و پیاده‌سازی اتوماسیون پیشرفته، نرخ تبدیل شما را تا ۵ برابر افزایش می‌دهد. اجازه ندهید مشتریان شما به رقبا بروند!"
          primaryCta={{ text: "شروع بهینه‌سازی قیف فروش" }}
          secondaryCta={{ text: "تحلیل رایگان قیف فروش فعلی" }}
          primaryClass="bg-orange-600 hover:bg-orange-700 text-white"
        />
      </main>

      <Footer />
    </div>
</BaseLayout>
