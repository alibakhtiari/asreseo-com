---
import { withServiceMeta } from '../../../lib/service-schema';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Layout/Header.astro';
import Footer from '../../../components/Layout/Footer.astro';
import Button from '../../../components/ui/button/Button.astro';
import Card from '../../../components/ui/card/Card.astro';
import CardContent from '../../../components/ui/card/CardContent.astro';
import CardHeader from '../../../components/ui/card/CardHeader.astro';
import CardTitle from '../../../components/ui/card/CardTitle.astro';
import Picture from '../../../components/ui/Picture.astro';
import Icon from '../../../components/ui/Icon.astro';
import BreadcrumbStructuredData from '../../../components/BreadcrumbStructuredData.astro';
import ServiceFAQ from '../../../components/Services/ServiceFAQ.astro';

const marketingServices = [
    {
        code: 'VEC_01',
        title: 'Google Ads & Search Arbitrage',
        description: 'Instant qualified demand capture with algorithmic keyword bid balancing, programmatic ad copy generation, and reduced CPC.',
        icon: "target",
        features: ['Algorithmic keyword research & clustering', 'Automated bid management & negative matching', 'Quality score lift & lower CPC', 'Deterministic conversion tracking'],
        href: '/services/marketing/google-ads/'
    },
    {
        code: 'VEC_02',
        title: 'Social Distribution & Growth',
        description: 'Scalable brand authority and engagement velocity across professional and algorithmic social platforms.',
        icon: "share2",
        features: ['Deterministic publishing matrix', 'Audience retention video frameworks', 'Entity-building authority hooks', 'Targeted audience acquisition'],
        href: '/services/marketing/social-media/'
    },
    {
        code: 'VEC_03',
        title: 'Email Infrastructure & Retention',
        description: 'Automated lifecycle loops turning transient visitors into high-LTV recurring enterprise customers.',
        icon: "mail",
        features: ['Triggered behavioral workflow sequences', 'Predictive customer segmentation', 'Dynamic personalization payloads', 'Deliverability & SPF/DKIM/DMARC hygiene'],
        href: '/services/marketing/email-marketing/'
    },
    {
        code: 'VEC_04',
        title: 'Sales Funnel & Conversion Engineering',
        description: 'End-to-end friction reduction across discovery, consideration, and checkout workflows to elevate ROAS.',
        icon: "filter",
        features: ['High-converting landing page frameworks', 'Algorithmic multivariate A/B testing', 'Checkout funnel leakage patching', 'LTV-to-CAC ratio acceleration'],
        href: '/services/marketing/sales-funnel-management/'
    },
    {
        code: 'VEC_05',
        title: 'Integrated 360° Omnichannel Execution',
        description: 'Synchronized cross-platform deployment ensuring relentless brand presence and compounded ROI.',
        icon: "layers",
        features: ['Unified cross-channel attribution modeling', 'Synchronized messaging architecture', 'Comprehensive blended ROAS monitoring', 'Omnichannel budget reallocation'],
        href: '/services/marketing/integrated-campaigns/'
    }
];

const faqs = [
    {
        q: 'How does programmatic Google Ads integrate with autonomous SEO?',
        a: 'We use high-intent paid search data to discover exact converting search terms in real-time, then feed those semantic vectors immediately into our automated organic indexation engine for permanent organic rank dominance.'
    },
    {
        q: 'Can budget allocations be algorithmically controlled across campaigns?',
        a: 'Yes. Daily and monthly budget caps are enforced with automated spend guards that throttle ad spend during sub-optimal conversion hours and surge bids during peak conversion windows.'
    },
    {
        q: 'How is omnichannel Return on Ad Spend (ROAS) verified?',
        a: 'We install server-side conversion tracking (Google Enhanced Conversions, CAPI) that bypasses client-side ad blockers to give you mathematically verifiable CAC, blended ROAS, and customer lifetime value.'
    }
];

const serviceSchema = {
    '@context': 'https://schema.org',
    '@type': 'Service',
    'name': 'Autonomous Digital Marketing & Paid Acquisition Suite',
    'description': 'Algorithmic digital marketing infrastructure including Google Ads, email automation, funnel engineering, and omnichannel campaigns by AsreSEO.',
    'inLanguage': 'en-US',
    'provider': {
        '@type': 'Organization',
        'name': 'AsreSEO',
        'url': 'https://asreseo.com',
        'logo': 'https://asreseo.com/Logo.svg'
    },
    'hasOfferCatalog': {
        '@type': 'OfferCatalog',
        'name': 'AsreSEO Digital Marketing Services',
        'itemListElement': marketingServices.map(s => ({
            '@type': 'Offer',
            'itemOffered': {
                '@type': 'Service',
                'name': s.title,
                'description': s.description
            }
        }))
    }
};

const breadcrumbs = [
    { position: 1, name: 'Home', item: 'https://asreseo.com/' },
    { position: 2, name: 'Marketing Services', item: 'https://asreseo.com/services/marketing/' },
];
---

<BaseLayout
    lang="en"
    title="Digital Marketing & Google Ads Services | AsreSEO"
    description="AsreSEO full-service digital marketing: Google Ads management, social media marketing, email marketing and sales funnel optimization to lift conversion rates."
    keywords="digital marketing, digital marketing services, Google Ads, Google advertising, email marketing, social media, sales funnel, ad campaigns"
    canonical="/services/marketing/"
    ogType="website"
    ogUrl="https://asreseo.com/services/marketing/"
    ogImages={[{ url: "/og/services-marketing.jpg", width: 1200, height: 630, alt: "AsreSEO digital marketing and Google Ads services" }]}
    twitterCard="summary_large_image"
>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(withServiceMeta(serviceSchema, { url: 'https://asreseo.com/services/marketing/', image: '/og/services-marketing.jpg' }))} />
    <BreadcrumbStructuredData items={breadcrumbs} />

    <div class="min-h-screen bg-[#000000] text-slate-100 wireframe-grid">
        <Header lang="en" />
        <main class="pt-28 pb-20">
            <!-- Hero Section -->
            <section class="py-16 md:py-24 border-b-2 border-white/10 relative">
                <div class="w-full max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 relative z-10">
                    <div class="grid lg:grid-cols-12 gap-12 items-center">
                        <div class="lg:col-span-7 text-left order-2 lg:order-1">
                            <div class="inline-flex items-center gap-3 px-3.5 py-1.5 bg-[#0a0d14] border border-white/20 mb-8 font-mono text-xs tracking-wider uppercase">
                                <span class="w-2.5 h-2.5 rounded-full bg-[#CCFF00] animate-pulse"></span>
                                <span class="text-[#CCFF00] font-bold">[PROTOCOL_04 // MULTI_CHANNEL_ENGINE]</span>
                                <span class="text-slate-500">|</span>
                                <span class="text-slate-300">ROAS ARBITRAGE</span>
                            </div>

                            <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black uppercase text-white mb-6 tracking-tight leading-[1.05]">
                                Autonomous <span class="text-[#CCFF00]">Marketing</span> & Acquisition Suite
                            </h1>

                            <p class="text-lg sm:text-xl text-slate-300 leading-relaxed max-w-2xl mb-8">
                                Deterministic customer acquisition combining programmatic Google Ads arbitrage, high-velocity email funnels, and data-driven cross-channel distribution.
                            </p>

                            <div class="flex flex-wrap gap-4 font-mono text-xs">
                                <Button
                                    variant="acid"
                                    size="lg"
                                    class="px-8 py-4"
                                    href="/consultation/"
                                >
                                    Deploy Acquisition Funnel ↗
                                </Button>
                                <Button
                                    variant="brutalist"
                                    size="lg"
                                    class="px-8 py-4"
                                    href="/services/marketing/google-ads/"
                                >
                                    Inspect Google Ads Protocol
                                </Button>
                            </div>
                        </div>

                        <div class="lg:col-span-5 order-1 lg:order-2 border-2 border-white/20 bg-[#090d16] brutalist-card brutalist-shadow-white group overflow-hidden">
                            <div class="p-3 bg-black border-b border-white/10 font-mono text-[11px] flex items-center justify-between text-slate-400">
                                <span class="text-[#CCFF00] font-bold">CAMPAIGN_NODE // ONLINE</span>
                                <span>ROAS: 4.8X AVG</span>
                            </div>
                            <div class="relative h-72 sm:h-80 md:h-96 w-full overflow-hidden">
                                <Picture
                                    src="/images/services-marketing.webp"
                                    alt="AsreSEO digital marketing and Google Ads services"
                                    class="object-cover w-full h-full group-hover:scale-105 transition-transform duration-700 opacity-90"
                                    eager
                                    sizes="(max-width: 768px) 100vw, 50vw"
                                />
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Services Grid -->
            <section class="py-20 border-b-2 border-white/10 bg-[#05070d]">
                <div class="w-full max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
                    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6 pb-6 border-b border-white/15">
                        <div>
                            <div class="font-mono text-xs text-[#CCFF00] uppercase tracking-widest mb-2">[TACTICAL_DISPATCH]</div>
                            <h2 class="text-3xl sm:text-4xl font-black uppercase tracking-tight text-white">Specialized Acquisition Vectors</h2>
                        </div>
                        <p class="text-slate-400 font-mono text-xs max-w-md">// Mathematical precision applied to paid search, retention loops, and conversion rate optimization.</p>
                    </div>

                    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                        {marketingServices.map((service) => (
                            <Card class="bg-[#0a0e17] border-2 border-white/15 brutalist-card group hover:border-[#CCFF00] transition-colors p-6 sm:p-8 flex flex-col justify-between rounded-none">
                                <div>
                                    <div class="flex items-center justify-between pb-4 mb-6 border-b border-white/10 font-mono text-xs">
                                        <span class="text-[#CCFF00] font-bold">{service.code} //</span>
                                        <div class="w-8 h-8 bg-black border border-white/20 flex items-center justify-center text-[#CCFF00]">
                                            <Icon name={service.icon} class="h-4 w-4" />
                                        </div>
                                    </div>
                                    <CardHeader class="p-0 mb-4">
                                        <CardTitle class="text-xl font-black uppercase text-white group-hover:text-[#CCFF00] transition-colors">
                                            <a href={service.href}>{service.title}</a>
                                        </CardTitle>
                                    </CardHeader>
                                    <CardContent class="p-0">
                                        <p class="text-slate-300 text-xs sm:text-sm leading-relaxed mb-6">
                                            {service.description}
                                        </p>
                                        <ul class="space-y-2.5 font-mono text-xs text-slate-400 mb-6">
                                            {service.features.map((feature) => (
                                                <li class="flex items-start">
                                                    <span class="text-[#CCFF00] font-bold me-2">[✓]</span>
                                                    <span>{feature}</span>
                                                </li>
                                            ))}
                                        </ul>
                                    </CardContent>
                                </div>
                                <div class="pt-4 border-t border-white/10 font-mono text-xs">
                                    <a href={service.href} class="inline-flex items-center text-[#CCFF00] font-bold hover:underline">
                                        Inspect Protocol Specs ↗
                                    </a>
                                </div>
                            </Card>
                        ))}
                    </div>
                </div>
            </section>

            <!-- FAQ Section -->
            <ServiceFAQ lang="en" title="Acquisition Protocol FAQs" subtitle="Deterministic answers regarding ad budgeting, attribution tracking, and blended ROAS" faqs={faqs} />

            <!-- CTA Terminal -->
            <section class="py-20 bg-[#000000]">
                <div class="w-full max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
                    <div class="p-8 sm:p-12 bg-[#090d16] border-2 border-[#CCFF00] brutalist-shadow-white flex flex-col md:flex-row items-center justify-between gap-8">
                        <div class="space-y-2 text-center md:text-left">
                            <div class="font-mono text-xs text-[#CCFF00] uppercase font-bold tracking-wider">[COMMISSION_CAMPAIGN]</div>
                            <h2 class="text-2xl sm:text-4xl font-black text-white uppercase">Ready to Scale Customer Acquisition?</h2>
                            <p class="text-slate-300 text-sm sm:text-base max-w-xl">
                                Consult directly with our senior acquisition engineers to audit your current ad spend, funnel leakage, and attribution pipeline.
                            </p>
                        </div>
                        <div class="flex flex-col sm:flex-row gap-4 font-mono text-xs shrink-0">
                            <Button
                                variant="acid"
                                size="lg"
                                class="px-8 py-4"
                                href="/consultation/"
                            >
                                Schedule Acquisition Audit ↗
                            </Button>
                        </div>
                    </div>
                </div>
            </section>
        </main>
        <Footer lang="en" />
    </div>
</BaseLayout>
