---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Layout/Header.astro';
import Footer from '../../../components/Layout/Footer.astro';
import Button from '../../../components/ui/button/Button.astro';
import Card from '../../../components/ui/card/Card.astro';
import CardContent from '../../../components/ui/card/CardContent.astro';
import CardHeader from '../../../components/ui/card/CardHeader.astro';
import CardTitle from '../../../components/ui/card/CardTitle.astro';
import Picture from '../../../components/ui/Picture.astro';
import Icon from '../../../components/ui/Icon.astro';
import Accordion from '../../../components/ui/Accordion.astro';
import AccordionContent from '../../../components/ui/AccordionContent.astro';
import AccordionItem from '../../../components/ui/AccordionItem.astro';
import AccordionTrigger from '../../../components/ui/AccordionTrigger.astro';

const webServices = [
    {
        title: 'طراحی سایت سئو محور',
        description: 'ساخت وب‌سایت‌هایی که از همان ابتدا برای رتبه‌بندی عالی در موتورهای جستجو طراحی شده‌اند.',
        icon: "search",
        features: ['ساختار کد استاندارد', 'رعایت اصول سئو تکنیکال', 'Mobile First Design', 'یکپارچگی با گوگل'],
        gradient: 'from-blue-500 to-indigo-700',
        href: '/services/web/seo-web-design/'
    },
    {
        title: 'بهینه‌سازی سرعت سایت (Core Web Vitals)',
        description: 'افزایش سرعت بارگذاری به زیر ۲ ثانیه برای بهبود تجربه کاربری و رتبه گوگل.',
        icon: "gauge",
        features: ['بهینه‌سازی تصاویر نسل جدید', 'کاهش حجم کدها و CSS/JS', 'تنظیمات کش پیشرفته', 'بهبود امتیاز PageSpeed'],
        gradient: 'from-orange-500 to-red-700',
        href: '/services/web/website-speed/'
    },
    {
        title: 'طراحی صفحات فرود (Landing Pages)',
        description: 'طراحی لندینگ پیج‌های حرفه‌ای با هدف افزایش مستقیم فروش و نرخ تبدیل کمپین‌ها.',
        icon: "layout",
        features: ['طراحی اختصاصی و جذاب', 'کال تو اکشن‌های موثر', 'سرعت بسیار بالا', 'بهینه‌سازی نرخ تبدیل (CRO)'],
        gradient: 'from-purple-500 to-fuchsia-700',
        href: '/services/web/landing-pages/'
    },
    {
        title: 'معماری اطلاعات و تجربه کاربری (UX)',
        description: 'طراحی اصولی مسیر حرکت کاربر برای ایجاد تجربه‌ای لذت‌بخش و افزایش زمان ماندگاری.',
        icon: "smartphone",
        features: ['User Research عمیق', 'طراحی وایرفریم اختصاصی', 'بهبود دسترسی‌پذیری', 'تست‌های کاربردپذیری'],
        gradient: 'from-teal-500 to-cyan-700',
        href: '/services/web/ux-architecture/'
    }
];

const faqs = [
    {
        q: 'طراحی سایت سئومحور در عصر سئو چه فرقی با طراحی سایت معمولی دارد؟',
        a: 'در طراحی سئومحور، از اولین خط کدنویسی ساختار هدینگ‌ها، متاتگ‌ها، نشانه‌گذاری‌های اسکیما، سلسله‌مراتب URLها، بهینه‌سازی تصاویر و کدهای سبک بر اساس آخرین استانداردهای گوگل پیاده‌سازی می‌شوند تا سایت بلافاصله پس از لانچ آماده رتبه‌گیری باشد.'
    },
    {
        q: 'آیا سرعت وب‌سایت‌های طراحی شده تضمین می‌شود؟',
        a: 'بله. ما لود زیر ۲ ثانیه و کسب نمره سبز در گزارش Core Web Vitals گوگل (Google PageSpeed Insights) را در کلیه پروژه‌های طراحی و بهینه‌سازی سرعت تضمین می‌کنیم.'
    },
    {
        q: 'آیا وب‌سایت‌ها روی موبایل و تبلت به صورت بی‌نقص نمایش داده می‌شوند؟',
        a: 'بله. با توجه به اینکه بیش از ۸۵٪ کاربران با تلفن همراه وب‌گردی می‌کنند، تمام صفحات با رویکرد Mobile-First و به صورت کاملاً ریسپانسیو پیاده‌سازی می‌شوند.'
    }
];

const serviceSchema = {
    '@context': 'https://schema.org',
    '@type': 'Service',
    'name': 'طراحی وب‌سایت سئومحور و توسعه وب',
    'description': 'خدمات تخصصی طراحی وب‌سایت‌های سئومحور، بهینه‌سازی سرعت Core Web Vitals و طراحی لندینگ پیج توسط عصر سئو.',
    'provider': {
        '@type': 'Organization',
        'name': 'عصر سئو',
        'url': 'https://asreseo.com',
        'logo': 'https://asreseo.com/Logo-spaced.png'
    },
    'areaServed': 'Iran',
    'hasOfferCatalog': {
        '@type': 'OfferCatalog',
        'name': 'خدمات طراحی و توسعه وب عصر سئو',
        'itemListElement': webServices.map(s => ({
            '@type': 'Offer',
            'itemOffered': {
                '@type': 'Service',
                'name': s.title,
                'description': s.description
            }
        }))
    }
};

const faqSchema = {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    'mainEntity': faqs.map(f => ({
        '@type': 'Question',
        'name': f.q,
        'acceptedAnswer': {
            '@type': 'Answer',
            'text': f.a
        }
    }))
};

const breadcrumbSchema = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    'itemListElement': [
        { '@type': 'ListItem', 'position': 1, 'name': 'خانه', 'item': 'https://asreseo.com/' },
        { '@type': 'ListItem', 'position': 2, 'name': 'خدمات وب', 'item': 'https://asreseo.com/services/web/' }
    ]
};
---

<BaseLayout
    title='طراحی وب‌سایت سئومحور و توسعه وب | عصر سئو'
    description='خدمات تخصصی طراحی وب‌سایت‌های سئومحور، بهینه‌سازی سرعت و Core Web Vitals، طراحی لندینگ پیج و تجربه کاربری (UX) توسط تیم فنی عصر سئو.'
    keywords='طراحی وب‌سایت, طراحی سایت سئو محور, توسعه وب, بهینه‌سازی سرعت سایت, Core Web Vitals, لندینگ پیج, تجربه کاربری, UX'
    canonical='https://asreseo.com/services/web/'
    ogType='website'
    ogUrl='https://asreseo.com/services/web/'
    ogImages={[{ url: "/images/web-design-hero.webp", width: 1200, height: 630, alt: "طراحی وب‌سایت سئو محور و بهینه‌سازی سرعت عصر سئو" }]}
    twitterCard='summary_large_image'
>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(serviceSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />

    <div class="min-h-screen bg-white">
        <Header />
        <main>
            <!-- Hero Section -->
            <section class="section-padding bg-linear-to-br from-indigo-50 to-purple-50 overflow-hidden relative">
                <div class="absolute top-0 right-0 w-1/3 h-full bg-indigo-100/50 blur-3xl -z-10 rounded-full mix-blend-multiply opacity-70 animate-blob"></div>
                <div class="absolute bottom-0 left-0 w-1/3 h-full bg-purple-100/50 blur-3xl -z-10 rounded-full mix-blend-multiply opacity-70 animate-blob animation-delay-2000"></div>

                <div class="container-custom relative z-10">
                    <div class="grid lg:grid-cols-2 gap-12 items-center">
                        <div class="text-right animate-fade-in order-2 lg:order-1">
                            <div class="inline-flex items-center gap-2 bg-indigo-100 text-indigo-700 px-4 py-2 rounded-full text-sm font-medium mb-6">
                                <Icon name="code" class="h-4 w-4" />
                                تلفیق زیبایی بصری، سرعت و استانداردهای سئو
                            </div>
                            <h1 class="text-4xl md:text-6xl font-bold text-gray-900 mb-6 leading-tight">
                                طراحی وب‌سایت <span class="gradient-text">سئومحور</span> و مدرن
                            </h1>
                            <p class="text-xl text-gray-600 mb-8 leading-relaxed">
                                وب‌سایتی سریع، واکنش‌گرا و بهینه‌سازی شده برای گوگل بسازید که بازدیدکنندگان را به مشتریان وفادار تبدیل کند. رعایت دقیق اصول Core Web Vitals و سئو تکنیکال.
                            </p>
                            <div class="flex flex-col sm:flex-row gap-4 justify-start">
                                <a href="/consultation/">
                                    <Button size="lg" class="gradient-bg text-white px-8 hover:shadow-lg hover:shadow-indigo-500/30 transition-all duration-300">
                                        سفارش طراحی سایت
                                    </Button>
                                </a>
                                <a href="/services/web/website-speed/">
                                    <Button variant="outline" size="lg" class="border-indigo-200 text-indigo-700 hover:bg-indigo-50">
                                        بهینه‌سازی سرعت سایت
                                    </Button>
                                </a>
                            </div>
                        </div>

                        <div class="relative h-87.5 md:h-112.5 w-full rounded-2xl overflow-hidden shadow-2xl animate-fade-in order-1 lg:order-2 ring-1 ring-gray-200/50 group">
                            <div class="absolute inset-0 bg-linear-to-tr from-indigo-600/10 to-transparent z-10" />
                            <Picture
                                src="/images/web-design-hero.webp"
                                alt="طراحی وب‌سایت سئو محور و بهینه‌سازی سرعت عصر سئو"
                                class="object-cover group-hover:scale-105 transition-transform duration-700 w-full h-full"
                                eager
                                sizes="(max-width: 768px) 100vw, 50vw"
                            />
                        </div>
                    </div>
                </div>
            </section>

            <!-- Services Grid -->
            <section class="section-padding">
                <div class="container-custom">
                    <div class="text-center mb-16">
                        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">خدمات طراحی و توسعه وب عصر سئو</h2>
                        <p class="text-gray-600 max-w-2xl mx-auto">ارائه راهکارهای جامع فنی برای داشتن وب‌سایتی پایدار، فوق‌العاده سریع و آماده رتبه‌گیری</p>
                    </div>

                    <div class="grid md:grid-cols-2 gap-8">
                        {webServices.map((service) => (
                            <Card class="hover:shadow-xl transition-all duration-300 group overflow-hidden border-gray-200">
                                <CardHeader class="p-8">
                                    <div class={`w-14 h-14 bg-linear-to-r ${service.gradient} rounded-xl flex items-center justify-center mb-6 text-white shadow-md`}>
                                        <Icon name={service.icon} class="h-7 w-7" />
                                    </div>
                                    <CardTitle class="text-2xl font-bold mb-3 group-hover:text-indigo-600 transition-colors">
                                        <a href={service.href}>{service.title}</a>
                                    </CardTitle>
                                    <p class="text-gray-600 leading-relaxed text-base">
                                        {service.description}
                                    </p>
                                </CardHeader>
                                <CardContent class="px-8 pb-8 pt-0">
                                    <div class="grid grid-cols-2 gap-3 mb-6">
                                        {service.features.map((feature) => (
                                            <div class="flex items-center gap-2 text-sm text-gray-600">
                                                <div class="w-1.5 h-1.5 rounded-full bg-indigo-500 shrink-0" />
                                                {feature}
                                            </div>
                                        ))}
                                    </div>
                                    <a href={service.href} class="inline-flex items-center text-sm font-semibold text-indigo-600 hover:text-indigo-700 pt-4 border-t border-gray-100">
                                        مشاهده مشخصات و تعرفه‌ها
                                        <Icon name="arrow-left" class="w-4 h-4 mr-2" />
                                    </a>
                                </CardContent>
                            </Card>
                        ))}
                    </div>
                </div>
            </section>

            <!-- FAQ Section -->
            <section class="section-padding bg-slate-50 border-t border-gray-100">
                <div class="container-custom max-w-4xl">
                    <div class="text-center mb-12">
                        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
                            پرسش‌های متداول طراحی وب‌سایت و سرعت
                        </h2>
                        <p class="text-lg text-gray-600">
                            پاسخ به سوالات کلیدی درباره کدنویسی سئومحور، سرعت بارگذاری و ریسپانسیو بودن
                        </p>
                    </div>

                    <Accordion type="single" collapsible class="w-full" dir="rtl">
                        {faqs.map((faq, index) => (
                            <AccordionItem value={`item-${index}`} class="bg-white mb-3 rounded-xl border border-gray-200 px-4">
                                <AccordionTrigger class="text-right text-lg font-medium text-gray-900 hover:text-indigo-600">
                                    {faq.q}
                                </AccordionTrigger>
                                <AccordionContent class="text-right text-gray-600 text-base leading-relaxed pt-2 pb-4">
                                    {faq.a}
                                </AccordionContent>
                            </AccordionItem>
                        ))}
                    </Accordion>
                </div>
            </section>

            <!-- CTA Section -->
            <section class="section-padding bg-slate-900 text-white">
                <div class="container-custom text-center max-w-3xl">
                    <h2 class="text-3xl md:text-4xl font-bold mb-6">می‌خواهید وب‌سایت شما سریع‌تر و پربازده‌تر باشد؟</h2>
                    <p class="text-xl text-gray-300 mb-8 leading-relaxed">
                        برای ارزیابی رایگان سرعت، تجربه کاربری و سئوی تکنیکال وب‌سایت خود، با تیم مهندسی عصر سئو تماس بگیرید.
                    </p>
                    <div class="flex flex-col sm:flex-row gap-4 justify-center">
                        <a href="tel:+989125811880">
                            <Button size="lg" class="bg-white text-slate-900 hover:bg-gray-100 px-8 font-bold">
                                <Icon name="phone" class="ml-2 h-5 w-5" />
                                تماس مستقیم: ۰۹۱۲۵۸۱۱۸۸۰
                            </Button>
                        </a>
                        <a href="/consultation/">
                            <Button size="lg" variant="outline" class="border-gray-600 text-white hover:bg-slate-800 px-8">
                                رزرو وقت مشاوره آنلاین
                            </Button>
                        </a>
                    </div>
                </div>
            </section>
        </main>
        <Footer />
    </div>
</BaseLayout>
