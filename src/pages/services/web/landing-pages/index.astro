---
import { withServiceMeta } from '../../../../lib/service-schema';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Header from '../../../../components/Layout/Header.astro';
import Footer from '../../../../components/Layout/Footer.astro';
import Card from '../../../../components/ui/card/Card.astro';
import CardContent from '../../../../components/ui/card/CardContent.astro';
import CardHeader from '../../../../components/ui/card/CardHeader.astro';
import CardTitle from '../../../../components/ui/card/CardTitle.astro';
import Badge from '../../../../components/ui/badge/Badge.astro';
import Icon from '../../../../components/ui/Icon.astro';
import ServiceHero from '../../../../components/Services/ServiceHero.astro';
import ServiceStats from '../../../../components/Services/ServiceStats.astro';
import ServiceFAQ from '../../../../components/Services/ServiceFAQ.astro';
import ServiceCTA from '../../../../components/Services/ServiceCTA.astro';
import BreadcrumbStructuredData from '../../../../components/BreadcrumbStructuredData.astro';
import ServiceBenefits from '../../../../components/Services/ServiceBenefits.astro';





const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  'name': 'Custom Landing Page Design',
  'description': 'Design and development of dedicated landing pages with a focus on high conversion rates',
  'serviceType': 'Landing Page Design & Development',
  'provider': {
    '@type': 'Organization',
    'name': 'AsreSEO',
    'url': 'https://asreseo.com'
  },
  'inLanguage': 'en-US',
  'hasOfferCatalog': {
    '@type': 'OfferCatalog',
    'name': 'Landing Page Design Services',
    'itemListElement': [
      {
        '@type': 'Offer',
        'itemOffered': {
          '@type': 'Service',
          'name': 'High-Conversion Landing Page',
          'description': 'Landing pages with optimized conversion rates'
        }
      }
    ]
  }
}



  const landingFeatures = [
    {
      icon: "mouse-pointer-click",
      title: 'Built for High Conversion',
      description: 'Designed with CRO principles to steer users toward action with optimized CTAs',
      benefits: ['Measurable conversion lift', 'Psychology-driven factors', 'Strong call to action']
    },
    {
      icon: "scroll-text",
      title: 'Optimized for Ads & SEO',
      description: 'Landing pages that compete in paid campaigns and rank for long-tail keywords',
      benefits: ['Better keyword rankings', 'Improved ad ROI', 'Faster indexing']
    },
    {
      icon: "monitor-smartphone",
      title: 'Fully Responsive & Fast',
      description: 'Pixel-perfect on every device with high load speed and zero distracting scroll',
      benefits: ['Full mobile support', 'High load speed', 'Consistent experience']
    },
    {
      icon: "palette",
      title: 'On-Brand Visual Identity',
      description: 'Colors and graphic design matched to your brand strategy and target users',
      benefits: ['Stronger brand recognition', 'Greater customer trust', 'Strategic merchandising']
    },
    {
      icon: "eye",
      title: 'Advanced Analytics & A/B Testing',
      description: 'Precise user-behavior tracking with heatmaps and statistical tests for maximum optimization',
      benefits: ['Continuous data-driven improvement', 'Data-centric decisions', 'Scientific decision-making']
    },
    {
      icon: "trending-up",
      title: 'Marketing-Tool Integrations',
      description: 'Direct connections to your CRM, email systems and marketing automation tools',
      benefits: ['Peak operational efficiency', 'Time savings', 'High close rate']
    }
  ];

  const conversionElements = [
    {
      element: 'Compelling Headline',
      importance: 'The first thing visitors see',
      effect: 'Direct impact on click-through rate'
    },
    {
      element: 'Strong CTA Buttons',
      importance: 'Eye-catching calls to action',
      effect: 'Better conversion rate'
    },
    {
      element: 'Social Proof',
      importance: 'An atmosphere of trust and credibility',
      effect: 'Stronger trust and conversions'
    },
    {
      element: 'Urgency Elements',
      importance: 'Creating a sense of urgency',
      effect: 'Faster purchase decisions'
    },
    {
      element: 'Video Demo',
      importance: 'Showing the product in action',
      effect: 'Longer visitor dwell time'
    },
    {
      element: 'Testimonials',
      importance: 'Proof of customer satisfaction',
      effect: 'Higher trust rate'
    }
  ];

  const caseStudies = [
    {
      client: 'FinTech Startup',
      problem: 'Low conversion rate and short dwell time',
      solution: 'Landing page design with video demo and pricing tables',
      result: 'Steady conversion and monthly revenue growth, trackable in the reporting dashboard'
    },
    {
      client: 'Medical Clinic',
      problem: 'Too few patients, weak online presence',
      solution: 'Landing page with free-consultation form and social proof',
      result: 'A steady flow of new patients via the online booking form, with booking rates monitored in the reporting dashboard'
    },
    {
      client: 'Online Store',
      problem: 'Low purchase rate and high cart abandonment',
      solution: 'Removing distractions, focusing on one goal',
      result: 'Purchase-rate and monthly profit growth, measured in the reporting dashboard'
    },
    {
      client: 'Mobile App',
      problem: 'Too few installs, overly technical descriptions',
      solution: 'Landing page with plain explanations and screenshots',
      result: 'Install-rate growth and better app-store ranking, measured in the reporting dashboard'
    }
  ];

  const toolsIntegration = [
    {
      tool: 'Google Analytics 4',
      purpose: 'Tracking user behavior and conversion rates',
      benefit: 'Accurate page-performance data'
    },
    {
      tool: 'Google Optimize',
      purpose: 'Running automated A/B tests',
      benefit: 'Continuous, scientific optimization'
    },
    {
      tool: 'Hotjar',
      purpose: 'Scroll and click heatmaps',
      benefit: 'Understanding behavior and weak spots'
    },
    {
      tool: 'Mailchimp / CRM',
      purpose: 'Lead management and drip marketing',
      benefit: 'Turning visitors into customers'
    },
    {
      tool: 'Facebook Pixel',
      purpose: 'Ad tracking and remarketing',
      benefit: 'Optimized ad spend'
    },
    {
      tool: 'Typeform / Calendly',
      purpose: 'Collecting complete user information',
      benefit: 'Higher-quality leads'
    }
  ];

  const workflowSteps = [
    {
      step: 'Research & Strategy',
      desc: 'Analyzing the target audience, competitors and business goals; mapping the buyer journey',
      duration: '3\u20135 days',
      output: 'Strategy Document & User Journey Map'
    },
    {
      step: 'Design & Wireframing',
      desc: 'Building the page structure, element layout and call-to-action definitions',
      duration: '4\u20137 days',
      output: 'Wireframes & Interactive Prototype'
    },
    {
      step: 'Development & Coding',
      desc: 'Responsive implementation with high speed, connecting forms and required tools',
      duration: '5\u20138 days',
      output: 'Live Landing Page & Integration Setup'
    },
    {
      step: 'Testing & Optimization',
      desc: 'A/B testing, usability testing and user-behavior analysis',
      duration: '4\u20136 days',
      output: 'Optimized Page & Performance Report'
    },
    {
      step: 'Monitoring & Support',
      desc: 'Performance tracking and continuous improvement suggestions for maximum conversion',
      duration: 'Monthly',
      output: 'Monthly Reports & Continuous Optimization'
    }
  ];

  const benefits = [
    'Measurably higher conversion rates with science-led design rooted in consumer psychology',
    'Lower customer acquisition cost (CPA) through sharper targeting',
    'Better goal-completion rates thanks to a smooth, engaging user experience',
    'Higher return on investment through single-goal focus',
    'Stronger brand trust and credibility via social proof and testimonials'
  ];

  const stats = [
    { metric: 'Steady growth', label: 'Measurable conversion rate', icon: "target" },
    { metric: '12 days', label: 'Average build time', icon: "trending-up" },
    { metric: 'Ongoing feedback', label: 'Client satisfaction', icon: "users" },
    { metric: 'Portfolio', label: 'Successful landing pages built', icon: "bar-chart3" }
  ];

  const faqs = [
    {
      question: 'How is a landing page different from my site\u2019s regular pages?',
      answer: 'A landing page has exactly one goal: turning a visitor into a customer. No complex menus, no distracting links, no side quests. Every element is designed to guide users toward one specific action. If your homepage is a bazaar, a landing page is a specialist boutique.'
    },
    {
      question: 'How long does it take to design a landing page?',
      answer: 'Build time depends on complexity. A simple landing page takes 4\u20136 days, an average one 7\u201310 days, and a complex one with advanced animations 2\u20133 weeks. More important than speed is reaching the maximum conversion rate \u2014 if the fastest route delivers a weak rate, it\u2019s worth spending more time.'
    },
    {
      question: 'Do you keep improving the landing page after delivery?',
      answer: 'That may be the most important part of our work! A landing page is never finished \u2014 there\u2019s always room to improve. We monitor it free of charge up to the project\u2019s value, and deliver ongoing improvement suggestions based on heatmap data, A/B tests and user records.'
    },
    {
      question: 'How much does a landing page typically lift conversion rates?',
      answer: 'It varies by industry. Finance pages, B2B software, services and consumer products each see different conversion ranges. Instead of relying on a fixed number, we measure your page\u2019s baseline rate and lift it gradually with A/B testing and optimization. What matters most is turning traffic directly into customers.'
    },
    {
      question: 'Does it still work with a limited ad budget?',
      answer: 'Yes! Landing pages are especially powerful on tight budgets. Paid ads are expensive, and a bad landing page multiplies that waste. An ad campaign spending a fixed budget converts at a higher rate with a good landing page \u2014 meaning more customers from the same budget, at no extra cost.'
    },
    {
      question: 'Why do some landing pages have multiple calls to action?',
      answer: 'With strategy! But those CTAs must be hierarchical: one primary CTA, supporting secondary CTAs, and a final CTA for visitors who aren\u2019t ready yet. Remember, though: more CTAs mean less user focus. The art is making a single primary CTA supported by the rest.'
    }
  ];

---
<BaseLayout lang="en" title='High-Converting Landing Page Design | AsreSEO' description='Custom landing page design with high conversion rates \u2014 optimized for ads and digital marketing campaigns with advanced technology.' keywords='landing page, landing page design, conversion rate, Conversion Rate Optimization' canonical='/services/web/landing-pages/' ogType='website' ogUrl='https://asreseo.com/services/web/landing-pages/' ogImages={[{ url: "/og/landing-page-hero.jpg", width: 1200, height: 630, alt: "Landing page design | AsreSEO" }]} twitterCard='summary_large_image'
  ogTitle='Custom Landing Page Design | AsreSEO'

  ogDescription='High-converting landing pages for advertising and marketing.'
>
<div class="min-h-screen bg-[#000000] text-slate-100 wireframe-grid">
      <script id="structured-data" type="application/ld+json" is:inline set:html={JSON.stringify(withServiceMeta(structuredData, { url: 'https://asreseo.com/services/web/landing-pages/', image: '/og/landing-page-hero.jpg' }))} />

      <Header lang="en" />
      <BreadcrumbStructuredData
        items={[
          { position: 1, name: 'Home', item: 'https://asreseo.com/' },
          { position: 2, name: 'Web Services', item: 'https://asreseo.com/services/web/' },
          { position: 3, name: 'Landing Page Design', item: 'https://asreseo.com/services/web/landing-pages/' }
        ]}
      />

      <main>
        <!-- Hero Section -->
        <ServiceHero lang="en"
          badge="Professional Landing Page Design"
          title="High-Converting Landing Pages"
          titleGradient="High-Converting"
          description="The growth engine of digital campaigns \u2014 turning visitors into loyal customers with AsreSEO\u2019s science-led landing page design."
          primaryCta={{ text: "Start My Landing Page" }}
          secondaryCta={{ text: "Successful Case Studies" }}
          imageSrc="/images/landing-page-hero.webp"
          imageAlt="Custom landing page design"
          theme="purple"
        />

        <!-- Stats Section -->
        <ServiceStats lang="en" stats={stats} theme="purple" />

        <!-- Landing Features Section -->
        <section class="section-padding">
          <div class="container-custom">
            <div class="text-center mb-12">
              <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
                Advanced <span class="gradient-text">Landing Page Design</span> Technology
              </h2>
              <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                A scientific approach to maximum conversion rates
              </p>
            </div>

            <div class="grid md:grid-cols-2 gap-8">
              {landingFeatures.map((feature, index) => (
                <Card class="hover:shadow-xl transition-all duration-300 group border-0 shadow-lg">
                  <CardHeader class="pb-4">
                    <div class="flex items-center gap-3 mb-3">
                      <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center group-hover:bg-purple-200 transition-colors">
                        <Icon name={feature.icon} class="h-6 w-6 text-purple-600" />
                      </div>
                      <CardTitle class="text-xl font-semibold">{feature.title}</CardTitle>
                    </div>
                  </CardHeader>
                  <CardContent>
                    <p class="text-gray-600 mb-4 leading-relaxed">
                      {feature.description}
                    </p>
                    <div class="space-y-2">
                      {feature.benefits.map((benefit, benefitIndex) => (
                        <div class="flex items-center gap-2 text-sm text-gray-500">
                          <Icon name="check-circle2" class="h-4 w-4 text-green-500 shrink-0" />
                          {benefit}
                        </div>
                      ))}
                    </div>
                  </CardContent>
                </Card>
              ))}
            </div>
          </div>
        </section>

        <!-- Conversion Elements Section -->
        <section class="section-padding bg-linear-to-br from-slate-50 to-gray-50">
          <div class="container-custom">
            <div class="text-center mb-12">
              <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
                <span class="gradient-text">Conversion-Boosting</span> Landing Page Elements
              </h2>
              <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                Scientific components for guiding users to buy
              </p>
            </div>

            <div class="grid md:grid-cols-2 gap-8">
              {conversionElements.map((element, index) => (
                <Card class="hover:shadow-lg transition-all duration-300">
                  <CardContent class="p-6">
                    <div class="flex items-start gap-4">
                      <div class="w-12 h-12 bg-orange-100 rounded-lg flex items-center justify-center shrink-0">
                        <Icon name="target" class="h-6 w-6 text-orange-600" />
                      </div>
                      <div class="flex-1">
                        <h3 class="text-lg font-semibold text-gray-900 mb-2">
                          {element.element}
                        </h3>
                        <p class="text-gray-600 mb-3">
                          {element.importance}
                        </p>
                        <Badge class="bg-green-100 text-green-800">
                          {element.effect}
                        </Badge>
                      </div>
                    </div>
                  </CardContent>
                </Card>
              ))}
            </div>
          </div>
        </section>

        <!-- Case Studies Section -->
        <section class="section-padding">
          <div class="container-custom">
            <div class="text-center mb-12">
              <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
                Case Studies & <span class="gradient-text">Client Wins</span>
              </h2>
              <p class="text-xl text-gray-600">
                Real reports of business growth with AsreSEO landing pages
              </p>
            </div>

            <div class="grid md:grid-cols-2 gap-8">
              {caseStudies.map((study, index) => (
                <Card class="hover:shadow-lg transition-shadow border-0 shadow-md">
                  <CardContent class="p-8">
                    <div class="text-center mb-6">
                      <Badge class="bg-indigo-100 text-indigo-700 text-sm mb-2">
                        {study.client}
                      </Badge>
                      <h3 class="text-xl font-semibold text-gray-900">
                        Challenge: {study.problem}
                      </h3>
                    </div>

                    <div class="space-y-4">
                      <div class="flex items-start gap-3">
                        <div class="w-2 h-2 bg-green-500 rounded-full mt-2 shrink-0"></div>
                        <div>
                          <span class="font-medium text-gray-900">Solution: </span>
                          <span class="text-gray-600">{study.solution}</span>
                        </div>
                      </div>
                      <div class="flex items-start gap-3">
                        <div class="w-2 h-2 bg-blue-500 rounded-full mt-2 shrink-0"></div>
                        <div>
                          <span class="font-medium text-gray-900">Result: </span>
                          <span class="text-gray-600">{study.result}</span>
                        </div>
                      </div>
                    </div>
                  </CardContent>
                </Card>
              ))}
            </div>
          </div>
        </section>

        <!-- Tools Integration Section -->
        <section class="section-padding bg-purple-50">
          <div class="container-custom">
            <div class="text-center mb-12">
              <h2 class="text-3xl font-bold text-gray-900 mb-6">
                <span class="gradient-text">Analytics & Optimization</span> Tools
              </h2>
              <p class="text-xl text-gray-600">
                Direct connections to the best digital marketing tools
              </p>
            </div>

            <div class="grid md:grid-cols-2 gap-8">
              {toolsIntegration.map((tool, index) => (
                <Card class="hover:shadow-md transition-shadow">
                  <CardContent class="p-6">
                    <div class="flex items-start gap-4">
                      <div class="w-12 h-12 bg-indigo-100 rounded-lg flex items-center justify-center shrink-0">
                        <Icon name="eye" class="h-6 w-6 text-indigo-600" />
                      </div>
                      <div class="flex-1">
                        <h3 class="text-lg font-semibold text-gray-900 mb-2">
                          {tool.tool}
                        </h3>
                        <p class="text-gray-600 mb-2">
                          {tool.purpose}
                        </p>
                        <Badge variant="outline" class="text-sm">
                          {tool.benefit}
                        </Badge>
                      </div>
                    </div>
                  </CardContent>
                </Card>
              ))}
            </div>
          </div>
        </section>

              <ServiceBenefits lang="en" title="AsreSEO Landing Page Benefits" titleHighlight="AsreSEO" subtitle="Real reports of client growth with professional landing page design" benefits={benefits} />

        <!-- Workflow Section -->
        <section class="section-padding bg-slate-50">
          <div class="container-custom">
            <div class="text-center mb-12">
              <h2 class="text-3xl font-bold text-gray-900 mb-6">
                The <span class="gradient-text">Landing Page</span> Design Process
              </h2>
              <p class="text-xl text-gray-600">
                A 5-step approach to maximum conversion rates
              </p>
            </div>

            <div class="space-y-8">
              {workflowSteps.map((step, index) => (
                <div class="flex items-center gap-8 p-6 bg-white rounded-xl shadow-xs">
                  <div class="w-16 h-16 bg-purple-100 rounded-full flex items-center justify-center text-2xl font-bold text-purple-700">
                    {index + 1}
                  </div>
                  <div class="flex-1">
                    <h3 class="text-xl font-semibold text-gray-900 mb-2">
                      {step.step}
                    </h3>
                    <p class="text-gray-600 leading-relaxed mb-2">
                      {step.desc}
                    </p>
                    <Badge variant="outline" class="text-sm mr-3">
                      Duration: {step.duration}
                    </Badge>
                    <Badge class="bg-green-100 text-green-800">
                      {step.output}
                    </Badge>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </section>

        <!-- FAQ Section -->
        <ServiceFAQ lang="en"
          title="Frequently Asked Questions"
          titleGradient="Asked Questions"
          subtitle="Answers to client questions about landing page design"
          faqs={faqs}
        />

        <!-- CTA Section -->
        <ServiceCTA lang="en"
          title="Let\u2019s turn your campaigns into endless revenue!"
          description="With AsreSEO landing page design, every visitor becomes a customer. Higher conversion rates and lower cost per new customer \u2014 measured in the reporting dashboard. Start the countdown to new customers today!"
          primaryCta={{ text: "Free Landing Page Consultation" }}
          secondaryCta={{ text: "Successful Landing Page Samples" }}
          primaryClass="bg-purple-600 hover:bg-purple-700 text-white font-semibold shadow-lg shadow-purple-600/30"
        />
      </main>

      <Footer lang="en" />
    </div>
</BaseLayout>
