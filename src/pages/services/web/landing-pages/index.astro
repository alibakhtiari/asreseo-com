---
<BaseLayout title='طراحی صفحات فرود | Landing Page اختصاصی | نرخ تبدیل بالا | عصر سئو' description='طراحی صفحات فرود اختصاصی با نرخ تبدیل بالا، بهینه برای تبلیغات و کمپین‌های بازاریابی دیجیتال با فناوری‌های پیشرفته.' keywords='صفحه فرود, Landing Page, طراحی لندینگ, نرخ تبدیل, Conversion Rate Optimization' canonical='https://asreseo.com/services/web/landing-pages/' ogType='website' ogUrl='https://asreseo.com/services/web/landing-pages/' ogImages={[{ url: "/images/landing-page-hero.webp", width: 1200, height: 630, alt: "طراحی صفحات فرود | عصر سئو" }]} twitterCard='summary_large_image'
  ogTitle='طراحی صفحات فرود اختصاصی | عصر سئو'

  ogDescription='طراحی Landing Page با نرخ تبدیل بالا برای تبلیغات و بازاریابی.'
>
<div class="min-h-screen bg-white">
      <script id="structured-data" type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

      <Header />
      <BreadcrumbStructuredData
        items={[
          { name: 'خانه', url: '/' },
          { name: 'خدمات وب', url: '/services/web/' },
          { name: 'طراحی صفحات فرود', url: '/services/web/landing-pages/' }
        ]}
      />

      <main>
        <!-- Hero Section -->
        <ServiceHero
          badge="طراحی صفحات فرود حرفه‌ای"
          title="صفحات فرود"
          titleGradient="پرتبدیل"
          description="موتور رشد کمپین‌های دیجیتال و تبدیل بازدیدکنندگان به مشتریان وفادار با طراحی علمی Landing Page عصر سئو."
          primaryCta={{ text: "شروع طراحی Landing Page" }}
          secondaryCta={{ text: "نمونه کارهای موفق" }}
          imageSrc="/images/landing-page-hero.webp"
          imageAlt="طراحی صفحات فرود اختصاصی"
          theme="purple"
        />

        <!-- Stats Section -->
        <ServiceStats stats={stats} theme="purple" />

        <!-- Landing Features Section -->
        <section class="section-padding">
          <div class="container-custom">
            <div class="text-center mb-12">
              <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
                تکنولوژی‌های پیشرفته <span class="gradient-text">طراحی Landing Page</span>
              </h2>
              <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                رویکرد علمی برای حداکثر نرخ تبدیل
              </p>
            </div>

            <div class="grid md:grid-cols-2 gap-8">
              {landingFeatures.map((feature, index) => (
                <Card class="hover:shadow-xl transition-all duration-300 group border-0 shadow-lg">
                  <CardHeader class="pb-4">
                    <div class="flex items-center gap-3 mb-3">
                      <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center group-hover:bg-purple-200 transition-colors">
                        <Icon name={feature.icon} class="h-6 w-6 text-purple-600" />
                      </div>
                      <CardTitle class="text-xl font-semibold">{feature.title}</CardTitle>
                    </div>
                  </CardHeader>
                  <CardContent>
                    <p class="text-gray-600 mb-4 leading-relaxed">
                      {feature.description}
                    </p>
                    <div class="space-y-2">
                      {feature.benefits.map((benefit, benefitIndex) => (
                        <div class="flex items-center gap-2 text-sm text-gray-500">
                          <Icon name="check-circle2" class="h-4 w-4 text-green-500 shrink-0" />
                          {benefit}
                        </div>
                      ))}
                    </div>
                  </CardContent>
                </Card>
              ))}
            </div>
          </div>
        </section>

        <!-- Conversion Elements Section -->
        <section class="section-padding bg-linear-to-br from-slate-50 to-gray-50">
          <div class="container-custom">
            <div class="text-center mb-12">
              <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
                عناصر <span class="gradient-text">افزایش تبدیل</span> Landing Page
              </h2>
              <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                اجزاء علمی برای هدایت کاربر به خرید
              </p>
            </div>

            <div class="grid md:grid-cols-2 gap-8">
              {conversionElements.map((element, index) => (
                <Card class="hover:shadow-lg transition-all duration-300">
                  <CardContent class="p-6">
                    <div class="flex items-start gap-4">
                      <div class="w-12 h-12 bg-orange-100 rounded-lg flex items-center justify-center shrink-0">
                        <Icon name="target" class="h-6 w-6 text-orange-600" />
                      </div>
                      <div class="flex-1">
                        <h3 class="text-lg font-semibold text-gray-900 mb-2">
                          {element.element}
                        </h3>
                        <p class="text-gray-600 mb-3">
                          {element.importance}
                        </p>
                        <Badge class="bg-green-100 text-green-700">
                          {element.effect}
                        </Badge>
                      </div>
                    </div>
                  </CardContent>
                </Card>
              ))}
            </div>
          </div>
        </section>

        <!-- Case Studies Section -->
        <section class="section-padding">
          <div class="container-custom">
            <div class="text-center mb-12">
              <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
                نمونه کارها و <span class="gradient-text">موفقیت مشتریان</span>
              </h2>
              <p class="text-xl text-gray-600">
                آمار واقعی از بهبود کسب‌وکارها با Landing Page عصر سئو
              </p>
            </div>

            <div class="grid md:grid-cols-2 gap-8">
              {caseStudies.map((study, index) => (
                <Card class="hover:shadow-lg transition-shadow border-0 shadow-md">
                  <CardContent class="p-8">
                    <div class="text-center mb-6">
                      <Badge class="bg-indigo-100 text-indigo-700 text-sm mb-2">
                        {study.client}
                      </Badge>
                      <h3 class="text-xl font-semibold text-gray-900">
                        چالش: {study.problem}
                      </h3>
                    </div>

                    <div class="space-y-4">
                      <div class="flex items-start gap-3">
                        <div class="w-2 h-2 bg-green-500 rounded-full mt-2 shrink-0"></div>
                        <div>
                          <span class="font-medium text-gray-900">راه حل: </span>
                          <span class="text-gray-600">{study.solution}</span>
                        </div>
                      </div>
                      <div class="flex items-start gap-3">
                        <div class="w-2 h-2 bg-blue-500 rounded-full mt-2 shrink-0"></div>
                        <div>
                          <span class="font-medium text-gray-900">نتیجه: </span>
                          <span class="text-gray-600">{study.result}</span>
                        </div>
                      </div>
                    </div>
                  </CardContent>
                </Card>
              ))}
            </div>
          </div>
        </section>

        <!-- Tools Integration Section -->
        <section class="section-padding bg-purple-50">
          <div class="container-custom">
            <div class="text-center mb-12">
              <h2 class="text-3xl font-bold text-gray-900 mb-6">
                ابزارهای <span class="gradient-text">تحلیل و بهینه‌سازی</span>
              </h2>
              <p class="text-xl text-gray-600">
                اتصال مستقیم به بهترین ابزارهای بازاریاب دیجیتال
              </p>
            </div>

            <div class="grid md:grid-cols-2 gap-8">
              {toolsIntegration.map((tool, index) => (
                <Card class="hover:shadow-md transition-shadow">
                  <CardContent class="p-6">
                    <div class="flex items-start gap-4">
                      <div class="w-12 h-12 bg-indigo-100 rounded-lg flex items-center justify-center shrink-0">
                        <Icon name="eye" class="h-6 w-6 text-indigo-600" />
                      </div>
                      <div class="flex-1">
                        <h3 class="text-lg font-semibold text-gray-900 mb-2">
                          {tool.tool}
                        </h3>
                        <p class="text-gray-600 mb-2">
                          {tool.purpose}
                        </p>
                        <Badge variant="outline" class="text-sm">
                          {tool.benefit}
                        </Badge>
                      </div>
                    </div>
                  </CardContent>
                </Card>
              ))}
            </div>
          </div>
        </section>

        <!-- Benefits Section -->
        <section class="section-padding">
          <div class="container-custom">
            <div class="text-center mb-12">
              <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
                مزایای Landing Page <span class="gradient-text">عصر سئو</span>
              </h2>
              <p class="text-xl text-gray-600 max-w-2xl mx-auto">
                آمار واقعی از بهبود مشتریان با طراحی Landing Page حرفه‌ای
              </p>
            </div>

            <div class="grid md:grid-cols-2 gap-6 max-w-4xl mx-auto">
              {benefits.map((benefit, index) => (
                <div class="flex items-start gap-4 p-6 bg-white rounded-xl border border-gray-200 hover:shadow-md transition-shadow">
                  <div class="w-8 h-8 bg-indigo-100 rounded-lg flex items-center justify-center shrink-0">
                    <Icon name="award" class="h-5 w-5 text-indigo-600" />
                  </div>
                  <span class="text-gray-900 font-medium leading-relaxed">
                    {benefit}
                  </span>
                </div>
              ))}
            </div>
          </div>
        </section>

        <!-- Workflow Section -->
        <section class="section-padding bg-slate-50">
          <div class="container-custom">
            <div class="text-center mb-12">
              <h2 class="text-3xl font-bold text-gray-900 mb-6">
                فرآیند طراحی <span class="gradient-text">Landing Page</span>
              </h2>
              <p class="text-xl text-gray-600">
                رویکرد ۵ مرحله‌ای برای حداکثر نرخ تبدیل
              </p>
            </div>

            <div class="space-y-8">
              {workflowSteps.map((step, index) => (
                <div class="flex items-center gap-8 p-6 bg-white rounded-xl shadow-xs">
                  <div class="w-16 h-16 bg-purple-100 rounded-full flex items-center justify-center text-2xl font-bold text-purple-700">
                    {index + 1}
                  </div>
                  <div class="flex-1">
                    <h3 class="text-xl font-semibold text-gray-900 mb-2">
                      {step.step}
                    </h3>
                    <p class="text-gray-600 leading-relaxed mb-2">
                      {step.desc}
                    </p>
                    <Badge variant="outline" class="text-sm mr-3">
                      مدت زمان: {step.duration}
                    </Badge>
                    <Badge class="bg-green-100 text-green-700">
                      {step.output}
                    </Badge>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </section>

        <!-- FAQ Section -->
        <ServiceFAQ
          title="سوالات"
          titleGradient="متداول"
          subtitle="پاسخ به پرسش‌های مشتریان درباره طراحی Landing Page"
          faqs={faqs}
        />

        <!-- CTA Section -->
        <ServiceCTA
          title="کمپین‌های شما را به درآمد بی‌پایان تبدیل کنیم!"
          description="با طراحی Landing Page عصر سئو، هر بازدیدکننده تبدیل به مشتری می‌شود. نرخ تبدیل ۲۵۰% بالاتر، هزینه CPA ۶۵% کمتر. همین امروز شمارش معکوس مشتریان جدید را شروع کنید!"
          primaryCta={{ text: "مشاوره رایگان Landing Page" }}
          secondaryCta={{ text: "نمونه Landing Page موفق" }}
          primaryClass="bg-purple-600 hover:bg-purple-700 text-white"
        />
      </main>

      <Footer />
    </div>
</BaseLayout>
