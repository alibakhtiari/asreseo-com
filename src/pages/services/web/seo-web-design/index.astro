---
import { withServiceMeta } from '../../../../lib/service-schema';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Header from '../../../../components/Layout/Header.astro';
import Footer from '../../../../components/Layout/Footer.astro';
import Card from '../../../../components/ui/card/Card.astro';
import CardContent from '../../../../components/ui/card/CardContent.astro';
import CardHeader from '../../../../components/ui/card/CardHeader.astro';
import CardTitle from '../../../../components/ui/card/CardTitle.astro';
import Badge from '../../../../components/ui/badge/Badge.astro';
import Icon from '../../../../components/ui/Icon.astro';
import ServiceHero from '../../../../components/Services/ServiceHero.astro';
import ServiceStats from '../../../../components/Services/ServiceStats.astro';
import ServiceBenefits from '../../../../components/Services/ServiceBenefits.astro';
import ServiceFAQ from '../../../../components/Services/ServiceFAQ.astro';
import ServiceCTA from '../../../../components/Services/ServiceCTA.astro';
import BreadcrumbStructuredData from '../../../../components/BreadcrumbStructuredData.astro';





const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  'name': 'SEO-Driven Web Design',
  'description': 'Web design services built for SEO, user experience and high conversion rates',
  'serviceType': 'SEO Web Design',
  'provider': {
    '@type': 'Organization',
    'name': 'AsreSEO',
    'url': 'https://asreseo.com'
  },
  'inLanguage': 'en-US',
  'hasOfferCatalog': {
    '@type': 'OfferCatalog',
    'name': 'Web Design Services',
    'itemListElement': [
      {
        '@type': 'Offer',
        'itemOffered': {
          '@type': 'Service',
          'name': 'Responsive Design',
          'description': 'Compatible with every device and screen size'
        }
      },
      {
        '@type': 'Offer',
        'itemOffered': {
          '@type': 'Service',
          'name': 'Speed Optimization',
          'description': 'Load times under 2 seconds'
        }
      }
    ]
  }
};



  const designPrinciples = [
    {
      principle: 'SEO-First Architecture',
      description: 'Your site\u2019s structure is designed from the ground up around Google\u2019s algorithms',
      benefits: ['Faster rankings', 'More visitors', 'Steady sales']
    },
    {
      principle: 'User Experience Excellence',
      description: 'Interfaces designed around customer psychology and real online behavior',
      benefits: ['Higher satisfaction', 'Better conversion rate', 'Returning customers']
    },
    {
      principle: 'Conversion Rate Optimization',
      description: 'Every page element is designed to guide visitors toward taking action',
      benefits: ['More sales', 'Higher conversion rate', 'Better ROI']
    },
    {
      principle: 'Technical Performance',
      description: 'Clean code, high speed and full compatibility with search engines',
      benefits: ['Better efficiency', 'Higher rankings', 'Superb user experience']
    }
  ];

  const seoFeatures = [
    {
      category: 'On-Page SEO',
      features: [
        'SEO-optimized URL hierarchy',
        'Unique title tags and meta descriptions',
        'Optimized heading structure (H1\u2013H6)',
        'Image optimization and alt tags',
        'Implemented schema markup'
      ]
    },
    {
      category: 'Technical SEO',
      features: [
        'Load times under 2 seconds',
        'Full mobile compatibility (Mobile-First)',
        'Implemented SSL security and HTTPS',
        'Optimized Core Web Vitals',
        'Standard XML sitemap and robots.txt'
      ]
    },
    {
      category: 'UX/UI Excellence',
      features: [
        'Clean, user-friendly interface',
        'Simple, logical navigation',
        'Optimized input forms',
        'Strategically placed CTAs',
        'Responsive design for every device'
      ]
    }
  ];

  const conversionElements = [
    {
      element: 'Smart CTAs',
      description: 'Clever, strategic calls to action that lift conversions',
      impact: 'Higher click-through rate'
    },
    {
      element: 'Trust Signals',
      description: 'Trust-building elements from certifications to customer reviews',
      impact: 'Stronger credibility'
    },
    {
      element: 'Social Proof',
      description: 'Stats, client counts and past wins displayed front and center',
      impact: 'Greater trust'
    }
  ];

  const technologyStack = [
    {
      name: 'Next.js 14 Framework',
      description: 'A modern framework with unmatched speed and SEO',
      benefits: ['High speed', 'Excellent SEO', 'SSR/SSG']
    },
    {
      name: 'React Components',
      description: 'Reusable, efficient components',
      benefits: ['High conversion rate', 'Advanced UX', 'Performance']
    },
    {
      name: 'Tailwind CSS',
      description: 'A modern, responsive design system',
      benefits: ['Fast development', 'Full compatibility', 'Automatic optimization']
    },
    {
      name: 'Cloud Database',
      description: 'A powerful, secure cloud database',
      benefits: ['High reliability', 'Fast access', 'Complete security']
    }
  ];

  const comparisonFeatures = [
    {
      feature: 'Load time',
      seoDesign: 'Under 2 seconds',
      regularDesign: 'Usually slower',
      improvement: 'Faster'
    },
    {
      feature: 'Conversion rate',
      seoDesign: 'Higher',
      regularDesign: 'Lower',
      improvement: 'More efficient'
    },
    {
      feature: 'Google ranking',
      seoDesign: 'Pages 1\u20132',
      regularDesign: 'Pages 5\u201310',
      improvement: 'More visibility'
    },
    {
      feature: 'Rebuild cost',
      seoDesign: 'Lower',
      regularDesign: 'Higher',
      improvement: 'Cost savings'
    }
  ];

  const projectPhases = [
    {
      phase: 'Discovery & Strategy',
      description: 'Analyzing needs, competitors and brand strategy'
    },
    {
      phase: 'Information Architecture',
      description: 'Designing content structure and information architecture'
    },
    {
      phase: 'Wireframing & Prototyping',
      description: 'Early mockups and interactive prototypes'
    },
    {
      phase: 'Design & Development',
      description: 'UI design and technical development'
    },
    {
      phase: 'SEO Implementation',
      description: 'Full implementation of technical SEO elements'
    },
    {
      phase: 'Testing & Launch',
      description: 'Final testing and official launch'
    },
    {
      phase: 'Training & Support',
      description: 'Team training and post-launch support'
    }
  ];

  const stats = [
    { metric: '2 seconds', label: 'Load time', icon: "zap" },
    { metric: 'CRO', label: 'Higher conversion rate', icon: "trending-up" },
    { metric: 'SEO-friendly', label: 'Better Google rankings', icon: "search" },
    { metric: 'Mobile-first', label: 'Mobile compatibility', icon: "smartphone" }
  ];

  const benefits = [
    'Higher conversion rates with strategic, UX-led design',
    'Better Google rankings with SEO-friendly architecture',
    'Lower marketing costs thanks to an optimized design',
    'Faster site speed with modern technologies'
  ];

  const faqs = [
    {
      question: 'Why is SEO-driven design better than conventional design?',
      answer: 'SEO-driven design is built for search engines from day one. Every element \u2014 from URLs to code \u2014 is designed to be optimized. As a result your site gets seen sooner, ranks better and converts at a higher rate. In effect, you get part of your SEO done during the design itself.'
    },
    {
      question: 'Will the website be responsive?',
      answer: 'Yes! AsreSEO designs every website mobile-first. That means we design for mobile first, then optimize for larger screens. Most web users are on mobile, so your site is optimized for their primary device.'
    },
    {
      question: 'How long does designing and launching a site take?',
      answer: 'It varies with project complexity, but AsreSEO projects average 2\u20136 weeks. Simple projects take 2 weeks, online stores 4 weeks, and complex enterprise projects at most 6 weeks \u2014 covering design, development, testing and launch.'
    },
    {
      question: 'Do you support the site after launch?',
      answer: 'Yes! Every design package includes a defined support period \u2014 from 3 months on the Startup package up to 12 months on Enterprise. Support covers security updates, bug fixes, team training and optimization consulting.'
    },
    {
      question: 'Which frameworks and technologies do you use?',
      answer: 'We use the latest and best: Next.js 14 for structure, React for components, Tailwind CSS for styling, and a cloud database for top performance. Together they deliver high speed, superb SEO and an outstanding user experience.'
    },
    {
      question: 'How much does SEO-driven web design cost?',
      answer: 'Pricing is based on your needs. The Startup package starts at an affordable entry price suited to small businesses, the Professional package serves growing companies, and the Enterprise package covers large organizations \u2014 each with services matched to your requirements. Request a free consultation for an exact quote.'
    }
  ];


const breadcrumbs = [
    { position: 1, name: 'Home', item: 'https://asreseo.com/' },
    { position: 2, name: 'Web Services', item: 'https://asreseo.com/services/web/' },
    { position: 3, name: 'SEO-Driven Web Design', item: 'https://asreseo.com/services/web/seo-web-design/' },
  ];

---
<BaseLayout lang="en" title='SEO-Driven Web Design & Speed Optimization | AsreSEO' description='SEO-driven web design with high speed, excellent user experience and better Google rankings. Higher conversion rates with professional UX/UI design.' keywords='SEO-driven web design, website design, SEO optimization, UX/UI, responsive design' canonical='/services/web/seo-web-design/' ogType='website' ogUrl='https://asreseo.com/services/web/seo-web-design/' ogImages={[{ url: "/og/web-design-hero.jpg", width: 1200, height: 630, alt: "SEO-driven web design | AsreSEO" }]} twitterCard='summary_large_image'
  ogTitle='SEO-Driven Web Design & Speed Optimization | AsreSEO'

  ogDescription='SEO-driven web design built to the highest standards.'
>
<div class="min-h-screen bg-[#000000] text-slate-100 wireframe-grid">
      <script id="structured-data" type="application/ld+json" is:inline set:html={JSON.stringify(withServiceMeta(structuredData, { url: 'https://asreseo.com/services/web/seo-web-design/', image: '/og/web-design-hero.jpg' }))} />

      <Header lang="en" />
      <BreadcrumbStructuredData items={breadcrumbs} />

      <main>
        <ServiceHero lang="en"
          badge="Professional Web Design"
          title="SEO-Driven Web Design"
          titleHighlight="SEO-Driven"
          description="Your website is designed from day one to rank on Google, delight users and convert at a high rate. AsreSEO builds sites with cutting-edge technology that shine on Google\u2019s first page!"
          primaryCtaText="Free Design Consultation"
          secondaryCtaText="See Our Portfolio"
          imageSrc="/images/web-design-hero.webp"
          imageAlt="SEO-driven web design"
          theme="indigo"
        />

        <ServiceStats lang="en" stats={stats} />

        <!-- Design Principles Section -->
        <section class="section-padding">
          <div class="container-custom">
            <div class="text-center mb-12">
              <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
                Four Pillars of <span class="gradient-text">SEO-Driven Design</span>
              </h2>
              <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                The approach that turns your website into an online sales machine
              </p>
            </div>

            <div class="grid md:grid-cols-2 gap-8">
              {designPrinciples.map((principle, index) => (
                <Card class="hover:shadow-xl transition-all duration-300 group border-0 shadow-lg">
                  <CardHeader class="pb-4">
                    <div class="flex items-center gap-3 mb-3">
                      <div class="w-12 h-12 bg-indigo-100 rounded-lg flex items-center justify-center group-hover:bg-indigo-200 transition-colors">
                        <Icon name="target" class="h-6 w-6 text-indigo-600" />
                      </div>
                      <CardTitle class="text-xl font-semibold">{principle.principle}</CardTitle>
                    </div>
                    <p class="text-gray-600">{principle.description}</p>
                  </CardHeader>
                  <CardContent>
                    <div class="space-y-1">
                      {principle.benefits.map((benefit, benefitIndex) => (
                        <div class="flex items-center gap-2 text-sm text-gray-500">
                          <Icon name="check-circle2" class="h-4 w-4 text-green-500 shrink-0" />
                          {benefit}
                        </div>
                      ))}
                    </div>
                  </CardContent>
                </Card>
              ))}
            </div>
          </div>
        </section>

        <!-- SEO Features Grid -->
        <section class="section-padding bg-linear-to-br from-slate-50 to-indigo-50">
          <div class="container-custom">
            <div class="text-center mb-12">
              <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
                Complete <span class="gradient-text">SEO Element</span> Coverage
              </h2>
              <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                No SEO element left behind
              </p>
            </div>

            <div class="space-y-8">
              {seoFeatures.map((category, index) => (
                <Card class="p-6 border-0 shadow-lg">
                  <CardHeader class="pb-4">
                    <CardTitle class="text-2xl text-center">{category.category}</CardTitle>
                  </CardHeader>
                  <CardContent>
                    <div class={`grid ${category.category === 'UX/UI Excellence' ? 'md:grid-cols-3' : 'md:grid-cols-5'} gap-4`}>
                      {category.features.map((feature, featureIndex) => (
                        <div class="text-center p-4 bg-white rounded-lg border">
                          <Icon name="check-circle2" class="h-6 w-6 text-green-500 mx-auto mb-2" />
                          <p class="text-sm font-medium text-gray-900">{feature}</p>
                        </div>
                      ))}
                    </div>
                  </CardContent>
                </Card>
              ))}
            </div>
          </div>
        </section>

        <!-- Conversion Elements -->
        <section class="section-padding">
          <div class="container-custom">
            <div class="text-center mb-12">
              <h2 class="text-3xl font-bold text-gray-900 mb-6">
                Strategic <span class="gradient-text">Conversion-Boosting</span> Elements
              </h2>
              <p class="text-xl text-gray-600">
                Proven techniques for turning visitors into customers
              </p>
            </div>

            <div class="grid md:grid-cols-3 gap-8">
              {conversionElements.map((element, index) => (
                <Card class="hover:shadow-lg transition-all duration-300">
                  <CardHeader>
                    <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mb-4">
                      <Icon name="trending-up" class="h-8 w-8 text-green-800" />
                    </div>
                    <CardTitle class="text-lg">{element.element}</CardTitle>
                  </CardHeader>
                  <CardContent>
                    <p class="text-gray-600 mb-3">{element.description}</p>
                    <Badge class="bg-green-100 text-green-800">{element.impact}</Badge>
                  </CardContent>
                </Card>
              ))}
            </div>
          </div>
        </section>

        <!-- Technology Stack -->
        <section class="section-padding bg-slate-50">
          <div class="container-custom">
            <div class="text-center mb-12">
              <h2 class="text-3xl font-bold text-gray-900 mb-6">
                Advanced <span class="gradient-text">Technologies</span> We Use
              </h2>
              <p class="text-xl text-gray-600">
                The latest web tooling for maximum performance and security
              </p>
            </div>

            <div class="grid md:grid-cols-2 gap-8">
              {technologyStack.map((tech, index) => (
                <Card class="hover:shadow-md transition-shadow">
                  <CardContent class="p-6">
                    <h3 class="text-xl font-semibold mb-2">{tech.name}</h3>
                    <p class="text-gray-600 mb-4">{tech.description}</p>
                    <div class="flex flex-wrap gap-2">
                      {tech.benefits.map((benefit, benefitIndex) => (
                        <Badge variant="outline" class="text-sm">
                          {benefit}
                        </Badge>
                      ))}
                    </div>
                  </CardContent>
                </Card>
              ))}
            </div>
          </div>
        </section>

        <!-- Comparison Table -->
        <section class="section-padding">
          <div class="container-custom">
            <div class="text-center mb-12">
              <h2 class="text-3xl font-bold text-gray-900 mb-6">
                <span class="gradient-text">Conventional</span> vs <span class="gradient-text">SEO-Driven</span> Design
              </h2>
              <p class="text-xl text-gray-600">
                Why does SEO-driven design return better ROI?
              </p>
            </div>

            <div class="overflow-hidden rounded-none border-2 border-white/15 bg-[#0a0e17]">
              <table class="w-full">
                <thead class="bg-black border-b-2 border-white/20 font-mono text-xs uppercase tracking-wider text-[#CCFF00]">
                  <tr>
                    <th class="px-6 py-4 text-left font-bold">Metric</th>
                    <th class="px-6 py-4 text-center font-bold text-[#CCFF00]">SEO-Driven Design</th>
                    <th class="px-6 py-4 text-center font-bold text-red-400">Conventional Design</th>
                    <th class="px-6 py-4 text-center font-bold text-white">Improvement</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-white/10">
                  {comparisonFeatures.map((comp, index) => (
                    <tr class="hover:bg-white/5 transition-colors">
                      <td class="px-6 py-4 font-medium text-white">{comp.feature}</td>
                      <td class="px-6 py-4 text-center text-[#CCFF00] font-mono font-bold bg-black/40">
                        {comp.seoDesign}
                      </td>
                      <td class="px-6 py-4 text-center text-red-400 font-mono">
                        {comp.regularDesign}
                      </td>
                      <td class="px-6 py-4 text-center text-white font-mono font-bold bg-white/5">
                        {comp.improvement}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </section>

        <!-- Project Phases -->
        <section class="section-padding bg-linear-to-br from-blue-50 to-indigo-50">
          <div class="container-custom">
            <div class="text-center mb-12">
              <h2 class="text-3xl font-bold text-gray-900 mb-6">
                Our <span class="gradient-text">Design & Delivery</span> Process
              </h2>
              <p class="text-xl text-gray-600">
                A 7-step approach for guaranteed quality and satisfaction
              </p>
            </div>

            <div class="space-y-8">
              {projectPhases.map((phase, index) => (
                <div class="flex items-center gap-8 p-6 bg-white/80 rounded-xl shadow-xs">
                  <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center text-2xl font-bold text-blue-700">
                    {index + 1}
                  </div>
                  <div class="flex-1">
                    <h3 class="text-xl font-semibold text-gray-900 mb-2">
                      {phase.phase}
                    </h3>
                    <p class="text-gray-600 leading-relaxed">
                      {phase.description}
                    </p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </section>

        <ServiceBenefits lang="en"
          title="Benefits of AsreSEO\u2019s SEO-Driven Design"
          titleHighlight="SEO-Driven"
          subtitle="What you gain with AsreSEO\u2019s SEO-driven design"
          benefits={benefits}
          iconColorClass="text-blue-600"
          iconBgClass="bg-blue-100"
        />

        <ServiceFAQ lang="en"
          title="Frequently Asked Questions"
          highlightWord="Asked Questions"
          subtitle="Answers to common client questions about SEO-driven web design"
          faqs={faqs}
        />

        <ServiceCTA lang="en"
          title="Your website starts on Google\u2019s first page!"
          description="With years of website design experience, AsreSEO builds you a site that isn\u2019t just beautiful \u2014 it\u2019s your online sales machine. SEO-driven design means you enter the race the moment you launch!"
          primaryText="Start SEO-Driven Design"
          secondaryText="Free Project Consultation"
          primaryClass="bg-blue-600 hover:bg-blue-700 text-white font-semibold shadow-lg shadow-blue-600/30"
        />
      </main>

      <Footer lang="en" />
    </div>
</BaseLayout>
