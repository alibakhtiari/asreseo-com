---
import { withServiceMeta } from '../../../../lib/service-schema';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Header from '../../../../components/Layout/Header.astro';
import Footer from '../../../../components/Layout/Footer.astro';
import Card from '../../../../components/ui/card/Card.astro';
import CardContent from '../../../../components/ui/card/CardContent.astro';
import CardHeader from '../../../../components/ui/card/CardHeader.astro';
import CardTitle from '../../../../components/ui/card/CardTitle.astro';
import Badge from '../../../../components/ui/badge/Badge.astro';
import Icon from '../../../../components/ui/Icon.astro';
import ServiceHero from '../../../../components/Services/ServiceHero.astro';
import ServiceStats from '../../../../components/Services/ServiceStats.astro';
import ServiceFAQ from '../../../../components/Services/ServiceFAQ.astro';
import ServiceCTA from '../../../../components/Services/ServiceCTA.astro';
import BreadcrumbStructuredData from '../../../../components/BreadcrumbStructuredData.astro';
import ServiceBenefits from '../../../../components/Services/ServiceBenefits.astro';

const structuredData = {
    '@context': 'https://schema.org',
    '@type': 'Service',
    'name': 'Smart AI Content Production (Text & Video)',
    'description': 'End-to-end AI text and video content services, content cycle automation and expert SEO-driven articles.',
    'serviceType': 'AI Content Creation',
    'inLanguage': 'en-US',
    'provider': {
        '@type': 'Organization',
        'name': 'AsreSEO',
        'url': 'https://asreseo.com'
    },
    'hasOfferCatalog': {
        '@type': 'OfferCatalog',
        'name': 'AI content production services',
        'itemListElement': [
            {
                '@type': 'Offer',
                'itemOffered': {
                    '@type': 'Service',
                    'name': 'Smart article and copy production',
                    'description': 'Deep SEO-focused articles with AI drafting and human validation',
                    'inLanguage': 'en-US'
                }
            },
            {
                '@type': 'Offer',
                'itemOffered': {
                    '@type': 'Service',
                    'name': 'Smart video and teaser production',
                    'description': 'Promotional and educational videos with AI scriptwriting',
                    'inLanguage': 'en-US'
                }
            }
        ]
    }
};

const faqs = [
    {
        q: 'Will AI-generated articles actually rank in Google?',
        a: 'Yes. Google rewards quality, helpful content. At AsreSEO every AI-drafted article goes through expert editing and is enriched with first-hand data and real experience to compete for top rankings.'
    },
    {
        q: 'How does AI content-cycle automation work?',
        a: 'It starts with automated keyword research and ideation, then language models draft the article or script, and after expert quality approval it publishes on schedule to your website or social channels.'
    },
    {
        q: 'Which platforms are AI-generated videos suited for?',
        a: 'They are optimized for Instagram Reels, YouTube videos, product landing pages and similar placements, with automatic subtitles and smooth voiceover narration.'
    },
    {
        q: 'How does AI content production compare cost-wise with traditional production?',
        a: 'AI noticeably lowers text and video production costs while speeding up publishing; exact figures depend on project volume and are tracked in performance reports.'
    }
];

const breadcrumbs = [
    { position: 1, name: 'Home', item: 'https://asreseo.com/' },
    { position: 2, name: 'AI Services', item: 'https://asreseo.com/services/ai/' },
    { position: 3, name: 'Smart Content Production', item: 'https://asreseo.com/services/ai/content-creation/' }
];



    const textFeatures = [
        {
            icon: "file-text",
            title: 'Smart Article Writing',
            description: 'Complete, engaging, SEO-optimized articles delivered in minimal time.',
            benefits: ['SEO optimized', 'Unique content', 'Fast delivery']
        },
        {
            icon: "pen-tool",
            title: 'Social Media Content',
            description: 'Engaging, interactive posts for every social platform.',
            benefits: ['Share-worthy ideas', 'High engagement', 'Smart scheduling']
        },
        {
            icon: "target",
            title: 'Content Marketing',
            description: 'Smart, goal-driven content marketing strategy.',
            benefits: ['Inbound marketing', 'Optimized CTAs', 'High conversion']
        },
        {
            icon: "globe",
            title: 'Multilingual Content',
            description: 'Optimized content for different markets.',
            benefits: ['Global reach', 'International SEO', 'More sales']
        }
    ];

    const videoFeatures = [
        {
            icon: "film",
            title: 'Promotional Video Production',
            description: 'Short, compelling videos tailored to your marketing goals.',
            benefits: ['Targeted marketing', 'Shareable videos', 'Competitor analysis']
        },
        {
            icon: "sparkles",
            title: 'Animation & Graphics',
            description: 'Animations and graphic effects with no designer required.',
            benefits: ['High quality', 'Pro animation', 'Special effects']
        },
        {
            icon: "type",
            title: 'Text-to-Video',
            description: 'Turn a script or article into video in minutes.',
            benefits: ['High speed', 'High accuracy', 'Fair pricing']
        },
        {
            icon: "wand2",
            title: 'Smart Voiceover',
            description: 'Natural, varied narration voices for voiceovers.',
            benefits: ['Varied voices', 'Natural tone', 'No studio costs']
        }
    ];

    const contentTypes = [
        {
            title: 'Blog Articles',
            description: 'Educational, SEO-ready expert articles',
            icon: "file-text",
            type: 'Text'
        },
        {
            title: 'Promotional Videos',
            description: 'Snappy teasers for Instagram and YouTube',
            icon: "video",
            type: 'Video'
        },
        {
            title: 'Social Posts',
            description: 'Captions and text content for social feeds',
            icon: "pen-tool",
            type: 'Text'
        },
        {
            title: 'Tutorial Videos',
            description: 'Product demos and how-to videos',
            icon: "play",
            type: 'Video'
        }
    ];

    const benefits = [
        'Produce high-quality content faster with automation',
        'Lower your content production costs',
        'Text and video production unified in one studio',
        'Automatic optimization for search engines',
        'More organic traffic and higher engagement',
        'Full coverage of your brand content needs'
    ];

    const stats = [
        { metric: '10x', label: 'Production speed', color: 'text-blue-600' },
        { metric: 'Automated', label: 'Lower content production costs', color: 'text-green-800' },
        { metric: 'Google-grade', label: 'SEO optimization', color: 'text-purple-600' },
        { metric: '24/7', label: 'Always-on production', color: 'text-orange-600' }
    ];

    
---
<BaseLayout
  lang="en"
  title='AI Content Creation (Text & Video) | AsreSEO'
  description='AI-powered text and video content production, content workflow automation and SEO-driven articles. Scale content output with automation and pre-delivery quality control.'
  keywords='AI content creation, content workflow automation, AI content, AI video production, smart article writing, content SEO'
  canonical='/services/ai/content-creation/'
  ogType='website'
  ogUrl='https://asreseo.com/services/ai/content-creation/'
  ogImages={[{ url: "/og/ai-content-hero.jpg", width: 1200, height: 630, alt: "AI-powered text and video content production by AsreSEO" }]}
  twitterCard='summary_large_image'
>
<div class="min-h-screen bg-[#000000] text-slate-100 wireframe-grid">
            <script id="structured-data" type="application/ld+json" is:inline set:html={JSON.stringify(withServiceMeta(structuredData, { url: 'https://asreseo.com/services/ai/content-creation/', image: '/og/ai-content-hero.jpg' }))} />
            <BreadcrumbStructuredData items={breadcrumbs} />

            <Header lang="en" />

            <main>
                <!-- Hero Section -->
                <ServiceHero
                    lang="en"
                    badge="Smart Content Production Studio"
                    title="AI-Powered"
                    titleGradient="Text & Video Content"
                    description="An end-to-end AI content platform. From SEO-ready articles to compelling promo videos — produce everything fast, at high quality."
                    primaryCta={{ text: "Start Creating Content", href: "/consultation/" }}
                    secondaryCta={{ text: "See Samples", href: "/portfolio/" }}
                    imageSrc="/images/ai-content-hero.webp"
                    imageAlt="AI-powered text and video content production"
                    theme="purple"
                />

                <!-- Stats Section -->
                <ServiceStats lang="en" stats={stats} theme="purple" />

                <!-- Text Generation Section -->
                <section class="section-padding">
                    <div class="container-custom">
                        <div class="text-center mb-12">
                            <Badge class="bg-blue-100 text-blue-700 mb-4">Text production</Badge>
                            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
                                Smart <span class="gradient-text">Written Content</span>
                            </h2>
                            <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                                Articles, blog posts and social content written to full SEO standards
                            </p>
                        </div>

                        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
                            {textFeatures.map((feature, index) => (
                                <Card class="hover:shadow-xl transition-all duration-300 group border-0 shadow-lg bg-white">
                                    <CardHeader class="pb-4">
                                        <div class="flex items-center gap-3 mb-3">
                                            <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center group-hover:bg-blue-200 transition-colors">
                                                <Icon name={feature.icon} class="h-6 w-6 text-blue-600" />
                                            </div>
                                            <CardTitle class="text-lg font-semibold">{feature.title}</CardTitle>
                                        </div>
                                    </CardHeader>
                                    <CardContent>
                                        <p class="text-gray-600 mb-4 leading-relaxed">
                                            {feature.description}
                                        </p>
                                        <div class="space-y-2">
                                            {feature.benefits.map((benefit, benefitIndex) => (
                                                <div class="flex items-center gap-2 text-sm text-gray-500">
                                                    <Icon name="check-circle" class="h-4 w-4 text-green-500 shrink-0" />
                                                    {benefit}
                                                </div>
                                            ))}
                                        </div>
                                    </CardContent>
                                </Card>
                            ))}
                        </div>
                    </div>
                </section>

                <!-- Video Generation Section -->
                <section class="section-padding bg-slate-50">
                    <div class="container-custom">
                        <div class="text-center mb-12">
                            <Badge class="bg-pink-100 text-pink-700 mb-4">Video production</Badge>
                            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
                                Pro <span class="gradient-text">Videos</span> with AI
                            </h2>
                            <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                                Turn text into video and build promos and tutorials — no equipment needed
                            </p>
                        </div>

                        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
                            {videoFeatures.map((feature, index) => (
                                <Card class="hover:shadow-xl transition-all duration-300 group border-0 shadow-lg bg-white">
                                    <CardHeader class="pb-4">
                                        <div class="flex items-center gap-3 mb-3">
                                            <div class="w-12 h-12 bg-pink-100 rounded-lg flex items-center justify-center group-hover:bg-pink-200 transition-colors">
                                                <Icon name={feature.icon} class="h-6 w-6 text-pink-600" />
                                            </div>
                                            <CardTitle class="text-lg font-semibold">{feature.title}</CardTitle>
                                        </div>
                                    </CardHeader>
                                    <CardContent>
                                        <p class="text-gray-600 mb-4 leading-relaxed">
                                            {feature.description}
                                        </p>
                                        <div class="space-y-2">
                                            {feature.benefits.map((benefit, benefitIndex) => (
                                                <div class="flex items-center gap-2 text-sm text-gray-500">
                                                    <Icon name="check-circle" class="h-4 w-4 text-green-500 shrink-0" />
                                                    {benefit}
                                                </div>
                                            ))}
                                        </div>
                                    </CardContent>
                                </Card>
                            ))}
                        </div>
                    </div>
                </section>

                <!-- Content Types Grid -->
                <section class="section-padding">
                    <div class="container-custom">
                        <div class="text-center mb-12">
                            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
                                Full Coverage of Your <span class="gradient-text">Content Needs</span>
                            </h2>
                            <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                                Every content format your growing business needs
                            </p>
                        </div>

                        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
                            {contentTypes.map((type, index) => (
                                <Card class="hover:shadow-md transition-shadow bg-linear-to-br from-gray-50 to-white border border-gray-100">
                                    <CardContent class="p-6">
                                        <div class="flex items-center gap-3 mb-3">
                                            <div class="w-10 h-10 bg-purple-100 rounded-lg flex items-center justify-center text-purple-600">
                                                <Icon name={type.icon} class="h-5 w-5" />
                                            </div>
                                            <div>
                                                <h3 class="font-semibold text-gray-900">{type.title}</h3>
                                                <span class="text-xs text-purple-600 bg-purple-50 px-2 py-0.5 rounded-full">
                                                    {type.type}
                                                </span>
                                            </div>
                                        </div>
                                        <p class="text-sm text-gray-600">{type.description}</p>
                                    </CardContent>
                                </Card>
                            ))}
                        </div>
                    </div>
                </section>

                <!-- Publishing automation: this section owns the content-cycle
                     automation topic, so the query has a landing target instead
                     of scattering across unrelated services.
                     No invented statistics. -->
                <section class="section-padding bg-slate-50 border-t border-gray-200/60">
                    <div class="container-custom max-w-5xl">
                        <div class="text-center mb-12">
                            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
                                Automated Content Production & Publishing Cycle
                            </h2>
                            <p class="text-lg text-gray-600">
                                From idea to publishing and distribution — every step with a clear tool and a measurable output
                            </p>
                        </div>

                        <ol class="grid gap-6 md:grid-cols-2">
                            <li class="bg-white rounded-2xl p-6 shadow-xs border border-gray-200">
                                <div class="flex items-center gap-3 mb-3">
                                    <span class="flex items-center justify-center w-9 h-9 rounded-full bg-purple-100 text-purple-700 font-bold">1</span>
                                    <h3 class="text-xl font-bold text-gray-900">Drafting</h3>
                                </div>
                                <p class="text-gray-600 leading-relaxed">
                                    Drafts built on semantic clusters and real user questions — not just a single keyword.
                                </p>
                            </li>
                            <li class="bg-white rounded-2xl p-6 shadow-xs border border-gray-200">
                                <div class="flex items-center gap-3 mb-3">
                                    <span class="flex items-center justify-center w-9 h-9 rounded-full bg-purple-100 text-purple-700 font-bold">2</span>
                                    <h3 class="text-xl font-bold text-gray-900">Human Review</h3>
                                </div>
                                <p class="text-gray-600 leading-relaxed">
                                    Edited by a writer, claims fact-checked, and originality verified before anything ships.
                                </p>
                            </li>
                            <li class="bg-white rounded-2xl p-6 shadow-xs border border-gray-200">
                                <div class="flex items-center gap-3 mb-3">
                                    <span class="flex items-center justify-center w-9 h-9 rounded-full bg-purple-100 text-purple-700 font-bold">3</span>
                                    <h3 class="text-xl font-bold text-gray-900">Scheduled Publishing</h3>
                                </div>
                                <p class="text-gray-600 leading-relaxed">
                                    Auto-publishes to your blog and social feeds on your
                                    <a href="/services/content/content-calendar/" class="text-purple-700 font-semibold underline hover:no-underline">content calendar</a>.
                                </p>
                            </li>
                            <li class="bg-white rounded-2xl p-6 shadow-xs border border-gray-200">
                                <div class="flex items-center gap-3 mb-3">
                                    <span class="flex items-center justify-center w-9 h-9 rounded-full bg-purple-100 text-purple-700 font-bold">4</span>
                                    <h3 class="text-xl font-bold text-gray-900">Distribution & Monitoring</h3>
                                </div>
                                <p class="text-gray-600 leading-relaxed">
                                    Sent to the newsletter while each piece's performance feeds the next cycle's fixes.
                                </p>
                            </li>
                        </ol>
                    </div>
                </section>

                      <ServiceBenefits lang="en" title="Why Create Content" titleHighlight="With Our AI Studio" subtitle="Why use AI for content production?" benefits={benefits} />

                <!-- FAQ Section -->
                <ServiceFAQ
                    lang="en"
                    faqs={faqs}
                    title="AI Content Production FAQs"
                    description="Answers to common questions about article quality, Google compliance and automation"
                    theme="purple"
                />

                <!-- CTA Section -->
                <ServiceCTA
                    lang="en"
                    title="Create Professional Content Starting Today!"
                    description="Combine the power of words and visuals in our smart studio — content that attracts audiences and turns them into customers."
                    primaryCta={{ text: "Start Creating Content", href: "/consultation/" }}
                    secondaryCta={{ text: "Free Consultation", href: "/consultation/" }}
                    theme="purple"
                />
            </main>

            <Footer lang="en" />
        </div>
</BaseLayout>
