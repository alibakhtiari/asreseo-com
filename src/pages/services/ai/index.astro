---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Layout/Header.astro';
import Footer from '../../../components/Layout/Footer.astro';
import Button from '../../../components/ui/button/Button.astro';
import Card from '../../../components/ui/card/Card.astro';
import CardContent from '../../../components/ui/card/CardContent.astro';
import CardHeader from '../../../components/ui/card/CardHeader.astro';
import CardTitle from '../../../components/ui/card/CardTitle.astro';
import Badge from '../../../components/ui/badge/Badge.astro';
import Picture from '../../../components/ui/Picture.astro';
import Icon from '../../../components/ui/Icon.astro';
import BreadcrumbStructuredData from '../../../components/BreadcrumbStructuredData.astro';
import ServiceFAQ from '../../../components/Services/ServiceFAQ.astro';

const aiServices = [
  {
    title: 'تولید محتوای هوشمند (متن و ویدیو)',
    description: 'تولید مقالات سئومحور، سناریوهای ویدیویی و محتوای شبکه‌های اجتماعی با تلفیق هوش مصنوعی مولد و نظارت انسانی.',
    icon: "sparkles",
    features: ['نگارش مقالات تخصصی سئومحور', 'تولید ویدیو و موشن با AI', 'سناریونویسی هوشمند تبلیغاتی', 'بهینه‌سازی برای الگوریتم‌های گوگل'],
    isNew: true,
    gradient: 'from-purple-500 to-purple-700',
    href: '/services/ai/content-creation/'
  },
  {
    title: 'بازاریابی، اتوماسیون و چت‌بات فارسی',
    description: 'طراحی چت‌بات‌های هوشمند فارسی، اتوماسیون تعامل با مشتریان و شخصی‌سازی مسیر خرید در وب‌سایت.',
    icon: "bot",
    features: ['چت‌بات هوشمند فارسی ۲۴/۷', 'اتوماسیون بازاریابی ایمیلی و پیامکی', 'شخصی‌سازی تجربه مشتری (CX)', 'پاسخ‌دهی خودکار به لیدها'],
    isNew: true,
    gradient: 'from-blue-500 to-blue-700',
    href: '/services/ai/marketing-engagement/'
  },
  {
    title: 'تحلیل، استراتژی و سئو با AI',
    description: 'سئو هوشمند، تحلیل عمیق داده‌های سرچ کنسول، پایش مستمر رقبا و بهینه‌سازی نرخ تبدیل (CRO).',
    icon: "brain",
    features: ['تحلیل بلادرنگ داده‌های سئو و رقبا', 'بهینه‌سازی نرخ تبدیل (CRO)', 'تحلیل رفتار خرید کاربران', 'پیش‌بینی روندهای جستجوی کاربران'],
    isNew: true,
    gradient: 'from-orange-500 to-orange-700',
    href: '/services/ai/analysis-strategy/'
  }
];

const stats = [
  { number: '+۱۰۰', label: 'پروژه AI پیاده‌سازی شده' },
  { number: '۴.۵ برابر', label: 'سرعت تولید و انتشار محتوا' },
  { number: '۲۴/۷', label: 'پاسخ‌گویی خودکار چت‌بات' },
  { number: '۹۴٪', label: 'رضایت کارفرمایان عصر سئو' }
];

const workflowSteps = [
  {
    step: '۰۱',
    title: 'ارزیابی زیرساخت و نیازسنجی',
    desc: 'شناسایی نقاط اتلاف وقت در سازمان، گلوگاه‌های سئو و فرصت‌های پیاده‌سازی اتوماسیون هوش مصنوعی.'
  },
  {
    step: '۰۲',
    title: 'انتخاب مدل‌ها و شخصی‌سازی داده‌ها',
    desc: 'فاین‌تیونینگ پرامپت‌ها و اتصال پایگاه دانش سازمانی شما به مدل‌های زبانی پیشرفته و ایمن.'
  },
  {
    step: '۰۳',
    title: 'یکپارچه‌سازی با وب‌سایت و ابزارهای مارکتینگ',
    desc: 'اتصال چت‌بات به CRM، سیستم مدیریت محتوا (CMS)، سرچ کنسول و پنل‌های تبلیغاتی.'
  },
  {
    step: '۰۴',
    title: 'پایش، بهینه‌سازی و بهبود مستمر',
    desc: 'بررسی شاخص‌های عملکرد (KPI)، تحلیل دقیق رفتار مشتریان و ارتقای مداوم کیفیت خروجی‌ها.'
  }
];

const faqs = [
  {
    q: 'خدمات هوش مصنوعی و سئو در عصر سئو شامل چه مواردی است؟',
    a: 'این خدمات شامل تحلیل هوشمند کلمات کلیدی، بهینه‌سازی نرخ تبدیل، تولید مقالات با کیفیت سئومحور توسط هوش مصنوعی با بازبینی ویراستاران ارشد، راه‌اندازی چت‌بات فارسی در وب‌سایت و اتوماسیون کامل ارتباط با مشتریان است.'
  },
  {
    q: 'آیا استفاده از هوش مصنوعی برای سئو باعث جریمه توسط گوگل نمی‌شود؟',
    a: 'خیر. سیاست رسمی گوگل تمرکز بر کیفیت محتوا و ارزش آن برای کاربر (People-First Content) است، نه شیوه تولید آن. در عصر سئو تمامی خروجی‌های هوش مصنوعی توسط متخصصان سئو بازبینی، فکت‌چک و بهینه‌سازی انسانی می‌شوند تا بالاترین استانداردهای الگوریتم E-E-A-T را کسب کنند.'
  },
  {
    q: 'چت‌بات هوشمند فارسی چه تفاوتی با چت‌بات‌های سنتی و فرمی دارد؟',
    a: 'چت‌بات‌های سنتی فقط بر اساس چند دکمه پیش‌فرض پاسخ می‌دهند؛ اما چت‌بات هوشمند عصر سئو زبان محاوره‌ای و نیاز کاربر را متوجه شده، کاتالوگ محصولات شما را به خاطر می‌سپارد، و به صورت ۲۴ ساعته لید جذب کرده و خریدار را راهنمایی می‌کند.'
  },
  {
    q: 'پیاده‌سازی راهکارهای هوش مصنوعی چقدر زمان می‌برد؟',
    a: 'راه‌اندازی چت‌بات هوشمند و جریان‌های اتوماسیون محتوا معمولاً بین ۲ تا ۴ هفته کاری زمان می‌برد و پس از آموزش اولیه، بلافاصله بازدهی ملموس در کاهش هزینه‌ها و افزایش سرعت به همراه دارد.'
  },
  {
    q: 'چگونه می‌توان پروژه هوش مصنوعی اختصاصی برای کسب‌وکار خود سفارش داد؟',
    a: 'شما می‌توانید از طریق فرم مشاوره رایگان یا تماس مستقیم با کارشناسان عصر سئو (۰۹۱۲۵۸۱۱۸۸۰)، نیازهای کسب‌وکار خود را مطرح کنید تا بهترین استراتژی و پیش‌فاکتور شفاف برای شما تدوین شود.'
  }
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  'name': 'خدمات هوش مصنوعی و سئو',
  'description': 'ارائه تخصصی‌ترین خدمات هوش مصنوعی و سئو در ایران شامل چت‌بات هوشمند فارسی، اتوماسیون سازمانی، تولید محتوای AI و تحلیل پیشرفته رفتار کاربران.',
  'provider': {
    '@type': 'Organization',
    'name': 'عصر سئو',
    'url': 'https://asreseo.com',
    'logo': 'https://asreseo.com/Logo-spaced.png'
  },
  'areaServed': {
    '@type': 'Country',
    'name': 'Iran'
  },
  'serviceType': 'AI Solutions & AI SEO Services',
  'speakable': { '@type': 'SpeakableSpecification', 'cssSelector': ['.speakable-answer'] },
  'hasOfferCatalog': {
    '@type': 'OfferCatalog',
    'name': 'خدمات هوش مصنوعی عصر سئو',
    'itemListElement': aiServices.map(s => ({
      '@type': 'Offer',
      'itemOffered': {
        '@type': 'Service',
        'name': s.title,
        'description': s.description
      }
    }))
  }
};



const breadcrumbs = [
    { position: 1, name: 'خانه', item: 'https://asreseo.com/' },
    { position: 2, name: 'خدمات', item: 'https://asreseo.com/services/' },
    { position: 3, name: 'خدمات هوش مصنوعی', item: 'https://asreseo.com/services/ai/' },
  ];
---

<BaseLayout
  title='خدمات هوش مصنوعی | اتوماسیون و سئو با AI | عصر سئو'
  description='ارائه تخصصی‌ترین خدمات هوش مصنوعی و سئو در ایران. پیاده‌سازی چت‌بات فارسی، اتوماسیون سازمانی و تولید محتوای AI با مشاوره رایگان متخصصان عصر سئو.'
  keywords='خدمات هوش مصنوعی, خدمات هوش مصنوعی و سئو, شرکت خدمات هوش مصنوعی, خدمات ai, سئو هوش مصنوعی, چت‌بات فارسی, اتوماسیون بازاریابی'
  canonical='https://asreseo.com/services/ai/'
  ogType='website'
  ogUrl='https://asreseo.com/services/ai/'
  ogImages={[{ url: '/images/ai-service-hero.webp', width: 1200, height: 630, alt: 'خدمات هوش مصنوعی و سئو سازمانی عصر سئو' }]}
  twitterCard='summary_large_image'
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(serviceSchema)} />
  
  <BreadcrumbStructuredData items={breadcrumbs} />

  <div class="min-h-screen bg-white">
    <Header />
    <main>
      <!-- Hero Section -->
      <section class="section-padding bg-linear-to-br from-indigo-50 via-purple-50/40 to-slate-50 overflow-hidden relative">
        <div class="absolute top-0 right-0 w-1/3 h-full bg-indigo-100/50 blur-3xl -z-10 rounded-full mix-blend-multiply opacity-70 animate-blob"></div>
        <div class="absolute bottom-0 left-0 w-1/3 h-full bg-purple-100/50 blur-3xl -z-10 rounded-full mix-blend-multiply opacity-70 animate-blob animation-delay-2000"></div>

        <div class="container-custom relative z-10">
          <div class="grid lg:grid-cols-2 gap-12 items-center">
            <div class="text-right animate-fade-in order-2 lg:order-1">
              <div class="inline-flex items-center gap-2 bg-purple-100 text-purple-700 px-4 py-2 rounded-full text-sm font-medium mb-6">
                <Icon name="bot" class="h-4 w-4" />
                پیشگام خدمات هوش مصنوعی و سئو در ایران
              </div>
              <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 mb-6 leading-tight">
                خدمات <span class="gradient-text">هوش مصنوعی</span> و سئو سازمانی
              </h1>
              <p class="text-xl text-gray-600 mb-8 leading-relaxed">
                با جدیدترین فناوری‌های هوش مصنوعی، فرآیندهای بازاریابی و رتبه‌بندی سایت خود را هوشمند کنید. از چت‌بات‌های هوشمند فارسی تا تولید محتوا و بهینه‌سازی نرخ تبدیل با متخصصان عصر سئو.
              </p>
              <div class="flex flex-col sm:flex-row gap-4 justify-start">
                <Button size="lg" class="gradient-bg text-white px-8 hover:shadow-lg hover:shadow-purple-500/30 transition-all duration-300" href="/consultation/">
                    درخواست مشاوره رایگان AI
                  </Button>
                <Button variant="outline" size="lg" class="border-purple-200 text-purple-700 hover:bg-purple-50" href="tel:+989125811880">
                    تماس با کارشناس هوش مصنوعی
                  </Button>
              </div>
            </div>

            <div class="relative h-87.5 md:h-112.5 w-full rounded-2xl overflow-hidden shadow-2xl animate-fade-in order-1 lg:order-2 ring-1 ring-gray-200/50 group">
              <div class="absolute inset-0 bg-linear-to-tr from-purple-600/10 to-transparent z-10" />
              <Picture
                src="/images/ai-service-hero.webp"
                alt="خدمات هوش مصنوعی و سئو سازمانی عصر سئو"
                class="object-cover group-hover:scale-105 transition-transform duration-700 w-full h-full"
                eager
                sizes="(max-width: 768px) 100vw, 50vw"
              />
            </div>
          </div>
        </div>
      </section>

      <!-- AEO Direct Answer Section -->
      <section class="py-12 bg-purple-50/50 border-y border-purple-100">
        <div class="container-custom">
          <div class="speakable-answer max-w-4xl mx-auto text-right">
            <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-4">
              هوش مصنوعی در سئو و دیجیتال مارکتینگ چه تحولی ایجاد می‌کند؟
            </h2>
            <p class="text-lg text-gray-700 leading-relaxed bg-white p-6 rounded-2xl shadow-xs border border-purple-100">
              <strong>خدمات هوش مصنوعی و سئو</strong> با اتوماسیون تحلیل داده‌های رقبا، پیش‌بینی نوسانات الگوریتم‌های گوگل، شخصی‌سازی تجربه بازدیدکنندگان و نگارش پیش‌نویس مقالات تخصصی، هزینه تولید سرنخ (CPL) را تا ۶۰٪ کاهش و سرعت تسخیر رتبه‌های اول گوگل را تا ۳۰۰٪ افزایش می‌دهد. عصر سئو با بهره‌گیری از مدل‌های روز دنیا و اعتبارسنجی انسانی، بدون ریسک جریمه الگوریتمی، شما را در صدر رقابت بازار قرار می‌دهد.
            </p>
          </div>
        </div>
      </section>

      <!-- Stats Section -->
      <section class="section-padding py-12">
        <div class="container-custom">
          <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
            {stats.map((stat) => (
              <div class="text-center p-4 rounded-xl bg-slate-50 border border-slate-100">
                <div class="text-3xl md:text-4xl font-bold text-purple-600 mb-2">{stat.number}</div>
                <div class="text-gray-600 text-sm font-medium">{stat.label}</div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Services Grid -->
      <section class="section-padding bg-linear-to-br from-purple-50/40 to-blue-50/40">
        <div class="container-custom">
          <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">راه‌حل‌های اختصاصی شرکت خدمات هوش مصنوعی عصر سئو</h2>
            <p class="text-lg text-gray-600 max-w-2xl mx-auto">
              بسته‌ای جامع از ابزارهای هوشمند جهت جهش بهره‌وری، جذب مشتری و پیشی‌گرفتن از رقبای سنتی
            </p>
          </div>

          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
            {aiServices.map((service) => (
              <Card class="hover:shadow-xl transition-all duration-300 group relative overflow-hidden flex flex-col justify-between border-gray-200">
                {service.isNew && (
                  <Badge class="absolute top-4 left-4 bg-emerald-500 hover:bg-emerald-600 text-white">
                    تکنولوژی جدید
                  </Badge>
                )}

                <CardHeader>
                  <div class={`w-14 h-14 bg-linear-to-r ${service.gradient} rounded-xl flex items-center justify-center mb-4 text-white shadow-md`}>
                    <Icon name={service.icon} class="h-7 w-7" />
                  </div>
                  <CardTitle class="text-xl font-bold group-hover:text-purple-600 transition-colors">
                    <a href={service.href}>{service.title}</a>
                  </CardTitle>
                </CardHeader>
                <CardContent class="flex-1 flex flex-col justify-between">
                  <div>
                    <p class="text-gray-600 mb-6 text-sm leading-relaxed">
                      {service.description}
                    </p>
                    <ul class="space-y-2.5 text-xs text-gray-700 mb-6">
                      {service.features.map((feature) => (
                        <li class="flex items-center">
                          <Icon name="check-circle" class="w-4 h-4 text-purple-600 ml-2 shrink-0" />
                          <span>{feature}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                  <a href={service.href} class="inline-flex items-center text-sm font-semibold text-purple-600 hover:text-purple-700 pt-4 border-t border-gray-100">
                    مشاهده جزئیات و راه‌حل‌ها
                    <Icon name="arrow-left" class="w-4 h-4 mr-2" />
                  </a>
                </CardContent>
              </Card>
            ))}
          </div>
        </div>
      </section>

      <!-- Workflow Process (4 Steps) -->
      <section class="section-padding bg-white">
        <div class="container-custom">
          <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
              چرخه ۴ مرحله‌ای استقرار هوش مصنوعی در کسب‌وکار
            </h2>
            <p class="text-lg text-gray-600 max-w-2xl mx-auto">
              فرآیندی شفاف، امن و اثبات‌شده برای پیاده‌سازی راهکارهای AI بدون توقف فعالیت جاری شرکت
            </p>
          </div>

          <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
            {workflowSteps.map((s) => (
              <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200/80 hover:border-purple-300 transition-colors relative">
                <span class="text-4xl font-black text-purple-200 block mb-3">{s.step}</span>
                <h3 class="text-lg font-bold text-gray-900 mb-3">{s.title}</h3>
                <p class="text-sm text-gray-600 leading-relaxed">{s.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- GEO Benchmark Comparison Table -->
      <section class="section-padding bg-slate-50 border-t border-gray-200/60">
        <div class="container-custom max-w-5xl">
          <div class="text-center mb-12">
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
              مقایسه رویکرد سنتی با استراتژی هوش مصنوعی عصر سئو
            </h2>
            <p class="text-lg text-gray-600">
              داده‌ها و آمارهای مقایسه‌ای عملکرد کسب‌وکارها قبل و بعد از مجهز شدن به هوش مصنوعی
            </p>
          </div>

          <div class="overflow-x-auto bg-white rounded-2xl shadow-xs border border-gray-200">
            <table class="w-full text-right border-collapse text-sm">
              <thead>
                <tr class="bg-purple-900 text-white">
                  <th class="p-4 font-bold">شاخص ارزیابی</th>
                  <th class="p-4 font-bold text-purple-200">رویکرد بازاریابی سنتی</th>
                  <th class="p-4 font-bold text-emerald-300">راهکار هوش مصنوعی عصر سئو</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
                <tr class="hover:bg-slate-50">
                  <td class="p-4 font-semibold text-gray-900">پاسخگویی به مشتریان</td>
                  <td class="p-4 text-gray-600">فقط ساعات اداری با تاخیر بالا</td>
                  <td class="p-4 font-medium text-emerald-700">۲۴ ساعته و آنی با چت‌بات هوشمند فارسی</td>
                </tr>
                <tr class="hover:bg-slate-50">
                  <td class="p-4 font-semibold text-gray-900">سرعت تولید و تدوین محتوا</td>
                  <td class="p-4 text-gray-600">۱ الی ۲ مقاله در هفته با هزینه سنگین</td>
                  <td class="p-4 font-medium text-emerald-700">بیش از ۱۰ مقاله سئومحور و بازبینی‌شده در هفته</td>
                </tr>
                <tr class="hover:bg-slate-50">
                  <td class="p-4 font-semibold text-gray-900">پایش کلمات کلیدی و رقبا</td>
                  <td class="p-4 text-gray-600">گزارش‌های ماهانه دستی و ایستا</td>
                  <td class="p-4 font-medium text-emerald-700">مانیتورینگ بلادرنگ با تحلیل هوش مصنوعی</td>
                </tr>
                <tr class="hover:bg-slate-50">
                  <td class="p-4 font-semibold text-gray-900">هزینه جذب سرنخ (CPL)</td>
                  <td class="p-4 text-gray-600">بالا و غیرقابل پیش‌بینی</td>
                  <td class="p-4 font-medium text-emerald-700">تا ۶۰٪ کاهش هزینه با اتوماسیون هوشمند لیدها</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- AI SEO vs classic SEO. The audit flagged intent blur between this page
           and /services/seo/ (query «خدمات سئو هوش مصنوعی»): each page was
