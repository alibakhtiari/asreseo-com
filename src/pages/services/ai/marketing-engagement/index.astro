---
import { withServiceMeta } from '../../../../lib/service-schema';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Header from '../../../../components/Layout/Header.astro';
import Footer from '../../../../components/Layout/Footer.astro';
import Card from '../../../../components/ui/card/Card.astro';
import CardContent from '../../../../components/ui/card/CardContent.astro';
import CardHeader from '../../../../components/ui/card/CardHeader.astro';
import CardTitle from '../../../../components/ui/card/CardTitle.astro';
import Badge from '../../../../components/ui/badge/Badge.astro';
import Icon from '../../../../components/ui/Icon.astro';
import ServiceHero from '../../../../components/Services/ServiceHero.astro';
import ServiceStats from '../../../../components/Services/ServiceStats.astro';
import ServiceFAQ from '../../../../components/Services/ServiceFAQ.astro';
import ServiceCTA from '../../../../components/Services/ServiceCTA.astro';
import BreadcrumbStructuredData from '../../../../components/BreadcrumbStructuredData.astro';
import ServiceBenefits from '../../../../components/Services/ServiceBenefits.astro';

const structuredData = {
    '@context': 'https://schema.org',
    '@type': 'Service',
    'name': 'Smart Marketing, Automation & Chatbots',
    'description': 'End-to-end smart marketing services including automation, smart chatbots and content personalization by AsreSEO.',
    'serviceType': 'AI Marketing & Chatbot Solutions',
    'inLanguage': 'en-US',
    'provider': {
        '@type': 'Organization',
        'name': 'AsreSEO',
        'url': 'https://asreseo.com'
    },
    'hasOfferCatalog': {
        '@type': 'OfferCatalog',
        'name': 'AI marketing services',
        'itemListElement': [
            {
                '@type': 'Offer',
                'itemOffered': {
                    '@type': 'Service',
                    'name': 'Smart chatbot',
                    'description': '24/7 AI assistance and lead capture',
                    'inLanguage': 'en-US'
                }
            },
            {
                '@type': 'Offer',
                'itemOffered': {
                    '@type': 'Service',
                    'name': 'Marketing automation',
                    'description': 'Automated email and SMS campaigns with AI',
                    'inLanguage': 'en-US'
                }
            },
            {
                '@type': 'Offer',
                'itemOffered': {
                    '@type': 'Service',
                    'name': 'Customer experience personalization (CX)',
                    'description': 'Tailored offers based on user behavior',
                    'inLanguage': 'en-US'
                }
            }
        ]
    }
};

const faqs = [
    {
        q: 'How does the AsreSEO smart chatbot connect to a website?',
        a: 'A simple script or dedicated plugin activates the chatbot on your site and connects it to your product and service knowledge base.'
    },
    {
        q: 'Does the chatbot understand natural, conversational language?',
        a: 'Yes. The language models are tuned for conversational phrasing and adopt a friendly or formal tone to match your brand.'
    },
    {
        q: 'How does marketing automation lift conversion rates?',
        a: 'By automatically following up on abandoned carts, sending timely messages for occasions, and delivering relevant content based on each visitor’s viewed pages.'
    },
    {
        q: 'Can it integrate with our CRM software?',
        a: 'Yes. The chatbot and automation system connect easily to common CRMs, webhooks and SMS gateways.'
    }
];

const breadcrumbs = [
    { position: 1, name: 'Home', item: 'https://asreseo.com/' },
    { position: 2, name: 'AI Services', item: 'https://asreseo.com/services/ai/' },
    { position: 3, name: 'Smart Marketing & Engagement', item: 'https://asreseo.com/services/ai/marketing-engagement/' }
];



    const automationFeatures = [
        {
            icon: "mail",
            title: 'Smart Email Marketing',
            description: 'Automatic personalized emails driven by user behavior.',
            benefits: ['Content personalization', 'Smart scheduling', 'Automatic feedback']
        },
        {
            icon: "users",
            title: 'Lead Nurturing',
            description: 'Turn visitors into customers automatically with targeted campaigns.',
            benefits: ['Higher conversion', 'Systematic education', 'Smart follow-up']
        },
        {
            icon: "target",
            title: 'Advanced Targeting',
            description: 'Precise audience targeting from behavioral data.',
            benefits: ['Sharper targeting', 'Higher returns', 'Better ROI']
        }
    ];

    const chatbotFeatures = [
        {
            icon: "bot",
            title: 'Advanced RAG Chatbot',
            description: 'Accurate answers learned from your organizational knowledge base and documents.',
            benefits: ['Higher accuracy', 'Learns from your data', 'Relevant answers']
        },
        {
            icon: "database",
            title: 'Knowledge-Base Integration',
            description: 'Direct connection to product and service info for comprehensive answers.',
            benefits: ['Full access', 'Unified answers', 'Auto updates']
        },
        {
            icon: "message-square",
            title: 'Natural Conversation',
            description: 'Deep language understanding with fluent, natural dialogue.',
            benefits: ['High comprehension', 'Natural replies', '24/7 support']
        }
    ];

    const personalizationFeatures = [
        {
            icon: "user",
            title: 'A Personal User Experience',
            description: 'Unique content for every user based on their interests.',
            benefits: ['A special touch', 'More engagement', 'Higher satisfaction']
        },
        {
            icon: "sparkles",
            title: 'Smart Product Suggestions',
            description: 'Relevant product recommendations from browsing and purchase history.',
            benefits: ['More sales', 'Bigger baskets', 'Product discovery']
        },
        {
            icon: "heart-handshake",
            title: 'Customer Loyalty',
            description: 'Build belonging and loyalty with personal content.',
            benefits: ['Stronger loyalty', 'Repeat visits', 'Lifetime value']
        }
    ];

    const stats = [
        { metric: 'Personalized', label: 'Higher conversion rates', color: 'text-green-800' },
        { metric: 'Automated', label: 'Lower costs', color: 'text-blue-600' },
        { metric: '24/7', label: 'Always-on assistance', color: 'text-purple-600' },
        { metric: '4x', label: 'Return on investment', color: 'text-orange-600' }
    ];

    const benefits = [
        'Every customer communication channel fully unified',
        'Round-the-clock responses with no extra headcount',
        'Markedly higher conversion from personalized messaging',
        'Less human error and lower operating costs',
        'Valuable customer data collected and analyzed',
        'Better customer experience and stronger brand loyalty'
    ];

    
---
<BaseLayout
  lang="en"
  title='Smart Marketing, Automation & Chatbots | AsreSEO'
  description='Marketing automation, smart chatbot design and AI-driven customer personalization at AsreSEO. Higher engagement and more visitors converted into buyers.'
  keywords='smart chatbot, marketing automation, website chatbot, AI in marketing, content personalization, AI marketing'
  canonical='/services/ai/marketing-engagement/'
  ogType='website'
  ogUrl='https://asreseo.com/services/ai/marketing-engagement/'
  ogImages={[{ url: "/og/marketing-engagement-hero.jpg", width: 1200, height: 630, alt: "Smart chatbots and marketing automation by AsreSEO" }]}
  twitterCard='summary_large_image'
>
<div class="min-h-screen bg-[#000000] text-slate-100 wireframe-grid">
            <script id="structured-data" type="application/ld+json" is:inline set:html={JSON.stringify(withServiceMeta(structuredData, { url: 'https://asreseo.com/services/ai/marketing-engagement/', image: '/og/marketing-engagement-hero.jpg' }))} />
            <BreadcrumbStructuredData items={breadcrumbs} />

            <Header lang="en" />

            <main>
                <!-- Hero Section -->
                <ServiceHero
                    lang="en"
                    badge="End-to-End Customer Engagement Platform"
                    title="Smart Marketing"
                    titleGradient="& Engagement"
                    description="Automation, smart chatbots and content personalization combined for an unmatched customer experience — and more sales."
                    primaryCta={{ text: "Start Going Smart", href: "/consultation/" }}
                    secondaryCta={{ text: "Get a Consultation", href: "/consultation/" }}
                    imageSrc="/images/marketing-engagement-hero.webp"
                    imageAlt="Smart marketing and engagement with AI"
                    theme="orange"
                />

                <!-- Stats Section -->
                <ServiceStats lang="en" stats={stats} theme="orange" />

                <!-- Automation Section -->
                <section class="section-padding">
                    <div class="container-custom">
                        <div class="text-center mb-12">
                            <Badge class="bg-orange-100 text-orange-700 mb-4">Marketing automation</Badge>
                            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
                                Automating <span class="gradient-text">Marketing Workflows</span>
                            </h2>
                            <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                                Run smart campaigns and nurture leads hands-free
                            </p>
                        </div>

                        <div class="grid md:grid-cols-3 gap-8">
                            {automationFeatures.map((feature, index) => (
                                <Card class="hover:shadow-xl transition-all duration-300 group border-0 shadow-lg bg-white">
                                    <CardHeader class="pb-4">
                                        <div class="flex items-center gap-3 mb-3">
                                            <div class="w-12 h-12 bg-orange-100 rounded-lg flex items-center justify-center group-hover:bg-orange-200 transition-colors">
                                                <Icon name={feature.icon} class="h-6 w-6 text-orange-600" />
                                            </div>
                                            <CardTitle class="text-lg font-semibold">{feature.title}</CardTitle>
                                        </div>
                                    </CardHeader>
                                    <CardContent>
                                        <p class="text-gray-600 mb-4 leading-relaxed">
                                            {feature.description}
                                        </p>
                                        <div class="space-y-2">
                                            {feature.benefits.map((benefit, benefitIndex) => (
                                                <div class="flex items-center gap-2 text-sm text-gray-500">
                                                    <Icon name="check-circle" class="h-4 w-4 text-green-500 shrink-0" />
                                                    {benefit}
                                                </div>
                                            ))}
                                        </div>
                                    </CardContent>
                                </Card>
                            ))}
                        </div>
                    </div>
                </section>

                <!-- Dedicated n8n Workflow Automation Engine Section -->
                <section class="py-20 bg-[#000000] border-t-2 border-white/10 wireframe-grid relative">
                    <div class="container-custom">
                        <div class="mb-14 text-left">
                            <div class="font-mono text-xs text-[#CCFF00] uppercase tracking-widest mb-2">[ORCHESTRATION_CLUSTER // N8N_ENGINE]</div>
                            <h2 class="text-3xl sm:text-4xl md:text-5xl font-black uppercase text-white tracking-tight leading-tight">
                                Autonomous <span class="text-[#CCFF00]">n8n Workflow</span> Infrastructure
                            </h2>
                            <p class="text-sm sm:text-base text-slate-400 font-mono mt-3 max-w-3xl">
                                // Self-hosted high-throughput orchestration cluster running proprietary community nodes
                            </p>
                        </div>

                        <div class="grid md:grid-cols-3 gap-6">
                            <div class="p-6 bg-[#0a0e17] border-2 border-white/15 brutalist-card hover:border-[#CCFF00] transition-colors rounded-none flex flex-col justify-between">
                                <div>
                                    <div class="flex items-center justify-between pb-3 mb-4 border-b border-white/10 font-mono text-xs">
                                        <span class="text-[#CCFF00] font-bold">N8N_CLUSTER</span>
                                        <span class="text-emerald-400 flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>ACTIVE</span>
                                    </div>
                                    <h3 class="text-xl font-bold uppercase text-white mb-2">n8n.asreseo.com</h3>
                                    <p class="text-slate-300 text-sm leading-relaxed mb-4">
                                        Our self-hosted n8n enterprise cluster powers round-the-clock webhook handling, CRM data syncing, indexing API alerts, and automated multi-channel campaigns.
                                    </p>
                                </div>
                                <a
                                    href="https://n8n.asreseo.com"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="inline-flex items-center gap-2 font-mono text-xs font-bold text-black bg-[#CCFF00] px-4 py-2.5 uppercase hover:bg-white transition-colors"
                                >
                                    Access Live Engine ↗
                                </a>
                            </div>

                            <div class="p-6 bg-[#0a0e17] border-2 border-white/15 brutalist-card hover:border-[#CCFF00] transition-colors rounded-none flex flex-col justify-between">
                                <div>
                                    <div class="flex items-center justify-between pb-3 mb-4 border-b border-white/10 font-mono text-xs">
                                        <span class="text-[#CCFF00] font-bold">CUSTOM_NODE_01</span>
                                        <span class="text-slate-400">OPEN SOURCE</span>
                                    </div>
                                    <h3 class="text-xl font-bold uppercase text-white mb-2">n8n-nodes-avvalai</h3>
                                    <p class="text-slate-300 text-sm leading-relaxed mb-4">
                                        Custom n8n node extension authored by Ali Bakhtiari providing native integration between n8n automated pipelines and AvvalAI intelligence APIs.
                                    </p>
                                </div>
                                <a
                                    href="https://github.com/alibakhtiari/n8n-nodes-avvalai"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="inline-flex items-center gap-2 font-mono text-xs font-bold text-white bg-black border border-white/20 px-4 py-2.5 uppercase hover:border-[#CCFF00] hover:text-[#CCFF00] transition-colors"
                                >
                                    GitHub Repository ↗
                                </a>
                            </div>

                            <div class="p-6 bg-[#0a0e17] border-2 border-white/15 brutalist-card hover:border-[#CCFF00] transition-colors rounded-none flex flex-col justify-between">
                                <div>
                                    <div class="flex items-center justify-between pb-3 mb-4 border-b border-white/10 font-mono text-xs">
                                        <span class="text-[#CCFF00] font-bold">CUSTOM_NODE_02</span>
                                        <span class="text-slate-400">OPEN SOURCE</span>
                                    </div>
                                    <h3 class="text-xl font-bold uppercase text-white mb-2">n8n-nodes-imagerouter</h3>
                                    <p class="text-slate-300 text-sm leading-relaxed mb-4">
                                        Custom n8n node extension authored by Ali Bakhtiari engineered for high-throughput conditional image routing, compression, and AI vision dispatching.
                                    </p>
                                </div>
                                <a
                                    href="https://github.com/alibakhtiari/n8n-nodes-imagerouter"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="inline-flex items-center gap-2 font-mono text-xs font-bold text-white bg-black border border-white/20 px-4 py-2.5 uppercase hover:border-[#CCFF00] hover:text-[#CCFF00] transition-colors"
                                >
                                    GitHub Repository ↗
                                </a>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Chatbot Section -->
                <section class="section-padding bg-slate-50">
                    <div class="container-custom">
                        <div class="text-center mb-12">
                            <Badge class="bg-indigo-100 text-indigo-700 mb-4">Smart chatbot</Badge>
                            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
                                Smart <span class="gradient-text">24/7 Responses</span>
                            </h2>
                            <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                                Advanced chatbots that learn from your documents (RAG)
                            </p>
                        </div>

                        <div class="grid md:grid-cols-3 gap-8">
                            {chatbotFeatures.map((feature, index) => (
                                <Card class="hover:shadow-xl transition-all duration-300 group border-0 shadow-lg bg-white">
                                    <CardHeader class="pb-4">
                                        <div class="flex items-center gap-3 mb-3">
                                            <div class="w-12 h-12 bg-indigo-100 rounded-lg flex items-center justify-center group-hover:bg-indigo-200 transition-colors">
                                                <Icon name={feature.icon} class="h-6 w-6 text-indigo-600" />
                                            </div>
                                            <CardTitle class="text-lg font-semibold">{feature.title}</CardTitle>
                                        </div>
                                    </CardHeader>
                                    <CardContent>
                                        <p class="text-gray-600 mb-4 leading-relaxed">
                                            {feature.description}
                                        </p>
                                        <div class="space-y-2">
                                            {feature.benefits.map((benefit, benefitIndex) => (
                                                <div class="flex items-center gap-2 text-sm text-gray-500">
                                                    <Icon name="check-circle" class="h-4 w-4 text-green-500 shrink-0" />
                                                    {benefit}
                                                </div>
                                            ))}
                                        </div>
                                    </CardContent>
                                </Card>
                            ))}
                        </div>
                    </div>
                </section>

                <!-- Personalization Section -->
                <section class="section-padding">
                    <div class="container-custom">
                        <div class="text-center mb-12">
                            <Badge class="bg-purple-100 text-purple-700 mb-4">Content personalization</Badge>
                            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
                                A <span class="gradient-text">Unique</span> Experience for Every User
                            </h2>
                            <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                                Content and offers matched to each visitor's taste and behavior
                            </p>
                        </div>

                        <div class="grid md:grid-cols-3 gap-8">
                            {personalizationFeatures.map((feature, index) => (
                                <Card class="hover:shadow-xl transition-all duration-300 group border-0 shadow-lg bg-white">
                                    <CardHeader class="pb-4">
                                        <div class="flex items-center gap-3 mb-3">
                                            <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center group-hover:bg-purple-200 transition-colors">
                                                <Icon name={feature.icon} class="h-6 w-6 text-purple-600" />
                                            </div>
                                            <CardTitle class="text-lg font-semibold">{feature.title}</CardTitle>
                                        </div>
                                    </CardHeader>
                                    <CardContent>
                                        <p class="text-gray-600 mb-4 leading-relaxed">
                                            {feature.description}
                                        </p>
                                        <div class="space-y-2">
                                            {feature.benefits.map((benefit, benefitIndex) => (
                                                <div class="flex items-center gap-2 text-sm text-gray-500">
                                                    <Icon name="check-circle" class="h-4 w-4 text-green-500 shrink-0" />
                                                    {benefit}
                                                </div>
                                            ))}
                                        </div>
                                    </CardContent>
                                </Card>
                            ))}
                        </div>
                    </div>
                </section>

                      <ServiceBenefits lang="en" title="Why Unify Around" titleHighlight="Smart Marketing" subtitle="Why connect all your marketing tools into one smart system?" benefits={benefits} />

                <!-- FAQ Section -->
                <ServiceFAQ
                    lang="en"
                    faqs={faqs}
                    title="Smart Marketing & Chatbot FAQs"
                    description="Common questions about chatbot setup, response rates and customer data security"
                    theme="orange"
                />

                <!-- CTA Section -->
                <ServiceCTA
                    lang="en"
                    title="Transform Your Marketing!"
                    description="Know your customers better, engage them more effectively and grow sales with our end-to-end platform."
                    primaryCta={{ text: "Start Free", href: "/consultation/" }}
                    secondaryCta={{ text: "Get a Demo", href: "/consultation/" }}
                    theme="orange"
                />
            </main>

            <Footer lang="en" />
        </div>
</BaseLayout>
