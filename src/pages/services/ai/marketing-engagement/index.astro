---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Header from '../../../../components/Layout/Header.astro';
import Footer from '../../../../components/Layout/Footer.astro';
import Card from '../../../../components/ui/card/Card.astro';
import CardContent from '../../../../components/ui/card/CardContent.astro';
import CardHeader from '../../../../components/ui/card/CardHeader.astro';
import CardTitle from '../../../../components/ui/card/CardTitle.astro';
import Badge from '../../../../components/ui/badge/Badge.astro';
import Icon from '../../../../components/ui/Icon.astro';
import ServiceHero from '../../../../components/Services/ServiceHero.astro';
import ServiceStats from '../../../../components/Services/ServiceStats.astro';
import ServiceFAQ from '../../../../components/Services/ServiceFAQ.astro';
import ServiceCTA from '../../../../components/Services/ServiceCTA.astro';
import BreadcrumbStructuredData from '../../../../components/BreadcrumbStructuredData.astro';
import ServiceBenefits from '../../../../components/Services/ServiceBenefits.astro';

const structuredData = {
    '@context': 'https://schema.org',
    '@type': 'Service',
    'name': 'بازاریابی هوشمند، اتوماسیون و چت‌بات فارسی',
    'description': 'خدمات جامع بازاریابی هوشمند شامل اتوماسیون، چت‌بات هوشمند فارسی و شخصی‌سازی محتوا توسط عصر سئو.',
    'serviceType': 'AI Marketing & Chatbot Solutions',
    'provider': {
        '@type': 'Organization',
        'name': 'عصر سئو',
        'url': 'https://asreseo.com'
    },
    'areaServed': 'Iran',
    'hasOfferCatalog': {
        '@type': 'OfferCatalog',
        'name': 'خدمات بازاریابی هوش مصنوعی',
        'itemListElement': [
            {
                '@type': 'Offer',
                'itemOffered': {
                    '@type': 'Service',
                    'name': 'چت‌بات هوشمند فارسی',
                    'description': 'پاسخگویی ۲۴ ساعته با هوش مصنوعی و جذب لید'
                }
            },
            {
                '@type': 'Offer',
                'itemOffered': {
                    '@type': 'Service',
                    'name': 'اتوماسیون بازاریابی',
                    'description': 'خودکارسازی کمپین‌های ایمیل و پیامک با هوش مصنوعی'
                }
            },
            {
                '@type': 'Offer',
                'itemOffered': {
                    '@type': 'Service',
                    'name': 'شخصی‌سازی تجربه مشتری (CX)',
                    'description': 'نمایش پیشنهادهای اختصاصی بر اساس رفتار کاربر'
                }
            }
        ]
    }
};

const faqs = [
    {
        q: 'چت‌بات هوشمند فارسی عصر سئو چگونه به وب‌سایت متصل می‌شود؟',
        a: 'تنها با قرار دادن یک اسکریپت ساده یا افزونه اختصاصی، چت‌بات روی وب‌سایت شما فعال شده و به پایگاه دانش محصولات و خدمات شما متصل می‌گردد.'
    },
    {
        q: 'آیا چت‌بات زبان فارسی و اصطلاحات محاوره‌ای را می‌فهمد؟',
        a: 'بله. مدل‌های زبانی استفاده‌شده به طور کامل برای زبان و ادبیات محاوره‌ای فارسی بهینه‌سازی شده‌اند و لحن صمیمی یا رسمی متناسب با برند شما را به کار می‌گیرند.'
    },
    {
        q: 'چگونه اتوماسیون بازاریابی باعث افزایش نرخ تبدیل می‌شود؟',
        a: 'با پیگیری خودکار سبدهای خرید رهاشده، ارسال پیام‌های به موقع در مناسبت‌ها و ارسال محتوای مرتبط بر اساس صفحات بازدیدشده توسط هر کاربر، نرخ تبدیل تا ۳۰۰٪ رشد می‌کند.'
    },
    {
        q: 'آیا امکان یکپارچه‌سازی با نرم‌افزارهای CRM وجود دارد؟',
        a: 'بله. چت‌بات و سیستم اتوماسیون عصر سئو به نرم‌افزارهای CRM متداول، وب‌هوک‌ها و سامانه‌های پیامکی به سادگی متصل می‌شوند.'
    }
];

const breadcrumbs = [
    { position: 1, name: 'خانه', item: 'https://asreseo.com/' },
    { position: 2, name: 'خدمات هوش مصنوعی', item: 'https://asreseo.com/services/ai/' },
    { position: 3, name: 'بازاریابی و تعامل هوشمند', item: 'https://asreseo.com/services/ai/marketing-engagement/' }
];



    const automationFeatures = [
        {
            icon: "mail",
            title: 'ایمیل مارکتینگ هوشمند',
            description: 'ارسال خودکار ایمیل‌های شخصی‌سازی شده بر اساس رفتار کاربران.',
            benefits: ['شخصی‌سازی محتوا', 'زمان‌بندی هوشمند', 'بازخورد خودکار']
        },
        {
            icon: "users",
            title: 'پرورش سرنخ‌ها',
            description: 'تبدیل خودکار بازدیدکنندگان به مشتریان از طریق کمپین‌های هدفمند.',
            benefits: ['نرخ تبدیل بالاتر', 'آموزش سیستماتیک', 'پیگیری هوشمند']
        },
        {
            icon: "target",
            title: 'تارگتینگ پیشرفته',
            description: 'شناسایی و هدف‌گیری دقیق مخاطبان بر اساس داده‌های رفتاری.',
            benefits: ['هدف‌گیری دقیق‌تر', 'بازده بالاتر', 'بهبود ROI']
        }
    ];

    const chatbotFeatures = [
        {
            icon: "bot",
            title: 'چت‌بات RAG پیشرفته',
            description: 'پاسخگویی دقیق با یادگیری از پایگاه دانش و اسناد سازمانی شما.',
            benefits: ['دقت بالاتر', 'یادگیری از داده‌ها', 'پاسخ‌های مرتبط']
        },
        {
            icon: "database",
            title: 'ادغام با پایگاه دانش',
            description: 'اتصال مستقیم به اطلاعات محصولات و خدمات برای پاسخ‌های جامع.',
            benefits: ['دسترسی کامل', 'پاسخ‌های یکپارچه', 'به‌روزرسانی خودکار']
        },
        {
            icon: "message-square",
            title: 'گفتگوی طبیعی فارسی',
            description: 'درک عمیق زبان فارسی و قابلیت گفتگوی طبیعی و روان.',
            benefits: ['درک بالا', 'پاسخ‌های طبیعی', 'پشتیبانی ۲۴/۷']
        }
    ];

    const personalizationFeatures = [
        {
            icon: "user",
            title: 'تجربه کاربری اختصاصی',
            description: 'نمایش محتوای منحصربه‌فرد برای هر کاربر بر اساس علایق.',
            benefits: ['تجربه خاص', 'تعامل بیشتر', 'رضایت بالاتر']
        },
        {
            icon: "sparkles",
            title: 'پیشنهاد محصول هوشمند',
            description: 'پیشنهاد محصولات مرتبط بر اساس سوابق بازدید و خرید.',
            benefits: ['افزایش فروش', 'سبد خرید بزرگتر', 'کشف محصولات']
        },
        {
            icon: "heart-handshake",
            title: 'وفادارسازی مشتری',
            description: 'ایجاد حس ارزشمندی و افزایش وفاداری با محتوای شخصی.',
            benefits: ['وفاداری بیشتر', 'بازگشت مکرر', 'ارزش طول عمر']
        }
    ];

    const stats = [
        { metric: '۳۰۰%', label: 'افزایش نرخ تبدیل', color: 'text-green-800' },
        { metric: '۷۰%', label: 'کاهش هزینه‌ها', color: 'text-blue-600' },
        { metric: '۲۴/۷', label: 'پاسخگویی مداوم', color: 'text-purple-600' },
        { metric: '۴x', label: 'بازگشت سرمایه', color: 'text-orange-600' }
    ];

    const benefits = [
        'یکپارچگی کامل تمام کانال‌های ارتباطی با مشتری',
        'پاسخگویی ۲۴ ساعته بدون نیاز به نیروی انسانی اضافه',
        'افزایش چشمگیر نرخ تبدیل با پیام‌های شخصی‌سازی شده',
        'کاهش خطای انسانی و هزینه‌های عملیاتی',
        'جمع‌آوری و تحلیل داده‌های ارزشمند مشتریان',
        'بهبود تجربه مشتری و افزایش وفاداری به برند'
    ];

    
---
<BaseLayout
  title='بازاریابی هوشمند، اتوماسیون و چت‌بات فارسی | عصر سئو'
  description='خدمات اتوماسیون بازاریابی، طراحی چت‌بات هوشمند فارسی و شخصی‌سازی تجربه مشتری با هوش مصنوعی در عصر سئو. افزایش ۳۰۰٪ نرخ تعامل و تبدیل بازدیدکننده به خریدار.'
  keywords='چت‌بات هوشمند فارسی, اتوماسیون بازاریابی, چت‌بات سایت, هوش مصنوعی در بازاریابی, شخصی‌سازی محتوا, AI Marketing'
  canonical='https://asreseo.com/services/ai/marketing-engagement/'
  ogType='website'
  ogUrl='https://asreseo.com/services/ai/marketing-engagement/'
  ogImages={[{ url: "/images/marketing-engagement-hero.webp", width: 1200, height: 630, alt: "چت‌بات هوشمند فارسی و اتوماسیون بازاریابی عصر سئو" }]}
  twitterCard='summary_large_image'
>
<div class="min-h-screen bg-white">
            <script id="structured-data" type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
            <BreadcrumbStructuredData items={breadcrumbs} />

            <Header />

            <main>
                <!-- Hero Section -->
                <ServiceHero
                    badge="پلتفرم جامع تعامل با مشتری"
                    title="بازاریابی و تعامل"
                    titleGradient="هوشمند"
                    description="ترکیب قدرت اتوماسیون، چت‌بات‌های هوشمند و شخصی‌سازی محتوا برای خلق تجربه‌ای بی‌نظیر برای مشتریان و افزایش فروش."
                    primaryCta={{ text: "شروع هوشمندسازی", href: "/consultation/" }}
                    secondaryCta={{ text: "دریافت مشاوره", href: "/consultation/" }}
                    imageSrc="/images/marketing-engagement-hero.webp"
                    imageAlt="بازاریابی و تعامل هوشمند با هوش مصنوعی"
                    theme="orange"
                />

                <!-- Stats Section -->
                <ServiceStats stats={stats} theme="orange" />

                <!-- Automation Section -->
                <section class="section-padding">
                    <div class="container-custom">
                        <div class="text-center mb-12">
                            <Badge class="bg-orange-100 text-orange-700 mb-4">اتوماسیون بازاریابی</Badge>
                            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
                                خودکارسازی <span class="gradient-text">فرایندهای بازاریابی</span>
                            </h2>
                            <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                                اجرای کمپین‌های هوشمند و پرورش سرنخ‌ها بدون دخالت دست
                            </p>
                        </div>

                        <div class="grid md:grid-cols-3 gap-8">
                            {automationFeatures.map((feature, index) => (
                                <Card class="hover:shadow-xl transition-all duration-300 group border-0 shadow-lg bg-white">
                                    <CardHeader class="pb-4">
                                        <div class="flex items-center gap-3 mb-3">
                                            <div class="w-12 h-12 bg-orange-100 rounded-lg flex items-center justify-center group-hover:bg-orange-200 transition-colors">
                                                <Icon name={feature.icon} class="h-6 w-6 text-orange-600" />
                                            </div>
                                            <CardTitle class="text-lg font-semibold">{feature.title}</CardTitle>
                                        </div>
                                    </CardHeader>
                                    <CardContent>
                                        <p class="text-gray-600 mb-4 leading-relaxed">
                                            {feature.description}
                                        </p>
                                        <div class="space-y-2">
                                            {feature.benefits.map((benefit, benefitIndex) => (
                                                <div class="flex items-center gap-2 text-sm text-gray-500">
                                                    <Icon name="check-circle" class="h-4 w-4 text-green-500 shrink-0" />
                                                    {benefit}
                                                </div>
                                            ))}
                                        </div>
                                    </CardContent>
                                </Card>
                            ))}
                        </div>
                    </div>
                </section>

                <!-- Chatbot Section -->
                <section class="section-padding bg-slate-50">
                    <div class="container-custom">
                        <div class="text-center mb-12">
                            <Badge class="bg-indigo-100 text-indigo-700 mb-4">چت‌بات هوشمند</Badge>
                            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
                                پاسخگویی <span class="gradient-text">۲۴ ساعته و هوشمند</span>
                            </h2>
                            <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                                چت‌بات‌های پیشرفته با قابلیت یادگیری از مستندات شما (RAG)
                            </p>
                        </div>

                        <div class="grid md:grid-cols-3 gap-8">
                            {chatbotFeatures.map((feature, index) => (
                                <Card class="hover:shadow-xl transition-all duration-300 group border-0 shadow-lg bg-white">
                                    <CardHeader class="pb-4">
                                        <div class="flex items-center gap-3 mb-3">
                                            <div class="w-12 h-12 bg-indigo-100 rounded-lg flex items-center justify-center group-hover:bg-indigo-200 transition-colors">
                                                <Icon name={feature.icon} class="h-6 w-6 text-indigo-600" />
                                            </div>
                                            <CardTitle class="text-lg font-semibold">{feature.title}</CardTitle>
                                        </div>
                                    </CardHeader>
                                    <CardContent>
                                        <p class="text-gray-600 mb-4 leading-relaxed">
                                            {feature.description}
                                        </p>
                                        <div class="space-y-2">
                                            {feature.benefits.map((benefit, benefitIndex) => (
                                                <div class="flex items-center gap-2 text-sm text-gray-500">
                                                    <Icon name="check-circle" class="h-4 w-4 text-green-500 shrink-0" />
                                                    {benefit}
                                                </div>
                                            ))}
                                        </div>
                                    </CardContent>
                                </Card>
                            ))}
                        </div>
                    </div>
                </section>

                <!-- Personalization Section -->
                <section class="section-padding">
                    <div class="container-custom">
                        <div class="text-center mb-12">
                            <Badge class="bg-purple-100 text-purple-700 mb-4">شخصی‌سازی محتوا</Badge>
                            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
                                تجربه <span class="gradient-text">منحصربه‌فرد</span> برای هر کاربر
                            </h2>
                            <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                                نمایش محتوا و پیشنهادات متناسب با سلیقه و رفتار هر بازدیدکننده
                            </p>
                        </div>

                        <div class="grid md:grid-cols-3 gap-8">
                            {personalizationFeatures.map((feature, index) => (
                                <Card class="hover:shadow-xl transition-all duration-300 group border-0 shadow-lg bg-white">
                                    <CardHeader class="pb-4">
                                        <div class="flex items-center gap-3 mb-3">
                                            <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center group-hover:bg-purple-200 transition-colors">
                                                <Icon name={feature.icon} class="h-6 w-6 text-purple-600" />
                                            </div>
                                            <CardTitle class="text-lg font-semibold">{feature.title}</CardTitle>
                                        </div>
                                    </CardHeader>
                                    <CardContent>
                                        <p class="text-gray-600 mb-4 leading-relaxed">
                                            {feature.description}
                                        </p>
                                        <div class="space-y-2">
                                            {feature.benefits.map((benefit, benefitIndex) => (
                                                <div class="flex items-center gap-2 text-sm text-gray-500">
                                                    <Icon name="check-circle" class="h-4 w-4 text-green-500 shrink-0" />
                                                    {benefit}
                                                </div>
                                            ))}
                                        </div>
                                    </CardContent>
                                </Card>
                            ))}
                        </div>
                    </div>
                </section>

                      <ServiceBenefits title="مزایای یکپارچه‌سازی" titleHighlight="بازاریابی هوشمند" subtitle="چرا باید تمام ابزارهای بازاریابی خود را هوشمند و یکپارچه کنید؟" benefits={benefits} />

                <!-- FAQ Section -->
                <ServiceFAQ
                    faqs={faqs}
                    title="سوالات متداول بازاریابی هوشمند و چت‌بات فارسی"
                    description="پاسخ به سوالات رایج درباره راه‌اندازی چت‌بات، نرخ پاسخگویی و امنیت مشتریان"
                    theme="orange"
                />

                <!-- CTA Section -->
                <ServiceCTA
                    title="بازاریابی خود را متحول کنید!"
                    description="با پلتفرم جامع ما، مشتریان خود را بهتر بشناسید، با آن‌ها تعامل موثرتری داشته باشید و فروش خود را افزایش دهید."
                    primaryCta={{ text: "شروع رایگان", href: "/consultation/" }}
                    secondaryCta={{ text: "دریافت دمو", href: "/consultation/" }}
                    theme="orange"
                />
            </main>

            <Footer />
        </div>
</BaseLayout>
