---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Layout/Header.astro';
import Footer from '../../components/Layout/Footer.astro';
import Button from '../../components/ui/button/Button.astro';
import Icon from '../../components/ui/Icon.astro';
import BreadcrumbStructuredData from '../../components/BreadcrumbStructuredData.astro';

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'پشتیبانی عصر سئو',
  url: 'https://asreseo.com/support/',
  inLanguage: 'fa-IR',
};
const breadcrumbs = [
  { position: 1, name: 'خانه', item: 'https://asreseo.com/' },
  { position: 2, name: 'پشتیبانی عصر سئو', item: 'https://asreseo.com/support/' },
];
---
<BaseLayout title='پشتیبانی | عصر سئو' description='پشتیبانی عصر سئو؛ پاسخگویی سریع از طریق تلگرام، ایمیل و تماس تلفنی شنبه تا چهارشنبه. مشکل خود را مطرح کنید.' canonical='https://asreseo.com/support/' ogType='website' twitterCard='summary_large_image'>
<div class="min-h-screen bg-white">
            <Header />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(pageSchema)} />
  <BreadcrumbStructuredData items={breadcrumbs} />
            <main class="section-padding pt-32">
                <div class="container-custom">
                    <div class="text-center mb-16">
                        <h1 class="text-4xl font-bold mb-6">مرکز پشتیبانی</h1>
                        <p class="text-xl text-gray-600">ما همیشه آماده پاسخگویی به شما هستیم</p>
                    </div>

                    <div class="grid md:grid-cols-3 gap-8">
                        <div class="p-8 rounded-2xl bg-blue-50 text-center animate-fade-in">
                            <Icon name="message-circle" class="h-12 w-12 text-blue-600 mx-auto mb-6" />
                            <h3 class="text-xl font-bold mb-4">پشتیبانی تلگرام</h3>
                            <p class="text-gray-600 mb-6">پاسخگویی سریع در کوتاه‌ترین زمان ممکن</p>
                            <Button class="w-full" href="https://t.me/asreseo" target="_blank" rel="noopener">ارسال پیام</Button>
                        </div>

                        <div class="p-8 rounded-2xl bg-indigo-50 text-center animate-fade-in animation-delay-200">
                            <Icon name="mail" class="h-12 w-12 text-indigo-600 mx-auto mb-6" />
                            <h3 class="text-xl font-bold mb-4">پشتیبانی ایمیلی</h3>
                            <p class="text-gray-600 mb-6">مناسب برای موارد رسمی و مستندات</p>
                            <Button class="w-full" href="mailto:info@asreseo.com">ارسال ایمیل</Button>
                        </div>

                        <div class="p-8 rounded-2xl bg-slate-100 text-center animate-fade-in animation-delay-400">
                            <Icon name="phone-call" class="h-12 w-12 text-slate-700 mx-auto mb-6" />
                            <h3 class="text-xl font-bold mb-4">تماس تلفنی</h3>
                            <p class="text-gray-600 mb-6">شنبه تا چهارشنبه، ۹ الی ۱۷</p>
                            <Button variant="outline" class="w-full border-slate-300" href="tel:+989125811880">تماس با ما</Button>
                        </div>
                    </div>
                </div>
            </main>
            <Footer />
        </div>
</BaseLayout>
