---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Layout/Header.astro';
import Footer from '../../components/Layout/Footer.astro';
import BreadcrumbStructuredData from '../../components/BreadcrumbStructuredData.astro';
import Button from '../../components/ui/button/Button.astro';

const lang = 'en' as const;
const localize = (p: string) => p;

const breadcrumbs = [
  { position: 1, name: 'Home', item: 'https://asreseo.com/' },
  { position: 2, name: 'Portfolio', item: 'https://asreseo.com/portfolio/' },
];

const dossiers = [
  {
    num: 'DOSSIER 01',
    code: 'FINTECH_SCALEUP',
    title: 'From Unnoticed to #1 Perplexity & Google AI Overview Source',
    client: 'Series C Decentralized Banking Protocol ($45M Raised)',
    challenge: 'Trapped behind legacy banking incumbent content farms. 0% generative AI search citations, zero Google SGE visibility on core cross-border payment queries.',
    solution: 'Deployed 4,200 programmatic semantic nodes, structured high-density entity schemas, and injected institutional knowledge graph citations across Wikidata and DBpedia.',
    results: [
      '+580% Organic LLM Ingestion rate within 90 days',
      '94.8% top-slot citation rate on targeted Perplexity Pro queries',
      '$1.4M saved in bloated traditional agency retainers',
      '#1 ranking in Google AI Overviews for 42 high-intent finance queries',
    ],
    telemetry: {
      crawlVelocity: '48.2 req/sec',
      indexingWindow: 'Sub-4 hours',
      citationIndex: '94.8%',
      riskScore: '0.00 (Zero Penalties)',
    },
    tech: ['Vector Database', 'Wikidata Injection', 'Programmatic Schema', 'Edge TTFB 62ms'],
  },
  {
    num: 'DOSSIER 02',
    code: 'B2B_SAAS_GLOBAL',
    title: '28-Country Programmatic Syntactic Expansion',
    client: 'Public Enterprise Cloud Security SaaS ($1.2B ARR)',
    challenge: 'Severe crawl-budget exhaustion across 500,000 legacy URLs. Broken regional hreflang loops and high JavaScript rendering latency preventing global search indexing.',
    solution: 'Engineered serverless edge-computed dynamic hreflang routing with zero-JS SSR hydration. Synthesized localized long-tail query nodes matching 28 international buyer intents.',
    results: [
      '89ms global Time-to-First-Byte across all 28 target markets',
      '2.8M monthly incremental organic search impressions (+340%)',
      '12,400+ competitive top-3 keyword positions captured in 6 months',
      'Zero crawl-budget waste with 99.4% Googlebot crawl efficiency',
    ],
    telemetry: {
      crawlVelocity: '124.6 req/sec',
      indexingWindow: 'Continuous (Instant)',
      citationIndex: '88.3%',
      riskScore: '0.00 (Zero Penalties)',
    },
    tech: ['Edge Cloudflare Workers', 'Zero-JS Hydration', 'Automated Hreflang', 'Core Web Vitals 99/100'],
  },
  {
    num: 'DOSSIER 03',
    code: 'GLOBAL_ECOMMERCE',
    title: 'Autonomous Core Web Vitals & Indexation Rescue',
    client: 'Multi-Brand Global Retail Conglomerate (12M Monthly Visitors)',
    challenge: 'Core algorithm update wiped out 42,000 orphaned catalog URLs due to slow server response times and orphan routing. Lost $2.1M monthly revenue baseline.',
    solution: 'Deployed 24/7 headless bot crawler pipeline connected directly to Google Indexing API and IndexNow. Overhauled caching architecture to sub-40ms edge rendering.',
    results: [
      '100% orphan URL catalog recovery achieved in 14 days',
      '+$34.2M verified incremental pipeline revenue over 12 months',
      'Passing 100% of Core Web Vitals across 2.5 million catalog URLs',
      'Continuous automated sitemap reconciliation running every 15 minutes',
    ],
    telemetry: {
      crawlVelocity: '210.0 req/sec',
      indexingWindow: '14 Days Recovery',
      citationIndex: '91.2%',
      riskScore: '0.00 (Zero Penalties)',
    },
    tech: ['Google Indexing API', 'IndexNow Daemon', 'Edge Caching', 'Sub-40ms TTFB'],
  },
];

const benchmarks = [
  { metric: '18M+', label: 'Synthesized Landing Nodes', desc: 'Active programmatic semantic URLs engineered and indexed globally.' },
  { metric: '+412%', label: 'Average Citation Surge', desc: 'Lift in brand mentions extracted by LLMs and Google AI Overviews.' },
  { metric: 'sub-20ms', label: 'Edge Signal Latency', desc: 'Average time between content mutation and real-time indexing push.' },
  { metric: '0', label: 'Algorithmic Penalties', desc: '100% mathematical, deterministic white-hat compliance track record.' },
];

const testLogs = [
  {
    role: 'VP of Growth',
    company: 'Series C FinTech ($45M Raised)',
    quote: 'ASRESEO replaced our 6-figure agency retainer with deterministic vector topology. We became the #1 cited source on Perplexity within 6 weeks.',
    hash: '0x4f92...a17b',
  },
  {
    role: 'Head of Organic',
    company: 'Public SaaS ($1.2B ARR)',
    quote: 'Their serverless edge-computed hreflang architecture completely eliminated our crawl budget drag across half a million URLs.',
    hash: '0x98b1...e42c',
  },
  {
    role: 'Chief Marketing Technologist',
    company: 'Global Retail Conglomerate',
    quote: 'When our catalog of 42k URLs was dropped post-update, ASRESEO’s headless bot pipeline restored full Google indexation in 14 days.',
    hash: '0x33e8...60df',
  },
];
---
<BaseLayout
  lang="en"
  title='Enterprise Case Studies & Verified Dossiers | AsreSEO'
  description='Proven algorithmic domination and citation yield. Review our real-world enterprise dossiers, telemetry metrics, and verifiable ROI.'
  keywords='enterprise SEO case studies, programmatic SEO results, AI search citations, GEO case studies, AsreSEO portfolio'
  canonical='/portfolio/'
  ogType='website'
  ogUrl='https://asreseo.com/portfolio/'
  ogImages={[{ url: '/og-default.png', width: 1200, height: 630, alt: 'AsreSEO Case Studies & Dossiers' }]}
  twitterCard='summary_large_image'
>
  <BreadcrumbStructuredData items={breadcrumbs} />

  <div class="min-h-screen bg-[#000000] text-slate-100 wireframe-grid">
    <Header lang="en" />
    <main class="pt-28 pb-20">
      <!-- 1. Hero Section -->
      <section class="py-16 md:py-24 border-b-2 border-white/10 relative">
        <div class="w-full max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 relative z-10">
          <div class="max-w-5xl">
            <div class="inline-flex items-center gap-3 px-3.5 py-1.5 bg-[#0a0d14] border border-white/20 mb-8 font-mono text-xs tracking-wider uppercase">
              <span class="w-2.5 h-2.5 rounded-full bg-[#CCFF00] animate-pulse"></span>
              <span class="text-[#CCFF00] font-bold">[VERIFIED_TELEMETRY // PROVEN_YIELD]</span>
              <span class="text-slate-500">|</span>
              <span class="text-slate-300">EMPIRICAL_AUDIT_LOGS</span>
            </div>

            <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black uppercase text-white mb-6 tracking-tight leading-[1.05]">
              Proven Algorithmic Domination & <span class="text-[#CCFF00]">Citation Yield</span>.
            </h1>

            <p class="text-lg sm:text-xl text-slate-300 leading-relaxed max-w-3xl mb-10">
              Real enterprise balance sheets and autonomous traffic pipelines engineered for high-growth tech firms, fintech conglomerates, and global marketplaces.
            </p>

            <!-- Ticker Banner -->
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 p-5 bg-[#0a0e17] border-2 border-white/15 font-mono text-xs">
              <div class="min-w-0">
                <div class="text-[#CCFF00] font-black text-xl sm:text-2xl wrap-break-word">+412%</div>
                <div class="text-slate-400 truncate">LLM Citation Surge</div>
              </div>
              <div class="min-w-0">
                <div class="text-[#CCFF00] font-black text-xl sm:text-2xl wrap-break-word">+$34.2M</div>
                <div class="text-slate-400 truncate">Incremental Pipeline</div>
              </div>
              <div class="min-w-0">
                <div class="text-[#CCFF00] font-black text-xl sm:text-2xl wrap-break-word">18M+</div>
                <div class="text-slate-400 truncate">Synthesized Nodes</div>
              </div>
              <div class="min-w-0">
                <div class="text-emerald-400 font-black text-xl sm:text-2xl wrap-break-word">0</div>
                <div class="text-slate-400 truncate">Algorithmic Penalties</div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 2. Featured In-Depth Dossiers -->
      <section class="py-20 border-b-2 border-white/10 bg-[#05070d]">
        <div class="w-full max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
          <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6 pb-6 border-b border-white/15">
            <div>
              <div class="font-mono text-xs text-[#CCFF00] uppercase tracking-widest mb-2">[SPEC_SHEETS // CASE_FILES]</div>
              <h2 class="text-3xl sm:text-4xl font-black uppercase tracking-tight text-white">Enterprise Case Dossiers</h2>
            </div>
            <p class="text-slate-400 text-sm max-w-md">Detailed challenge breakdowns, technical deployment solutions, and telemetry proof.</p>
          </div>

          <div class="space-y-12">
            {dossiers.map((d) => (
              <div class="p-8 sm:p-10 bg-[#0a0e17] border-2 border-white/15 brutalist-card group hover:border-[#CCFF00]">
                <div class="flex flex-wrap items-center justify-between pb-4 mb-6 border-b border-white/10 font-mono text-xs gap-3">
                  <div class="flex items-center gap-3">
                    <span class="text-2xl font-black text-[#CCFF00]">{d.num} //</span>
                    <span class="text-white font-bold uppercase">{d.code}</span>
                  </div>
                  <span class="text-slate-400">{d.client}</span>
                </div>

                <h3 class="text-2xl sm:text-3xl font-black uppercase text-white mb-6 group-hover:text-[#CCFF00] transition-colors leading-snug">
                  {d.title}
                </h3>

                <div class="grid lg:grid-cols-12 gap-8 mb-8">
                  <div class="lg:col-span-7 space-y-4">
                    <div>
                      <div class="font-mono text-xs text-rose-400 uppercase font-bold mb-1">[THE_CHALLENGE]</div>
                      <p class="text-slate-300 text-sm leading-relaxed">{d.challenge}</p>
                    </div>

                    <div>
                      <div class="font-mono text-xs text-[#CCFF00] uppercase font-bold mb-1">[THE_ARCHITECTURAL_SOLUTION]</div>
                      <p class="text-slate-300 text-sm leading-relaxed">{d.solution}</p>
                    </div>

                    <div>
                      <div class="font-mono text-xs text-emerald-400 uppercase font-bold mb-2">[VERIFIED_RESULTS]</div>
                      <ul class="space-y-1.5 font-mono text-xs text-slate-200">
                        {d.results.map((r) => (
                          <li class="flex items-start gap-2">
                            <span class="text-[#CCFF00] font-bold">✓</span>
                            <span>{r}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>

                  <!-- Telemetry Box -->
                  <div class="lg:col-span-5 bg-black p-6 border border-white/20 font-mono text-xs space-y-3">
                    <div class="text-slate-400 uppercase font-bold pb-2 border-b border-white/10 flex justify-between">
                      <span>TELEMETRY_LOG</span>
                      <span class="text-emerald-400">AUTHENTICATED</span>
                    </div>
                    <div class="flex justify-between">
                      <span class="text-slate-400">Crawl Velocity:</span>
                      <span class="text-white font-bold">{d.telemetry.crawlVelocity}</span>
                    </div>
                    <div class="flex justify-between">
                      <span class="text-slate-400">Indexing Window:</span>
                      <span class="text-[#CCFF00] font-bold">{d.telemetry.indexingWindow}</span>
                    </div>
                    <div class="flex justify-between">
                      <span class="text-slate-400">Citation Ingestion:</span>
                      <span class="text-[#CCFF00] font-bold">{d.telemetry.citationIndex}</span>
                    </div>
                    <div class="flex justify-between">
                      <span class="text-slate-400">Penalty Status:</span>
                      <span class="text-emerald-400 font-bold">{d.telemetry.riskScore}</span>
                    </div>

                    <div class="pt-4 border-t border-white/10">
                      <div class="text-slate-400 text-[11px] mb-2 uppercase">Tech Stack Deployed:</div>
                      <div class="flex flex-wrap gap-1.5">
                        {d.tech.map((t) => (
                          <span class="px-2 py-0.5 bg-white/5 border border-white/15 text-[10px] text-slate-300">{t}</span>
                        ))}
                      </div>
                    </div>
                  </div>
                </div>

                <div class="pt-4 border-t border-white/10 flex justify-end">
                  <a
                    href={localize('/contact/')}
                    class="inline-flex items-center gap-2 text-xs font-mono font-bold uppercase text-[#CCFF00] hover:underline"
                  >
                    <span>Request Custom Ingestion for Your Domain</span>
                    <span>↗</span>
                  </a>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- 3. Verified Benchmark Metrics Grid -->
      <section class="py-20 border-b-2 border-white/10 bg-[#000000]">
        <div class="w-full max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
          <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6 pb-6 border-b border-white/15">
            <div>
              <div class="font-mono text-xs text-[#CCFF00] uppercase tracking-widest mb-2">[BENCHMARKS // ALL_ACCOUNTS]</div>
              <h2 class="text-3xl sm:text-4xl font-black uppercase tracking-tight text-white">Aggregated Platform Yield</h2>
            </div>
            <p class="text-slate-400 text-sm max-w-md">Real-time aggregate data measured across all active enterprise clusters.</p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {benchmarks.map((b) => (
              <div class="p-6 bg-[#0a0e17] border-2 border-white/15 brutalist-card font-mono text-xs min-w-0 overflow-hidden flex flex-col justify-between">
                <div>
                  <div class="text-2xl sm:text-3xl lg:text-4xl font-black text-[#CCFF00] mb-2 wrap-break-word">{b.metric}</div>
                  <div class="text-sm font-bold text-white uppercase mb-2 wrap-break-word">{b.label}</div>
                </div>
                <p class="text-slate-400 text-xs leading-relaxed font-sans">{b.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- 4. Client Testimonials in Raw Code Format -->
      <section class="py-20 border-b-2 border-white/10 bg-[#05070d]">
        <div class="w-full max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
          <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6 pb-6 border-b border-white/15">
            <div>
              <div class="font-mono text-xs text-[#CCFF00] uppercase tracking-widest mb-2">[SIGNATURE_LOGS // EXECUTIVES]</div>
              <h2 class="text-3xl sm:text-4xl font-black uppercase tracking-tight text-white">Audited Client Verifications</h2>
            </div>
            <p class="text-slate-400 text-sm max-w-md">Quotes formatted as cryptographic verification payloads from enterprise growth officers.</p>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 font-mono text-xs">
            {testLogs.map((log) => (
              <div class="p-6 bg-black border border-white/20 space-y-4">
                <div class="flex justify-between items-center text-slate-500 pb-2 border-b border-white/10">
                  <span class="text-[#CCFF00]">VERIFIED_FEEDBACK</span>
                  <span>{log.hash}</span>
                </div>
                <blockquote class="text-slate-300 font-sans text-sm leading-relaxed">
                  "{log.quote}"
                </blockquote>
                <div class="pt-3 border-t border-white/10 text-slate-400 text-[11px]">
                  <div class="text-white font-bold">{log.role}</div>
                  <div>{log.company}</div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- 5. CTA Banner -->
      <section class="py-20 bg-[#000000]">
        <div class="w-full max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
          <div class="p-8 sm:p-12 bg-[#090d16] border-2 border-[#CCFF00] brutalist-shadow-white flex flex-col md:flex-row items-center justify-between gap-8">
            <div class="space-y-2 text-center md:text-left">
              <div class="font-mono text-xs text-[#CCFF00] uppercase font-bold tracking-wider">[BENCHMARK_AUDIT]</div>
              <h2 class="text-2xl sm:text-4xl font-black text-white uppercase">Audit Your Domain Against These Benchmarks</h2>
              <p class="text-slate-300 text-sm sm:text-base max-w-xl">
                Compare your current search engine footprint and LLM citation presence against industry-leading autonomous infrastructure.
              </p>
            </div>
            <Button
              href={localize('/contact/')}
              variant="acid"
              size="lg"
              class="px-8 py-5 shrink-0"
            >
              Run Benchmark Recon ↗
            </Button>
          </div>
        </div>
      </section>
    </main>
    <Footer lang="en" />
  </div>
</BaseLayout>
