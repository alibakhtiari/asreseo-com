---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Picture from '../../components/ui/Picture.astro';
import Header from '../../components/Layout/Header.astro';
import Footer from '../../components/Layout/Footer.astro';
import BreadcrumbStructuredData from '../../components/BreadcrumbStructuredData.astro';
const aboutSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  'name': 'درباره ما - عصر سئو',
  'description': 'معرفی آژانس دیجیتال مارکتینگ عصر سئو، رسالت، چشم‌انداز و سابقه متخصصان در حوزه سئو و هوش مصنوعی.',
  'mainEntity': {
    '@type': 'Organization',
    'name': 'عصر سئو',
    'url': 'https://asreseo.com',
    'logo': 'https://asreseo.com/Logo-spaced.png',
    'foundingDate': '2020',
    'sameAs': [
      'https://instagram.com/asreseo',
      'https://t.me/asreseo',
      'https://linkedin.com/company/asreseo'
    ]
  }
};

const breadcrumbs = [
    { position: 1, name: 'خانه', item: 'https://asreseo.com/' },
    { position: 2, name: 'درباره ما', item: 'https://asreseo.com/about/' },
  ];
---
<BaseLayout
  title='درباره ما | آژانس دیجیتال مارکتینگ و سئو عصر سئو'
  description='آشنایی با تیم متخصص عصر سئو، پیشگام خدمات سئو، تبلیغات گوگل، تولید محتوا و هوش مصنوعی در ایران با سابقه بیش از ۵۰۰ پروژه موفق.'
  keywords='درباره عصر سئو, تیم متخصص سئو, شرکت سئو, آژانس دیجیتال مارکتینگ, سابقه عصر سئو'
  canonical='https://asreseo.com/about/'
  ogType='website'
  ogUrl='https://asreseo.com/about/'
  ogImages={[{ url: '/images/about-hero.webp', width: 1200, height: 630, alt: 'درباره آژانس دیجیتال مارکتینگ و سئو عصر سئو' }]}
  twitterCard='summary_large_image'
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(aboutSchema)} />
  <BreadcrumbStructuredData items={breadcrumbs} />

  <div class="min-h-screen bg-white">
      <Header />
      <main>
        <!-- Hero Section -->
        <section class="relative py-24 md:py-32 overflow-hidden bg-gray-900">
          <div class="absolute inset-0 z-0">
            <Picture
              src="/images/about-hero.webp"
              alt="تیم عصر سئو"
             
             
              class="object-cover opacity-40 blur-xs"
              eager
            />
            <div class="absolute inset-0 bg-linear-to-b from-gray-900/60 via-gray-900/80 to-white" />
          </div>
          <div class="container-custom relative z-10 pt-16 md:pt-20">
            <div class="text-center animate-fade-in mb-8">
              <h1 class="text-4xl md:text-6xl font-bold text-white mb-6 drop-shadow-lg">
                درباره <span class="text-primary-400">عصر سئو</span>
              </h1>
              <p class="text-xl text-gray-100 max-w-3xl mx-auto leading-relaxed drop-shadow-md">
                ما تیمی از متخصصان باتجربه در حوزه دیجیتال مارکتینگ هستیم که با بهره‌گیری از جدیدترین تکنولوژی‌ها و هوش مصنوعی، کسب‌وکارها را به موفقیت می‌رسانیم.
              </p>
            </div>
          </div>
        </section>

        <div class="section-padding pt-0">
          <div class="container-custom">

          <!-- Mission & Vision -->
          <div class="grid md:grid-cols-2 gap-12 mb-20">
            <div class="bg-card rounded-2xl p-8 shadow-lg hover:shadow-xl transition-shadow animate-fade-in">
              <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mb-6">
                <svg class="w-8 h-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>
              <h2 class="text-2xl font-bold text-foreground mb-4">مأموریت ما</h2>
              <p class="text-muted-foreground leading-relaxed">
                کمک به کسب‌وکارهای ایرانی برای رسیدن به حضور قدرتمند در دنیای دیجیتال و افزایش فروش آنلاین از طریق استراتژی‌های نوآورانه و مبتنی بر داده.
              </p>
            </div>

            <div class="bg-card rounded-2xl p-8 shadow-lg hover:shadow-xl transition-shadow animate-fade-in">
              <div class="w-16 h-16 bg-secondary/10 rounded-full flex items-center justify-center mb-6">
                <svg class="w-8 h-8 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
              </div>
              <h2 class="text-2xl font-bold text-foreground mb-4">چشم‌انداز ما</h2>
              <p class="text-muted-foreground leading-relaxed">
                تبدیل شدن به پیشروترین آژانس دیجیتال مارکتینگ در ایران و منطقه با تمرکز بر هوش مصنوعی و تکنولوژی‌های پیشرفته.
              </p>
            </div>
          </div>

          <!-- Our Story -->
          <div class="mb-20 animate-fade-in">
            <div class="text-center mb-12">
              <h2 class="text-3xl md:text-4xl font-bold text-foreground mb-4">داستان ما</h2>
              <div class="w-24 h-1 bg-linear-to-r from-primary to-secondary mx-auto rounded-full"></div>
            </div>

            <div class="bg-linear-to-br from-primary/5 to-secondary/5 rounded-3xl p-8 md:p-12">
              <div class="max-w-4xl mx-auto">
                <p class="text-lg text-muted-foreground leading-relaxed mb-6">
                  عصر سئو در سال ۱۳۹۸ با هدف ارائه خدمات تخصصی سئو و دیجیتال مارکتینگ به کسب‌وکارهای ایرانی شروع به فعالیت کرد. از همان ابتدا، تمرکز ما بر کیفیت، نوآوری و نتیجه‌محوری بوده است.
                </p>
                <p class="text-lg text-muted-foreground leading-relaxed mb-6">
                  طی این سال‌ها، ما بیش از ۵۰۰ پروژه موفق انجام داده‌ایم و به صدها کسب‌وکار کمک کرده‌ایم تا در فضای آنلاین حضور قدرتمندی داشته باشند. با پیشرفت تکنولوژی و ظهور هوش مصنوعی، ما نیز خدمات خود را به‌روزرسانی کرده و امروز یکی از پیشگامان استفاده از AI در دیجیتال مارکتینگ هستیم.
                </p>
                <p class="text-lg text-muted-foreground leading-relaxed">
                  امروز، عصر سئو نه تنها در زمینه سئو و طراحی وب‌سایت فعالیت می‌کند، بلکه طیف وسیعی از خدمات شامل تولید محتوا با هوش مصنوعی، چت‌بات فارسی، تحلیل رفتار کاربران و اتوماسیون بازاریابی ارائه می‌دهد.
                </p>
              </div>
            </div>
          </div>

          <!-- Team Stats -->
          <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-20 animate-fade-in">
            <div class="text-center">
              <div class="text-4xl md:text-5xl font-bold text-primary mb-2">+500</div>
              <div class="text-muted-foreground">پروژه موفق</div>
            </div>
            <div class="text-center">
              <div class="text-4xl md:text-5xl font-bold text-secondary mb-2">+300</div>
              <div class="text-muted-foreground">مشتری راضی</div>
            </div>
            <div class="text-center">
              <div class="text-4xl md:text-5xl font-bold text-accent mb-2">6</div>
              <div class="text-muted-foreground">سال تجربه</div>
            </div>
            <div class="text-center">
              <div class="text-4xl md:text-5xl font-bold text-primary mb-2">24/7</div>
              <div class="text-muted-foreground">پشتیبانی</div>
            </div>
          </div>

          <!-- Values -->
          <div class="animate-fade-in">
            <div class="text-center mb-12">
              <h2 class="text-3xl md:text-4xl font-bold text-foreground mb-4">ارزش‌های ما</h2>
              <div class="w-24 h-1 bg-linear-to-r from-primary to-secondary mx-auto rounded-full"></div>
            </div>

            <div class="grid md:grid-cols-3 gap-8">
              <div class="text-center p-6 rounded-2xl bg-card hover:shadow-lg transition-shadow">
                <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
                  <svg class="w-8 h-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </div>
                <h3 class="text-xl font-bold text-foreground mb-3">کیفیت</h3>
                <p class="text-muted-foreground">تعهد به ارائه بالاترین کیفیت در تمام خدمات</p>
              </div>

              <div class="text-center p-6 rounded-2xl bg-card hover:shadow-lg transition-shadow">
                <div class="w-16 h-16 bg-secondary/10 rounded-full flex items-center justify-center mx-auto mb-4">
                  <svg class="w-8 h-8 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M13 10V3L4 14h7v7l9-11h-7z" />
                  </svg>
                </div>
                <h3 class="text-xl font-bold text-foreground mb-3">نوآوری</h3>
                <p class="text-muted-foreground">استفاده از آخرین تکنولوژی‌ها و روش‌های نوین</p>
              </div>

              <div class="text-center p-6 rounded-2xl bg-card hover:shadow-lg transition-shadow">
                <div class="w-16 h-16 bg-accent/10 rounded-full flex items-center justify-center mx-auto mb-4">
                  <svg class="w-8 h-8 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                  </svg>
                </div>
                <h3 class="text-xl font-bold text-foreground mb-3">همکاری</h3>
                <p class="text-muted-foreground">کار تیمی و شراکت راستین با مشتریان</p>
              </div>
            </div>
          </div>
          </div>
        </div>
      </main>
      <Footer />
    </div>
</BaseLayout>
