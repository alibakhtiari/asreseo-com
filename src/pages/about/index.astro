---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Picture from '../../components/ui/Picture.astro';
import Header from '../../components/Layout/Header.astro';
import Footer from '../../components/Layout/Footer.astro';
import BreadcrumbStructuredData from '../../components/BreadcrumbStructuredData.astro';

const aboutSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  'name': 'درباره ما - عصر سئو',
  'description': 'معرفی آژانس دیجیتال مارکتینگ و سئو عصر سئو، رسالت، استراتژی و سابقه متخصصان در حوزه سئو داده‌محور و هوش مصنوعی.',
  'mainEntity': {
    '@type': 'Organization',
    'name': 'عصر سئو',
    'url': 'https://asreseo.com',
    'logo': 'https://asreseo.com/Logo-spaced.png',
    'foundingDate': '2020',
    'founder': {
      '@type': 'Person',
      'name': 'علی بختیاری',
      'jobTitle': 'مدیر ارشد استراتژی و بنیان‌گذار'
    },
    'sameAs': [
      'https://instagram.com/asreseo',
      'https://t.me/asreseo',
      'https://linkedin.com/company/asreseo'
    ]
  }
};

const breadcrumbs = [
  { position: 1, name: 'خانه', item: 'https://asreseo.com/' },
  { position: 2, name: 'درباره ما', item: 'https://asreseo.com/about/' },
];

const milestones = [
  {
    year: '۱۳۹۸',
    title: 'نقطه آغاز و تثبیت در سئو کلاه سفید',
    desc: 'شروع فعالیت عصر سئو با تمرکز بر اصول بنیادین سئو ارگانیک، استراتژی‌های ضد پنالتی و کمک به استارتاپ‌های ایرانی برای کسب جایگاه‌های برتر در صفحه اول گوگل.'
  },
  {
    year: '۱۴۰۰',
    title: 'توسعه سئو تکنیکال عمیق و پرفورمنس مارکتینگ',
    desc: 'ارتقای زیرساخت‌های مهندسی وب، بهینه‌سازی سرعت و Core Web Vitals برای وب‌سایت‌های پرترافیک و اجرای کمپین‌های کلیکی هدفمند گوگل ادز.'
  },
  {
    year: '۱۴۰۲',
    title: 'راه‌اندازی آزمایشگاه هوش مصنوعی و اتوماسیون محتوا',
    desc: 'پیشگامی در ادغام مدل‌های زبانی پیشرفته در فرآیندهای تحلیل داده، طراحی چت‌بات‌های هوشمند فارسی و اتوماسیون خوشه‌های محتوایی سئومحور.'
  },
  {
    year: '۱۴۰۴',
    title: 'پیشگامی در سئو معنایی (Semantic SEO) و بهینه‌سازی AEO',
    desc: 'هدایت برندها در عصر موتورهای پاسخگو و هوش مصنوعی (Google AI Overviews)، ارتقای Topical Authority و تعریف استانداردهای نوین سئو در بازار وب فارسی.'
  }
];

const values = [
  {
    icon: 'shield-check',
    title: 'سئو کلاه سفید و امنیت سرمایه',
    desc: 'پایبندی مطلق به اصول اخلاقی و استانداردهای گوگل؛ بدون هیچ روش فریبنده یا پرخطر تا رتبه‌های کسب‌شده پایدار و همیشگی بمانند.'
  },
  {
    icon: 'bar-chart-2',
    title: 'رویکرد داده‌محور و شفافیت کامل',
    desc: 'تمام تصمیمات ما بر اساس تحلیل داده‌های دقیق سرچ کنسول و رفتار واقعی کاربران اتخاذ می‌شوند و گزارش‌های ماهانه کاملاً شفاف ارائه می‌گردند.'
  },
  {
    icon: 'cpu',
    title: 'تلفیق هوش مصنوعی و هوش انسانی',
    desc: 'بهره‌مندی از سرعت و توان پردازشی الگوریتم‌های AI در کنار تجربه، قضاوت عمیق و خلاقیت استراتژیست‌های متخصص.'
  },
  {
    icon: 'trending-up',
    title: 'تمرکز بر بازگشت سرمایه (ROI)',
    desc: 'هدف غایی ما صرفاً افزایش رتبه یا کلیک نیست؛ بلکه تبدیل مخاطبان ارگانیک به سرنخ‌های کیفی، مشتریان وفادار و رشد درآمد شماست.'
  },
  {
    icon: 'headphones',
    title: 'پشتیبانی متعهد و پاسخگویی سریع',
    desc: 'همراهی اختصاصی مشاور در تمامی مراحل پروژه، پاسخ به سوالات، تحلیل دوره‌ای رقبا و رفع سریع چالش‌های فنی وب‌سایت.'
  },
  {
    icon: 'refresh-cw',
    title: 'نوآوری و تطابق لحظه‌ای با الگوریتم‌ها',
    desc: 'رصد لحظه‌ای آپدیت‌های هسته گوگل و تحولات موتورهای جستجو برای به‌روزرسانی پیشگیرانه استراتژی‌های سئو.'
  }
];
---
<BaseLayout
  title='درباره ما | آژانس دیجیتال مارکتینگ و سئو عصر سئو'
  description='آشنایی با تیم متخصص عصر سئو، پیشگام خدمات سئو، تبلیغات گوگل، تولید محتوا و هوش مصنوعی در ایران با سابقه بیش از ۵۰۰ پروژه موفق.'
  keywords='درباره عصر سئو, تیم متخصص سئو, شرکت سئو, آژانس دیجیتال مارکتینگ, سابقه عصر سئو, علی بختیاری سئو'
  canonical='https://asreseo.com/about/'
  ogType='website'
  ogUrl='https://asreseo.com/about/'
  ogImages={[{ url: '/images/about-hero.webp', width: 1200, height: 630, alt: 'درباره آژانس دیجیتال مارکتینگ و سئو عصر سئو' }]}
  twitterCard='summary_large_image'
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(aboutSchema)} />
  <BreadcrumbStructuredData items={breadcrumbs} />

  <div class="min-h-screen bg-slate-50/40">
    <Header />
    <main class="pt-28 pb-20">
      <!-- Rich Visual Hero Section -->
      <section class="py-12 md:py-16 bg-linear-to-b from-blue-50/70 via-slate-50/30 to-transparent border-b border-slate-100">
        <div class="container-custom max-w-6xl">
          <div class="grid lg:grid-cols-12 gap-10 lg:gap-12 items-center">
            <!-- Hero Content (7 Cols) -->
            <div class="lg:col-span-7 space-y-6 text-right">
              <div class="inline-flex items-center gap-2 bg-blue-100/80 text-blue-800 px-3.5 py-1.5 rounded-full text-xs md:text-sm font-semibold">
                <span class="w-2 h-2 rounded-full bg-blue-600 animate-pulse"></span>
                پیشگام در سئو نوین و هوش مصنوعی در ایران
              </div>

              <h1 class="text-3xl md:text-5xl font-black text-slate-900 leading-tight">
                درباره <span class="gradient-text">عصر سئو</span>؛ آژانس تخصصی رشد ارگانیک و سئو مدرن
              </h1>

              <p class="text-base md:text-lg text-slate-600 leading-relaxed">
                عصر سئو از سال ۱۳۹۸ با یک هدف روشن آغاز شد: رهایی کسب‌وکارهای ایرانی از تکنیک‌های پرخطر و زودگذر، و پایه‌ریزی سیستم‌های سئو داده‌محور، ساختاریافته و مقاوم در برابر به‌روزرسانی‌های گوگل. ما امروز به‌عنوان شرکت خدمات هوش مصنوعی و سئو پیشرفته، علم داده را با تفکر استراتژیک انسانی ادغام کرده‌ایم.
              </p>

              <!-- Trust Points Checklist -->
              <div class="space-y-3 pt-2">
                <div class="flex items-center gap-3 text-sm text-slate-700 font-medium">
                  <div class="w-6 h-6 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0">
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                  </div>
                  <span>تعهد ۱۰۰٪ به سئو کلاه سفید و رشد طبیعی پایدار در گوگل</span>
                </div>
                <div class="flex items-center gap-3 text-sm text-slate-700 font-medium">
                  <div class="w-6 h-6 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0">
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                  </div>
                  <span>شفافیت کامل در داده‌ها، گزارش‌های ماهانه سرچ کنسول و دسترسی‌ها</span>
                </div>
                <div class="flex items-center gap-3 text-sm text-slate-700 font-medium">
                  <div class="w-6 h-6 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0">
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                  </div>
                  <span>آماده‌سازی زیرساخت سایت برای موتورهای پاسخگو و سئو هوش مصنوعی (AEO/GEO)</span>
                </div>
              </div>

              <!-- Hero Actions -->
              <div class="pt-4 flex flex-wrap gap-3">
                <a
                  href="/consultation/"
                  class="rounded-xl bg-blue-600 px-6 py-3 text-sm font-bold text-white shadow-md hover:bg-blue-700 hover:shadow-lg shadow-blue-600/20 transition-all flex items-center gap-2"
                >
                  رزرو جلسه مشاوره رایگان
                  <svg class="w-4 h-4 transform -rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </a>
                <a
                  href="/services/"
                  class="rounded-xl border border-slate-300 bg-white px-6 py-3 text-sm font-bold text-slate-700 hover:bg-slate-50 transition-all"
                >
                  مشاهده خدمات تخصصی
                </a>
              </div>
            </div>

            <!-- Hero Visual Asset (5 Cols) -->
            <div class="lg:col-span-5 relative">
              <div class="relative mx-auto max-w-md lg:max-w-none">
                <!-- Background Accent Glow -->
                <div class="absolute -inset-2 rounded-3xl bg-linear-to-tr from-blue-500/20 to-indigo-500/20 blur-xl"></div>

                <!-- Main Image Card -->
                <div class="relative rounded-3xl overflow-hidden border border-slate-200/80 shadow-2xl bg-white">
                  <Picture
                    src="/images/about-hero.webp"
                    alt="تیم متخصص آژانس دیجیتال مارکتینگ و سئو عصر سئو"
                    class="w-full h-auto object-cover aspect-4/3"
                    eager={true}
                  />
                  <!-- Subtle Image Overlay Gradient -->
                  <div class="absolute inset-0 bg-linear-to-t from-slate-950/60 via-transparent to-transparent"></div>
                  
                  <div class="absolute bottom-4 right-4 left-4 text-white">
                    <div class="text-xs text-blue-200 font-medium mb-1">عصر سئو</div>
                    <div class="text-sm font-bold">پیشگام سئو داده‌محور و هوش مصنوعی در ایران</div>
                  </div>
                </div>

                <!-- Floating Trust Badge 1: Projects -->
                <div class="absolute -bottom-5 -right-4 bg-white/95 backdrop-blur-md p-3.5 rounded-2xl border border-slate-200 shadow-lg flex items-center gap-3">
                  <div class="w-10 h-10 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center font-black text-lg">
                    ۵۰۰+
                  </div>
                  <div>
                    <div class="text-xs text-slate-500 font-medium">پروژه‌های انجام‌شده</div>
                    <div class="text-sm font-bold text-slate-900">سئو و مارکتینگ موفق</div>
                  </div>
                </div>

                <!-- Floating Trust Badge 2: Satisfaction -->
                <div class="absolute -top-4 -left-4 bg-white/95 backdrop-blur-md p-3 rounded-2xl border border-slate-200 shadow-lg flex items-center gap-2.5">
                  <div class="w-8 h-8 rounded-lg bg-emerald-100 text-emerald-600 flex items-center justify-center">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                  </div>
                  <div class="text-right">
                    <div class="text-xs font-bold text-slate-900">۹۸٪ رضایت مشتریان</div>
                    <div class="text-[10px] text-slate-500">و تمدید همکاری مستمر</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Headline Metrics Grid -->
      <section class="py-12">
        <div class="container-custom max-w-6xl">
          <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
            <div class="bg-white rounded-2xl p-6 border border-slate-200 text-center shadow-xs hover:shadow-md transition-shadow">
              <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center mx-auto mb-3">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div class="text-3xl md:text-4xl font-black text-slate-900 mb-1 font-mono">۵۰۰+</div>
              <div class="text-xs md:text-sm font-bold text-slate-700 mb-1">پروژه موفق اجراشده</div>
              <div class="text-xs text-slate-500">در انواع صنایع و فروشگاه‌ها</div>
            </div>

            <div class="bg-white rounded-2xl p-6 border border-slate-200 text-center shadow-xs hover:shadow-md transition-shadow">
              <div class="w-12 h-12 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center mx-auto mb-3">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div class="text-3xl md:text-4xl font-black text-indigo-600 mb-1 font-mono">۹۸٪</div>
              <div class="text-xs md:text-sm font-bold text-slate-700 mb-1">رضایت کارفرمایان</div>
              <div class="text-xs text-slate-500">پایداری نتایج و قراردادها</div>
            </div>

            <div class="bg-white rounded-2xl p-6 border border-slate-200 text-center shadow-xs hover:shadow-md transition-shadow">
              <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center mx-auto mb-3">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div class="text-3xl md:text-4xl font-black text-emerald-600 mb-1 font-mono">۶+</div>
              <div class="text-xs md:text-sm font-bold text-slate-700 mb-1">سال سابقه مستمر</div>
              <div class="text-xs text-slate-500">از سال ۱۳۹۸ در وب فارسی</div>
            </div>

            <div class="bg-white rounded-2xl p-6 border border-slate-200 text-center shadow-xs hover:shadow-md transition-shadow">
              <div class="w-12 h-12 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center mx-auto mb-3">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>
              <div class="text-3xl md:text-4xl font-black text-purple-600 mb-1 font-mono">۲۴/۷</div>
              <div class="text-xs md:text-sm font-bold text-slate-700 mb-1">مانیتورینگ و پشتیبانی</div>
              <div class="text-xs text-slate-500">پایش مداوم سلامت سرچ کنسول</div>
            </div>
          </div>
        </div>
      </section>

      <!-- Mission and Vision -->
      <section class="py-12">
        <div class="container-custom max-w-6xl">
          <div class="grid md:grid-cols-2 gap-8">
            <div class="bg-white rounded-3xl p-8 md:p-10 border border-slate-200/90 shadow-sm relative overflow-hidden group hover:border-blue-300 transition-all">
              <div class="w-14 h-14 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
                <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>
              <h2 class="text-2xl font-bold text-slate-900 mb-4">مأموریت ما</h2>
              <p class="text-slate-600 leading-relaxed text-base">
                کمک به کسب‌وکارهای ایرانی برای تبدیل وب‌سایت به یک دارایی درآمدزای پایدار. ما با تدوین استراتژی‌های سئو کلاه سفید، اصلاح زیرساخت فنی و تولید محتوای ارزشمند، ترافیک سرچ ارگانیک را به خریداران و مشتریان وفادار تبدیل می‌کنیم تا حضور دیجیتال شما مستقل از هزینه‌های سرسام‌آور تبلیغات باشد.
              </p>
            </div>

            <div class="bg-white rounded-3xl p-8 md:p-10 border border-slate-200/90 shadow-sm relative overflow-hidden group hover:border-indigo-300 transition-all">
              <div class="w-14 h-14 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
                <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
              </div>
              <h2 class="text-2xl font-bold text-slate-900 mb-4">چشم‌انداز ما</h2>
              <p class="text-slate-600 leading-relaxed text-base">
                پیشگامی بی‌رقیب در معماری سئو معنایی (Semantic Search) و بهینه‌سازی موتورهای پاسخگو (AEO/GEO) در خاورمیانه. ما باور داریم عصر آینده متعلق به پیوند ناگسستنی هوش مصنوعی و تفکر استراتژیک انسانی است و عصر سئو این افق را برای برندهای پیشرو خلق می‌کند.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Our Journey & Milestone Timeline -->
      <section class="py-16 bg-white border-y border-slate-200/70">
        <div class="container-custom max-w-5xl">
          <div class="text-center mb-14">
            <div class="inline-flex items-center gap-2 bg-blue-50 text-blue-700 px-4 py-1.5 rounded-full text-xs md:text-sm font-medium mb-3">
              مسیر تکامل و دستاوردها
            </div>
            <h2 class="text-2xl md:text-4xl font-bold text-slate-900 mb-4">
              داستان رشد و نقاط عطف <span class="gradient-text">عصر سئو</span>
            </h2>
            <p class="text-base text-slate-600 max-w-2xl mx-auto leading-relaxed">
              روایت ۶ سال تعهد بی‌وقفه به استانداردسازی سئو در فضای وب فارسی
            </p>
          </div>

          <div class="space-y-8 relative before:absolute before:inset-0 before:right-6 md:before:right-1/2 before:w-0.5 before:bg-slate-200">
            {milestones.map((m, idx) => (
              <div class={`relative flex flex-col md:flex-row items-start gap-8 ${idx % 2 === 0 ? 'md:flex-row-reverse' : ''}`}>
                <!-- Timeline Dot -->
                <div class="absolute right-6 md:right-1/2 transform translate-x-1/2 w-8 h-8 rounded-full bg-blue-600 border-4 border-white shadow-md flex items-center justify-center text-white text-xs font-bold z-10">
                  {idx + 1}
                </div>

                <!-- Content Card -->
                <div class="w-full md:w-1/2 pr-14 md:pr-0 md:px-8">
