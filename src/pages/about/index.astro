---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Layout/Header.astro';
import Footer from '../../components/Layout/Footer.astro';
import BreadcrumbStructuredData from '../../components/BreadcrumbStructuredData.astro';
import Button from '../../components/ui/button/Button.astro';
import Icon from '../../components/ui/Icon.astro';

const lang = 'en' as const;
const localize = (p: string) => p;

const aboutSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  'name': 'About Us - AsreSEO',
  'description': 'We dismantle obsolete manual SEO playbooks in favor of autonomous, computational, and entity-driven search infrastructure.',
  'mainEntity': {
    '@type': 'Organization',
    '@id': 'https://asreseo.com/#organization'
  }
};

const breadcrumbs = [
  { position: 1, name: 'Home', item: 'https://asreseo.com/' },
  { position: 2, name: 'About Us', item: 'https://asreseo.com/about/' },
];

const principles = [
  {
    num: '01',
    code: 'ZERO_SYNTHETIC_FLUFF',
    title: 'Zero Synthetic Fluff',
    desc: 'We do not produce 1,500-word recycled blog posts. We build deterministic semantic database architectures and structured entity vectors that modern AI engines ingest effortlessly.',
  },
  {
    num: '02',
    code: 'POST_HUMAN_ENGINES',
    title: 'Post-Human Search Engine Reality',
    desc: 'Google AI Overviews, Perplexity Pro, and SearchGPT consume entity vector graphs, not keyword stuffing. We speak machine-to-machine, embedding your brand into foundation knowledge bases.',
  },
  {
    num: '03',
    code: 'CONTINUOUS_REINDEX',
    title: 'Continuous Programmatic Re-Indexation',
    desc: 'If your site relies on weekly crawls, you are already dead in modern SERPs. Our autonomous crawlers and edge bots ping Google Indexing API and IndexNow the moment content mutates.',
  },
  {
    num: '04',
    code: 'ALGORITHMIC_ARBITRAGE',
    title: 'Algorithmic Arbitrage',
    desc: 'Modern search is an efficiency equation. Our automated bots and serverless nodes perform the workload of 25 manual junior agency reps in under 30 milliseconds.',
  },
];

const team = [
  {
    name: 'Ali Bakhtiari',
    role: 'Principal Automation Engineer & Open-Source Node Author',
    cred: 'n8n Ecosystem Developer & Distributed Workflow Architect',
    spec: 'Workflow Orchestration, AI Ingestion & Image Routing Nodes',
    hash: '0xAB-108',
  },
  {
    name: 'Dr. Julian Vance',
    role: 'Chief Systems Architect',
    cred: 'Ex-Search Infrastructure Lead, Distributed Systems PhD',
    spec: 'Algorithmic Indexation & Crawl Topologies',
    hash: '0xJV-771',
  },
  {
    name: 'Elena Rostova',
    role: 'Head of Neural Knowledge Graphs',
    cred: 'Ontology Specialist & Wikidata Fellow',
    spec: 'Entity Injection & AI Overview Citation Extraction',
    hash: '0xER-209',
  },
  {
    name: 'Kaito Tanaka',
    role: 'VP of Autonomous Crawl Infrastructure',
    cred: 'Edge Compute & High-Throughput Bots Architect',
    spec: 'Sub-20ms IndexNow Pushes & Edge Caching',
    hash: '0xKT-482',
  },
  {
    name: 'Sarah Lin-Chen',
    role: 'Director of Generative SERP Defense',
    cred: 'Machine Learning Safety & LLM Consensus Researcher',
    spec: 'Hallucination Mitigation & Brand Entity Seeding',
    hash: '0xSL-914',
  },
];

const clusters = [
  { region: 'US-East (Virginia)', nodes: '16 Active Nodes', ping: '9ms', status: 'ONLINE' },
  { region: 'Europe-West (Frankfurt)', nodes: '12 Active Nodes', ping: '12ms', status: 'ONLINE' },
  { region: 'Asia-East (Tokyo)', nodes: '10 Active Nodes', ping: '16ms', status: 'ONLINE' },
  { region: 'Asia-South (Singapore)', nodes: '10 Active Nodes', ping: '18ms', status: 'ONLINE' },
];
---
<BaseLayout
  lang="en"
  title='About Us — Infrastructure Manifesto | AsreSEO'
  description='We dismantle obsolete manual SEO playbooks. Meet the systems architects and autonomous crawl engineers powering AsreSEO.'
  keywords='about AsreSEO, autonomous SEO infrastructure, AI search architecture, search engineers, entity SEO'
  canonical='/about/'
  ogType='website'
  ogUrl='https://asreseo.com/about/'
  ogImages={[{ url: '/og-default.png', width: 1200, height: 630, alt: 'AsreSEO Infrastructure Manifesto' }]}
  twitterCard='summary_large_image'
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(aboutSchema)} />
  <BreadcrumbStructuredData items={breadcrumbs} />

  <div class="min-h-screen bg-[#000000] text-slate-100 wireframe-grid">
    <Header lang="en" />
    <main class="pt-28 pb-20">
      <!-- 1. Hero Section -->
      <section class="py-16 md:py-24 border-b-2 border-white/10 relative">
        <div class="w-full max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 relative z-10">
          <div class="max-w-4xl">
            <div class="inline-flex items-center gap-3 px-3.5 py-1.5 bg-[#0a0d14] border border-white/20 mb-8 font-mono text-xs tracking-wider uppercase">
              <span class="w-2.5 h-2.5 rounded-full bg-[#CCFF00] animate-pulse"></span>
              <span class="text-[#CCFF00] font-bold">[MANIFESTO // INFRASTRUCTURE_FIRST]</span>
              <span class="text-slate-500">|</span>
              <span class="text-slate-300">EST. 2019 // V4.0 DEPLOYED</span>
            </div>

            <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black uppercase text-white mb-6 tracking-tight leading-[1.05]">
              We Dismantle <span class="text-[#CCFF00]">Obsolete Manual</span> SEO Playbooks.
            </h1>

            <p class="text-lg sm:text-xl text-slate-300 leading-relaxed max-w-3xl mb-8">
              Founded by search systems engineers, distributed systems researchers, and algorithmic growth architects who realized the future of organic search is autonomous, computational, and entity-driven.
            </p>

            <div class="flex flex-wrap gap-4">
              <Button
                href={localize('/contact/')}
                variant="acid"
                size="lg"
                class="text-sm sm:text-base px-8 py-4"
              >
                Schedule Technical Deep Dive ↗
              </Button>
              <Button
                href={localize('/services/')}
                variant="brutalist"
                size="lg"
                class="text-sm sm:text-base px-8 py-4"
              >
                Inspect Tactical Suite
              </Button>
            </div>
          </div>
        </div>
      </section>

      <!-- 2. Core Engineering Principles -->
      <section class="py-20 border-b-2 border-white/10 bg-[#05070d]">
        <div class="w-full max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
          <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6 pb-6 border-b border-white/15">
            <div>
              <div class="font-mono text-xs text-[#CCFF00] uppercase tracking-widest mb-2">[FOUNDATIONAL_DOCTRINE]</div>
              <h2 class="text-3xl sm:text-4xl font-black uppercase tracking-tight text-white">Core Engineering Principles</h2>
            </div>
            <p class="text-slate-400 text-sm max-w-md">Our deterministic framework for zero-risk, high-throughput search engine dominance.</p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {principles.map((p) => (
              <div class="p-8 bg-[#0a0e17] border-2 border-white/15 brutalist-card group hover:border-[#CCFF00]">
                <div class="flex items-center justify-between pb-4 mb-6 border-b border-white/10 font-mono text-xs">
                  <span class="text-2xl font-black text-[#CCFF00]">{p.num} //</span>
                  <span class="text-slate-400 uppercase tracking-wider">{p.code}</span>
                </div>
                <h3 class="text-xl sm:text-2xl font-black uppercase text-white mb-4 group-hover:text-[#CCFF00] transition-colors">{p.title}</h3>
                <p class="text-slate-300 leading-relaxed text-sm sm:text-base">{p.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- 3. The Engineering Team & Node Architect Profiles -->
      <section class="py-20 border-b-2 border-white/10 bg-[#000000]">
        <div class="w-full max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
          <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6 pb-6 border-b border-white/15">
            <div>
              <div class="font-mono text-xs text-[#CCFF00] uppercase tracking-widest mb-2">[LEADERSHIP // PRINCIPALS]</div>
              <h2 class="text-3xl sm:text-4xl font-black uppercase tracking-tight text-white">Systems Architects & Leadership</h2>
            </div>
            <p class="text-slate-400 text-sm max-w-md">Decades of combined research in search indexing, ontology models, and distributed crawlers.</p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {team.map((m) => (
              <div class="p-6 bg-[#090d16] border-2 border-white/15 brutalist-card font-mono text-xs flex flex-col justify-between min-w-0 overflow-hidden">
                <div>
                  <div class="flex items-center justify-between pb-3 mb-4 border-b border-white/10">
                    <span class="text-[#CCFF00] font-bold">{m.hash}</span>
                    <span class="text-emerald-400">ACTIVE</span>
                  </div>
                  <h3 class="text-lg font-black uppercase text-white font-sans mb-1">{m.name}</h3>
                  <div class="text-[#CCFF00] font-bold mb-3">{m.role}</div>
                  <p class="text-slate-400 mb-4">{m.cred}</p>
                </div>
                <div class="pt-4 border-t border-white/10 text-[11px] text-slate-500">
                  <div class="text-slate-300 uppercase font-bold mb-1">Focus Domain:</div>
                  <div>{m.spec}</div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- 4. Infrastructure & Server Topology -->
      <section class="py-20 border-b-2 border-white/10 bg-[#05070d]">
        <div class="w-full max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
          <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6 pb-6 border-b border-white/15">
            <div>
              <div class="font-mono text-xs text-[#CCFF00] uppercase tracking-widest mb-2">[CLUSTER_TOPOLOGY // GLOBAL]</div>
              <h2 class="text-3xl sm:text-4xl font-black uppercase tracking-tight text-white">Global Edge Crawl Infrastructure</h2>
            </div>
            <p class="text-slate-400 text-sm max-w-md">48 automated headless crawl clusters distributed worldwide with sub-20ms edge latency.</p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-10">
            {clusters.map((c) => (
              <div class="p-5 bg-black border border-white/20 font-mono text-xs">
                <div class="text-white font-bold uppercase mb-2">{c.region}</div>
                <div class="text-[#CCFF00] text-sm font-black mb-1">{c.nodes}</div>
                <div class="flex items-center justify-between text-slate-400 pt-2 border-t border-white/10">
                  <span>Ping: {c.ping}</span>
                  <span class="text-emerald-400">{c.status}</span>
                </div>
              </div>
            ))}
          </div>

          <div class="p-6 bg-black border border-white/15 font-mono text-xs flex flex-wrap items-center justify-between gap-4 text-slate-400">
            <span class="flex items-center gap-2"><span class="text-[#CCFF00]">✓</span> 99.99% Uptime SLA Guaranteed</span>
            <span class="flex items-center gap-2"><span class="text-[#CCFF00]">✓</span> SOC2 Type II Certified Read-Only Crawl</span>
            <span class="flex items-center gap-2"><span class="text-[#CCFF00]">✓</span> Real-Time Continuous SERP Telemetry</span>
          </div>
        </div>
      </section>

      <!-- 5. n8n Automation Engine & Open-Source Node Engineering -->
      <section class="py-20 border-b-2 border-white/10 bg-[#000000] wireframe-grid relative">
        <div class="w-full max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
          <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6 pb-6 border-b border-white/15">
            <div>
              <div class="font-mono text-xs text-[#CCFF00] uppercase tracking-widest mb-2">[ORCHESTRATION // N8N_ENGINE]</div>
              <h2 class="text-3xl sm:text-4xl font-black uppercase tracking-tight text-white">Dedicated n8n Workflow Automation</h2>
            </div>
            <p class="text-slate-400 text-sm max-w-md">Our continuous execution cluster and custom open-source n8n extensions power enterprise telemetry.</p>
          </div>

          <div class="grid md:grid-cols-3 gap-6 mb-8">
            <!-- n8n Instance Card -->
            <div class="p-6 bg-[#0a0e17] border-2 border-white/15 brutalist-card hover:border-[#CCFF00] transition-colors flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between pb-3 mb-4 border-b border-white/10 font-mono text-xs">
                  <span class="text-[#CCFF00] font-bold">N8N_INSTANCE</span>
                  <span class="text-emerald-400 flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>LIVE</span>
                </div>
                <h3 class="text-xl font-black uppercase text-white mb-2">n8n.asreseo.com</h3>
                <p class="text-slate-300 text-xs sm:text-sm leading-relaxed mb-4">
                  Self-hosted, high-throughput n8n workflow cluster running autonomous SEO audit triggers, Google Indexing pings, and AI payload dispatching.
                </p>
              </div>
              <a
                href="https://n8n.asreseo.com"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 font-mono text-xs font-bold text-black bg-[#CCFF00] px-4 py-2.5 uppercase hover:bg-white transition-colors"
              >
                Access Automation Portal ↗
              </a>
            </div>

            <!-- Custom Node: n8n-nodes-avvalai -->
            <div class="p-6 bg-[#0a0e17] border-2 border-white/15 brutalist-card hover:border-[#CCFF00] transition-colors flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between pb-3 mb-4 border-b border-white/10 font-mono text-xs">
                  <span class="text-[#CCFF00] font-bold">OPEN_SOURCE // NODE_01</span>
                  <span class="text-slate-400">NPM / GITHUB</span>
                </div>
                <h3 class="text-xl font-black uppercase text-white mb-2">n8n-nodes-avvalai</h3>
                <p class="text-slate-300 text-xs sm:text-sm leading-relaxed mb-4">
                  Custom community node developed by Ali Bakhtiari enabling seamless integration between n8n workflows and AvvalAI intelligence services.
                </p>
              </div>
              <a
                href="https://github.com/alibakhtiari/n8n-nodes-avvalai"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 font-mono text-xs font-bold text-white bg-black border border-white/20 px-4 py-2.5 uppercase hover:border-[#CCFF00] hover:text-[#CCFF00] transition-colors"
              >
                Inspect on GitHub ↗
              </a>
            </div>

            <!-- Custom Node: n8n-nodes-imagerouter -->
            <div class="p-6 bg-[#0a0e17] border-2 border-white/15 brutalist-card hover:border-[#CCFF00] transition-colors flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between pb-3 mb-4 border-b border-white/10 font-mono text-xs">
                  <span class="text-[#CCFF00] font-bold">OPEN_SOURCE // NODE_02</span>
                  <span class="text-slate-400">NPM / GITHUB</span>
                </div>
                <h3 class="text-xl font-black uppercase text-white mb-2">n8n-nodes-imagerouter</h3>
                <p class="text-slate-300 text-xs sm:text-sm leading-relaxed mb-4">
                  Custom image routing node developed by Ali Bakhtiari designed for high-performance conditional image handling, transformation, and AI vision pipelines.
                </p>
              </div>
              <a
                href="https://github.com/alibakhtiari/n8n-nodes-imagerouter"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 font-mono text-xs font-bold text-white bg-black border border-white/20 px-4 py-2.5 uppercase hover:border-[#CCFF00] hover:text-[#CCFF00] transition-colors"
              >
                Inspect on GitHub ↗
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- 6. CTA Terminal -->
      <section class="py-20 bg-[#000000]">
        <div class="w-full max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
          <div class="p-8 sm:p-12 bg-[#090d16] border-2 border-[#CCFF00] brutalist-shadow-white flex flex-col md:flex-row items-center justify-between gap-8">
            <div class="space-y-2 text-center md:text-left">
              <div class="font-mono text-xs text-[#CCFF00] uppercase font-bold tracking-wider">[COMMISSION_RECON]</div>
              <h2 class="text-2xl sm:text-4xl font-black text-white uppercase">Meet With Our Principal Systems Architects</h2>
              <p class="text-slate-300 text-sm sm:text-base max-w-xl">
                Discuss your domain architecture, crawl budget constraints, and AI search presence directly with our lead engineers.
              </p>
            </div>
            <Button
              href={localize('/contact/')}
              variant="acid"
              size="lg"
              class="px-8 py-5 shrink-0"
            >
              Schedule Technical Deep Dive ↗
            </Button>
          </div>
        </div>
      </section>
    </main>
    <Footer lang="en" />
  </div>
</BaseLayout>
