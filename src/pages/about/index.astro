---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Picture from '../../components/ui/Picture.astro';
import Header from '../../components/Layout/Header.astro';
import Footer from '../../components/Layout/Footer.astro';
import BreadcrumbStructuredData from '../../components/BreadcrumbStructuredData.astro';
import Accordion from '../../components/ui/Accordion.astro';
import AccordionItem from '../../components/ui/AccordionItem.astro';
import AccordionTrigger from '../../components/ui/AccordionTrigger.astro';
import AccordionContent from '../../components/ui/AccordionContent.astro';

// The canonical Organization (#organization) is declared once in
// OrganizationStructuredData.astro (rendered on the homepage); founder and
// foundingDate were merged into that node — AboutPage now references it.
const aboutSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  'name': 'درباره ما - عصر سئو',
  'description': 'معرفی آژانس دیجیتال مارکتینگ و سئو عصر سئو، رسالت، استراتژی و سابقه متخصصان در حوزه سئو داده‌محور و هوش مصنوعی.',
  'mainEntity': {
    '@type': 'Organization',
    '@id': 'https://asreseo.com/#organization'
  }
};

const breadcrumbs = [
  { position: 1, name: 'خانه', item: 'https://asreseo.com/' },
  { position: 2, name: 'درباره ما', item: 'https://asreseo.com/about/' },
];

const milestones = [
  {
    year: '۱۳۹۸',
    title: 'نقطه آغاز و تثبیت در سئو کلاه سفید',
    desc: 'شروع فعالیت عصر سئو با تمرکز بر اصول بنیادین سئو ارگانیک، استراتژی‌های ضد پنالتی و کمک به استارتاپ‌های ایرانی برای کسب جایگاه‌های برتر در صفحه اول گوگل.'
  },
  {
    year: '۱۴۰۰',
    title: 'توسعه سئو تکنیکال عمیق و پرفورمنس مارکتینگ',
    desc: 'ارتقای زیرساخت‌های مهندسی وب، بهینه‌سازی سرعت و Core Web Vitals برای وب‌سایت‌های پرترافیک و اجرای کمپین‌های کلیکی هدفمند گوگل ادز.'
  },
  {
    year: '۱۴۰۲',
    title: 'راه‌اندازی آزمایشگاه هوش مصنوعی و اتوماسیون محتوا',
    desc: 'پیشگامی در ادغام مدل‌های زبانی پیشرفته در فرآیندهای تحلیل داده، طراحی چت‌بات‌های هوشمند فارسی و اتوماسیون خوشه‌های محتوایی سئومحور.'
  },
  {
    year: '۱۴۰۴',
    title: 'پیشگامی در سئو معنایی (Semantic SEO) و بهینه‌سازی AEO',
    desc: 'هدایت برندها در عصر موتورهای پاسخگو و هوش مصنوعی (Google AI Overviews)، ارتقای Topical Authority و تعریف استانداردهای نوین سئو در بازار وب فارسی.'
  }
];

const methodology = [
  {
    step: '۰۱',
    title: 'ممیزی فنی و تکنیکال ۳۶۰ درجه',
    desc: 'بررسی جامع کدها، معماری URL، بودجه خزش (Crawl Budget)، خطاهای ایندکس، شاخص‌های Core Web Vitals و سازگاری کامل نسخه موبایل برای رفع موانع موتورهای جستجو.',
    badge: 'زیرساخت بی‌نقص'
  },
  {
    step: '۰۲',
    title: 'معماری معنایی، آنتیتی‌ها و تاپیکال آتوریتی',
    desc: 'استخراج موجودیت‌های کلیدی صنعت، طراحی خوشه‌های محتوایی (Topic Clusters)، لینک‌سازی داخلی هوشمند و برطرف‌سازی هم‌نوع‌خواری کلمات (Cannibalization).',
    badge: 'مرجعیت موضوعی'
  },
  {
    step: '۰۳',
    title: 'شتاب‌دهی با هوش مصنوعی و بهینه‌سازی AEO',
    desc: 'تحلیل داده‌های کلان سرچ کنسول با مدل‌های زبانی، شناسایی الگوهای نوظهور جستجو، تدوین کپسول‌های پاسخ برای هوش مصنوعی (AEO/GEO) و اتوماسیون گردش کارها.',
    badge: 'پیشتازی در عصر AI'
  },
  {
    step: '۰۴',
    title: 'سئو خارجی کلاه سفید، روابط عمومی دیجیتال و تثبیت',
    desc: 'ایجاد پیوندهای اعتبارساز طبیعی از مراجع معتبر، کمپین‌های هدفمند رپرتاژ آگهی، پایش پیوسته رفتار رقبا و تثبیت پایدار رتبه‌های صفحه اول گوگل.',
    badge: 'پایداری و رشد مداوم'
  }
];

const departments = [
  {
    title: 'مهندسی سئو تکنیکال و پرفورمنس',
    desc: 'متخصصان معماری وب، بهینه‌سازی سرعت لود، ساختار داده‌های Schema.org و رفع موانع فنی در پلتفرم‌های مدرن (Next.js, Astro, WordPress).',
    metric: 'مطابق استانداردهای گوگل'
  },
  {
    title: 'استراتژی محتوا، معماری کلمات و AEO',
    desc: 'خلق محتواهای عمیق مطابق استانداردهای E-E-A-T گوگل، بهینه‌سازی برای موتورهای جستجوی هوش مصنوعی و تدوین استراتژی تاپیکال آتوریتی.',
    metric: 'محتوای رتبه‌دار متعدد'
  },
  {
    title: 'آزمایشگاه هوش مصنوعی و داده‌کاوی',
    desc: 'طراحی الگوریتم‌های تحلیلی، استخراج کوئری‌های پرپتانسیل از داده‌های سرچ کنسول و اتوماسیون فرآیندهای سئو داده‌محور.',
    metric: 'تحلیل کلان‌داده اختصاصی'
  },
  {
    title: 'روابط عمومی دیجیتال و برندینگ ارگانیک',
    desc: 'کمپین‌های حرفه‌ای برند منشن، رپرتاژهای استراتژیک، ارتقای Domain Authority و ایجاد پیوندهای طبیعی و ضد جریمه الگوریتمی.',
    metric: 'همکاری با مراجع معتبر رسانه‌ای'
  }
];

const industries = [
  { name: 'فروشگاه‌های آنلاین و ایکامرس', desc: 'مدیریت معماری هزاران محصول، دسته‌بندی و صفحات فیلتر' },
  { name: 'شرکت‌های SaaS و پلتفرم‌های B2B', desc: 'جذب لیدهای تجاری، تصمیم‌گیرندگان و مدیران سازمان‌ها' },
  { name: 'سلامت، دارویی و پزشکی (YMYL)', desc: 'پایبندی عمیق به فاکتورهای اعتماد، ارجاعات علمی و E-E-A-T' },
  { name: 'صنعت گردشگری و رزرو آنلاین', desc: 'رقابت در عبارات پرترافیک و فصلی بلیط، تور و هتل' },
  { name: 'خدمات مالی، فین‌تک و سرمایه‌گذاری', desc: 'سئو کلمات پرارزش مالی و ارتقای امنیت و نرخ تبدیل لندینگ‌ها' },
  { name: 'پلتفرم‌های آموزش و آکادمی‌ها', desc: 'تبدیل جستجوگران عبارات آموزشی به خریداران دوره‌ها' }
];

const values = [
  {
    title: 'سئو کلاه سفید و امنیت سرمایه',
    desc: 'پایبندی مطلق به اصول اخلاقی و استانداردهای گوگل؛ بدون هیچ روش فریبنده یا پرخطر تا رتبه‌های کسب‌شده پایدار و همیشگی بمانند.'
  },
  {
    title: 'رویکرد داده‌محور و شفافیت کامل',
    desc: 'تمام تصمیمات ما بر اساس تحلیل داده‌های دقیق سرچ کنسول و رفتار واقعی کاربران اتخاذ می‌شوند و گزارش‌های ماهانه کاملاً شفاف ارائه می‌گردند.'
  },
  {
    title: 'تلفیق هوش مصنوعی و هوش انسانی',
    desc: 'بهره‌مندی از سرعت و توان پردازشی الگوریتم‌های AI در کنار تجربه، قضاوت عمیق و خلاقیت استراتژیست‌های متخصص.'
  },
  {
    title: 'تمرکز بر بازگشت سرمایه (ROI)',
    desc: 'هدف غایی ما صرفاً افزایش رتبه یا کلیک نیست؛ بلکه تبدیل مخاطبان ارگانیک به سرنخ‌های کیفی، مشتریان وفادار و رشد درآمد شماست.'
  },
  {
    title: 'پشتیبانی متعهد و پاسخگویی سریع',
    desc: 'همراهی اختصاصی مشاور در تمامی مراحل پروژه، پاسخ به سوالات، تحلیل دوره‌ای رقبا و رفع سریع چالش‌های فنی وب‌سایت.'
  },
  {
    title: 'نوآوری و تطابق لحظه‌ای با الگوریتم‌ها',
    desc: 'رصد لحظه‌ای آپدیت‌های هسته گوگل و تحولات موتورهای جستجو برای به‌روزرسانی پیشگیرانه استراتژی‌های سئو.'
  }
];

const aboutFaqs = [
  {
    q: 'رویکرد عصر سئو در ارائه خدمات چگونه است و چه تمایزی با سایر شرکت‌ها دارد؟',
    a: 'ما سئو را به عنوان یک علم مهندسی داده و استراتژی سرمایه‌گذاری نگاه می‌کنیم، نه ترفندهای ناپایدار یا لینک‌سازی کورکورانه. تمایز اصلی ما تلفیق تحلیل تکنیکال عمیق، معماری معنایی (Semantic SEO) و ابزارهای هوش مصنوعی اختصاصی است که در قالب قراردادهای شفاف و گزارش‌دهی مستقیم ماهانه ارائه می‌گردد.'
  },
  {
    q: 'آیا عصر سئو رتبه‌بندی کلمات کلیدی را تضمین می‌کند؟',
    a: 'گوگل در مستندات رسمی خود صراحتاً اعلام کرده هیچ آژانسی توانایی تضمین رتبه یک گوگل را ندارد. تعهد ما «تضمین بالاترین کیفیت اجرای فرآیند سئو بر اساس استانداردهای کلاه سفید» است که در پروژه‌های متعدد به رشد مستمر ورودی سرچ ارگانیک و رتبه‌های اول انجامیده است.'
  },
  {
    q: 'چگونه از هوش مصنوعی استفاده می‌کنید بدون آنکه سایت دچار افت کیفیت یا پنالتی شود؟',
    a: 'ما از هوش مصنوعی برای داده‌کاوی، تحلیل سریع رقبا، پیدا کردن شکاف‌های معنایی (Content Gaps) و ایجاد درفت اولیه استفاده می‌کنیم. در مرحله نهایی، تمامی متون توسط استراتژیست‌های انسانی با تخصص E-E-A-T بازبینی، ویرایش و غنی‌سازی محتوایی می‌شوند.'
  },
  {
    q: 'فرآیند گزارش‌دهی و مانیتورینگ پروژه در طول ماه چگونه انجام می‌شود؟',
    a: 'هر پروژه یک مدیر اختصاصی دارد. کارفرمایان به داشبورد آنلاین دسترسی دارند و در پایان هر ماه گزارش جامع شامل مقایسه کلیک‌ها، ایمپرشن‌ها، وضعیت کلمات کلیدی هدف و اقدامات ماه آتی همراه با جلسه آنلاین ارائه می‌گردد.'
  }
];

const aboutFaqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': aboutFaqs.map(item => ({
    '@type': 'Question',
    'name': item.q,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': item.a
    }
  }))
};
---
<BaseLayout
  title='درباره ما | آژانس دیجیتال مارکتینگ و سئو عصر سئو'
  description='آشنایی با تیم متخصص عصر سئو، پیشگام خدمات سئو، تبلیغات گوگل، تولید محتوا و هوش مصنوعی در ایران با سابقه اجرای پروژه‌های موفق متعدد.'
  keywords='درباره عصر سئو, تیم متخصص سئو, شرکت سئو, آژانس دیجیتال مارکتینگ, سابقه عصر سئو, علی بختیاری سئو'
  canonical='https://asreseo.com/about/'
  ogType='website'
  ogUrl='https://asreseo.com/about/'
  ogImages={[{ url: '/og/about-hero.jpg', width: 1200, height: 630, alt: 'درباره آژانس دیجیتال مارکتینگ و سئو عصر سئو' }]}
  twitterCard='summary_large_image'
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(aboutSchema)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(aboutFaqSchema)} />
  <BreadcrumbStructuredData items={breadcrumbs} />

  <div class="min-h-screen bg-slate-50/40">
    <Header />
    <main class="pt-28 pb-20">
      <!-- Rich Visual Hero Section -->
      <section class="py-12 md:py-16 bg-linear-to-b from-blue-50/70 via-slate-50/30 to-transparent border-b border-slate-100">
        <div class="container-custom max-w-6xl">
          <div class="grid lg:grid-cols-12 gap-10 lg:gap-12 items-center">
            <!-- Hero Content (7 Cols) -->
            <div class="lg:col-span-7 space-y-6 text-right">
              <div class="inline-flex items-center gap-2 bg-blue-100/80 text-blue-800 px-3.5 py-1.5 rounded-full text-xs md:text-sm font-semibold">
                <span class="w-2 h-2 rounded-full bg-blue-600 animate-pulse"></span>
                پیشگام در سئو نوین و هوش مصنوعی در ایران
              </div>

              <h1 class="text-3xl md:text-5xl font-black text-slate-900 leading-tight">
                درباره <span class="gradient-text">عصر سئو</span>؛ آژانس تخصصی رشد ارگانیک و سئو مدرن
              </h1>

              <p class="text-base md:text-lg text-slate-600 leading-relaxed">
                عصر سئو از سال ۱۳۹۸ با یک هدف روشن آغاز شد: رهایی کسب‌وکارهای ایرانی از تکنیک‌های پرخطر و زودگذر، و پایه‌ریزی سیستم‌های سئو داده‌محور، ساختاریافته و مقاوم در برابر به‌روزرسانی‌های گوگل. ما امروز به‌عنوان شرکت خدمات هوش مصنوعی و سئو پیشرفته، علم داده را با تفکر استراتژیک انسانی ادغام کرده‌ایم.
              </p>

              <!-- Trust Points Checklist -->
              <div class="space-y-3 pt-2">
                <div class="flex items-center gap-3 text-sm text-slate-700 font-medium">
                  <div class="w-6 h-6 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0">
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                  </div>
                  <span>تعهد کامل به سئو کلاه سفید و رشد طبیعی پایدار در گوگل</span>
                </div>
                <div class="flex items-center gap-3 text-sm text-slate-700 font-medium">
                  <div class="w-6 h-6 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0">
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                  </div>
                  <span>شفافیت کامل در داده‌ها، گزارش‌های ماهانه سرچ کنسول و دسترسی‌ها</span>
                </div>
                <div class="flex items-center gap-3 text-sm text-slate-700 font-medium">
                  <div class="w-6 h-6 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0">
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                  </div>
                  <span>آماده‌سازی زیرساخت سایت برای موتورهای پاسخگو و سئو هوش مصنوعی (AEO/GEO)</span>
                </div>
              </div>

              <!-- Hero Actions -->
              <div class="pt-4 flex flex-wrap gap-3">
                <a
                  href="/consultation/"
                  class="rounded-xl bg-blue-600 px-6 py-3 text-sm font-bold text-white shadow-md hover:bg-blue-700 hover:shadow-lg shadow-blue-600/20 transition-all flex items-center gap-2"
                >
                  رزرو جلسه مشاوره رایگان
                  <svg class="w-4 h-4 transform -rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </a>
                <a
                  href="/services/"
                  class="rounded-xl border border-slate-300 bg-white px-6 py-3 text-sm font-bold text-slate-700 hover:bg-slate-50 transition-all"
                >
                  مشاهده خدمات تخصصی
                </a>
              </div>
            </div>

            <!-- Hero Visual Asset (5 Cols) -->
            <div class="lg:col-span-5 relative">
              <div class="relative mx-auto max-w-md lg:max-w-none">
                <!-- Background Accent Glow -->
                <div class="absolute -inset-2 rounded-3xl bg-linear-to-tr from-blue-500/20 to-indigo-500/20 blur-xl"></div>

                <!-- Main Image Card -->
                <div class="relative rounded-3xl overflow-hidden border border-slate-200/80 shadow-2xl bg-white">
                  <Picture
                    src="/images/about-hero.webp"
                    alt="تیم متخصص آژانس دیجیتال مارکتینگ و سئو عصر سئو"
                    class="w-full h-auto object-cover aspect-4/3"
                    eager={true}
                  />
                  <!-- Subtle Image Overlay Gradient -->
                  <div class="absolute inset-0 bg-linear-to-t from-slate-950/60 via-transparent to-transparent"></div>
                  
                  <div class="absolute bottom-4 right-4 left-4 text-white">
                    <div class="text-xs text-blue-200 font-medium mb-1">عصر سئو</div>
                    <div class="text-sm font-bold">پیشگام سئو داده‌محور و هوش مصنوعی در ایران</div>
                  </div>
                </div>

                <!-- Floating Trust Badge 1: Projects -->
                <div class="absolute -bottom-5 -right-4 bg-white/95 backdrop-blur-md p-3.5 rounded-2xl border border-slate-200 shadow-lg flex items-center gap-3">
                  <div class="w-10 h-10 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center font-black text-lg">
                    متعدد
                  </div>
                  <div>
                    <div class="text-xs text-slate-500 font-medium">پروژه‌های انجام‌شده</div>
                    <div class="text-sm font-bold text-slate-900">سئو و مارکتینگ موفق</div>
                  </div>
                </div>

                <!-- Floating Trust Badge 2: Satisfaction -->
                <div class="absolute -top-4 -left-4 bg-white/95 backdrop-blur-md p-3 rounded-2xl border border-slate-200 shadow-lg flex items-center gap-2.5">
                  <div class="w-8 h-8 rounded-lg bg-emerald-100 text-emerald-600 flex items-center justify-center">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                  </div>
                  <div class="text-right">
                    <div class="text-xs font-bold text-slate-900">رضایت مشتریان</div>
                    <div class="text-[10px] text-slate-500">و تمدید همکاری مستمر</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Headline Metrics Grid -->
      <section class="py-12">
        <div class="container-custom max-w-6xl">
