---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Layout/Header.astro';
import Footer from '../../components/Layout/Footer.astro';




const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  'name': 'عصر سئو',
  'url': 'https://asreseo.com',
  'contactPoint': [
    {
      '@type': 'ContactPoint',
      'telephone': '+98-912-581-1880',
      'contactType': 'customer service',
      'areaServed': 'IR',
      'availableLanguage': ['Persian', 'English']
    },
    {
      '@type': 'ContactPoint',
      'telephone': '+98-912-581-1880',
      'contactType': 'customer support',
      'areaServed': 'IR'
    },
    {
      '@type': 'ContactPoint',
      'telephone': '+98-912-581-1880',
      'contactType': 'emergency',
      'areaServed': 'IR',
      'hoursAvailable': 'Mo-Su 00:00-23:59'
    }
  ],
  'address': {
    '@type': 'PostalAddress',
    'addressLocality': 'تهران',
    'addressRegion': 'تهران',
    'addressCountry': 'IR'
  },
  'openingHours': [
    'Sa-Th 09:00-18:00'
  ]
}


  
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'خانه', item: 'https://asreseo.com/' },
    { '@type': 'ListItem', position: 2, name: 'تماس با ما', item: 'https://asreseo.com/contact/' },
  ],
};
---
<BaseLayout
  title='تماس با ما | مشاوره رایگان دیجیتال مارکتینگ و سئو | عصر سئو'
  description='ارتباط با تیم متخصص عصر سئو. برای مشاوره رایگان سئو، تبلیغات گوگل و طراحی سایت با شماره ۰۹۱۲۵۸۱۱۸۸۰ تماس بگیرید.'
  keywords='تماس با عصر سئو, مشاوره سئو, مشاوره دیجیتال مارکتینگ, شماره تماس سئو'
  canonical='https://asreseo.com/contact/'
  ogUrl='https://asreseo.com/contact/'
  ogTitle='تماس با ما | عصر سئو'
  ogDescription='ارتباط با تیم متخصص عصر سئو برای دریافت مشاوره رایگان دیجیتال مارکتینگ.'
  ogImages={[{ url: '/images/contact-hero.webp', width: 1200, height: 630, alt: 'تماس با ما - عصر سئو' }]}
  twitterCard='summary_large_image'
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
<div class="min-h-screen bg-slate-50/50">
      <Header />
      <main class="pt-28 pb-20">
        <!-- Hero Section -->
        <section class="py-12 bg-linear-to-b from-blue-50/60 via-slate-50/40 to-transparent border-b border-slate-100">
          <div class="container-custom max-w-5xl text-center">
            <div class="inline-flex flex-wrap items-center justify-center gap-3 mb-6">
              <span class="inline-flex items-center gap-1.5 bg-blue-100/80 text-blue-800 px-3.5 py-1.5 rounded-full text-xs md:text-sm font-semibold">
                <svg class="w-4 h-4 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
                پاسخگویی در کمتر از ۲ ساعت کاری
              </span>
              <span class="inline-flex items-center gap-1.5 bg-emerald-100/80 text-emerald-800 px-3.5 py-1.5 rounded-full text-xs md:text-sm font-semibold">
                <svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
                مشاوره اولیه ۳۰ دقیقه‌ای رایگان
              </span>
              <span class="inline-flex items-center gap-1.5 bg-purple-100/80 text-purple-800 px-3.5 py-1.5 rounded-full text-xs md:text-sm font-semibold">
                <span class="w-2 h-2 rounded-full bg-purple-600 animate-pulse"></span>
                پشتیبانی ۲۴ ساعته آنلاین
              </span>
            </div>

            <h1 class="text-3xl md:text-5xl font-black text-slate-900 mb-6 leading-tight">
              تماس با کارشناسان <span class="gradient-text">عصر سئو</span>
            </h1>
            <p class="text-base md:text-xl text-slate-600 max-w-3xl mx-auto leading-relaxed">
              برای تحلیل رایگان وب‌سایت، استعلام تعرفه‌ها و آغاز پروژه دیجیتال مارکتینگ و هوش مصنوعی، فرم زیر را تکمیل کنید یا از طریق راه‌های ارتباطی مستقیم با ما در تماس باشید.
            </p>
          </div>
        </section>

        <div class="container-custom max-w-6xl mt-10">
          <!-- Quick Connect Tiles -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-12">
            <!-- Call Tile -->
            <a
              href="tel:+989125811880"
              class="group bg-white p-5 rounded-2xl border border-slate-200 hover:border-blue-500 shadow-xs hover:shadow-md transition-all duration-200 flex items-center gap-4"
            >
              <div class="w-12 h-12 rounded-xl bg-blue-50 group-hover:bg-blue-600 text-blue-600 group-hover:text-white flex items-center justify-center shrink-0 transition-colors">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div class="min-w-0">
                <div class="text-xs text-slate-500 font-medium mb-1">تماس تلفنی مستقیم</div>
                <div class="text-base font-bold text-slate-900 group-hover:text-blue-600 transition-colors" dir="ltr">0912-581-1880</div>
              </div>
            </a>

            <!-- WhatsApp Tile -->
            <a
              href="https://wa.me/989125811880"
              target="_blank"
              rel="noopener noreferrer"
              class="group bg-white p-5 rounded-2xl border border-slate-200 hover:border-emerald-500 shadow-xs hover:shadow-md transition-all duration-200 flex items-center gap-4"
            >
              <div class="w-12 h-12 rounded-xl bg-emerald-50 group-hover:bg-emerald-600 text-emerald-600 group-hover:text-white flex items-center justify-center shrink-0 transition-colors">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M17.472 14.382c-.301-.15-1.782-.879-2.057-.978-.276-.1-.476-.15-.676.15s-.777.978-.952 1.178c-.176.2-.351.226-.652.075-1.579-.79-2.614-1.41-3.66-3.21-.276-.475.276-.441.788-1.468.087-.176.044-.326-.022-.476-.065-.15-.676-1.63-1.002-2.23-.318-.58-.642-.5-.877-.512-.227-.012-.489-.015-.751-.015-.262 0-.689.098-1.05.49-.362.392-1.38 1.35-1.38 3.292 0 1.942 1.416 3.82 1.614 4.083.198.263 2.787 4.257 6.753 5.971 2.503 1.082 3.49.948 4.733.83 1.341-.128 2.92-1.194 3.33-2.35.41-1.156.41-2.146.287-2.35-.122-.204-.322-.326-.623-.476zM12.04 21.78a9.72 9.72 0 01-4.96-1.36l-.356-.21-3.69 1.19 1.206-3.597-.233-.37a9.71 9.71 0 01-1.492-5.183c0-5.38 4.38-9.755 9.77-9.755 2.607 0 5.057 1.015 6.9 2.858 1.843 1.843 2.857 4.293 2.857 6.9 0 5.38-4.38 9.527-10 9.527z" />
                </svg>
              </div>
              <div class="min-w-0">
                <div class="text-xs text-slate-500 font-medium mb-1">گفتگوی واتساپ</div>
                <div class="text-sm font-bold text-slate-900 group-hover:text-emerald-600 transition-colors">شروع گفتگو و ارسال فایل</div>
              </div>
            </a>

            <!-- Telegram Tile -->
            <a
              href="https://t.me/asreseo"
              target="_blank"
              rel="noopener noreferrer"
              class="group bg-white p-5 rounded-2xl border border-slate-200 hover:border-sky-500 shadow-xs hover:shadow-md transition-all duration-200 flex items-center gap-4"
            >
              <div class="w-12 h-12 rounded-xl bg-sky-50 group-hover:bg-sky-500 text-sky-600 group-hover:text-white flex items-center justify-center shrink-0 transition-colors">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z" />
                </svg>
              </div>
              <div class="min-w-0">
                <div class="text-xs text-slate-500 font-medium mb-1">پشتیبانی تلگرام</div>
                <div class="text-sm font-bold text-slate-900 group-hover:text-sky-600 transition-colors">@asreseo</div>
              </div>
            </a>

            <!-- Free Consultation Tile -->
            <a
              href="/consultation/"
              class="group bg-linear-to-br from-blue-600 to-indigo-700 p-5 rounded-2xl text-white shadow-xs hover:shadow-lg hover:shadow-blue-500/20 transition-all duration-200 flex items-center gap-4"
            >
              <div class="w-12 h-12 rounded-xl bg-white/15 group-hover:bg-white/25 flex items-center justify-center shrink-0 transition-colors">
                <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
              </div>
              <div class="min-w-0">
                <div class="text-xs text-blue-100 font-medium mb-1">رزرو جلسه تخصصی</div>
                <div class="text-sm font-bold text-white flex items-center gap-1">
                  مشاوره ۳۰ دقیقه‌ای
                  <svg class="w-4 h-4 transform group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                  </svg>
                </div>
              </div>
            </a>
          </div>

          <div class="grid lg:grid-cols-3 gap-8 items-start">
            <!-- Contact Form Card -->
            <div class="lg:col-span-2">
              <div class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-sm">
                <div class="mb-8 pb-6 border-b border-slate-100">
                  <h2 class="text-2xl font-bold text-slate-900 mb-2">ارسال پیام و استعلام خدمات</h2>
                  <p class="text-sm md:text-base text-slate-600 leading-relaxed">
                    اطلاعات پروژه خود را ثبت فرمایید تا کارشناسان ارشد عصر سئو پس از بررسی اولیه سایت، ظرف ۲ ساعت کاری با شما تماس بگیرند.
                  </p>
                </div>

                <!-- Form Status Alert Banners -->
                <div id="form-success-banner" class="hidden mb-6 p-5 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-900">
                  <div class="flex items-start gap-3">
                    <div class="w-8 h-8 rounded-full bg-emerald-100 flex items-center justify-center shrink-0 text-emerald-600 mt-0.5">
                      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                      </svg>
                    </div>
                    <div>
                      <h3 class="font-bold text-base mb-1">درخواست شما با موفقیت ثبت شد!</h3>
                      <p class="text-sm text-emerald-800 leading-relaxed">
                        اطلاعات شما در سامانه ثبت گردید. کارشناسان ما اطلاعات اولیه وب‌سایت شما را بررسی کرده و در کمتر از ۲ ساعت کاری آینده برای ارائه مشاوره رایگان با شما تماس خواهند گرفت.
                      </p>
                    </div>
                  </div>
                </div>

                <div id="form-error-banner" class="hidden mb-6 p-5 rounded-2xl bg-rose-50 border border-rose-200 text-rose-900">
                  <div class="flex items-start gap-3">
                    <div class="w-8 h-8 rounded-full bg-rose-100 flex items-center justify-center shrink-0 text-rose-600 mt-0.5">
                      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                      </svg>
                    </div>
                    <div>
                      <h3 class="font-bold text-base mb-1" id="error-banner-title">خطایی رخ داد</h3>
                      <p class="text-sm text-rose-800 leading-relaxed" id="error-banner-text">
                        ارسال پیام با مشکل مواجه شد. لطفاً دوباره تلاش کنید یا مستقیماً با شماره <a href="tel:+989125811880" class="underline font-bold">۰۹۱۲۵۸۱۱۸۸۰</a> تماس حاصل فرمایید.
                      </p>
                    </div>
                  </div>
                </div>

                <form data-contact-form class="space-y-6" novalidate>
                  <div class="grid md:grid-cols-2 gap-6">
                    <div>
                      <label for="contact-name" class="block text-sm font-semibold text-slate-800 mb-2">
                        نام و نام خانوادگی <span class="text-rose-500">*</span>
                      </label>
                      <input
                        type="text"
                        id="contact-name"
                        name="name"
                        required
                        placeholder="مثال: علی محمدی"
                        class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50/50 text-slate-900 placeholder:text-slate-400 focus:bg-white focus:outline-hidden focus:ring-2 focus:ring-blue-600 focus:border-blue-600 transition-all text-sm"
                      />
                    </div>

                    <div>
                      <label for="contact-phone" class="block text-sm font-semibold text-slate-800 mb-2">
                        شماره تماس همراه <span class="text-rose-500">*</span>
                      </label>
                      <input
                        type="tel"
                        id="contact-phone"
                        name="phone"
                        required
                        dir="ltr"
                        placeholder="09123456789"
                        class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50/50 text-slate-900 placeholder:text-slate-400 focus:bg-white focus:outline-hidden focus:ring-2 focus:ring-blue-600 focus:border-blue-600 transition-all text-sm font-mono text-right"
                      />
                      <p class="text-xs text-slate-500 mt-1.5">
                        ارقام فارسی و انگلیسی هر دو پشتیبانی می‌شوند.
                      </p>
                    </div>
                  </div>

                  <div class="grid md:grid-cols-2 gap-6">
                    <div>
                      <label for="contact-email" class="block text-sm font-semibold text-slate-800 mb-2">
                        آدرس ایمیل <span class="text-rose-500">*</span>
                      </label>
                      <input
                        type="email"
                        id="contact-email"
                        name="email"
                        required
                        dir="ltr"
                        placeholder="you@company.com"
                        class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50/50 text-slate-900 placeholder:text-slate-400 focus:bg-white focus:outline-hidden focus:ring-2 focus:ring-blue-600 focus:border-blue-600 transition-all text-sm font-mono text-left"
                      />
                    </div>

                    <div>
                      <label for="contact-service" class="block text-sm font-semibold text-slate-800 mb-2">
                        سرویس مورد نظر
                      </label>
                      <select
                        id="contact-service"
                        name="service"
                        class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50/50 text-slate-900 focus:bg-white focus:outline-hidden focus:ring-2 focus:ring-blue-600 focus:border-blue-600 transition-all text-sm cursor-pointer"
                      >
                        <option value="سئو و رتبه‌بندی در گوگل">سئو ارگانیک و رتبه‌بندی گوگل</option>
                        <option value="سئو تکنیکال و بهینه‌سازی سرعت">سئو تکنیکال و Core Web Vitals</option>
                        <option value="خدمات هوش مصنوعی و اتوماسیون">خدمات هوش مصنوعی و اتوماسیون مارکتینگ</option>
                        <option value="تبلیغات گوگل (Google Ads)">تبلیغات گوگل ادز (PPC)</option>
                        <option value="استراتژی و تولید محتوا">استراتژی و تولید محتوای سئومحور</option>
                        <option value="طراحی سایت سئومحور">طراحی وب‌سایت سئومحور</option>
                        <option value="مشاوره جامع دیجیتال مارکتینگ">مشاوره جامع دیجیتال مارکتینگ</option>
                        <option value="سایر موارد">سایر موارد</option>
                      </select>
                    </div>
                  </div>

                  <div>
                    <label for="contact-message" class="block text-sm font-semibold text-slate-800 mb-2">
                      شرح نیاز یا اهداف کسب‌وکار شما <span class="text-rose-500">*</span>
                    </label>
                    <textarea
                      id="contact-message"
                      name="message"
                      required
                      rows="5"
                      placeholder="توضیح مختصری از آدرس وب‌سایت، حوزه فعالیت، کلمات کلیدی مد نظر یا چالش‌های فعلی خود بنویسید..."
                      class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50/50 text-slate-900 placeholder:text-slate-400 focus:bg-white focus:outline-hidden focus:ring-2 focus:ring-blue-600 focus:border-blue-600 transition-all text-sm leading-relaxed"
                    ></textarea>
                  </div>

                  <div class="pt-2">
                    <p class="text-xs text-slate-500 mb-5 leading-relaxed flex items-center gap-2">
                      <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                      </svg>
                      اطلاعات شما نزد عصر سئو کاملاً محرمانه نگه داشته می‌شود و صرفاً جهت هماهنگی جلسه و بررسی پروژه استفاده خواهد شد.
                    </p>

                    <button
                      type="submit"
                      data-submit-btn
                      class="w-full py-4 px-6 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-base shadow-md hover:shadow-lg shadow-blue-600/20 transition-all duration-200 flex items-center justify-center gap-2 cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed"
                    >
                      <span data-submit-idle class="flex items-center gap-2">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                        </svg>
                        ارسال درخواست و دریافت مشاوره
                      </span>
                      <span data-submit-busy class="hidden flex items-center gap-2">
                        <svg class="w-5 h-5 animate-spin text-white" fill="none" viewBox="0 0 24 24">
                          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                        در حال ثبت اطلاعات...
                      </span>
                    </button>
                  </div>
                </form>
              </div>
            </div>

            <!-- Sidebar Information Cards -->
            <div class="space-y-6">
              <!-- Official Contact Details -->
              <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-xs">
                <h3 class="text-xl font-bold text-slate-900 mb-6 pb-4 border-b border-slate-100 flex items-center gap-2">
                  <span class="w-2.5 h-2.5 rounded-full bg-blue-600"></span>
                  اطلاعات تماس رسمی
                </h3>

                <div class="space-y-5">
                  <div class="flex items-start gap-4">
                    <div class="w-10 h-10 rounded-xl bg-blue-50 flex items-center justify-center text-blue-600 shrink-0">
