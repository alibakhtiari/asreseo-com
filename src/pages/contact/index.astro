<script>
  function setupContactForm() {
    const form = document.querySelector('[data-contact-form]') as HTMLFormElement | null;
    if (!form || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';

    const btn = form.querySelector('[data-submit-btn]') as HTMLButtonElement | null;
    const idle = form.querySelector('[data-submit-idle]') as HTMLElement | null;
    const busy = form.querySelector('[data-submit-busy]') as HTMLElement | null;
    const successBanner = document.getElementById('form-success-banner');
    const errorBanner = document.getElementById('form-error-banner');
    const errorTitle = document.getElementById('error-banner-title');
    const errorText = document.getElementById('error-banner-text');
    const trackingIdSpan = document.getElementById('success-tracking-id');

    const phoneInput = form.querySelector('#contact-phone') as HTMLInputElement | null;
    const phoneValidBadge = document.getElementById('phone-valid-badge');
    const messageInput = form.querySelector('#contact-message') as HTMLTextAreaElement | null;
    const charCounter = document.getElementById('char-counter');

    // Copy Phone Number Functionality
    document.querySelectorAll('[data-copy-phone]').forEach((btnEl) => {
      btnEl.addEventListener('click', async () => {
        const num = btnEl.getAttribute('data-copy-phone') || '09125811880';
        try {
          await navigator.clipboard.writeText(num);
          const originalTitle = btnEl.getAttribute('title') || 'کپی شماره';
          btnEl.setAttribute('title', 'کپی شد!');
          btnEl.classList.add('text-emerald-600');
          setTimeout(() => {
            btnEl.setAttribute('title', originalTitle);
            btnEl.classList.remove('text-emerald-600');
          }, 2000);
        } catch {
          // fallback if clipboard api fails
        }
      });
    });

    // Normalize Persian/Arabic digits to ASCII 0-9
    const normalizeDigits = (str: string): string => {
      return str
        .replace(/[۰-۹]/g, (d) => String('۰۱۲۳۴۵۶۷۸۹'.indexOf(d)))
        .replace(/[٠-٩]/g, (d) => String('٠١٢٣٤٥٦٧٨٩'.indexOf(d)));
    };

    // Live phone formatting and checkmark
    if (phoneInput) {
      phoneInput.addEventListener('input', () => {
        const raw = phoneInput.value;
        const normalized = normalizeDigits(raw).replace(/[^\d+]/g, '');
        if (raw !== normalized) {
          phoneInput.value = normalized;
        }

        let cleanPhone = normalized.replace(/[\s-]/g, '');
        if (cleanPhone.startsWith('+98')) cleanPhone = '0' + cleanPhone.slice(3);
        else if (cleanPhone.startsWith('0098')) cleanPhone = '0' + cleanPhone.slice(4);
        else if (cleanPhone.startsWith('98')) cleanPhone = '0' + cleanPhone.slice(2);
        else if (cleanPhone.startsWith('9') && cleanPhone.length === 10) cleanPhone = '0' + cleanPhone;

        if (/^09\d{9}$/.test(cleanPhone)) {
          phoneValidBadge?.classList.remove('hidden');
          phoneValidBadge?.classList.add('inline-flex');
        } else {
          phoneValidBadge?.classList.add('hidden');
          phoneValidBadge?.classList.remove('inline-flex');
        }
      });
    }

    // Live character counter for message
    if (messageInput && charCounter) {
      messageInput.addEventListener('input', () => {
        const len = messageInput.value.length;
        charCounter.textContent = `${len} حرف`;
        if (len >= 10) {
          charCounter.classList.add('text-emerald-600');
          charCounter.classList.remove('text-rose-500');
        } else if (len > 0) {
          charCounter.classList.add('text-rose-500');
          charCounter.classList.remove('text-emerald-600');
        } else {
          charCounter.classList.remove('text-emerald-600', 'text-rose-500');
        }
      });
    }

    // Form Submission
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (successBanner) successBanner.classList.add('hidden');
      if (errorBanner) errorBanner.classList.add('hidden');

      const nameInput = form.querySelector('#contact-name') as HTMLInputElement | null;
      const emailInput = form.querySelector('#contact-email') as HTMLInputElement | null;
      const websiteInput = form.querySelector('#contact-website') as HTMLInputElement | null;
      const serviceSelect = form.querySelector('#contact-service') as HTMLSelectElement | null;
      const scaleSelect = form.querySelector('#contact-scale') as HTMLSelectElement | null;

      const name = nameInput?.value.trim() || '';
      const email = emailInput?.value.trim() || '';
      let phone = phoneInput?.value.trim() || '';
      const website = websiteInput?.value.trim() || '';
      const service = serviceSelect?.value || 'سئو و رتبه‌بندی در گوگل';
      const scale = scaleSelect?.value || '';
      let message = messageInput?.value.trim() || '';

      if (phone) {
        phone = normalizeDigits(phone).replace(/[\s-]/g, '');
        if (phone.startsWith('+98')) phone = '0' + phone.slice(3);
        else if (phone.startsWith('0098')) phone = '0' + phone.slice(4);
        else if (phone.startsWith('98')) phone = '0' + phone.slice(2);
        else if (phone.startsWith('9') && phone.length === 10) phone = '0' + phone;
        if (phoneInput) phoneInput.value = phone;
      }

      // Validations
      if (!name) {
        showError('نام الزامی است', 'لطفاً نام و نام خانوادگی خود را وارد نمایید.');
        nameInput?.focus();
        return;
      }
      if (!phone || !/^09\d{9}$/.test(phone)) {
        showError('شماره همراه نامعتبر است', 'شماره همراه باید ۱۱ رقم و با ۰۹ شروع شود (مثال: ۰۹۱۲۳۴۵۶۷۸۹).');
        phoneInput?.focus();
        return;
      }
      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) {
        showError('ایمیل نامعتبر است', 'لطفاً یک آدرس ایمیل معتبر وارد کنید (مثال: info@company.com).');
        emailInput?.focus();
        return;
      }
      if (!message || message.length < 10) {
        showError('پیام بسیار کوتاه است', 'لطفاً شرح مختصری از اهداف یا نیاز پروژه خود (حداقل ۱۰ حرف) بنویسید.');
        messageInput?.focus();
        return;
      }

      // Append website & scale to message for full context on backend
      let fullMessage = message;
      const extraNotes: string[] = [];
      if (website) extraNotes.push(`وب‌سایت: ${website}`);
      if (scale) extraNotes.push(`مقیاس پروژه: ${scale}`);
      if (extraNotes.length > 0) {
        fullMessage = `[${extraNotes.join(' | ')}]\n\n${message}`;
      }

      // Set busy state
      btn?.setAttribute('disabled', 'true');
      idle?.classList.add('hidden');
      busy?.classList.remove('hidden');

      try {
        const formData = new FormData();
        formData.set('name', name);
        formData.set('phone', phone);
        formData.set('email', email);
        formData.set('service', service);
        formData.set('message', fullMessage);

        const response = await fetch('/api/send-email', {
          method: 'POST',
          body: formData,
        });

        const result = await response.json();

        if (!response.ok || result.error) {
          showError('خطا در ارسال اطلاعات', result.error || 'ارسال پیام با مشکل مواجه شد. لطفاً دوباره تلاش فرمایید.');
        } else {
          if (successBanner) {
            if (trackingIdSpan) {
              const randNum = Math.floor(1000 + Math.random() * 9000);
              trackingIdSpan.textContent = `ASRE-${randNum}`;
            }
            successBanner.classList.remove('hidden');
            successBanner.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
          form.reset();
          if (charCounter) charCounter.textContent = '۰ حرف';
          if (phoneValidBadge) phoneValidBadge.classList.add('hidden');
        }
      } catch {
        showError('خطای ارتباط با سرور', 'اتصال اینترنت را بررسی کرده و مجدداً تلاش کنید، یا مستقیماً با ۰۹۱۲۵۸۱۱۸۸۰ تماس بگیرید.');
      } finally {
        btn?.removeAttribute('disabled');
        idle?.classList.remove('hidden');
        busy?.classList.add('hidden');
      }
    });

    function showError(title: string, text: string) {
      if (errorBanner) {
        if (errorTitle) errorTitle.textContent = title;
        if (errorText) errorText.textContent = text;
        errorBanner.classList.remove('hidden');
        errorBanner.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    }
  }

  setupContactForm();
  document.addEventListener('astro:page-load', setupContactForm);
</script>

