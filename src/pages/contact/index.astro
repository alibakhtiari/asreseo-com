---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Layout/Header.astro';
import Footer from '../../components/Layout/Footer.astro';
import Accordion from '../../components/ui/Accordion.astro';
import AccordionItem from '../../components/ui/AccordionItem.astro';
import AccordionTrigger from '../../components/ui/AccordionTrigger.astro';
import AccordionContent from '../../components/ui/AccordionContent.astro';

// The canonical Organization (#organization) is declared once in
// OrganizationStructuredData.astro (rendered on the homepage). The contact
// points, postal address and opening hours that used to live here were merged
// into that node — this page only references the entity.
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://asreseo.com/#organization'
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'خانه', item: 'https://asreseo.com/' },
    { '@type': 'ListItem', position: 2, name: 'تماس با ما', item: 'https://asreseo.com/contact/' },
  ],
};

const contactFaqs = [
  {
    q: 'آیا مشاوره تلفنی اولیه و آنالیز مقدماتی سایت رایگان است؟',
    a: 'بله، مکالمه تلفنی اولیه و بررسی اجمالی وضعیت وب‌سایت شما (شامل ایندکس صفحات، خطاهای بارز فنی و پتانسیل کلمات کلیدی) توسط کارشناسان ارشد عصر سئو کاملاً رایگان است.'
  },
  {
    q: 'پس از ثبت فرم، چقدر زمان می‌برد تا با من تماس گرفته شود؟',
    a: 'کارشناسان ما حداکثر ظرف ۲ ساعت کاری پس از دریافت اطلاعات فرم، با شما تماس گرفته و زمان جلسه مشاوره تحلیلی را هماهنگ می‌نمایند.'
  },
  {
    q: 'آیا امکان برگزاری جلسه حضوری در دفتر تهران وجود دارد؟',
    a: 'بله، برای پروژه‌های جامع سئو و قراردادهای سازمانی، امکان هماهنگی جلسه حضوری در دفتر مرکزی تهران یا جلسه آنلاین تصویری (Google Meet / Zoom) فراهم است.'
  },
  {
    q: 'برای آنالیز اولیه به چه اطلاعات یا دسترسی‌هایی نیاز است؟',
    a: 'برای بررسی اولیه صرفاً آدرس وب‌سایت (دامنه) و حوزه فعالیت کافی است. پس از جلسه اول و در صورت تمایل به آنالیز عمیق‌تر، دسترسی Read-Only سرچ کنسول درخواست می‌شود.'
  }
];

const contactFaqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': contactFaqs.map(item => ({
    '@type': 'Question',
    'name': item.q,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': item.a
    }
  }))
};
---
<BaseLayout
  title='تماس با ما | مشاوره رایگان دیجیتال مارکتینگ و سئو | عصر سئو'
  description='ارتباط با تیم متخصص عصر سئو. برای مشاوره رایگان سئو، تبلیغات گوگل و طراحی سایت با شماره ۰۹۱۲۵۸۱۱۸۸۰ تماس بگیرید.'
  keywords='تماس با عصر سئو, مشاوره سئو, مشاوره دیجیتال مارکتینگ, شماره تماس سئو'
  canonical='https://asreseo.com/contact/'
  ogUrl='https://asreseo.com/contact/'
  ogTitle='تماس با ما | عصر سئو'
  ogDescription='ارتباط با تیم متخصص عصر سئو برای دریافت مشاوره رایگان دیجیتال مارکتینگ.'
  ogImages={[{ url: '/images/contact-hero.webp', width: 1200, height: 630, alt: 'تماس با ما - عصر سئو' }]}
  twitterCard='summary_large_image'
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(contactFaqSchema)} />

  <div class="min-h-screen bg-slate-50/50">
    <Header />
    <main class="pt-28 pb-20">
      <!-- Ambient Hero Section -->
      <section class="relative py-16 bg-linear-to-b from-blue-50/70 via-indigo-50/30 to-transparent border-b border-slate-200/60 overflow-hidden">
        <!-- Decorative Ambient Glows -->
        <div class="absolute -top-24 right-1/4 w-96 h-96 bg-blue-400/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-24 left-1/4 w-96 h-96 bg-indigo-400/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="container-custom max-w-5xl text-center relative z-10">
          <div class="inline-flex flex-wrap items-center justify-center gap-3 mb-6">
            <span class="inline-flex items-center gap-2 bg-white/90 backdrop-blur-md text-blue-800 border border-blue-200/80 px-4 py-1.5 rounded-full text-xs md:text-sm font-semibold shadow-xs">
              <span class="w-2 h-2 rounded-full bg-blue-600 animate-ping"></span>
              پاسخگویی مستقیم در کمتر از ۲ ساعت کاری
            </span>
            <span class="inline-flex items-center gap-1.5 bg-emerald-50 text-emerald-800 border border-emerald-200/80 px-4 py-1.5 rounded-full text-xs md:text-sm font-semibold shadow-xs">
              <svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
              مشاوره تلفنی اولیه کاملاً رایگان
            </span>
            <span class="inline-flex items-center gap-1.5 bg-purple-50 text-purple-800 border border-purple-200/80 px-4 py-1.5 rounded-full text-xs md:text-sm font-semibold shadow-xs">
              <svg class="w-4 h-4 text-purple-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
              تضمین محرمانگی اطلاعات
            </span>
          </div>

          <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-black text-slate-900 mb-6 leading-tight tracking-tight">
            تماس با متخصصان و مشاوران <span class="gradient-text">عصر سئو</span>
          </h1>
          <p class="text-base sm:text-lg md:text-xl text-slate-600 max-w-3xl mx-auto leading-relaxed">
            برای ممیزی رایگان سایت، استعلام دقیق تعرفه‌ها و شروع همکاری هدفمند، از طریق فرم زیر پروژه خود را ثبت فرمایید یا از کانال‌های مستقیم با ما در ارتباط باشید.
          </p>
        </div>
      </section>

      <div class="container-custom max-w-6xl mt-10">
        <!-- Quick Connect Matrix (4 Luxury Tiles) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-12">
          <!-- Direct Phone Tile -->
          <div class="group bg-white p-5 rounded-2xl border border-slate-200/90 hover:border-blue-500 shadow-xs hover:shadow-lg transition-all duration-300 flex flex-col justify-between">
            <div class="flex items-center justify-between mb-3">
              <div class="w-12 h-12 rounded-xl bg-blue-50 group-hover:bg-blue-600 text-blue-600 group-hover:text-white flex items-center justify-center transition-colors">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <span class="inline-flex items-center gap-1 text-[11px] font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                خط آزاد
              </span>
            </div>
            <div>
              <div class="text-xs text-slate-500 font-medium mb-1">تماس تلفنی مستقیم</div>
              <div class="text-lg font-black text-slate-900 group-hover:text-blue-600 transition-colors font-mono" dir="ltr">0912-581-1880</div>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
              <a href="tel:+989125811880" class="text-blue-600 hover:text-blue-800 font-bold flex items-center gap-1">
                برقراری تماس
                <svg class="w-3.5 h-3.5 transform -rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
              <button
                type="button"
                data-copy-phone="09125811880"
                class="text-slate-400 hover:text-slate-700 cursor-pointer transition-colors p-1"
                title="کپی شماره"
              >
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
              </button>
            </div>
          </div>

          <!-- WhatsApp Tile -->
          <a
            href="https://wa.me/989125811880?text=%D8%B3%D9%84%D8%A7%D9%85%D8%8C%20%D8%AC%D9%87%D8%AA%20%D8%A7%D8%B3%D8%AA%D8%B9%D9%84%D8%A7%D9%85%20%D8%AE%D8%AF%D9%85%D8%A7%D8%AA%20%D8%B3%D8%A6%D9%88%20%D9%88%20%D9%85%D8%B4%D8%A7%D9%88%D8%B1%D9%87%20%D8%A7%D8%B2%20%D9%88%D8%A8%E2%80%8C%D8%B3%D8%A7%DB%8C%D8%AA%20%D8%B9%D8%B5%D8%B1%20%D8%B3%D8%A6%D9%88%20%D9%BE%DB%8C%D8%A7%D9%85%20%D9%85%DB%8C%E2%80%8C%D8%AF%D9%87%D9%85."
            target="_blank"
            rel="noopener noreferrer"
            class="group bg-white p-5 rounded-2xl border border-slate-200/90 hover:border-emerald-500 shadow-xs hover:shadow-lg transition-all duration-300 flex flex-col justify-between"
          >
            <div class="flex items-center justify-between mb-3">
              <div class="w-12 h-12 rounded-xl bg-emerald-50 group-hover:bg-emerald-600 text-emerald-600 group-hover:text-white flex items-center justify-center transition-colors">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M17.472 14.382c-.301-.15-1.782-.879-2.057-.978-.276-.1-.476-.15-.676.15s-.777.978-.952 1.178c-.176.2-.351.226-.652.075-1.579-.79-2.614-1.41-3.66-3.21-.276-.475.276-.441.788-1.468.087-.176.044-.326-.022-.476-.065-.15-.676-1.63-1.002-2.23-.318-.58-.642-.5-.877-.512-.227-.012-.489-.015-.751-.015-.262 0-.689.098-1.05.49-.362.392-1.38 1.35-1.38 3.292 0 1.942 1.416 3.82 1.614 4.083.198.263 2.787 4.257 6.753 5.971 2.503 1.082 3.49.948 4.733.83 1.341-.128 2.92-1.194 3.33-2.35.41-1.156.41-2.146.287-2.35-.122-.204-.322-.326-.623-.476zM12.04 21.78a9.72 9.72 0 01-4.96-1.36l-.356-.21-3.69 1.19 1.206-3.597-.233-.37a9.71 9.71 0 01-1.492-5.183c0-5.38 4.38-9.755 9.77-9.755 2.607 0 5.057 1.015 6.9 2.858 1.843 1.843 2.857 4.293 2.857 6.9 0 5.38-4.38 9.527-10 9.527z" />
                </svg>
              </div>
              <span class="text-[11px] font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full">ارسال فوری</span>
            </div>
            <div>
              <div class="text-xs text-slate-500 font-medium mb-1">گفتگوی واتساپ</div>
              <div class="text-base font-bold text-slate-900 group-hover:text-emerald-600 transition-colors">شروع گفتگو و ارسال فایل</div>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-100 text-xs text-emerald-600 font-bold flex items-center justify-between">
              <span>ارسال پیام با متن آماده</span>
              <svg class="w-4 h-4 transform -rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </div>
          </a>

          <!-- Telegram Tile -->
          <a
            href="https://t.me/asreseo"
            target="_blank"
            rel="noopener noreferrer"
            class="group bg-white p-5 rounded-2xl border border-slate-200/90 hover:border-sky-500 shadow-xs hover:shadow-lg transition-all duration-300 flex flex-col justify-between"
          >
            <div class="flex items-center justify-between mb-3">
              <div class="w-12 h-12 rounded-xl bg-sky-50 group-hover:bg-sky-500 text-sky-600 group-hover:text-white flex items-center justify-center transition-colors">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z" />
                </svg>
              </div>
              <span class="text-[11px] font-bold text-sky-700 bg-sky-50 px-2 py-0.5 rounded-full">پشتیبانی آنلاین</span>
            </div>
            <div>
              <div class="text-xs text-slate-500 font-medium mb-1">پشتیبانی تلگرام</div>
              <div class="text-base font-bold text-slate-900 group-hover:text-sky-600 transition-colors font-mono">@asreseo</div>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-100 text-xs text-sky-600 font-bold flex items-center justify-between">
              <span>ارتباط در تلگرام</span>
              <svg class="w-4 h-4 transform -rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </div>
          </a>

          <!-- Free Consultation 30-min Tile -->
          <a
            href="/consultation/"
            class="group bg-linear-to-br from-blue-600 via-indigo-600 to-indigo-800 p-5 rounded-2xl text-white shadow-xs hover:shadow-xl hover:shadow-blue-500/25 transition-all duration-300 flex flex-col justify-between"
          >
            <div class="flex items-center justify-between mb-3">
              <div class="w-12 h-12 rounded-xl bg-white/15 group-hover:bg-white/25 flex items-center justify-center transition-colors">
                <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
              </div>
              <span class="text-[11px] font-black text-amber-300 bg-amber-400/20 px-2 py-0.5 rounded-full border border-amber-300/30">
                کاملاً رایگان
              </span>
            </div>
            <div>
              <div class="text-xs text-blue-100 font-medium mb-1">جلسه آنالیز اختصاصی</div>
              <div class="text-base font-bold text-white">رزرو مشاوره ۳۰ دقیقه‌ای</div>
            </div>
            <div class="mt-4 pt-3 border-t border-white/15 text-xs text-white font-bold flex items-center justify-between">
              <span>بررسی سرچ کنسول و رقبا</span>
              <svg class="w-4 h-4 transform -rotate-180 group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </div>
          </a>
        </div>

        <!-- Main Form & Information Section -->
        <div class="grid lg:grid-cols-12 gap-8 items-start">
          <!-- Form Container (7 Cols) -->
          <div class="lg:col-span-7">
            <div class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200/90 shadow-sm relative">
              <div class="mb-8 pb-6 border-b border-slate-100">
                <div class="inline-flex items-center gap-2 text-blue-700 bg-blue-50 px-3 py-1 rounded-full text-xs font-bold mb-2">
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                  </svg>
                  ثبت استعلام و شروع همکاری
                </div>
                <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">فرم ارسال پروژه و درخواست مشاوره</h2>
                <p class="text-sm md:text-base text-slate-600 leading-relaxed">
                  اطلاعات وب‌سایت خود را وارد فرمایید تا مشاوران ارشد ما پیش از تماس، بررسی اولیه را روی وضعیت سئو و کلمات کلیدی شما انجام دهند.
                </p>
              </div>

              <!-- Success Alert Banner -->
              <div id="form-success-banner" class="hidden mb-6 p-6 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-950 animate-fade-in">
                <div class="flex items-start gap-4">
                  <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0 mt-0.5">
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                  </div>
                  <div>
                    <h3 class="font-bold text-lg mb-1">درخواست شما با موفقیت ثبت شد!</h3>
                    <p class="text-sm text-emerald-800 leading-relaxed mb-3">
                      اطلاعات شما در سیستم ممیزی عصر سئو ثبت گردید. کارشناسان ارشد ما وب‌سایت شما را بررسی کرده و ظرف ۲ ساعت کاری آینده برای ارائه مشاوره رایگان با شما تماس خواهند گرفت.
                    </p>
                    <div class="inline-flex items-center gap-2 bg-emerald-100/70 text-emerald-900 px-3 py-1 rounded-lg text-xs font-mono font-bold">
                      <span>شناسه پیگیری:</span>
                      <span id="success-tracking-id">ASRE-9284</span>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Error Alert Banner -->
              <div id="form-error-banner" class="hidden mb-6 p-5 rounded-2xl bg-rose-50 border border-rose-200 text-rose-950 animate-fade-in">
                <div class="flex items-start gap-3">
                  <div class="w-8 h-8 rounded-xl bg-rose-100 text-rose-600 flex items-center justify-center shrink-0 mt-0.5">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                  </div>
                  <div>
                    <h3 class="font-bold text-base mb-1" id="error-banner-title">خطایی رخ داد</h3>
                    <p class="text-sm text-rose-800 leading-relaxed" id="error-banner-text">
