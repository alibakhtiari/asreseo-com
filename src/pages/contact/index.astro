---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Picture from '../../components/ui/Picture.astro';
import Header from '../../components/Layout/Header.astro';
import Footer from '../../components/Layout/Footer.astro';
import Button from '../../components/ui/button/Button.astro';
import Input from '../../components/ui/input/Input.astro';
import Textarea from '../../components/ui/textarea/Textarea.astro';
import Card from '../../components/ui/card/Card.astro';
import CardContent from '../../components/ui/card/CardContent.astro';



const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  'name': 'عصر سئو',
  'url': 'https://asreseo.com',
  'contactPoint': [
    {
      '@type': 'ContactPoint',
      'telephone': '+98-912-581-1880',
      'contactType': 'customer service',
      'areaServed': 'IR',
      'availableLanguage': ['Persian', 'English']
    },
    {
      '@type': 'ContactPoint',
      'telephone': '+98-912-581-1880',
      'contactType': 'customer support',
      'areaServed': 'IR'
    },
    {
      '@type': 'ContactPoint',
      'telephone': '+98-912-581-1880',
      'contactType': 'emergency',
      'areaServed': 'IR',
      'hoursAvailable': 'Mo-Su 00:00-23:59'
    }
  ],
  'address': {
    '@type': 'PostalAddress',
    'addressLocality': 'تهران',
    'addressRegion': 'تهران',
    'addressCountry': 'IR'
  },
  'openingHours': [
    'Sa-Th 09:00-18:00'
  ]
}


  
---
<BaseLayout
  title='تماس با ما | مشاوره رایگان دیجیتال مارکتینگ و سئو | عصر سئو'
  description='ارتباط با تیم متخصص عصر سئو. برای مشاوره رایگان سئو، تبلیغات گوگل و طراحی سایت با شماره ۰۹۱۲۵۸۱۱۸۸۰ تماس بگیرید.'
  keywords='تماس با عصر سئو, مشاوره سئو, مشاوره دیجیتال مارکتینگ, شماره تماس سئو'
  canonical='https://asreseo.com/contact/'
  ogUrl='https://asreseo.com/contact/'
  ogTitle='تماس با ما | عصر سئو'
  ogDescription='ارتباط با تیم متخصص عصر سئو برای دریافت مشاوره رایگان دیجیتال مارکتینگ.'
  ogImages={[{ url: '/images/contact-hero.webp', width: 1200, height: 630, alt: 'تماس با ما - عصر سئو' }]}
  twitterCard='summary_large_image'
>
<div class="min-h-screen bg-white">
      <Header />
      <main>
        <!-- Hero Section -->
        <section class="relative py-16 md:py-20 overflow-hidden bg-gray-900 mb-12">
          <div class="absolute inset-0 z-0">
            <Picture
              src="/images/contact-hero.webp"
              alt="تماس با عصر سئو"
             
             
              class="object-cover opacity-30 blur-xs"
              eager
            />
            <div class="absolute inset-0 bg-linear-to-b from-gray-900/60 via-gray-900/80 to-white" />
          </div>
          <div class="container-custom relative z-10 pt-12 md:pt-14">
            <div class="text-center animate-fade-in mb-8">
              <h1 class="text-4xl md:text-6xl font-bold text-white mb-6 drop-shadow-lg">
                تماس با <span class="text-primary-400">ما</span>
              </h1>
              <p class="text-xl text-gray-100 max-w-3xl mx-auto leading-relaxed drop-shadow-md font-medium">
                آماده همکاری با شما هستیم. مشاوره رایگان دریافت کنید و پروژه دیجیتال مارکتینگ خود را همین امروز شروع کنید.
              </p>
            </div>
          </div>
        </section>

        <div class="container-custom">
          <div class="grid lg:grid-cols-3 gap-12">
            <!-- Contact Form -->
            <div class="lg:col-span-2">
              <Card class="shadow-lg hover:shadow-xl transition-all duration-300 animate-fade-in bg-linear-to-br from-white to-background-50 border-primary/20">
                <CardContent class="p-8">
                  <h2 class="text-2xl font-bold text-primary mb-6">فرم تماس</h2>

                  <form data-contact-form class="space-y-6">
                    <div class="grid md:grid-cols-2 gap-6">
                      <div>
                        <label class="block text-sm font-medium text-primary mb-2">نام و نام خانوادگی *</label>
                        <Input
                          type="text"
                          name="name"
                         
                          
                          required
                          placeholder="نام خود را وارد کنید"
                          class="w-full"
                        />
                      </div>

                      <div>
                        <label class="block text-sm font-medium text-primary mb-2">ایمیل *</label>
                        <Input
                          type="email"
                          name="email"
                         
                          
                          required
                          placeholder="ایمیل خود را وارد کنید"
                          class="w-full"
                        />
                      </div>
                    </div>

                    <div class="grid md:grid-cols-2 gap-6">
                      <div>
                        <label class="block text-sm font-medium text-primary mb-2">شماره تماس</label>
                        <Input
                          type="tel"
                          name="phone"
                         
                          
                          placeholder="09xxxxxxxxx"
                          class="w-full"
                        />
                      </div>

                      <div>
                        <label class="block text-sm font-medium text-primary mb-2">سرویس مورد نظر</label>
                        <select
                          name="service"
                         
                          
                          class="w-full px-3 py-2 border border-input bg-background rounded-md focus:outline-hidden focus:ring-2 focus:ring-primary"
                        >
                          <option value="">انتخاب کنید</option>
                          <option value="seo">سئو و بهینه‌سازی</option>
                          <option value="web-design">طراحی وب‌سایت</option>
                          <option value="content">تولید محتوا</option>
                          <option value="social-media">مدیریت شبکه‌های اجتماعی</option>
                          <option value="google-ads">تبلیغات گوگل</option>
                          <option value="ai-services">خدمات هوش مصنوعی</option>
                          <option value="consultation">مشاوره</option>
                        </select>
                      </div>
                    </div>

                    <div>
                      <label class="block text-sm font-medium text-primary mb-2">پیام شما *</label>
                      <Textarea
                        name="message"
                       
                        
                        required
                        placeholder="توضیح مختصری از نیاز خود ارائه دهید..."
                        rows={5}
                        class="w-full"
                      />
                    </div>

                    <Button
                      type="submit"
                      data-submit-btn
                      class="w-full md:w-auto"
                      size="lg"
                    >
                      <span data-submit-idle>'ارسال پیام'</span><span data-submit-busy hidden>'در حال ارسال...'</span>
                    </Button>
                  </form>
                </CardContent>
              </Card>
            </div>

            <!-- Contact Information -->
            <div class="space-y-8">
              <!-- Contact Details -->
              <Card class="shadow-lg hover:shadow-xl transition-all duration-300 animate-fade-in bg-linear-to-br from-white to-background-50 border-secondary/20">
                <CardContent class="p-6">
                  <h3 class="text-xl font-bold text-primary mb-6">اطلاعات تماس</h3>

                  <div class="space-y-4">
                    <div class="flex items-start space-x-3 space-x-reverse">
                      <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center shrink-0">
                        <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                        </svg>
                      </div>
                      <div>
                        <div class="font-medium text-primary-800">تلفن تماس</div>
                        <div class="text-primary-700" dir="ltr"><a href="tel:+989125811880" class="hover:text-primary transition-colors">0912-581-1880</a></div>
                      </div>
                    </div>

                    <div class="flex items-start space-x-3 space-x-reverse">
                      <div class="w-10 h-10 bg-indigo-50 rounded-full flex items-center justify-center shrink-0">
                        <svg class="w-5 h-5 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                        </svg>
                      </div>
                      <div>
                        <div class="font-medium text-primary-800">ایمیل</div>
                        <div class="text-primary-700" dir="ltr"><a href="mailto:info@asreseo.com" class="hover:text-primary transition-colors">info@asreseo.com</a></div>
                        <div class="text-primary-700" dir="ltr"><a href="mailto:support@asreseo.com" class="hover:text-primary transition-colors">support@asreseo.com</a></div>
                      </div>
                    </div>

                    <div class="flex items-start space-x-3 space-x-reverse">
                      <div class="w-10 h-10 bg-emerald-50 rounded-full flex items-center justify-center shrink-0">
                        <svg class="w-5 h-5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                        </svg>
                      </div>
                      <div>
                        <div class="font-medium text-primary-800">آدرس</div>
                        <div class="text-primary-700">تهران، ایران</div>
                      </div>
                    </div>

                    <div class="flex items-start space-x-3 space-x-reverse">
                      <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center shrink-0">
                        <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                      </div>
                      <div>
                        <div class="font-medium text-primary-800">ساعات کاری</div>
                        <div class="text-primary-700">شنبه تا پنج‌شنبه: ۹ تا ۱۸</div>
                        <div class="text-primary-700">پشتیبانی آنلاین: ۲۴/۷</div>
                      </div>
                    </div>
                  </div>
                </CardContent>
              </Card>


              <!-- Emergency Contact -->
              <Card class="shadow-lg hover:shadow-xl transition-all duration-300 animate-fade-in bg-linear-to-br from-accent-50 to-accent-100 border-accent-300 hover:border-accent-400">
                <CardContent class="p-6">
                  <h3 class="text-xl font-bold text-accent-900 mb-2">تماس اضطراری</h3>
                  <p class="text-accent-700 text-sm mb-4">برای موارد فوری و خارج از ساعت کاری</p>
                  <a href="tel:+989125811880" class="block">
                    <Button class="w-full bg-linear-to-r from-accent-500 to-accent-600 hover:from-accent-600 hover:to-accent-700 text-white border-0">
                    <svg class="w-4 h-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                    </svg>
                    0912-581-1880
                  </Button>
                    </a>
                </CardContent>
              </Card>
            </div>
          </div>
        </div>
      </main>
      <Footer />
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(structuredData)}
      />
    </div>
</BaseLayout>

<script>
  const form = document.querySelector('[data-contact-form]');
  const btn = form?.querySelector('[data-submit-btn]');
  const idle = form?.querySelector('[data-submit-idle]');
  const busy = form?.querySelector('[data-submit-busy]');
  let status: HTMLElement | null = form?.querySelector('[data-form-status]') ?? null;
  if (form && !status) {
    status = document.createElement('p');
    status.setAttribute('data-form-status', '');
    status.setAttribute('role', 'status');
    status.className = 'text-sm font-medium';
    status.hidden = true;
    form.prepend(status);
  }
  const SUCCESS_MSG = 'پیام شما با موفقیت ارسال شد. به زودی با شما تماس خواهیم گرفت.';
  const ERROR_MSG = 'خطایی رخ داد. لطفا دوباره تلاش کنید.';
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!(form instanceof HTMLFormElement)) return;
    btn?.setAttribute('disabled', '');
    idle?.setAttribute('hidden', '');
    busy?.removeAttribute('hidden');
    try {
      const response = await fetch('/api/send-email', {
        method: 'POST',
        body: new FormData(form),
      });
      const result = await response.json();
      if (result.error) {
        if (status) {
          status.textContent = result.error;
          status.hidden = false;
        }
      } else {
        if (status) {
          status.textContent = SUCCESS_MSG;
          status.hidden = false;
        }
        form.reset();
      }
    } catch {
      if (status) {
        status.textContent = ERROR_MSG;
        status.hidden = false;
      }
    } finally {
      btn?.removeAttribute('disabled');
      idle?.removeAttribute('hidden');
      busy?.setAttribute('hidden', '');
    }
  });
</script>
