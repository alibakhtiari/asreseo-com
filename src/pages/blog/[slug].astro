---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Layout/Header.astro';
import Footer from '../../components/Layout/Footer.astro';
import BlogPost from '../../components/Blog/BlogPost.astro';
import BreadcrumbStructuredData from '../../components/BreadcrumbStructuredData.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((entry: any) => ({
    params: { slug: entry.id.replace(/\.mdx?$/, '') },
    props: { entry },
  }));
}

const { entry }: any = Astro.props;
const { Content, headings } = await render(entry);
// Key takeaways and FAQs live in frontmatter (see src/content.config.ts), so
// BlogPost.astro is the only thing that renders them — no duplication.
const keyTakeaways: string[] = entry.data.keyTakeaways ?? [];
const faqs: { question: string; answer: string }[] = entry.data.faqs ?? [];
const TOC_SKIP = ['Table of contents', 'Key takeaways'];
// Exclude FAQ questions from the auto TOC by text (they're shown in the FAQ
// accordion instead), rather than by position.
const faqQuestions = new Set(
  faqs.map((f: any) => String(f.question ?? '').trim()).filter(Boolean),
);
const tableOfContents = headings
  .filter((h: any) => {
    if (h.depth !== 2 && h.depth !== 3) return false;
    if (TOC_SKIP.includes(h.text)) return false;
    if (faqQuestions.has(String(h.text).trim())) return false;
    return true;
  })
  .map((h: any) => ({ id: h.slug, title: h.text, level: h.depth }));

// MDX frontmatter is the single source of truth for post metadata.
const slug = entry.id.replace(/\.mdx?$/, '');
const d: any = entry.data;
const post = {
  slug,
  title: d.title,
  // Short form for the <title> tag only (see content.config.ts).
  seoTitle: d.seoTitle,
  excerpt: d.excerpt ?? '',
  description: d.description ?? d.excerpt ?? '',
  category: d.category ?? '',
  author: d.author ?? '',
  date: d.date ?? '',
  updated: d.updated ?? '',
  readTime: d.readTime ?? '',
  image: d.image ?? '',
  featured: d.featured ?? false,
  tags: d.tags ?? [],
  keyTakeaways,
  faqs,
  tableOfContents,
};

const seoTitle = `${post.seoTitle ?? post.title} | AsreSEO`;

// Mirrors the visual <ol> rendered directly under the header:
// Home / Blog / {post.title}
const breadcrumbs = [
  { position: 1, name: 'Home', item: 'https://asreseo.com/' },
  { position: 2, name: 'Blog', item: 'https://asreseo.com/blog/' },
  { position: 3, name: post.title, item: `https://asreseo.com/blog/${post.slug}/` },
];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `https://asreseo.com/blog/${post.slug}/#article`,
  isPartOf: {
    '@type': 'WebSite',
    '@id': 'https://asreseo.com/#website',
    name: 'AsreSEO',
    url: 'https://asreseo.com/',
  },
  headline: post.title,
  description: post.description || post.excerpt,
  image: post.image ? [new URL(post.image, 'https://asreseo.com').href] : undefined,
  datePublished: post.date || undefined,
  dateModified: post.updated || post.date || undefined,
  author: post.author
    ? { '@type': 'Person', name: post.author }
    : { '@type': 'Organization', name: 'AsreSEO' },
  publisher: {
    '@type': 'Organization',
    name: 'AsreSEO',
    logo: { '@type': 'ImageObject', url: 'https://asreseo.com/Logo-spaced.png' },
  },
  mainEntityOfPage: `https://asreseo.com/blog/${post.slug}/`,
  inLanguage: 'en-US',
  speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.speakable-summary'] },
};
---
<BaseLayout
  lang="en"
  title={seoTitle}
  description={post.description}
  canonical={`https://asreseo.com/blog/${post.slug}/`}
  ogType="article"
  ogImages={[{ url: post.image.replace('/images/', '/og/').replace(/\.webp$/, '.jpg'), width: 1200, height: 630, alt: post.title }]}
  ogUrl={`https://asreseo.com/blog/${post.slug}/`}

>
  <div class="min-h-screen bg-[#000000] text-slate-100 wireframe-grid">
    <Header lang="en" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />
    <BreadcrumbStructuredData items={breadcrumbs} />
    <main class="pt-32 pb-24">
      <div class="w-full max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
        <nav class="mb-10 max-w-4xl mx-auto font-mono text-xs uppercase tracking-wider" aria-label="Breadcrumb">
          <ol class="flex items-center gap-2 text-slate-500">
            <li>
              <a href="/" class="hover:text-[#CCFF00] transition-colors">Home</a>
            </li>
            <li>/</li>
            <li>
              <a href="/blog/" class="hover:text-[#CCFF00] transition-colors">Blog</a>
            </li>
            <li>/</li>
            <li class="text-[#CCFF00] font-bold truncate max-w-xs sm:max-w-md">{post.title}</li>
          </ol>
        </nav>
        <div class="max-w-4xl mx-auto">
          <BlogPost post={post} Content={Content} lang="en" />
        </div>
      </div>
    </main>
    <Footer lang="en" />
  </div>
</BaseLayout>
