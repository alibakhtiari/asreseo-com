---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Layout/Header.astro';
import Footer from '../../components/Layout/Footer.astro';
import BlogPost from '../../components/Blog/BlogPost.astro';
import { parseSections } from '../../lib/blog';
import { getBlogPost } from '../../lib/blog-data';
import { readFileSync, existsSync } from 'node:fs';
import { join } from 'node:path';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((entry: any) => ({
    params: { slug: entry.id.replace(/\.mdx?$/, '') },
    props: { entry },
  }));
}

const { entry }: any = Astro.props;
const { Content, headings } = await render(entry);
const rawFile = readFileSync(
  (() => {
    const base = join(process.cwd(), 'src', 'content', 'blog', entry.id.replace(/\.mdx?$/, ''));
    return existsSync(base + '.mdx') ? base + '.mdx' : base + '.md';
  })(),
  'utf8',
);
const rawBody = rawFile.replace(/^---[\s\S]*?---\n/, '');
const { content, keyTakeaways, faqs } = parseSections(rawBody);
const TOC_SKIP = ['فهرست مطالب', 'نکات کلیدی'];
const faqAt = headings.findIndex((h: any) => h.text === 'سوالات متداول');
const tableOfContents = headings
  .filter((h: any, i: number) => {
    if (h.depth !== 2 && h.depth !== 3) return false;
    if (TOC_SKIP.includes(h.text)) return false;
    if (faqAt !== -1 && i > faqAt && h.depth === 3) return false;
    return true;
  })
  .map((h: any) => ({ id: h.slug, title: h.text, level: h.depth }));

const slug = entry.id.replace(/\.mdx?$/, '');
const meta: any = getBlogPost(slug) ?? {};
const post = {
  slug,
  title: meta.title ?? entry.data.title,
  excerpt: meta.excerpt ?? entry.data.excerpt ?? '',
  description: meta.description ?? entry.data.description ?? entry.data.excerpt ?? '',
  category: meta.category ?? entry.data.category ?? '',
  author: meta.author ?? entry.data.author ?? '',
  date: meta.date ?? entry.data.date ?? '',
  updated: meta.updated ?? entry.data.updated ?? '',
  readTime: meta.readTime ?? entry.data.readTime ?? '',
  image: meta.image ?? entry.data.image ?? '',
  featured: meta.featured ?? entry.data.featured ?? false,
  tags: meta.tags ?? entry.data.tags ?? [],
  content,
  keyTakeaways,
  faqs,
  tableOfContents,
};

const seoTitle = `${post.title} | عصر سئو`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.description || post.excerpt,
  image: post.image ? [post.image] : undefined,
  datePublished: post.date || undefined,
  dateModified: post.updated || post.date || undefined,
  author: post.author
    ? { '@type': 'Person', name: post.author }
    : { '@type': 'Organization', name: 'عصر سئو' },
  publisher: {
    '@type': 'Organization',
    name: 'عصر سئو',
    logo: { '@type': 'ImageObject', url: 'https://asreseo.com/Logo-spaced.png' },
  },
  mainEntityOfPage: `https://asreseo.com/blog/${post.slug}/`,
  inLanguage: 'fa-IR',
  speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.speakable-summary'] },
};
---
<BaseLayout
  title={seoTitle}
  description={post.description}
  canonical={`https://asreseo.com/blog/${post.slug}/`}
  ogType="article"
  ogImages={[{ url: post.image, width: 1200, height: 630, alt: post.title }]}
  ogUrl={`https://asreseo.com/blog/${post.slug}/`}

>
  <Header />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />
  <main class="section-padding pt-32">
    <div class="container-custom">
      <nav class="mb-8 max-w-4xl mx-auto" aria-label="مسیر">
        <ol class="flex items-center gap-2 text-sm text-gray-500">
          <li>
            <a href="/" class="hover:text-primary transition-colors">صفحه اصلی</a>
          </li>
          <li>/</li>
          <li>
            <a href="/blog/" class="hover:text-primary transition-colors">وبلاگ</a>
          </li>
          <li>/</li>
          <li class="text-gray-900 font-medium truncate">{post.title}</li>
        </ol>
      </nav>
      <div class="max-w-4xl mx-auto">
        <BlogPost post={post} Content={Content} />
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
