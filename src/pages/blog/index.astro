---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Layout/Header.astro';
import Footer from '../../components/Layout/Footer.astro';
import BlogGrid from '../../components/Blog/BlogGrid.astro';
import BlogHero from '../../components/Blog/BlogHero.astro';

// MDX frontmatter is the single source of truth (see src/content/blog/*.mdx).
const posts: any[] = (await getCollection('blog'))
  .map((e: any) => ({ ...e.data, slug: e.id.replace(/\.mdx?$/, '') }))
  .sort((a: any, b: any) => String(b.date ?? '').localeCompare(String(a.date ?? '')));

const blogListSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'وبلاگ عصر سئو',
  url: 'https://asreseo.com/blog/',
  inLanguage: 'fa-IR',
  // datePublished / author / image are required by Google's BlogPosting
  // guidelines — they were dropped when this page moved off the legacy
  // blog-data.ts override table, so they are read straight from frontmatter.
  blogPost: posts.map((p: any, i: number) => {
    const node: Record<string, unknown> = {
      '@type': 'BlogPosting',
      position: i + 1,
      headline: p.title,
      description: p.description ?? p.excerpt,
      url: `https://asreseo.com/blog/${p.slug}/`,
      inLanguage: 'fa-IR',
    };
    if (p.date) node.datePublished = p.date;
    if (p.updated ?? p.date) node.dateModified = p.updated ?? p.date;
    if (p.author) node.author = { '@type': 'Person', name: p.author };
    if (p.image) node.image = new URL(p.image, 'https://asreseo.com').href;
    return node;
  }),
};
---
<BaseLayout
  title='وبلاگ عصر سئو | آموزش دیجیتال مارکتینگ | مطالب آموزشی تخصصی'
  description='وبلاگ آموزشی عصر سئو شامل مقالات تخصصی digital marketing، سئو، بهینه‌سازی وب‌سایت، تبلیغات گوگل، هوش مصنوعی و بازاریابی محتوایی.'
  keywords='وبلاگ دیجیتال مارکتینگ, مقالات سئو, آموزش Marketing, مطالب آموزشی, عصر سئو'
  canonical='https://asreseo.com/blog/'
  ogUrl='https://asreseo.com/blog/'

  ogTitle='وبلاگ آموزشی عصر سئو'

  ogDescription='مقالات تخصصی دیجیتال مارکتینگ و سئو.'

  ogImages={[{ url: '/images/blog-hero.webp', width: 1200, height: 630, alt: 'وبلاگ عصر سئو' }]}
>
  <Header />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(blogListSchema)} />
  <main>
    <BlogHero />
    <div class="section-padding">
      <div class="container-custom">
        <BlogGrid posts={posts} />
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
