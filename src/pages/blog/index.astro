---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Layout/Header.astro';
import Footer from '../../components/Layout/Footer.astro';
import BlogGrid from '../../components/Blog/BlogGrid.astro';
import BlogHero from '../../components/Blog/BlogHero.astro';
import BreadcrumbStructuredData from '../../components/BreadcrumbStructuredData.astro';

// All posts are English; entry.id is '<slug>.mdx'.
const posts: any[] = (await getCollection('blog'))
  .map((e: any) => ({ ...e.data, slug: e.id.replace(/\.mdx?$/, '') }))
  .sort((a: any, b: any) => String(b.date ?? '').localeCompare(String(a.date ?? '')));

const blogListSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'AsreSEO Blog',
  url: 'https://asreseo.com/blog/',
  inLanguage: 'en-US',
  // datePublished / author / image are required by Google's BlogPosting
  // guidelines, so they are read straight from frontmatter.
  // `@id` must match the BlogPosting `@id` emitted by /blog/<slug>/ so both
  // pages resolve to the same article entities instead of duplicating them.
  blogPost: posts.map((p: any) => {
    const node: Record<string, unknown> = {
      '@type': 'BlogPosting',
      '@id': `https://asreseo.com/blog/${p.slug}/#article`,
      headline: p.title,
      description: p.description ?? p.excerpt,
      url: `https://asreseo.com/blog/${p.slug}/`,
      inLanguage: 'en-US',
    };
    if (p.date) node.datePublished = p.date;
    if (p.updated ?? p.date) node.dateModified = p.updated ?? p.date;
    if (p.author) node.author = { '@type': 'Person', name: p.author };
    if (p.image) node.image = new URL(p.image, 'https://asreseo.com').href;
    return node;
  }),
};

// No visible breadcrumb UI on this template; the trail mirrors the site
// header nav (Home > Blog) for breadcrumb entity completeness.
const breadcrumbs = [
  { position: 1, name: 'Home', item: 'https://asreseo.com/' },
  { position: 2, name: 'Blog', item: 'https://asreseo.com/blog/' },
];
---
<BaseLayout
  lang="en"
  title="AsreSEO Blog | Expert SEO, Content & AI Articles"
  description="Expert AsreSEO articles on SEO, content production, Google Ads and AI — practical digital marketing guides to improve your Google rankings and grow website traffic."
  keywords="digital marketing blog, SEO articles, marketing tutorials, AsreSEO"
  canonical="/blog/"
  ogUrl="https://asreseo.com/blog/"
  ogTitle="AsreSEO Educational Blog"
  ogDescription="Expert digital marketing and SEO articles."
  ogImages={[{ url: '/og/blog-hero.jpg', width: 1200, height: 630, alt: 'AsreSEO blog' }]}
>
  <div class="min-h-screen bg-[#000000] text-slate-100 wireframe-grid">
    <Header lang="en" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(blogListSchema)} />
    <BreadcrumbStructuredData items={breadcrumbs} />
    <main class="pt-28 pb-20">
      <BlogHero lang="en" />
      <div class="py-16">
        <div class="w-full max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
          <BlogGrid posts={posts} lang="en" />
        </div>
      </div>
    </main>
    <Footer lang="en" />
  </div>
</BaseLayout>
