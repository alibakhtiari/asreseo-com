# Security headers + default HTML cache for all pages
#
# Header composition on this host (Cloudflare Workers static-asset docs): a
# request matching MULTIPLE rules inherits ALL of their headers, and when the
# same header is set twice the values are JOINED with a comma — they are NOT
# overridden (the earlier "later rule wins" assumption was wrong). Every rule
# below that redefines Cache-Control therefore first DETACHES the value
# inherited from the /* rule with "! Cache-Control". Without that detach,
# /robots.txt shipped "public, max-age=3600, public, max-age=86400",
# /sitemap-index.xml shipped it twice over, and /favicon.ico shipped
# "public, max-age=3600, public, max-age=31536000, immutable" — parsers read
# only the first value, silently truncating every intended TTL to 1h.
# (_headers only covers static-asset responses; worker.ts sets the same
# headers for Worker-generated responses, where _headers does not apply.)
#
# CSP baseline: script/style 'unsafe-inline' is deliberate and NOT the end
# state — the build emits ~9 distinct executable inline scripts (header,
# mega-menu, back-to-top, accordions, share buttons) whose bodies are
# minified build output, so their sha256 hashes cannot be pinned without a
# build. After the next build, hash every non-ld+json <script> body in
# dist/**/*.html and replace 'unsafe-inline' here and in worker.ts.
# HTML pages get max-age=3600, CDN-friendly; assets stay immutable.
# Bump `max-age` here or set a longer `s-maxage` if you'd like longer
# edge caching (e.g. public, max-age=0, s-maxage=86400 for stale-while-revalidate).
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Cache-Control: public, max-age=3600

# Cache static assets aggressively ("! Cache-Control" detaches the /* value
# first — see composition note above; otherwise the two values are joined)
/_astro/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/*.png
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/*.jpeg
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/*.gif
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/*.avif
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/*.ico
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/*.woff
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

