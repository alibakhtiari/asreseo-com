  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# API routes (if any)
#/api/*
#  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800

# Sitemap and robots (detached from /* the same way, then re-set to 86400)
/sitemap.xml
  ! Cache-Control
  Cache-Control: public, max-age=86400

/sitemap-index.xml
  ! Cache-Control
  Cache-Control: public, max-age=86400

/sitemap-*.xml
  ! Cache-Control
  Cache-Control: public, max-age=86400

/robots.txt
  ! Cache-Control
  Cache-Control: public, max-age=86400
